# ============================================================
# AssetPro Backend — Environment Variables
# Copy this file to .env and fill in all values
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/assetpro?sslmode=require"
DB_DISABLE_TLS_VERIFY=false

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# App
PORT=3001
NODE_ENV=development
DOMAIN_SUFFIX=assetpro.test
APP_NAME=AssetPro
APP_NAME_SHORT=AssetPro
COMPANY_DOMAIN=assetpro.io

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@assetpro.io
SMTP_FROM_NAME=AssetPro

# File Storage (S3-compatible — optional, falls back to local disk)
STORAGE_PROVIDER=local
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
UPLOAD_DIR=./uploads

# SMS / WhatsApp (optional)
TERMII_API_KEY=
TERMII_SENDER_ID=AssetPro
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Public frontend URL (used in email links)
FRONTEND_URL=http://localhost:4001

# Central admin
CENTRAL_ADMIN_EMAIL=admin@assetpro.io
