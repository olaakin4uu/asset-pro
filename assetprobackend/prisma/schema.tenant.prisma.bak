  expiryDate      DateTime? @db.Date
  purchaseOrderId Int?
  notes           String?   @db.Text
  receivedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, receiptCode])
  @@index([companyId, siteId])
  @@index([companyId, receiptDate])
  @@map("lsk_feed_receipts")
}

model LskFeedIssue {
  id              Int       @id @default(autoincrement())
  companyId       Int
  entityType      String    @db.VarChar(30)
  entityId        Int
  issueDate       DateTime  @db.Date
  feedTypeId      Int?
  feedName        String    @db.VarChar(150)
  formulationId   Int?
  quantityKg      Decimal   @db.Decimal(15,4)
  costPerKg       Decimal?  @db.Decimal(15,4)
  totalCost       Decimal?  @db.Decimal(15,2)
  siteId          Int?
  notes           String?   @db.Text
  issuedById      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, issueDate])
  @@index([companyId, siteId])
  @@map("lsk_feed_issues")
}

model LskFeedConsumptionSummary {
  id              Int       @id @default(autoincrement())
  companyId       Int
  entityType      String    @db.VarChar(30)
  entityId        Int
  periodStart     DateTime  @db.Date
  periodEnd       DateTime  @db.Date
  totalFeedKg     Decimal   @db.Decimal(15,4)
  totalGainKg     Decimal?  @db.Decimal(15,4)
  fcr             Decimal?  @db.Decimal(8,4)
  costPerKgGain   Decimal?  @db.Decimal(15,4)
  computedAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, entityType, entityId])
  @@map("lsk_feed_consumption_summaries")
}

model LskFeedWasteLog {
  id              Int       @id @default(autoincrement())
  companyId       Int
  siteId          Int
  wasteDate       DateTime  @db.Date
  feedTypeId      Int?
  feedName        String    @db.VarChar(150)
  quantityKg      Decimal   @db.Decimal(15,4)
  reason          String    @db.VarChar(200)
  estimatedCost   Decimal?  @db.Decimal(15,2)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())

  @@index([companyId, siteId])
  @@index([companyId, wasteDate])
  @@map("lsk_feed_waste_logs")
}

model LskFeedMillProduction {
  id              Int       @id @default(autoincrement())
  companyId       Int
