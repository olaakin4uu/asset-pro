  notes         String?
  herdId        String?
  isActive      Boolean   @default(true)
  isDeceased    Boolean   @default(false)
  deceasedDate  DateTime? @db.Date
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

