  objective             Json?
  assessment            Json?
  plan                  String?   @db.Text
  dischargeInstructions String?   @db.Text
  createdById           Int
  signedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("vet_soap_notes")
}

