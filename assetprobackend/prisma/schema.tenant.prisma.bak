}

// ============================================================================
// LIVESTOCK MODULE — Phase 5: Piggery
// ============================================================================

enum LskPigStatus {
  ACTIVE
  GESTATING
  LACTATING
  DRY
  GROWING
  FINISHING
  SOLD
  DECEASED
  CULLED
}

enum LskPigSex {
  BOAR
  SOW
  GILT
  BARROW
  PIGLET_MALE
  PIGLET_FEMALE
}

enum LskFarrowingEase {
  UNASSISTED
  MINOR_ASSIST
  MAJOR_ASSIST
  CAESAREAN
}

enum LskPigBatchStatus {
  ACTIVE
  GROWING
  FINISHING
  MARKETING
  CLOSED
  CANCELLED
}

model LskPig {
  id                  Int            @id @default(autoincrement())
  companyId           Int
  siteId              Int
  siteUnitId          Int?
  pigTag              String         @db.VarChar(50)
  name                String?        @db.VarChar(100)
  speciesId           Int
  breedId             Int?
  sex                 LskPigSex
  dateOfBirth         DateTime?      @db.Date
  status              LskPigStatus   @default(ACTIVE)
  sireId              Int?
  damId               Int?
  litterNumber        Int?
  earNotch            String?        @db.VarChar(30)
  tattoo              String?        @db.VarChar(30)
  rfidTag             String?        @db.VarChar(50)
  birthWeight         Decimal?       @db.Decimal(8,2)
  currentWeight       Decimal?       @db.Decimal(10,2)
  lastWeighDate       DateTime?      @db.Date
  parity              Int            @default(0)
  acquisitionDate     DateTime?      @db.Date
  acquisitionType     String?        @db.VarChar(30)
  acquisitionCost     Decimal?       @db.Decimal(15,2)
  disposalDate        DateTime?      @db.Date
  disposalType        String?        @db.VarChar(30)
  disposalAmount      Decimal?       @db.Decimal(15,2)
  notes               String?        @db.Text
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([companyId, pigTag])
  @@index([companyId, status])
  @@index([companyId, sex])
  @@index([companyId, siteId])
  @@index([companyId, sireId])
  @@index([companyId, damId])
  @@map("lsk_pigs")
}

model LskPigStatusLog {
  id          Int           @id @default(autoincrement())
  companyId   Int
  pigId       Int
  fromStatus  LskPigStatus?
  toStatus    LskPigStatus
  changedById Int?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())

  @@index([companyId, pigId])
  @@map("lsk_pig_status_log")
}

model LskSowCard {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  pigId                   Int       @unique
  firstServiceDate        DateTime? @db.Date
  totalLitters            Int       @default(0)
  totalBornAlive          Int       @default(0)
  totalStillborn          Int       @default(0)
  totalMummified          Int       @default(0)
  totalWeaned             Int       @default(0)
  avgBornAlivePerLitter   Decimal?  @db.Decimal(6,2)
  avgWeanedPerLitter      Decimal?  @db.Decimal(6,2)
  avgPreWeaningMortality  Decimal?  @db.Decimal(5,2)
  pigletIndex             Decimal?  @db.Decimal(8,2)
  lastFarrowingDate       DateTime? @db.Date
  lastWeaningDate         DateTime? @db.Date
  nextExpectedHeat        DateTime? @db.Date
  isActive                Boolean   @default(true)
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("lsk_sow_cards")
}

model LskBoarStud {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  pigId                 Int       @unique
  studEntryDate         DateTime? @db.Date
  totalMatings          Int       @default(0)
  successfulMatings     Int       @default(0)
  conceptionRate        Decimal?  @db.Decimal(5,2)
  semenQualityScore     String?   @db.VarChar(20)
  lastCollectionDate    DateTime? @db.Date
  lastSemenVolumeMl     Decimal?  @db.Decimal(8,2)
  lastSpermConcentration Decimal? @db.Decimal(12,2)
  lastMotilityPercent   Decimal?  @db.Decimal(5,2)
  isActive              Boolean   @default(true)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, isActive])
  @@map("lsk_boar_studs")
}

model LskPigBreedingEvent {
  id                  Int            @id @default(autoincrement())
  companyId           Int
  sowId               Int
  boarId              Int?
  breedingMethod      LskBreedingMethod
  breedingDate        DateTime       @db.Date
  semenBatchNumber    String?        @db.VarChar(50)
  heatDetectedDate    DateTime?      @db.Date
  heatNumber          Int?
  result              LskBreedingResult @default(PENDING)
  resultDate          DateTime?      @db.Date
  expectedFarrowDate  DateTime?      @db.Date
  notes               String?        @db.Text
  recordedById        Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId, sowId])
  @@index([companyId, boarId])
  @@index([companyId, breedingDate])
  @@index([companyId, result])
  @@map("lsk_pig_breeding_events")
}

model LskPigPregnancyCheck {
  id                  Int            @id @default(autoincrement())
  companyId           Int
  sowId               Int
  breedingEventId     Int?
  checkDate           DateTime       @db.Date
  checkMethod         String         @db.VarChar(50)
  result              LskBreedingResult
  daysPostBreeding    Int?
  estimatedFarrowDate DateTime?      @db.Date
  notes               String?        @db.Text
  checkedById         Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId, sowId])
  @@index([companyId, checkDate])
  @@map("lsk_pig_pregnancy_checks")
}

model LskPigFarrowingEvent {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  sowId               Int
  breedingEventId     Int?
  farrowingDate       DateTime         @db.Date
  farrowingEase       LskFarrowingEase @default(UNASSISTED)
  parityNumber        Int
  bornAlive           Int              @default(0)
  stillborn           Int              @default(0)
  mummified           Int              @default(0)
  totalBorn           Int              @default(0)
  avgBirthWeightKg    Decimal?         @db.Decimal(6,2)
  lightest            Decimal?         @db.Decimal(6,2)
  heaviest            Decimal?         @db.Decimal(6,2)
  crossFosteredIn     Int              @default(0)
  crossFosteredOut    Int              @default(0)
  nursingCount        Int?
  farrowingDurationMin Int?
  complications       String?          @db.Text
  notes               String?          @db.Text
  assistedById        Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([companyId, sowId])
  @@index([companyId, farrowingDate])
  @@map("lsk_pig_farrowing_events")
}

model LskPigPigletRecord {
  id                Int       @id @default(autoincrement())
  companyId         Int
  farrowingEventId  Int
  sowId             Int
  pigletTag         String?   @db.VarChar(50)
  sex               LskPigSex?
  birthWeightKg     Decimal?  @db.Decimal(6,2)
  isAlive           Boolean   @default(true)
  deathDate         DateTime? @db.Date
  deathReason       String?   @db.VarChar(100)
  weaningDate       DateTime? @db.Date
  weaningWeightKg   Decimal?  @db.Decimal(6,2)
  crossFosteredToSowId Int?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, farrowingEventId])
  @@index([companyId, sowId])
  @@map("lsk_pig_piglet_records")
}

model LskPigNurseryBatch {
  id                Int              @id @default(autoincrement())
  companyId         Int
  batchCode         String           @db.VarChar(30)
  siteUnitId        Int?
  status            LskPigBatchStatus @default(ACTIVE)
  entryDate         DateTime         @db.Date
  exitDate          DateTime?        @db.Date
  entryCount        Int
  entryAvgWeightKg  Decimal?         @db.Decimal(8,2)
  exitCount         Int?
  exitAvgWeightKg   Decimal?         @db.Decimal(8,2)
  mortalities       Int              @default(0)
  totalFeedKg       Decimal          @default(0) @db.Decimal(15,4)
  fcr               Decimal?         @db.Decimal(8,4)
  adg               Decimal?         @db.Decimal(8,4)
  feedProgramId     Int?
  notes             String?          @db.Text
  createdById       Int?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companyId, batchCode])
  @@index([companyId, status])
  @@map("lsk_pig_nursery_batches")
}

model LskPigGrowFinishBatch {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  batchCode           String           @db.VarChar(30)
  siteUnitId          Int?
  status              LskPigBatchStatus @default(ACTIVE)
  entryDate           DateTime         @db.Date
  exitDate            DateTime?        @db.Date
  entryCount          Int
  entryAvgWeightKg    Decimal?         @db.Decimal(8,2)
  targetMarketWeightKg Decimal?        @db.Decimal(8,2)
  exitCount           Int?
  exitAvgWeightKg     Decimal?         @db.Decimal(8,2)
  mortalities         Int              @default(0)
  totalFeedKg         Decimal          @default(0) @db.Decimal(15,4)
  fcr                 Decimal?         @db.Decimal(8,4)
  adg                 Decimal?         @db.Decimal(8,4)
  daysToMarket        Int?
  feedProgramId       Int?
  notes               String?          @db.Text
  createdById         Int?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([companyId, batchCode])
  @@index([companyId, status])
  @@map("lsk_pig_grow_finish_batches")
}

model LskPigWeight {
  id              Int       @id @default(autoincrement())
  companyId       Int
  pigId           Int?
  batchId         Int?
  batchType       String?   @db.VarChar(20)
  weighDate       DateTime  @db.Date
  weightKg        Decimal   @db.Decimal(10,2)
  isGroupAvg      Boolean   @default(false)
  sampleCount     Int?
  adg             Decimal?  @db.Decimal(8,4)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, pigId])
  @@index([companyId, batchId])
  @@index([companyId, weighDate])
