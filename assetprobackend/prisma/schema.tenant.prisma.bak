model VetLabResult {
  id           Int      @id @default(autoincrement())
  labOrderId   Int
  analyte      String
  value        String
  numericValue Decimal? @db.Decimal(12, 4)
  unit         String?
  referenceMin Decimal? @db.Decimal(12, 4)
  referenceMax Decimal? @db.Decimal(12, 4)
  isCritical   Boolean  @default(false)
  flag         String?
  notes        String?
  enteredById  Int?
  createdAt    DateTime @default(now())

  @@index([labOrderId])
  @@map("vet_lab_results")
}

