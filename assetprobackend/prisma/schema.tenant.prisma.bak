}

// ============================================================================
// LIVESTOCK MODULE — Phase 7: Health & Biosecurity (Cross-Species)
// ============================================================================

enum LskHealthEventSeverity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
}

enum LskTreatmentStatus {
  ACTIVE
  COMPLETED
  IN_WITHDRAWAL
  CLEARED
  CANCELLED
}

enum LskQuarantineStatus {
  ACTIVE
  RELEASED
  EXTENDED
  CANCELLED
}

enum LskMovementPermitStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  USED
}

model LskHealthEvent {
  id              Int                    @id @default(autoincrement())
  companyId       Int
  entityType      String                 @db.VarChar(30)
  entityId        Int
  eventDate       DateTime               @db.Date
  diseaseCodeId   Int?
  diseaseName     String?                @db.VarChar(150)
  severity        LskHealthEventSeverity?
  affectedCount   Int?
  symptoms        String?                @db.Text
  diagnosis       String?                @db.Text
  labResultId     Int?
  reportedById    Int?
  resolvedDate    DateTime?              @db.Date
  resolutionNotes String?                @db.Text
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, eventDate])
  @@index([companyId, severity])
  @@map("lsk_health_events")
}

model LskTreatment {
  id                  Int                @id @default(autoincrement())
  companyId           Int
  healthEventId       Int?
  entityType          String             @db.VarChar(30)
  entityId            Int
  treatmentDate       DateTime           @db.Date
  medicationId        Int?
  medicationName      String             @db.VarChar(150)
  dosage              String?            @db.VarChar(100)
  dosageUnit          String?            @db.VarChar(30)
  route               String?            @db.VarChar(30)
  durationDays        Int?
  endDate             DateTime?          @db.Date
  administeredById    Int?
  approvedByVetId     Int?
  status              LskTreatmentStatus @default(ACTIVE)
  notes               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, healthEventId])
  @@index([companyId, status])
  @@index([companyId, treatmentDate])
  @@map("lsk_treatments")
}

model LskTreatmentWithdrawal {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  treatmentId           Int
  entityType            String    @db.VarChar(30)
  entityId              Int
  medicationId          Int?
  medicationName        String    @db.VarChar(150)
  withdrawalType        String    @db.VarChar(20)
  withdrawalDays        Int
  withdrawalStartDate   DateTime  @db.Date
  withdrawalEndDate     DateTime  @db.Date
  isCleared             Boolean   @default(false)
  clearedDate           DateTime? @db.Date
  clearedById           Int?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, treatmentId])
  @@index([companyId, isCleared])
  @@index([companyId, withdrawalEndDate])
  @@map("lsk_treatment_withdrawals")
}

model LskVaccinationProgram {
  id              Int       @id @default(autoincrement())
  companyId       Int
  name            String    @db.VarChar(150)
  speciesId       Int?
  productionType  String?   @db.VarChar(30)
  description     String?   @db.Text
  isActive        Boolean   @default(true)
  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, speciesId])
  @@index([companyId, isActive])
  @@map("lsk_vaccination_programs")
}

model LskVaccinationEvent {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  entityType          String    @db.VarChar(30)
  entityId            Int
  programId           Int?
  vaccineName         String    @db.VarChar(150)
  diseaseTarget       String?   @db.VarChar(150)
  route               String?   @db.VarChar(30)
  batchNumber         String?   @db.VarChar(50)
  administeredDate    DateTime  @db.Date
  dosage              String?   @db.VarChar(50)
  dosageUnit          String?   @db.VarChar(30)
  treatedCount        Int?
  withdrawalDaysMeat  Int?
  withdrawalDaysMilk  Int?
  withdrawalDaysEggs  Int?
  administeredById    Int?
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, administeredDate])
  @@index([companyId, programId])
  @@map("lsk_vaccination_events")
}

model LskBiosecuritySop {
  id              Int       @id @default(autoincrement())
  companyId       Int
  sopCode         String    @db.VarChar(30)
  name            String    @db.VarChar(200)
  category        String    @db.VarChar(50)
  description     String?   @db.Text
  checklistItems  Json?
  frequency       String?   @db.VarChar(30)
  isActive        Boolean   @default(true)
  version         Int       @default(1)
  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, sopCode])
  @@index([companyId, category])
  @@index([companyId, isActive])
  @@map("lsk_biosecurity_sops")
}

model LskBiosecurityCheck {
  id              Int       @id @default(autoincrement())
  companyId       Int
  sopId           Int?
  siteId          Int
  checkDate       DateTime  @db.Date
  inspectorId     Int?
  inspectorName   String?   @db.VarChar(150)
  checklistResults Json?
  totalItems      Int?
  passedItems     Int?
  score           Decimal?  @db.Decimal(5,2)
  overallResult   String?   @db.VarChar(20)
  correctiveActions String? @db.Text
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, siteId])
  @@index([companyId, checkDate])
  @@map("lsk_biosecurity_checks")
}

model LskBiosecurityViolation {
  id                Int       @id @default(autoincrement())
  companyId         Int
  checkId           Int?
  siteId            Int
  violationDate     DateTime  @db.Date
  category          String    @db.VarChar(50)
  description       String    @db.Text
  severity          String    @db.VarChar(20)
  correctiveAction  String?   @db.Text
  dueDate           DateTime? @db.Date
  resolvedDate      DateTime? @db.Date
  resolvedById      Int?
  notes             String?   @db.Text
  reportedById      Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, siteId])
  @@index([companyId, violationDate])
  @@index([companyId, resolvedDate])
  @@map("lsk_biosecurity_violations")
}

model LskQuarantineZone {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  siteId          Int
  siteUnitId      Int?
  reason          String               @db.VarChar(200)
  diseaseCodeId   Int?
  status          LskQuarantineStatus  @default(ACTIVE)
  startDate       DateTime             @db.Date
  expectedEndDate DateTime?            @db.Date
  actualEndDate   DateTime?            @db.Date
  affectedCount   Int?
  restrictions    String?              @db.Text
  releasedById    Int?
  notes           String?              @db.Text
  createdById     Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, status])
  @@index([companyId, siteId])
  @@map("lsk_quarantine_zones")
}

model LskMovementPermit {
  id                Int                     @id @default(autoincrement())
  companyId         Int
  permitCode        String                  @db.VarChar(30)
  entityType        String                  @db.VarChar(30)
  entityId          Int?
  animalCount       Int?
  fromSiteId        Int
  toSiteId          Int?
  toExternalDest    String?                 @db.VarChar(200)
  movementDate      DateTime?               @db.Date
  purpose           String?                 @db.VarChar(100)
  healthCertRef     String?                 @db.VarChar(50)
  status            LskMovementPermitStatus @default(REQUESTED)
  requestedById     Int?
  approvedById      Int?
  approvedDate      DateTime?
  rejectionReason   String?                 @db.Text
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([companyId, permitCode])
  @@index([companyId, status])
  @@index([companyId, movementDate])
  @@map("lsk_movement_permits")
}

model LskVisitorLog {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  siteId              Int
  visitorName         String    @db.VarChar(150)
  visitorCompany      String?   @db.VarChar(200)
  visitorPhone        String?   @db.VarChar(30)
  purpose             String    @db.VarChar(200)
  visitDate           DateTime  @db.Date
  arrivalTime         DateTime?
  departureTime       DateTime?
  biosecurityCompliant Boolean  @default(false)
  footbathUsed        Boolean   @default(false)
  ppeWorn             Boolean   @default(false)
  vehicleDisinfected  Boolean?
  previousFarmVisit   Boolean?
  previousFarmName    String?   @db.VarChar(200)
  notes               String?   @db.Text
  loggedById          Int?
  createdAt           DateTime  @default(now())

  @@index([companyId, siteId])
  @@index([companyId, visitDate])
  @@map("lsk_visitor_logs")
}

model LskLabResult {
  id              Int       @id @default(autoincrement())
  companyId       Int
  healthEventId   Int?
  entityType      String?   @db.VarChar(30)
  entityId        Int?
  testDate        DateTime  @db.Date
  testType        String    @db.VarChar(100)
  labName         String?   @db.VarChar(200)
  labRefNumber    String?   @db.VarChar(50)
  sampleType      String?   @db.VarChar(50)
  result          String    @db.VarChar(200)
  resultDetails   Json?
  isPositive      Boolean?
  notes           String?   @db.Text
  testedById      Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, healthEventId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, testDate])
  @@map("lsk_lab_results")
}

// ============================================================================
// LIVESTOCK MODULE — Phase 8: Processing & Cold Chain
// ============================================================================

enum LskProcessingBatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LskColdChainZoneType {
  CHILLER
  FREEZER
  BLAST_FREEZER
  TRANSPORT
  AMBIENT
  OTHER
}

model LskProcessingBatch {
  id                Int                      @id @default(autoincrement())
  companyId         Int
  batchCode         String                   @db.VarChar(30)
  sourceEntityType  String                   @db.VarChar(30)
  sourceEntityId    Int
  processingType    String                   @db.VarChar(50)
  status            LskProcessingBatchStatus @default(PENDING)
  processingDate    DateTime                 @db.Date
  siteId            Int?
  notes             String?                  @db.Text
  processedById     Int?
  completedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([companyId, batchCode])
  @@index([companyId, status])
  @@index([companyId, processingDate])
  @@map("lsk_processing_batches")
}

model LskProcessingInput {
  id                Int       @id @default(autoincrement())
  companyId         Int
  batchId           Int
  description       String    @db.VarChar(200)
  quantity          Int?
  liveWeightKg      Decimal?  @db.Decimal(15,4)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([companyId, batchId])
  @@map("lsk_processing_inputs")
}

model LskProcessingOutput {
  id                Int       @id @default(autoincrement())
  companyId         Int
  batchId           Int
  productName       String    @db.VarChar(200)
  productType       String    @db.VarChar(50)
  grade             String?   @db.VarChar(30)
  quantity          Int?
  weightKg          Decimal?  @db.Decimal(15,4)
  pricePerKg        Decimal?  @db.Decimal(15,2)
  totalValue        Decimal?  @db.Decimal(15,2)
  lotNumber         String?   @db.VarChar(50)
  expiryDate        DateTime? @db.Date
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([companyId, batchId])
  @@map("lsk_processing_outputs")
}

model LskProcessingByproduct {
  id                Int       @id @default(autoincrement())
  companyId         Int
  batchId           Int
  byproductName     String    @db.VarChar(200)
  byproductType     String    @db.VarChar(50)
  quantityKg        Decimal?  @db.Decimal(15,4)
  disposition       String?   @db.VarChar(100)
  value             Decimal?  @db.Decimal(15,2)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([companyId, batchId])
  @@map("lsk_processing_byproducts")
}

model LskProcessingYield {
  id                Int       @id @default(autoincrement())
  companyId         Int
  batchId           Int       @unique
  totalInputKg      Decimal   @db.Decimal(15,4)
  totalOutputKg     Decimal   @db.Decimal(15,4)
  totalByproductKg  Decimal?  @db.Decimal(15,4)
  totalWasteKg      Decimal?  @db.Decimal(15,4)
  dressPercent      Decimal?  @db.Decimal(5,2)
  usablePercent     Decimal?  @db.Decimal(5,2)
  wastePercent      Decimal?  @db.Decimal(5,2)
  computedAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([companyId])
  @@map("lsk_processing_yields")
}

model LskColdChainZone {
  id                Int                @id @default(autoincrement())
  companyId         Int
  zoneCode          String             @db.VarChar(30)
  name              String             @db.VarChar(150)
  zoneType          LskColdChainZoneType
  siteId            Int?
  targetTempMin     Decimal?           @db.Decimal(5,2)
  targetTempMax     Decimal?           @db.Decimal(5,2)
  targetHumidityMin Decimal?           @db.Decimal(5,2)
  targetHumidityMax Decimal?           @db.Decimal(5,2)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, zoneCode])
  @@index([companyId, zoneType])
  @@index([companyId, isActive])
  @@map("lsk_cold_chain_zones")
}

model LskColdChainReading {
  id              Int       @id @default(autoincrement())
  companyId       Int
  zoneId          Int
  readingTime     DateTime
  temperatureC    Decimal   @db.Decimal(6,2)
  humidityPercent Decimal?  @db.Decimal(5,2)
  isIotReading    Boolean   @default(false)
  deviceId        String?   @db.VarChar(50)
  isAlert         Boolean   @default(false)
  alertMessage    String?   @db.VarChar(500)
  recordedById    Int?
  createdAt       DateTime  @default(now())

  @@index([companyId, zoneId])
  @@index([companyId, readingTime])
  @@index([companyId, isAlert])
  @@map("lsk_cold_chain_readings")
}

model LskColdChainExcursion {
  id                Int       @id @default(autoincrement())
  companyId         Int
  zoneId            Int
  startTime         DateTime
  endTime           DateTime?
  durationMinutes   Int?
  maxTempC          Decimal?  @db.Decimal(6,2)
  minTempC          Decimal?  @db.Decimal(6,2)
  correctiveAction  String?   @db.Text
  resolvedById      Int?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, zoneId])
  @@index([companyId, startTime])
  @@map("lsk_cold_chain_excursions")
}

model LskProductTraceability {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  lotNumber             String    @db.VarChar(50)
  productName           String    @db.VarChar(200)
  processingBatchId     Int?
  sourceEntityType      String?   @db.VarChar(30)
  sourceEntityId        Int?
  harvestDate           DateTime? @db.Date
  processingDate        DateTime? @db.Date
  packagingDate         DateTime? @db.Date
  expiryDate            DateTime? @db.Date
  coldChainZoneId       Int?
  dispatchDate          DateTime? @db.Date
  customerName          String?   @db.VarChar(200)
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([companyId, lotNumber])
  @@index([companyId, processingBatchId])
  @@index([companyId, sourceEntityType, sourceEntityId])
  @@map("lsk_product_traceability")
}

// ============================================================================
// LIVESTOCK MODULE — Phase 9: Finance & Costing
// ============================================================================

model LskCostCenter {
  id              Int       @id @default(autoincrement())
  companyId       Int
  costCenterCode  String    @db.VarChar(30)
  name            String    @db.VarChar(150)
  entityType      String?   @db.VarChar(30)
  speciesCategory String?   @db.VarChar(20)
  siteId          Int?
  parentId        Int?
  description     String?   @db.Text
  isActive        Boolean   @default(true)
  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, costCenterCode])
  @@index([companyId, entityType])
  @@index([companyId, isActive])
  @@map("lsk_cost_centers")
}

model LskCostAllocation {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  allocationCode     String    @db.VarChar(30)
  name               String    @db.VarChar(150)
  sourceType         String    @db.VarChar(50)
  sourceCostCenterId Int?
  allocationMethod   String    @db.VarChar(30)
  allocationBasis    String?   @db.VarChar(50)
  targetEntityTypes  Json?
  isActive           Boolean   @default(true)
  description        String?   @db.Text
  createdById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, allocationCode])
  @@index([companyId, isActive])
  @@map("lsk_cost_allocations")
}

model LskBiologicalAsset {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  entityType          String    @db.VarChar(30)
  entityId            Int
  assetClass          String    @db.VarChar(50)
  valuationDate       DateTime  @db.Date
  fairValuePerUnit    Decimal?  @db.Decimal(15, 4)
  unitCount           Int?
  totalFairValue      Decimal?  @db.Decimal(15, 2)
  costToSell          Decimal?  @db.Decimal(15, 2)
  fairValueLessCosts  Decimal?  @db.Decimal(15, 2)
  accumulatedCost     Decimal?  @db.Decimal(15, 2)
  gainLossOnValuation Decimal?  @db.Decimal(15, 2)
  valuationMethod     String?   @db.VarChar(50)
  notes               String?   @db.Text
  valuedById          Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, entityType, entityId])
  @@index([companyId, valuationDate])
  @@index([companyId, assetClass])
  @@map("lsk_biological_assets")
}

model LskBiologicalAssetMovement {
  id           Int      @id @default(autoincrement())
  companyId    Int
  assetId      Int
  movementDate DateTime @db.Date
  movementType String   @db.VarChar(50)
  description  String   @db.VarChar(200)
  quantity     Int?
  amount       Decimal  @db.Decimal(15, 2)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([companyId, assetId])
  @@index([companyId, movementDate])
  @@map("lsk_biological_asset_movements")
}

model LskCostVarianceAnalysis {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  entityType          String   @db.VarChar(30)
  entityId            Int
  periodStart         DateTime @db.Date
  periodEnd           DateTime @db.Date
  standardCostPerUnit Decimal? @db.Decimal(15, 4)
  actualCostPerUnit   Decimal? @db.Decimal(15, 4)
  variancePerUnit     Decimal? @db.Decimal(15, 4)
  variancePercent     Decimal? @db.Decimal(8, 2)
  totalStandardCost   Decimal? @db.Decimal(15, 2)
  totalActualCost     Decimal? @db.Decimal(15, 2)
  totalVariance       Decimal? @db.Decimal(15, 2)
  varianceType        String?  @db.VarChar(30)
  notes               String?  @db.Text
  computedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, periodStart])
  @@map("lsk_cost_variance_analyses")
}

model LskProfitabilityReport {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  entityType            String   @db.VarChar(30)
  entityId              Int
  periodStart           DateTime @db.Date
  periodEnd             DateTime @db.Date
  totalRevenue          Decimal? @db.Decimal(15, 2)
  totalCostOfProduction Decimal? @db.Decimal(15, 2)
  feedCost              Decimal? @db.Decimal(15, 2)
  healthCost            Decimal? @db.Decimal(15, 2)
  laborCost             Decimal? @db.Decimal(15, 2)
  overheadCost          Decimal? @db.Decimal(15, 2)
  otherCost             Decimal? @db.Decimal(15, 2)
  grossProfit           Decimal? @db.Decimal(15, 2)
  grossMarginPercent    Decimal? @db.Decimal(8, 2)
  netProfit             Decimal? @db.Decimal(15, 2)
  netMarginPercent      Decimal? @db.Decimal(8, 2)
  costPerUnit           Decimal? @db.Decimal(15, 4)
  unitType              String?  @db.VarChar(20)
  computedAt            DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, periodStart])
  @@map("lsk_profitability_reports")
}

// ============================================================================
// ALERT RULE ENGINE
// ============================================================================

enum LskAlertRuleType {
  MORTALITY_DAILY_PCT        // deadQty+cullQty on one day / placementQty * 100
  MORTALITY_CUMULATIVE_PCT   // totalMortalities+totalCulls / placementQty * 100
  HDP_DROP_3D                // henDayPercent dropped for 3 consecutive days
  HDP_DROP_1D                // single-day HDP drop exceeding threshold pp from yesterday
  FCR_HIGH                   // cumulativeFcr exceeds threshold
  FEED_TO_EGG_HIGH           // feed-per-egg ratio above threshold
  VACCINATION_OVERDUE        // scheduled vaccination is past due
  UNDERWEIGHT_ARRIVAL        // avgPlacementWeightG below breed target at day 0 by more than threshold %
  WEIGHT_DEVIATION           // weight sample avg is below breed target by more than threshold %
  BROODING_COLD_SNAP         // forecast low-temp for a brooding flock's site drops below threshold °C
}

enum LskAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum LskAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model LskAlertRule {
  id           Int              @id @default(autoincrement())
  companyId    Int
  ruleType     LskAlertRuleType
  name         String           @db.VarChar(120)
  description  String?          @db.Text
  threshold    Decimal          @db.Decimal(10, 4)
  severity     LskAlertSeverity @default(WARNING)
  isActive     Boolean          @default(true)
  isSystem     Boolean          @default(false)
  createdById  Int?
  updatedById  Int?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, ruleType])
  @@map("lsk_alert_rules")
}

model LskAlert {
  id               Int              @id @default(autoincrement())
  companyId        Int
  ruleId           Int
  ruleType         LskAlertRuleType
  entityType       String           @db.VarChar(20)
  entityId         Int
  severity         LskAlertSeverity
  status           LskAlertStatus   @default(ACTIVE)
  metric           String           @db.VarChar(40)
  observedValue    Decimal          @db.Decimal(12, 4)
  thresholdValue   Decimal          @db.Decimal(12, 4)
  message          String           @db.Text
  contextJson      Json?
  triggeredAt      DateTime         @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  resolvedAt       DateTime?
  resolvedById     Int?
  resolutionNotes  String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([companyId, status, triggeredAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, ruleId])
  @@map("lsk_alerts")
}

// ============================================================================
// NOTIFICATION CHANNEL (phones + email get alerts)
// ============================================================================

enum LskNotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum LskNotificationStatus {
  QUEUED
  SENT
  FAILED
}

model LskNotificationRecipient {
  id           Int                    @id @default(autoincrement())
  companyId    Int
  name         String                 @db.VarChar(120)
  channel      LskNotificationChannel
  destination  String                 @db.VarChar(200)
  minSeverity  LskAlertSeverity       @default(WARNING)
  ruleTypes    Json?
  isActive     Boolean                @default(true)
  createdById  Int?
  updatedById  Int?
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, channel])
  @@map("lsk_notification_recipients")
}

model LskNotificationLog {
  id                Int                    @id @default(autoincrement())
  companyId         Int
  alertId           Int
  recipientId       Int
  channel           LskNotificationChannel
  destination       String                 @db.VarChar(200)
  status            LskNotificationStatus
  providerMessageId String?                @db.VarChar(200)
  errorMessage      String?                @db.Text
  sentAt            DateTime?
  createdAt         DateTime               @default(now())

  @@index([companyId, alertId])
  @@index([companyId, status, createdAt])
  @@map("lsk_notification_log")
}

// ============================================================================
// LEAKAGE CONTROL — egg reconciliation + empty feed-bag audit
// ============================================================================

model LskEggStockReconciliation {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  reconciliationDate   DateTime  @db.Date
  flockId              Int?
  openingStock         Int       @default(0)
  collectedToday       Int       @default(0)
  damagedToday         Int       @default(0)
  soldToday            Int       @default(0)
  adjustmentsToday     Int       @default(0)
  expectedClosingStock Int       @default(0)
  actualClosingStock   Int       @default(0)
  variance             Int       @default(0)
  variancePercent      Decimal?  @db.Decimal(6, 2)
  varianceNotes        String?   @db.Text
  createdById          Int?
  updatedById          Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, reconciliationDate])
  @@index([companyId, flockId, reconciliationDate])
  @@map("lsk_egg_stock_reconciliations")
}

model LskEmptyBagLog {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  logDate            DateTime  @db.Date
  feedTypeId         Int?
  expectedEmptyBags  Int       @default(0)
  actualEmptyBags    Int       @default(0)
  variance           Int       @default(0)
  bagsSoldForReturn  Int       @default(0)
  notes              String?   @db.Text
  createdById        Int?
  updatedById        Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId, logDate])
  @@map("lsk_empty_bag_logs")
}

// ============================================================================
// VACCINE STOCK (batch tracking + expiry watch)
// ============================================================================

// ============================================================================
// MARKET PRICES (tenant-curated rates for eggs / live birds / DOCs)
// ============================================================================

enum LskMarketProductType {
  EGG_CRATE
  LIVE_BROILER_KG
  LIVE_LAYER_KG
  POINT_OF_LAY_PULLET
  DAY_OLD_CHICK
  SPENT_HEN
  OTHER
}

model LskMarketPrice {
  id           Int                  @id @default(autoincrement())
  companyId    Int
  productType  LskMarketProductType
  productLabel String?              @db.VarChar(120)
  price        Decimal              @db.Decimal(15, 2)
  currencyCode String               @default("NGN") @db.VarChar(3)
  recordedDate DateTime             @db.Date
  source       String?              @db.VarChar(120)
  notes        String?              @db.Text
  createdById  Int?
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([companyId, productType, recordedDate])
  @@map("lsk_market_prices")
}

// ============================================================================
// LIVESTOCK PRE-ORDERS (booking ledger for future eggs / birds)
// ============================================================================

enum LskPreorderStatus {
  BOOKED
  FULFILLED
  CANCELLED
}

model LskPreorder {
  id                 Int                  @id @default(autoincrement())
  companyId          Int
  customerId         Int
  productType        LskMarketProductType
  productLabel       String?              @db.VarChar(120)
  quantity           Decimal              @db.Decimal(15, 2)
  unit               String               @default("crates") @db.VarChar(30)
  unitPrice          Decimal?             @db.Decimal(15, 2)
  totalAmount        Decimal?             @db.Decimal(15, 2)
  expectedDeliveryDate DateTime           @db.Date
  status             LskPreorderStatus    @default(BOOKED)
  fulfilledAt        DateTime?
  depositAmount      Decimal?             @db.Decimal(15, 2)
  salesOrderId       Int?
  notes              String?              @db.Text
  createdById        Int?
  updatedById        Int?
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId, status, expectedDeliveryDate])
  @@index([companyId, customerId])
  @@map("lsk_preorders")
}

/// Pivot linking sales documents (orders/invoices) back to livestock sources
/// (flocks, egg collections). Lets "sales per flock" reports JOIN without
/// adding livestock columns to the sales schema.
model LskSaleLink {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  salesOrderId       Int?
  salesOrderLineId   Int?
  salesInvoiceId     Int?
  salesInvoiceLineId Int?
  preorderId         Int?
  flockId            Int?
  eggCollectionId    Int?
  linkType           String   @db.VarChar(40)
  quantity           Decimal  @db.Decimal(15, 4)
  unit               String   @default("birds") @db.VarChar(30)
  avgLiveWeightKg    Decimal? @db.Decimal(10, 3)
  eggGrade           String?  @db.VarChar(10)
  notes              String?  @db.Text
  createdById        Int?
  createdAt          DateTime @default(now())

  @@index([companyId, flockId])
  @@index([companyId, preorderId])
  @@index([companyId, salesOrderId])
  @@index([companyId, salesInvoiceId])
  @@map("lsk_sale_links")
}

model LskVaccineStock {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  vaccineScheduleId   Int?
  vaccineName         String    @db.VarChar(150)
  batchNumber         String    @db.VarChar(80)
  expiryDate          DateTime  @db.Date
  manufacturerName    String?   @db.VarChar(150)
  supplierName        String?   @db.VarChar(150)
  receivedDate        DateTime? @db.Date
  storageLocation     String?   @db.VarChar(120)
  initialDoses        Int       @default(0)
  remainingDoses      Int       @default(0)
  unitCost            Decimal?  @db.Decimal(12, 2)
  notes               String?   @db.Text
  isActive            Boolean   @default(true)
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, vaccineName])
  @@index([companyId, expiryDate])
  @@index([companyId, isActive])
  @@map("lsk_vaccine_stock")
}

// ---------------------------------------------------------------------------
// Messaging — per-company outbound SMS/WhatsApp settings (Sprint 2 Batch 3)
// ---------------------------------------------------------------------------

// ============================================================================
// Shared identity verification — used by Vet (client KYC), Hotel (guest KYC),
// Fund Management (investor onboarding). Cached per (companyId, doc-hash,
// provider) to avoid re-billing for the same NIN/BVN. Entries expire after
// 12 months — past that, the caller must re-verify.
//
// `documentNumberHash` is sha256 of the raw NIN/BVN — we never store raw.
// `documentNumberMasked` keeps only the last 4 digits visible (******1234)
// for the audit UI.
// ============================================================================
// ============================================================================
// HOTEL MANAGEMENT — Sprint 1 (multi-property)
//
// One company can run many branches; each branch is a distinct hotel
// property. Room types + rooms + reservations are all branch-scoped, so a
// chain ("Bar Magen Hotels" with Lagos + Abuja + PH branches) shares one
// company / one Customer table / one chart of accounts but gets its own
// inventory of rooms.
//
// Reservations link to standard `customers` (the AR backbone) — same
// bridge pattern Vet uses for clients. Folios collapse into SalesInvoices
// at checkout via the existing GL machinery.
// ============================================================================

model HotelRoomType {
  id            Int       @id @default(autoincrement())
  companyId     Int
  branchId      Int
  code          String    // STD, DLX, EXEC-SUITE, etc.
  name          String    // Standard Room, Deluxe, Executive Suite
  description   String?   @db.Text
  baseRate      Decimal   @db.Decimal(12, 2)        // before tax / discount
  maxOccupancy  Int       @default(2)
  bedConfig     String?   // "1 King" / "2 Twin" / etc.
  amenities     Json?     // ["AC", "Smart TV", "Mini-bar"…]
  photos        Json?     // [{ url, caption }] — managed via the file pipeline
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rooms HotelRoom[]

  @@unique([companyId, branchId, code])
  @@index([companyId, branchId, isActive])
  @@map("hotel_room_types")
}

model HotelRoom {
  id            Int       @id @default(autoincrement())
  companyId     Int
  branchId      Int
  roomTypeId    Int
  roomNumber    String    // "101", "Suite-3A", "Garden-1"
  floor         String?   // "Ground", "1", "2", "Penthouse"
  view          String?   // "Pool", "Garden", "Sea", "Inner court"
  // Status grid (matches the visual floor-plan colour codes):
  //   vacant_clean  - green   - ready
  //   vacant_dirty  - red     - needs cleaning
  //   occupied      - blue    - guest inside
  //   reserved      - grey    - assigned to an arriving reservation
  //   maintenance   - yellow  - AC / plumbing / etc.
  //   out_of_order  - black   - long-term hold (e.g. renovation)
  status        String    @default("vacant_clean")
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roomType     HotelRoomType         @relation(fields: [roomTypeId], references: [id])
  reservations HotelReservation[]
  statusLog    HotelRoomStatusLog[]

  @@unique([companyId, branchId, roomNumber])
  @@index([companyId, branchId, status])
  @@index([roomTypeId])
  @@map("hotel_rooms")
}

model HotelRoomStatusLog {
  id          Int      @id @default(autoincrement())
  roomId      Int
  fromStatus  String?
  toStatus    String
  changedById Int?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())

  room HotelRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("hotel_room_status_log")
}

model HotelReservation {
  id              Int       @id @default(autoincrement())
  companyId       Int
  branchId        Int
  customerId      Int       // standard AR customer (same bridge as Vet)
  reservationCode String    // RES-2026-000123
  // Lifecycle:
  //   pending       - awaiting confirmation / payment
  //   confirmed     - guaranteed
  //   checked_in    - guest has key
  //   checked_out   - bill closed, room dirty
  //   no_show       - never arrived
  //   cancelled     - by guest or by clinic
  status          String    @default("pending")
  // Source keeps OTA commission visible in reports:
  //   walk_in / direct / website / booking_com / expedia / jumia / corporate
  source          String    @default("direct")

  arrivalDate     DateTime  @db.Date
  departureDate   DateTime  @db.Date
  nights          Int

  adults          Int       @default(1)
  children        Int       @default(0)

  roomTypeId      Int?      // preferred type at booking
  roomId          Int?      // assigned (set at check-in or earlier)

  ratePerNight    Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(15, 2)
  // State consumption tax — snapshot of the rate at booking time so historical
  // bills stay correct when the tenant changes their tax setting later.
  taxRate         Decimal   @default(0) @db.Decimal(6, 4) // e.g. 0.0500 = 5%
  taxAmount       Decimal   @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal   @db.Decimal(15, 2)
  depositAmount   Decimal   @default(0) @db.Decimal(15, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(15, 2)
  balanceAmount   Decimal   @db.Decimal(15, 2)
  // Caution / damages deposit — refundable, NOT counted toward total.
  // Released back at check-out (less any damages forfeited).
  cautionDepositAmount  Decimal @default(0) @db.Decimal(15, 2)
  cautionRefundedAmount Decimal @default(0) @db.Decimal(15, 2)
  cautionReleaseReason  String? @db.Text

  // KYC linkage — FK to the shared identity verification table
  kycVerificationId Int?

  // Misc
  specialRequests   String?   @db.Text
  internalNotes     String?   @db.Text
  blacklistFlag     Boolean   @default(false)
  flagReason        String?

  // Timestamps
  checkedInAt       DateTime?
  checkedInById     Int?
  checkedOutAt      DateTime?
  checkedOutById    Int?
  cancelledAt       DateTime?
  cancelledById     Int?
  cancellationReason String?  @db.Text

  // Folio linkage when the reservation closes into a SalesInvoice
  salesInvoiceId  Int?

  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  room     HotelRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([companyId, reservationCode])
  @@index([companyId, branchId, status])
  @@index([companyId, branchId, arrivalDate])
  @@index([customerId])
  @@map("hotel_reservations")
}

// =====================================================================
// Halal Asset-Backed Financing — every credit facility must be tied to
// at least one physical asset, with proof of ownership/invoice, and
// disbursement routed to the supplier directly (never as cash to the
// investee). Lifecycle: pending_proof → proof_uploaded → awaiting_payment
// → paid_to_supplier → delivered. Plus a reject branch for Shari'ah board
// pushback.
// =====================================================================
model FmFacilityAsset {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  facilityId               Int       // FK to fm_credit_facilities
  assetType                String    // vehicle | property | equipment | raw_materials | inventory | other
  description              String    @db.Text
  costPrice                Decimal   @db.Decimal(15, 2)
  // Supplier registry — direct disbursement target
  supplierName             String    @db.VarChar(255)
  supplierAccountName      String?   @db.VarChar(255)
  supplierAccountNumber    String?   @db.VarChar(30)
  supplierBankName         String?   @db.VarChar(255)
  supplierBankCode         String?   @db.VarChar(10)
  // Proof artifacts (relative paths under /uploads/tenants/<slug>/fm-assets/)
  certificateOfOwnershipUrl String?  @db.VarChar(500)
  invoiceUrl               String?   @db.VarChar(500)
  additionalDocsUrls       Json?     // jsonb array
  // Lifecycle
  status                   String    @default("pending_proof")
  rejectedReason           String?   @db.Text
  rejectedById             Int?
  rejectedAt               DateTime?
  // Disbursement audit
  paidAt                   DateTime?
  paidByUserId             Int?
  paidAmount               Decimal?  @db.Decimal(15, 2)
  paidViaTransactionRef    String?   @db.VarChar(120)
  // Delivery confirmation
  deliveryConfirmedAt      DateTime?
  deliveryConfirmedByUserId Int?
  deliveryNotes            String?   @db.Text
  createdById              Int?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([companyId, facilityId])
  @@index([companyId, status])
  @@map("fm_facility_assets")
}

// =====================================================================
// Halal Aqad — Islamic-finance contract templates + e-signatures
//
// Per blueprint: Mudarabah, Wakala, Sukuk subscription, Ijarah, Murabaha
// each need a signed digital Aqad. Two-table design:
//
//   fm_contract_templates  — tenant-curated boilerplate per contract type
//   fm_contract_signings   — one row per actual signing event (frozen snapshot)
//
// OTP-based e-signature: hash stored at server, plain code SMS/emailed via
// the existing Termii adapter. After verification, the rendered HTML is
// snapshotted into renderedContent so the legal text never silently mutates
// when a template is later edited.
// =====================================================================
model FmContractTemplate {
  id           Int       @id @default(autoincrement())
  companyId    Int
  type         String    // MUDARABAH | WAKALA | SUKUK_SUBSCRIPTION | IJARAH | MURABAHA
  name         String    @db.VarChar(255)
  version      Int       @default(1)
  contentHtml  String    @db.Text
  // Whitelist of allowed placeholder names — used by the renderer + UI hint.
  // e.g. ["investorName", "investorIdNumber", "fundName", "ratioInvestor",
  //       "ratioManager", "subscriptionAmount", "date"]
  placeholders Json      @default("[]")
  isActive     Boolean   @default(true)
  // Exactly one default per (companyId, type) — enforced in service, not SQL.
  isDefault    Boolean   @default(false)
  createdById  Int?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, type, isActive])
  @@map("fm_contract_templates")
}

model FmContractSigning {
  id              Int       @id @default(autoincrement())
  companyId       Int
  templateId      Int
  type            String    // mirrored from template at initiation
  investorId      Int
  // Polymorphic anchor — exactly one of these is set for a given signing.
  subscriptionId  Int?      // fm_subscriptions
  facilityId      Int?      // fm_credit_facilities
  sukukIssueId    Int?      // future hookup
  // Frozen content at the moment the signing was initiated. The template
  // can change later without rewriting history.
  renderedContent String    @db.Text
  // Lifecycle:
  //   draft             - just initiated, OTP sent
  //   pending_signature - OTP delivered, awaiting code
  //   signed            - OTP verified, contract bound
  //   cancelled         - operator rolled it back before signing
  //   expired           - OTP TTL elapsed without verification
  status          String    @default("pending_signature")
  // Signature metadata (captured at OTP verification)
  signedAt              DateTime?
  signedByName          String?   @db.VarChar(255)
  signedByEmail         String?   @db.VarChar(255)
  signedByIpAddress     String?   @db.VarChar(64)
  signedByUserAgent     String?   @db.Text
  // OTP — store sha256 hash only, never the plain code
  otpHash               String?   @db.VarChar(128)
  otpSentAt             DateTime?
  otpExpiresAt          DateTime?
  otpVerifiedAt         DateTime?
  otpAttempts           Int       @default(0)
  // Cancellation
  cancelledAt           DateTime?
  cancelledById         Int?
  cancellationReason    String?   @db.Text
  // PDF artifact (optional — we keep HTML on the row anyway)
  pdfPath               String?   @db.VarChar(500)
  createdById           Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, investorId])
  @@index([companyId, status])
  @@index([subscriptionId])
  @@index([facilityId])
  @@map("fm_contract_signings")
}

// Charity / NGO registry — destinations for Zakat distributions and
// purification/late-fee remittances. Per-tenant so each fund manager curates
// the NGOs their investors trust. focusAreas captures the cause types
// (poverty, education, healthcare, orphans, masjid, etc.) so investors can
// pick alignment with their preferred Zakat allocation.
model FmCharityNgo {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  name                String    @db.VarChar(255)
  registrationNumber  String?   @db.VarChar(120) // CAC / SCUML / regulator ID
  description         String?   @db.Text
  contactName         String?   @db.VarChar(255)
  contactEmail        String?   @db.VarChar(255)
  contactPhone        String?   @db.VarChar(50)
  websiteUrl          String?   @db.VarChar(500)
  // Bank details — Zakat / purification disbursements use these
  bankName            String?   @db.VarChar(255)
  bankAccountNumber   String?   @db.VarChar(30)
  bankAccountName     String?   @db.VarChar(255)
  bankCode            String?   @db.VarChar(10)
  // Cause categorisation (text array — e.g. ['poverty', 'education', 'masjid'])
  focusAreas          String[]
  // Approval state — only verified NGOs are pickable for live payouts
  isVerified          Boolean   @default(false)
  verifiedById        Int?
  verifiedAt          DateTime?
  isActive            Boolean   @default(true)
  notes               String?   @db.Text
  createdById         Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, isActive, isVerified])
  @@map("fm_charity_ngos")
}

// =====================================================================
// Halal late-payment fees on credit facilities.
//
// Sharia rule: late-payment fees CANNOT be recognised as the manager's
// income — that would constitute riba (interest on debt). Instead, the
// fee is accrued separately and forwarded to a verified charity NGO
// (purification flow). This table tracks the lifecycle:
//
//   accrued             — recorded against a facility (and optionally a
//                         specific repayment) but not yet routed
//   settled_to_charity  — disbursed to an NGO via fm_purification_records
//
// Why not just stuff it into fm_credit_repayments? Existing tenants are
// already running the repayments flow. A separate table keeps the
// migration safe (no destructive column adds) and isolates the
// purification audit trail per Sharia-board expectation.
// =====================================================================
model FmCreditFacilityLateFee {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  facilityId           Int       // FK to fm_credit_facilities
  repaymentId          Int?      // optional FK to fm_credit_repayments
  feeAmount            Decimal   @db.Decimal(18, 2)
  reason               String?   @db.Text
  recordedAt           DateTime  @default(now())
  recordedById         Int?
  // Settlement target — pre-selected NGO (optional at accrual time, must be
  // set when settling) and the resulting purification record.
  charityNgoId         Int?      // FK to fm_charity_ngos
  purificationRecordId Int?      // FK to fm_purification_records once settled
  // Lifecycle: 'accrued' | 'settled_to_charity' | 'waived'
  status               String    @default("accrued") @db.VarChar(30)
  settledAt            DateTime?
  settledById          Int?
  // Bank-transfer audit captured at settlement — establishes the trail
  // from the fee to the actual disbursement leaving the manager's bank.
  paymentMethod        String?   @db.VarChar(40) // bank_transfer | cash | other
  paymentReference     String?   @db.VarChar(100)
  notes                String?   @db.Text
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, facilityId])
  @@index([companyId, charityNgoId])
  @@map("fm_credit_facility_late_fees")
}

// =====================================================================
// Wakala fee schedule.
//
// Wakala is the agency contract in Islamic finance: investors appoint
// the manager as their agent (wakeel) to deploy capital, in exchange
// for an agreed fee. Unlike Mudarabah (which is profit-share), the
// Wakala fee is FIXED — typically tiered by AUM size or expressed as
// a flat periodic amount. The schedule is what the manager applies
// when the periodic fee accrual runs — this is configuration, not
// transactional accrual. Accruals continue to live in the generic
// fee-calculations flow.
//
// One tier set ("Standard Wakala Schedule 2026") may apply to all
// funds (fundId NULL) or to a single fund (fundId set). The active
// tier set at the period-end date is the one used.
// =====================================================================
model FmWakalaFeeTier {
  id               Int                   @id @default(autoincrement())
  companyId        Int
  fundId           Int?                  // null = applies to all funds (master schedule)
  name             String                @db.VarChar(120)
  description      String?               @db.Text
  // 'tiered' uses the brackets table; 'flat' uses flatFeeAmount + flatFeeFrequency
  feeMethod        String                @default("tiered") @db.VarChar(20)
  flatFeeAmount    Decimal?              @db.Decimal(20, 2)
  flatFeeFrequency String?               @db.VarChar(20)   // 'monthly' | 'quarterly' | 'annually'
  effectiveFrom    DateTime              @db.Timestamptz(6)
  effectiveTo      DateTime?             @db.Timestamptz(6)
  isActive         Boolean               @default(true)
  notes            String?               @db.Text
  brackets         FmWakalaFeeBracket[]
  facilities       FmCreditFacility[]
  createdById      Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  @@index([companyId, isActive])
  @@index([companyId, fundId])
  @@map("fm_wakala_fee_tiers")
}

// Each bracket maps an AUM range to an annual rate. Brackets must be
// sorted, contiguous, non-overlapping; the top bracket has upperBound
// NULL (unbounded). Rates are stored as decimal fractions — 0.0125 = 1.25%.
model FmWakalaFeeBracket {
  id          Int             @id @default(autoincrement())
  tierId      Int
  tier        FmWakalaFeeTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  lowerBound  Decimal         @db.Decimal(20, 2)
  upperBound  Decimal?        @db.Decimal(20, 2)
  annualRate  Decimal         @db.Decimal(8, 4)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tierId, sortOrder])
  @@map("fm_wakala_fee_brackets")
}

// Tracks each posted Wakala fee accrual. One row per period per facility.
// Voiding creates a reversal journal entry and stamps voidedAt.
model FmWakalaFeeAccrual {
  id              Int       @id @default(autoincrement())
  companyId       Int
  facilityId      Int
  feeTierId       Int
  periodFrom      DateTime  @db.Date
  periodTo        DateTime  @db.Date
  periodDays      Int
  aum             Decimal   @db.Decimal(20, 2)
  feeMethod       String    @db.VarChar(20)
  totalFee        Decimal   @db.Decimal(18, 2)
  journalEntryId  Int?
  voidedAt        DateTime?
  voidedBy        Int?
  voidJournalId   Int?
  notes           String?   @db.Text
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, facilityId])
  @@index([companyId, feeTierId])
  @@map("fm_wakala_fee_accruals")
}

// Per-reservation payment ledger. Hotel payments are recorded here directly
// rather than via the receivables receipt flow so receptionists can move fast
// at the front desk. Each payment bumps reservation.paidAmount; voids reverse
// it.
//
// posSessionId links the payment to the recording user's open POS cash
// register session (cash_register_sessions). Receptionists open/close their
// cash drawer using the existing POS session UI — there is no separate hotel
// "shift" table. The POS close summary aggregates these hotel payments so the
// receptionist's cash reconciliation includes hotel revenue.
model HotelReservationPayment {
  id              Int       @id @default(autoincrement())
  companyId       Int
  reservationId   Int
  posSessionId    Int?      // FK to cash_register_sessions.id when recorded inside an open session
  amount          Decimal   @db.Decimal(15, 2)
  paymentMethod   String    // cash | card | bank_transfer | pos | other
  bankAccountId   Int?      // FK to banks.id when method = bank_transfer / card
  referenceNumber String?   // bank ref / card slip / etc.
  description     String?
  paidAt          DateTime  @default(now())
  voidedAt        DateTime?
  voidedById      Int?
  voidReason      String?
  createdById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, reservationId])
  @@index([companyId, paidAt])
  @@index([posSessionId])
  @@map("hotel_reservation_payments")
}

// Nightly snapshot per branch produced by the night-audit cron.
// Captures the room board state at run time + a tally of the day's
// arrivals/no-shows so management can see daily KPIs without
// re-scanning the reservations table.
model HotelNightAuditRun {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int
  runDate             DateTime  @db.Date
  // Room board at the time of the audit
  totalRooms          Int
  vacantRooms         Int       @default(0)
  occupiedRooms       Int       @default(0)
  reservedRooms       Int       @default(0)
  dirtyRooms          Int       @default(0)
  oooRooms            Int       @default(0)
  // Daily tallies for runDate
  arrivalsExpected    Int       @default(0)
  arrivalsCompleted   Int       @default(0)
  noShowsMarked       Int       @default(0)
  occupancyRate       Decimal   @default(0) @db.Decimal(5, 4) // 0..1
  revenue             Decimal   @default(0) @db.Decimal(15, 2)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())

  @@unique([companyId, branchId, runDate])
  @@index([companyId, runDate])
  @@map("hotel_night_audit_runs")
}

// One row per branch — receptionists configure tax rate, check-in /
// check-out windows, default caution deposit. Branches with no row default
// to 0% tax (sane fallback so a fresh tenant doesn't break).
model HotelBranchSettings {
  id                    Int      @id @default(autoincrement())
  companyId             Int
  branchId              Int
  consumptionTaxRate    Decimal  @default(0) @db.Decimal(6, 4) // e.g. 0.0500 = 5%
  taxLabel              String   @default("State Consumption Tax")
  defaultCheckInTime    String   @default("14:00") // 24h HH:MM
  defaultCheckOutTime   String   @default("12:00")
  defaultCautionAmount  Decimal  @default(0) @db.Decimal(15, 2)
  // Optional invoice footer — Sharia-compliant or state-specific notes
  invoiceFooterNote     String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([companyId, branchId])
  @@map("hotel_branch_settings")
}

model KycVerification {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  documentType         String
  documentNumberHash   String
  documentNumberMasked String
  provider             String
  status               String

  matchedFirstName     String?
  matchedLastName      String?
  matchedMiddleName    String?
  matchedDateOfBirth   DateTime? @db.Date
  matchedGender        String?
  matchedPhone         String?
  matchedPhotoUrl      String?

  rawResponse          Json?
  requestedById        Int?

  entityType           String?
  entityId             Int?

  verifiedAt           DateTime?
  expiresAt            DateTime?
  errorMessage         String?   @db.Text

  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, documentNumberHash, provider])
  @@index([companyId, entityType, entityId])
  @@index([companyId, verifiedAt])
  @@map("kyc_verifications")
}

model MessagingSettings {
  companyId           Int      @id
  provider            String   @default("termii")
  apiKey              String   @db.Text
  senderId            String   @default("SalvagePro") @db.VarChar(20)
  whatsappFromNumber  String?  @db.VarChar(20)
  // Sprint 2 Batch 5: destination for the daily owner snapshot WhatsApp.
  ownerPhone          String?  @db.VarChar(20)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("messaging_settings")
}

// ============================================================================
// FUND MANAGEMENT - ISLAMIC FINANCE STRUCTURES
// ============================================================================
// Sharia-compliant pricing/scheduling/distribution for Murabaha, Ijarah and
// Mudarabah credit facilities. These extend FmCreditFacility with the
// structure-specific data each contract type requires:
//   Murabaha   — cost-plus sale: a fixed markup on a known asset cost.
//   Ijarah     — lease-to-own: a periodic rental schedule.
//   Mudarabah  — profit-sharing partnership: distributions per declared period.
// ============================================================================

model FmMurabahaPricing {
  id               Int       @id @default(autoincrement())
  companyId        Int
  facilityId       Int
  assetCost        Decimal   @db.Decimal(20, 2)
  markupAmount     Decimal   @db.Decimal(20, 2)
  totalSalePrice   Decimal   @db.Decimal(20, 2)
  supplierName     String    @db.VarChar(200)
  supplierInvoice  String?   @db.VarChar(100)
  costEvidenceUrl  String?   @db.VarChar(500)
  pricingDate      DateTime  @db.Timestamptz(6)
  notes            String?
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@unique([facilityId])
  @@index([companyId])
  @@map("fm_murabaha_pricing")
}

model FmIjarahRentalSchedule {
  id               Int       @id @default(autoincrement())
  companyId        Int
  facilityId       Int
  periodNumber     Int
  periodStart      DateTime  @db.Timestamptz(6)
  periodEnd        DateTime  @db.Timestamptz(6)
  dueDate          DateTime  @db.Timestamptz(6)
  rentAmount       Decimal   @db.Decimal(20, 2)
  status           String    @default("scheduled") @db.VarChar(20) // scheduled | invoiced | paid | overdue | waived
  paidAmount       Decimal?  @db.Decimal(20, 2)
  paidAt           DateTime? @db.Timestamptz(6)
  paymentReference String?   @db.VarChar(100)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@unique([facilityId, periodNumber])
  @@index([companyId, facilityId])
  @@index([dueDate, status])
  @@map("fm_ijarah_rental_schedules")
}

model FmMudarabahDistribution {
  id                Int       @id @default(autoincrement())
  companyId         Int
  facilityId        Int
  periodStart       DateTime  @db.Timestamptz(6)
  periodEnd         DateTime  @db.Timestamptz(6)
  declarationDate   DateTime  @db.Timestamptz(6)
  totalProfit       Decimal   @db.Decimal(20, 2)
  managerSharePct   Decimal   @db.Decimal(8, 4)
  managerShare      Decimal   @db.Decimal(20, 2)
  investorShare     Decimal   @db.Decimal(20, 2)
  status            String    @default("declared") @db.VarChar(20) // declared | paid | voided
  paidAt             DateTime? @db.Timestamptz(6)
  paymentReference   String?   @db.VarChar(100)
  paymentMethod      String?   @db.VarChar(40)
  notes              String?
  declaredById       Int?
  paidById           Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  @@index([companyId, facilityId, declarationDate])
  @@map("fm_mudarabah_distributions")
}

// ============================================================================
// FOOD & BEVERAGE POS (F&B)
// ----------------------------------------------------------------------------
// The hotel restaurant / bar / room-service order-taking and billing layer.
// Distinct from the retail POS module (cash sessions + SKU sales) because
// F&B has its own concerns: tables, courses, kitchen tickets, tableside
// modifiers, and the room-charge bridge into hotel_reservation_payments.
// ============================================================================

model FnbOutlet {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int
  name            String   @db.VarChar(120)
  outletType      String   @db.VarChar(30)
  description     String?
  isActive        Boolean  @default(true)
  vatRate         Decimal  @default(0.075) @db.Decimal(8, 4)
  serviceCharge   Decimal  @default(0.10) @db.Decimal(8, 4)
  defaultPrinterId String? @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, branchId, isActive])
  @@map("fnb_outlets")
}

model FnbTable {
  id            Int     @id @default(autoincrement())
  companyId     Int
  outletId      Int
  tableNumber   String  @db.VarChar(20)
  capacity      Int     @default(2)
  status        String  @default("vacant") @db.VarChar(20)
  zone          String? @db.VarChar(50)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([outletId, tableNumber])
  @@index([companyId, outletId, status])
  @@map("fnb_tables")
}

model FnbMenuCategory {
  id          Int     @id @default(autoincrement())
  companyId   Int
  outletId    Int?
  name        String  @db.VarChar(120)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([companyId, outletId, isActive])
  @@map("fnb_menu_categories")
}

model FnbMenuItem {
  id              Int      @id @default(autoincrement())
  companyId       Int
  categoryId      Int
  inventoryItemId Int?
  name            String   @db.VarChar(200)
  description     String?
  price           Decimal  @db.Decimal(20, 2)
  isAvailable     Boolean  @default(true)
  preparationMins Int      @default(15)
  imageUrl        String?  @db.VarChar(500)
  isVegetarian    Boolean  @default(false)
  isHalal         Boolean  @default(true)
  spiceLevel      Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, categoryId, isAvailable])
  @@map("fnb_menu_items")
}

model FnbModifier {
  id          Int     @id @default(autoincrement())
  companyId   Int
  menuItemId  Int
  name        String  @db.VarChar(120)
  priceAdjust Decimal @default(0) @db.Decimal(20, 2)
  isRequired  Boolean @default(false)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([companyId, menuItemId])
  @@map("fnb_modifiers")
}

model FnbOrder {
  id              Int      @id @default(autoincrement())
  companyId       Int
  outletId        Int
  tableId         Int?
  reservationId   Int?
  orderNumber     String   @db.VarChar(40)
  orderType       String   @db.VarChar(30)
  status          String   @default("open") @db.VarChar(20)
  guestCount      Int      @default(1)
  subtotal        Decimal  @default(0) @db.Decimal(20, 2)
  serviceCharge   Decimal  @default(0) @db.Decimal(20, 2)
  vatAmount       Decimal  @default(0) @db.Decimal(20, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(20, 2)
  total           Decimal  @default(0) @db.Decimal(20, 2)
  settlementMethod String? @db.VarChar(40)
  settledAt       DateTime? @db.Timestamptz(6)
  settledById     Int?
  posSessionId    Int?
  notes           String?
  serverId        Int?
  openedAt        DateTime @default(now())
  closedAt        DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([companyId, orderNumber])
  @@index([companyId, outletId, status])
  @@index([reservationId])
  @@map("fnb_orders")
}

model FnbOrderItem {
  id              Int     @id @default(autoincrement())
  orderId         Int
  menuItemId      Int
  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(20, 2)
  modifierAdjust  Decimal @default(0) @db.Decimal(20, 2)
  lineSubtotal    Decimal @db.Decimal(20, 2)
  status          String  @default("pending") @db.VarChar(20)
  course          Int     @default(1)
  specialInstructions String?
  voidReason      String?
  voidedById      Int?
  voidedAt        DateTime? @db.Timestamptz(6)
  sentToKitchenAt DateTime? @db.Timestamptz(6)
  servedAt        DateTime? @db.Timestamptz(6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId, status])
  @@map("fnb_order_items")
}

model FnbOrderItemModifier {
  id              Int     @id @default(autoincrement())
  orderItemId     Int
  modifierId      Int
  modifierName    String  @db.VarChar(120)
  priceAdjust     Decimal @db.Decimal(20, 2)

  @@index([orderItemId])
  @@map("fnb_order_item_modifiers")
}

// ============================================================================
// BANQUETS / EVENTS
// ============================================================================
// Function-room bookings (weddings, conferences, corporate events). Distinct
// from sleeping-room reservations in the hotel module — banquets are about
// venue + catering + addons (DJ, photography, decor) for a date+time slot.

model BqVenue {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int
  name            String   @db.VarChar(120)
  description     String?
  capacityMin     Int      @default(10)
  capacityMax     Int      @default(100)
  squareMetres    Decimal? @db.Decimal(10, 2)
  hasStage        Boolean  @default(false)
  hasAv           Boolean  @default(false)
  hasParking      Boolean  @default(false)
  baseHourlyRate  Decimal  @db.Decimal(20, 2)
  baseDailyRate   Decimal? @db.Decimal(20, 2)
  imageUrl        String?  @db.VarChar(500)
  amenities       String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, branchId, isActive])
  @@map("bq_venues")
}

model BqEventType {
  id            Int     @id @default(autoincrement())
  companyId     Int
  name          String  @db.VarChar(120)
  description   String?
  defaultDurationHours Decimal @default(4) @db.Decimal(8, 2)
  packageNotes  String?
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([companyId, isActive])
  @@map("bq_event_types")
}

model BqPackage {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String   @db.VarChar(120)
  description     String?
  perPersonPrice  Decimal  @db.Decimal(20, 2)
  flatPrice       Decimal  @default(0) @db.Decimal(20, 2)
  inclusions      String[] @default([])
  minGuests       Int      @default(20)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, isActive])
  @@map("bq_packages")
}

model BqEventBooking {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int
  bookingNumber   String   @db.VarChar(40)
  eventTypeId     Int
  packageId       Int?
  venueId         Int
  customerName    String   @db.VarChar(200)
  customerPhone   String?  @db.VarChar(40)
  customerEmail   String?  @db.VarChar(120)
  reservationId   Int?
  eventTitle      String   @db.VarChar(200)
  eventDate       DateTime @db.Timestamptz(6)
  startTime       String   @db.VarChar(5)
  endTime         String   @db.VarChar(5)
  durationHours   Decimal  @db.Decimal(8, 2)
  expectedGuests  Int
  actualGuests    Int?
  setupRequirements String?
  specialRequests String?
  status          String   @default("inquiry") @db.VarChar(20)

  venueRate       Decimal  @db.Decimal(20, 2)
  cateringTotal   Decimal  @default(0) @db.Decimal(20, 2)
  addonTotal      Decimal  @default(0) @db.Decimal(20, 2)
  subtotal        Decimal  @default(0) @db.Decimal(20, 2)
  vatAmount       Decimal  @default(0) @db.Decimal(20, 2)
  serviceCharge   Decimal  @default(0) @db.Decimal(20, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(20, 2)
  total           Decimal  @default(0) @db.Decimal(20, 2)
  depositRequired Decimal  @default(0) @db.Decimal(20, 2)
  depositPaid     Decimal  @default(0) @db.Decimal(20, 2)
  balanceDue      Decimal  @default(0) @db.Decimal(20, 2)

  inquiriedAt     DateTime @default(now())
  quotedAt        DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  completedAt     DateTime?

  notes           String?
  bookedById      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([companyId, bookingNumber])
  @@index([companyId, branchId, status])
  @@index([eventDate])
  @@index([venueId, eventDate])
  @@map("bq_event_bookings")
}

model BqEventCatering {
  id          Int     @id @default(autoincrement())
  bookingId   Int
  fnbItemId   Int?
  name        String  @db.VarChar(200)
  quantity    Int
  unitPrice   Decimal @db.Decimal(20, 2)
  lineTotal   Decimal @db.Decimal(20, 2)
  category    String? @db.VarChar(60)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
  @@map("bq_event_catering")
}

model BqEventAddon {
  id          Int     @id @default(autoincrement())
  bookingId   Int
  name        String  @db.VarChar(200)
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(20, 2)
  lineTotal   Decimal @db.Decimal(20, 2)
  vendorName  String? @db.VarChar(200)
  vendorPhone String? @db.VarChar(40)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
  @@map("bq_event_addons")
}

model BqEventPayment {
  id              Int      @id @default(autoincrement())
  companyId       Int
  bookingId       Int
  paymentDate     DateTime @db.Timestamptz(6)
  amount          Decimal  @db.Decimal(20, 2)
  paymentMethod   String   @db.VarChar(40)
  paymentReference String? @db.VarChar(100)
  paymentType     String   @db.VarChar(30)
  notes           String?
  receivedById    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, bookingId])
  @@map("bq_event_payments")
}

// ============================================================================
// LOYALTY MODULE - Guest profiles, tiers, points, rewards, redemptions
// Cross-module unification of repeat guests across hotel reservations,
// F&B orders and banquet bookings into a single profile.
// ============================================================================

model LoyaltyTier {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String   @db.VarChar(60)
  minPoints       Int
  pointsMultiplier Decimal @default(1.0) @db.Decimal(8, 4)
  benefits        String[] @default([])
  iconColor       String?  @db.VarChar(20)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, minPoints])
  @@map("loyalty_tiers")
}

model LoyaltyMember {
  id              Int      @id @default(autoincrement())
  companyId       Int
  membershipNumber String  @db.VarChar(40)
  firstName       String   @db.VarChar(100)
  lastName        String   @db.VarChar(100)
  email           String?  @db.VarChar(120)
  phone           String?  @db.VarChar(40)
  dateOfBirth     DateTime? @db.Date
  preferredCurrency String @default("NGN") @db.VarChar(10)
  preferredRoomType String? @db.VarChar(50)
  dietaryNotes    String?
  marketingConsent Boolean @default(false)
  status          String   @default("active") @db.VarChar(20)
  enrolledAt      DateTime @default(now())
  lifetimePoints  Int      @default(0)
  currentPoints   Int      @default(0)
  currentTierId   Int?
  totalStays      Int      @default(0)
  totalFnbOrders  Int      @default(0)
  totalBanquets   Int      @default(0)
  lastVisitAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([companyId, membershipNumber])
  @@index([companyId, status])
  @@index([email])
  @@index([phone])
  @@map("loyalty_members")
}

model LoyaltyTransaction {
  id              Int      @id @default(autoincrement())
  companyId       Int
  memberId        Int
  transactionType String   @db.VarChar(20)
  source          String   @db.VarChar(30)
  sourceId        Int?
  points          Int
  cashEquivalent  Decimal? @db.Decimal(20, 2)
  description     String?
  expiresAt       DateTime? @db.Timestamptz(6)
  recordedById    Int?
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, memberId, recordedAt])
  @@index([source, sourceId])
  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String   @db.VarChar(120)
  description     String?
  pointsCost      Int
  rewardType      String   @db.VarChar(30)
  cashValue       Decimal? @db.Decimal(20, 2)
  validityDays    Int      @default(180)
  isActive        Boolean  @default(true)
  imageUrl        String?  @db.VarChar(500)
  termsAndConditions String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([companyId, isActive])
  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id              Int      @id @default(autoincrement())
  companyId       Int
  memberId        Int
  rewardId        Int
  redemptionCode  String   @db.VarChar(40)
  pointsSpent     Int
  status          String   @default("issued") @db.VarChar(20)
  issuedAt        DateTime @default(now())
  expiresAt       DateTime @db.Timestamptz(6)
  usedAt          DateTime?
  usedAtSource    String?  @db.VarChar(30)
  usedAtSourceId  Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, redemptionCode])
  @@index([companyId, memberId, status])
  @@map("loyalty_redemptions")
}

// ============================================================================
// OTA / Channel Manager — framework scaffold for syncing inventory, rates and
// reservations to Online Travel Agencies (Booking.com, Expedia, Agoda, Airbnb,
// Hotels.com). Adapters are stubs — real sync requires partner credentials.
// ============================================================================

model OtaChannel {
  id              Int      @id @default(autoincrement())
  companyId       Int
  branchId        Int?
  channelCode     String   @db.VarChar(40)
  displayName     String   @db.VarChar(120)
  status          String   @default("disconnected") @db.VarChar(20)
  apiCredentialsRef String? @db.VarChar(200)
  hotelIdOnChannel String? @db.VarChar(100)
  syncRatesEnabled Boolean @default(true)
  syncInventoryEnabled Boolean @default(true)
  syncReservationsEnabled Boolean @default(true)
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorMessage String?
  config          Json?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([companyId, branchId, channelCode])
  @@index([companyId, status])
  @@map("ota_channels")
}

model OtaRoomMapping {
  id              Int      @id @default(autoincrement())
  companyId       Int
  channelId       Int
  hotelRoomTypeId Int
  channelRoomTypeId String @db.VarChar(100)
  channelRoomTypeName String? @db.VarChar(200)
  channelRatePlanIds String[] @default([])
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([channelId, hotelRoomTypeId])
  @@index([companyId, channelId])
  @@map("ota_room_mappings")
}

model OtaSyncJob {
  id              Int      @id @default(autoincrement())
  companyId       Int
  channelId       Int
  jobType         String   @db.VarChar(40)
  status          String   @default("pending") @db.VarChar(20)
  payload         Json?
  result          Json?
  errorMessage    String?
  attemptCount    Int      @default(0)
  maxAttempts     Int      @default(3)
  scheduledFor    DateTime @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, channelId, status])
  @@index([scheduledFor, status])
  @@map("ota_sync_jobs")
}

model OtaInboundReservation {
  id              Int      @id @default(autoincrement())
  companyId       Int
  channelId       Int
  channelReservationId String @db.VarChar(100)
  rawPayload      Json
  guestName       String   @db.VarChar(200)
  guestEmail      String?  @db.VarChar(120)
  guestPhone      String?  @db.VarChar(40)
  checkInDate     DateTime @db.Date
  checkOutDate    DateTime @db.Date
  channelRoomTypeId String @db.VarChar(100)
  totalAmount     Decimal  @db.Decimal(20, 2)
  currency        String   @default("NGN") @db.VarChar(10)
  status          String   @default("received") @db.VarChar(20)
  hotelReservationId Int?
  errorMessage    String?
  receivedAt      DateTime @default(now())
  mappedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([channelId, channelReservationId])
  @@index([companyId, status])
  @@map("ota_inbound_reservations")
}

// ============================================================================
// HATCHERY MODULE
// ============================================================================

enum HatcheryMachineType {
  SETTER
  HATCHER
  COMBO
}

enum HatcheryMachineStatus {
  ACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum HatcheryEggSourceType {
  IMPORT
  LOCAL_PURCHASE
  BREEDER_FARM
}

enum HatcheryEggBatchStatus {
  QUARANTINE
  AVAILABLE
  IN_INCUBATION
  EXHAUSTED
  REJECTED
}

enum HatcheryRunStatus {
  PENDING
  SETTING
  CANDLING
  HATCHING
  COMPLETE
  FAILED
  CANCELLED
}

enum HatcheryChickType {
  BROILER_DOC
  LAYER_DOC
  BROILER_PULLET
  LAYER_PULLET
  BREEDER_DOC
  TURKEY_DOC
  OTHER
}

enum HatcheryChickGrade {
  FIRST
  SECOND
  CULL
}

enum HatcheryChickBatchStatus {
  HOLDING
  PARTIALLY_SOLD
  FULLY_SOLD
  CULLED
}

model HatcheryMachine {
  id           Int                    @id @default(autoincrement())
  companyId    Int
  machineCode  String                 @db.VarChar(30)
  name         String                 @db.VarChar(120)
  machineType  HatcheryMachineType
  capacity     Int
  brand        String?                @db.VarChar(80)
  model        String?                @db.VarChar(80)
  serialNumber String?                @db.VarChar(80)
  siteId       Int?
  status       HatcheryMachineStatus  @default(ACTIVE)
  notes        String?                @db.Text
  createdById  Int?
  deletedAt    DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([companyId, machineCode])
  @@index([companyId, status])
  @@map("hatchery_machines")
}

model HatcheryEggBatch {
  id                   Int                    @id @default(autoincrement())
  companyId            Int
  batchCode            String                 @db.VarChar(40)
  sourceType           HatcheryEggSourceType
  sourceDocumentId     Int?
  sourceDocumentType   String?                @db.VarChar(40)
  flockEggCollectionId Int?
  supplierId           Int?
  breedId              Int?
  eggType              String                 @default("BROILER") @db.VarChar(30)
  quantityReceived     Int
  quantitySettable     Int?
  quantityRejected     Int                    @default(0)
  unitCost             Decimal?               @db.Decimal(15, 4)
  totalCost            Decimal?               @db.Decimal(15, 2)
  currency             String                 @default("NGN") @db.VarChar(10)
  flockId              Int?
  rejectionReason      String?                @db.VarChar(255)
  receivedDate         DateTime               @db.Date
  expiryDate           DateTime?              @db.Date
  status               HatcheryEggBatchStatus @default(QUARANTINE)
  notes                String?                @db.Text
  createdById          Int?
  deletedAt            DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([companyId, batchCode])
  @@index([companyId, status])
  @@index([companyId, sourceType])
  @@index([companyId, receivedDate])
  @@map("hatchery_egg_batches")
}

model HatcheryIncubationRun {
  id                  Int               @id @default(autoincrement())
  companyId           Int
  runCode             String            @db.VarChar(40)
  setterId            Int?
  hatcherId           Int?
  setDate             DateTime          @db.Date
  expectedCandleDate  DateTime?         @db.Date
  transferDate        DateTime?         @db.Date
  expectedHatchDate   DateTime?         @db.Date
  actualHatchDate     DateTime?         @db.Date
  totalEggsSet        Int               @default(0)
  breedStrain         String?           @db.VarChar(100)
  avgTemperature      Decimal?          @db.Decimal(5, 2)
  avgHumidity         Decimal?          @db.Decimal(5, 2)
  turningFrequency    Int?
  status              HatcheryRunStatus @default(PENDING)
  notes               String?           @db.Text
  createdById         Int?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([companyId, runCode])
  @@index([companyId, status])
  @@index([companyId, setDate])
  @@map("hatchery_incubation_runs")
}

model HatcheryRunEggBatch {
  id               Int      @id @default(autoincrement())
  companyId        Int
  incubationRunId  Int
  eggBatchId       Int
  quantitySet      Int
  createdAt        DateTime @default(now())

  @@unique([incubationRunId, eggBatchId])
  @@index([companyId, incubationRunId])
  @@index([companyId, eggBatchId])
  @@map("hatchery_run_egg_batches")
}

model HatcheryCandlingResult {
  id               Int      @id @default(autoincrement())
  companyId        Int
  incubationRunId  Int
  candlingDate     DateTime @db.Date
  candlingDay      Int
  fertile          Int      @default(0)
  infertile        Int      @default(0)
  deadInShell      Int      @default(0)
  cracked          Int      @default(0)
  totalInspected   Int      @default(0)
  fertilityRate    Decimal? @db.Decimal(5, 2)
  conductedById    Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([incubationRunId, candlingDate])
  @@index([companyId, incubationRunId])
  @@map("hatchery_candling_results")
}

model HatcheryHatchResult {
  id               Int      @id @default(autoincrement())
  companyId        Int
  incubationRunId  Int      @unique
  hatchDate        DateTime @db.Date
  eggsSet          Int
  eggsTransferred  Int?
  chicksHatched    Int      @default(0)
  deadInShell      Int      @default(0)
  unhatched        Int      @default(0)
  cripples         Int      @default(0)
  hatchRate        Decimal? @db.Decimal(5, 2)
  hatchability     Decimal? @db.Decimal(5, 2)
  fertilityRate    Decimal? @db.Decimal(5, 2)
  notes            String?  @db.Text
  recordedById     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, hatchDate])
  @@map("hatchery_hatch_results")
}

model HatcheryChickBatch {
  id               Int                      @id @default(autoincrement())
  companyId        Int
  batchCode        String                   @db.VarChar(40)
  incubationRunId  Int
  hatchResultId    Int?
  chickType        HatcheryChickType        @default(BROILER_DOC)
  chickGrade       HatcheryChickGrade       @default(FIRST)
  chicksCount      Int
  chicksAvailable  Int
  breedId          Int?
  breedStrain      String?                  @db.VarChar(100)
  earlyMortality   Int                      @default(0)
  vaccinationDone  Boolean                  @default(false)
  vaccinationDate  DateTime?                @db.Date
  vaccinationNotes String?                  @db.VarChar(255)
  inventoryItemId  Int?
  warehouseId      Int?
  postedToInventory Boolean                 @default(false)
  postedAt         DateTime?
  status           HatcheryChickBatchStatus @default(HOLDING)
  notes            String?                  @db.Text
  createdById      Int?
  deletedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([companyId, batchCode])
  @@index([companyId, status])
  @@index([companyId, incubationRunId])
  @@map("hatchery_chick_batches")
}

// ── New: operational & biosecurity extensions ─────────────────────────────────

enum HatcheryBiosecurityCheckType {
  FUMIGATION
  DISINFECTION
  VISITOR_LOG
  WASTE_DISPOSAL
  DISEASE_INCIDENT
  ROUTINE_INSPECTION
}

enum HatcheryConsumptionType {
  VACCINE
  DISINFECTANT
  FUEL_DIESEL
  FUEL_GAS
  PACKAGING
  MEDICATION
  OTHER
}

model HatcheryPowerLog {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  runId               Int?
  logDate             DateTime @db.Date
  powerOutageStart    DateTime?
  powerOutageEnd      DateTime?
  outageDurationMins  Int?
  generatorStarted    Boolean  @default(false)
  generatorRunMins    Int?
  dieselUsedLitres    Decimal? @db.Decimal(8, 2)
  impact              String?  @db.VarChar(500)
  loggedById          Int?
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId, logDate])
  @@index([companyId, runId])
  @@map("hatchery_power_logs")
}

model HatcheryBiosecurityCheck {
  id                  Int                          @id @default(autoincrement())
  companyId           Int
  checkType           HatcheryBiosecurityCheckType
  checkDate           DateTime                     @db.Date
  checkedById         Int?
  checkedByName       String?                      @db.VarChar(100)
  area                String?                      @db.VarChar(100)
  chemicalUsed        String?                      @db.VarChar(200)
  dilutionRate        String?                      @db.VarChar(100)
  passed              Boolean                      @default(true)
  failureReason       String?                      @db.VarChar(500)
  visitorName         String?                      @db.VarChar(200)
  visitorOrganisation String?                      @db.VarChar(200)
  visitorPurpose      String?                      @db.VarChar(200)
  incidentDescription String?                      @db.Text
  actionTaken         String?                      @db.Text
  notes               String?                      @db.Text
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([companyId, checkDate])
  @@index([companyId, checkType])
  @@map("hatchery_biosecurity_checks")
}

model HatcheryBatchConsumption {
  id              Int                    @id @default(autoincrement())
  companyId       Int
  runId           Int
  consumptionType HatcheryConsumptionType
  inventoryItemId Int?
  itemName        String                 @db.VarChar(200)
  quantity        Decimal                @db.Decimal(10, 3)
  unitOfMeasure   String?                @db.VarChar(20)
  unitCost        Decimal?               @db.Decimal(18, 2)
  totalCost       Decimal?               @db.Decimal(18, 2)
  isrRequestId    Int?
  consumptionDate DateTime               @db.Date
  recordedById    Int?
  notes           String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([companyId, runId])
  @@index([companyId, consumptionDate])
  @@map("hatchery_batch_consumptions")
}

model HatcheryVaccinationRecord {
  id                Int      @id @default(autoincrement())
  companyId         Int
  chickBatchId      Int
  vaccineName       String   @db.VarChar(200)
  vaccineType       String?  @db.VarChar(100)
  manufacturer      String?  @db.VarChar(200)
  batchNumber       String?  @db.VarChar(100)
  expiryDate        DateTime? @db.Date
  vaccinationDate   DateTime @db.Date
  dosagePerChick    Decimal? @db.Decimal(8, 4)
  routeOfAdmin      String?  @db.VarChar(50)
  chicksVaccinated  Int?
  administeredById  Int?
  administeredByName String? @db.VarChar(100)
  inventoryItemId   Int?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId, chickBatchId])
  @@index([companyId, vaccinationDate])
  @@map("hatchery_vaccination_records")
}

// ============================================================================
// REAL ESTATE MODULE
// ============================================================================

enum RePropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
  INDUSTRIAL

  @@map("RePropertyType")
}

enum RePropertyStatus {
  ACTIVE
  INACTIVE

  @@map("RePropertyStatus")
}

enum ReUnitType {
  APARTMENT
  STUDIO
  DUPLEX
  OFFICE
  SHOP
  WAREHOUSE
  LAND
  OTHER

  @@map("ReUnitType")
}

enum ReUnitStatus {
  VACANT
  OCCUPIED
  UNDER_MAINTENANCE
  RESERVED

  @@map("ReUnitStatus")
}

enum ReLeaseType {
  FIXED_TERM
  PERIODIC
  SUBLEASE

  @@map("ReLeaseType")
}

enum ReTenancyFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY

  @@map("ReTenancyFrequency")
}

enum ReLeaseStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED

  @@map("ReLeaseStatus")
}

enum ReLeaseChargeType {
  RENT
  SERVICE_CHARGE
  GROUND_RENT
  PARKING
  OTHER

  @@map("ReLeaseChargeType")
}

enum ReLeaseChargeFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_OFF

  @@map("ReLeaseChargeFrequency")
}

enum ReDepositStatus {
  HELD
  RELEASED
  FORFEITED
  PARTIALLY_FORFEITED

  @@map("ReDepositStatus")
}

enum ReNigerianState {
  LAGOS
  FCT
  RIVERS
  KANO
  OGUN
  OYO
  KWARA
  ANAMBRA
  ENUGU
  DELTA
  OTHER

  @@map("ReNigerianState")
}

model ReProperty {
  id                          Int              @id @default(autoincrement())
  companyId                   Int
  code                        String           @db.VarChar(30)
  name                        String           @db.VarChar(200)
  propertyType                RePropertyType   @default(RESIDENTIAL)
  address                     String?          @db.VarChar(500)
  city                        String?          @db.VarChar(100)
  state                       ReNigerianState  @default(LAGOS)
  lga                         String?          @db.VarChar(100)
  landRegistryRef             String?          @db.VarChar(100)
  coONumber                   String?          @db.VarChar(100)
  rightOfOccupancyRef         String?          @db.VarChar(100)
  totalUnits                  Int              @default(0)
  landAreaSqm                 Decimal?         @db.Decimal(12, 2)
  glRevenueAccountId          Int?
  glDepositLiabilityAccountId Int?
  glMaintenanceExpenseAccountId Int?
  managerId                   Int?
  status                      RePropertyStatus @default(ACTIVE)
  notes                       String?          @db.Text
  deletedAt                   DateTime?
  createdById                 Int?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, propertyType])
  @@map("re_properties")
}

model ReUnit {
  id               Int           @id @default(autoincrement())
  companyId        Int
  propertyId       Int
  unitNumber       String        @db.VarChar(30)
  floor            String?       @db.VarChar(20)
  unitType         ReUnitType    @default(APARTMENT)
  areaSqm          Decimal?      @db.Decimal(10, 2)
  bedroomCount     Int?
  bathroomCount    Int?
  furnished        Boolean       @default(false)
  marketRent       Decimal?      @db.Decimal(15, 2)
  currency         String        @default("NGN") @db.VarChar(3)
  status           ReUnitStatus  @default(VACANT)
  glRevenueAccountId Int?
  notes            String?       @db.Text
  deletedAt        DateTime?
  createdById      Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([companyId, propertyId, unitNumber])
  @@index([companyId, propertyId])
  @@index([companyId, status])
  @@map("re_units")
}

model ReAmenity {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String @db.VarChar(100)
  icon      String? @db.VarChar(50)

  @@unique([companyId, name])
  @@map("re_amenities")
}

model ReUnitAmenity {
  unitId    Int
  amenityId Int

  @@id([unitId, amenityId])
  @@map("re_unit_amenities")
}

model ReLease {
  id                      Int                  @id @default(autoincrement())
  companyId               Int
  leaseCode               String               @db.VarChar(30)
  unitId                  Int
  customerId              Int
  leaseType               ReLeaseType          @default(FIXED_TERM)
  tenancyFrequency        ReTenancyFrequency   @default(YEARLY)
  startDate               DateTime             @db.Date
  endDate                 DateTime?            @db.Date
  noticePeriodDays        Int                  @default(180)
  rentAmount              Decimal              @db.Decimal(15, 2)
  rentCurrency            String               @default("NGN") @db.VarChar(3)
  rentCurrencyRate        Decimal              @default(1) @db.Decimal(18, 6)
  rentDueDayOfMonth       Int                  @default(1)
  advanceMonthsCollected  Int                  @default(0)
  advanceAmountCollected  Decimal?             @db.Decimal(15, 2)
  serviceCharge           Decimal?             @db.Decimal(15, 2)
  serviceChargeCurrency   String?              @db.VarChar(3)
  stampDutyAmount         Decimal?             @db.Decimal(15, 2)
  stampDutyPaid           Boolean              @default(false)
  nigerianState           ReNigerianState      @default(LAGOS)
  status                  ReLeaseStatus        @default(DRAFT)
  terminationDate         DateTime?            @db.Date
  terminationReason       String?              @db.VarChar(500)
  terminationNoticedAt    DateTime?
  renewedFromLeaseId      Int?
  notes                   String?              @db.Text
  createdById             Int?
  deletedAt               DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@unique([companyId, leaseCode])
  @@index([companyId, unitId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@index([companyId, endDate])
  @@map("re_leases")
}

model ReLeaseCharge {
  id                 Int                    @id @default(autoincrement())
  companyId          Int
  leaseId            Int
  chargeType         ReLeaseChargeType      @default(RENT)
  description        String                 @db.VarChar(200)
  amount             Decimal                @db.Decimal(15, 2)
  currency           String                 @default("NGN") @db.VarChar(3)
  exchangeRate       Decimal                @default(1) @db.Decimal(18, 6)
  frequency          ReLeaseChargeFrequency @default(MONTHLY)
  startDate          DateTime               @db.Date
  endDate            DateTime?              @db.Date
  glRevenueAccountId Int?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([companyId, leaseId])
  @@index([companyId, isActive])
  @@map("re_lease_charges")
}

model ReSecurityDeposit {
  id                  Int             @id @default(autoincrement())
  companyId           Int
  leaseId             Int
  customerId          Int
  depositAmount       Decimal         @db.Decimal(15, 2)
  currency            String          @default("NGN") @db.VarChar(3)
  exchangeRate        Decimal         @default(1) @db.Decimal(18, 6)
  receivedDate        DateTime        @db.Date
  interestRate        Decimal?        @db.Decimal(5, 2)
  interestAccruedToDate Decimal?      @db.Decimal(15, 2)
  status              ReDepositStatus @default(HELD)
  releaseDate         DateTime?       @db.Date
  releaseAmount       Decimal?        @db.Decimal(15, 2)
  forfeitureAmount    Decimal?        @db.Decimal(15, 2)
  forfeitureReason    String?         @db.VarChar(500)
  returnDueDate       DateTime?       @db.Date
  glLiabilityAccountId Int?
  receiptReference    String?         @db.VarChar(100)
  notes               String?         @db.Text
  createdById         Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([companyId, leaseId])
  @@index([companyId, status])
  @@index([companyId, returnDueDate])
  @@map("re_security_deposits")
}


// ============================================================================
// DOCUMENT MANAGEMENT SYSTEM (DMS)
// ============================================================================

enum DmsDocumentStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

model DmsDocumentCategory {
  id               Int      @id @default(autoincrement())
  companyId        Int
  name             String   @db.VarChar(200)
  slug             String   @db.VarChar(100)
  parentId         Int?
  color            String?  @db.VarChar(20)
  icon             String?  @db.VarChar(50)
  retentionDays    Int?
  requiresApproval Boolean  @default(false)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parent           DmsDocumentCategory?   @relation("DmsCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         DmsDocumentCategory[]  @relation("DmsCategoryTree")
  documents        DmsDocument[]

  @@unique([companyId, slug])
  @@index([companyId, parentId])
  @@map("dms_document_categories")
}

model DmsDocument {
  id               Int               @id @default(autoincrement())
  companyId        Int
  documentCode     String            @db.VarChar(50)
  title            String            @db.VarChar(500)
  description      String?           @db.Text
  categoryId       Int?
  tags             Json?
  fileName         String            @db.VarChar(500)
  storedFileName   String            @db.VarChar(500)
  filePath         String            @db.VarChar(1000)
  mimeType         String            @db.VarChar(200)
  fileSize         Int               @default(0)
  fileHash         String            @db.VarChar(64)
  sourceModule     String?           @db.VarChar(100)
  sourceEntity     String?           @db.VarChar(200)
  sourceEntityId   Int?
  versionNumber    Int               @default(1)
  parentDocumentId Int?
  isLatestVersion  Boolean           @default(true)
  retentionPolicy  String?           @db.VarChar(50)
  retainUntil      DateTime?
  status           DmsDocumentStatus @default(DRAFT)
  isConfidential   Boolean           @default(false)
  isArchived       Boolean           @default(false)
  archivedAt       DateTime?
  createdBy        Int
  updatedBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category       DmsDocumentCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentDocument DmsDocument?            @relation("DmsDocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  versions       DmsDocument[]           @relation("DmsDocumentVersions")
  permissions    DmsDocumentPermission[]
  activities     DmsDocumentActivity[]
  shares         DmsDocumentShare[]

  @@unique([companyId, documentCode])
  @@index([companyId, categoryId])
  @@index([companyId, sourceModule, sourceEntityId])
  @@index([companyId, fileHash])
  @@index([companyId, isLatestVersion])
  @@index([companyId, isArchived, status])
  @@map("dms_documents")
}

model DmsDocumentPermission {
  id            Int      @id @default(autoincrement())
  documentId    Int
  principalType String   @db.VarChar(20)
  principalId   Int
  canView       Boolean  @default(true)
  canDownload   Boolean  @default(false)
  canEdit       Boolean  @default(false)
  canDelete     Boolean  @default(false)
  canShare      Boolean  @default(false)
  grantedBy     Int
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  document      DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([principalType, principalId])
  @@map("dms_document_permissions")
}

model DmsDocumentActivity {
  id         Int      @id @default(autoincrement())
  documentId Int
  userId     Int
  action     String   @db.VarChar(50)
  details    Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())

  document   DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
  @@map("dms_document_activities")
}

model DmsDocumentShare {
  id            Int      @id @default(autoincrement())
  documentId    Int
  shareToken    String   @unique @db.VarChar(100)
  sharedBy      Int
  expiresAt     DateTime
  downloadCount Int      @default(0)
  maxDownloads  Int?
  requiresPin   Boolean  @default(false)
  pinHash       String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  document      DmsDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("dms_document_shares")
}
