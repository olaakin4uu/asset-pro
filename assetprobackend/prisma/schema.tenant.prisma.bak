model VetInsuranceProfile {
  id               Int       @id @default(autoincrement())
  companyId        Int
  clientId         Int
  animalId         Int?
  insurerName      String
  policyNumber     String
  coverageType     String
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  policyLimit      Decimal?  @db.Decimal(12, 2)
  remainingLimit   Decimal?  @db.Decimal(12, 2)
  coPayPercentage  Decimal?  @db.Decimal(5, 2)
  deductibleAmount Decimal?  @db.Decimal(12, 2)
  exclusionNotes   String?   @db.Text
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, clientId])
  @@index([companyId, status])
  @@map("vet_insurance_profiles")
}

model VetInsuranceClaim {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  insuranceProfileId   Int
  visitId              Int
  invoiceId            Int?
  diagnosisCodes       Json?
  itemizedServices     Json?
  totalAmount          Decimal   @db.Decimal(12, 2)
  insurerPortion       Decimal   @db.Decimal(12, 2)
  clientPortion        Decimal   @db.Decimal(12, 2)
  preAuthId            Int?
  status               String    @default("DRAFT")
  submissionDate       DateTime?
  approvalDate         DateTime?
  approvedAmount       Decimal?  @db.Decimal(12, 2)
  denialReason         String?
  appealReference      Int?
  remittanceAmount     Decimal?  @db.Decimal(12, 2)
  remittanceDate       DateTime?
  remittanceReference  String?
  notes                String?
  createdById          Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, status])
  @@index([insuranceProfileId])
  @@index([visitId])
  @@map("vet_insurance_claims")
}

model VetClaimAttachment {
  id           Int      @id @default(autoincrement())
  claimId      Int
  fileType     String
  fileName     String
  filePath     String
  uploadedById Int?
  createdAt    DateTime @default(now())

  @@index([claimId])
  @@map("vet_claim_attachments")
}

model VetPreAuthorization {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  insuranceProfileId     Int
  proposedProcedure      String
  estimatedCost          Decimal   @db.Decimal(12, 2)
  clinicalJustification  String?   @db.Text
  status                 String    @default("PENDING")
  approvedAmount         Decimal?  @db.Decimal(12, 2)
  denialReason           String?
  expiresAt              DateTime?
  createdById            Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyId, status])
  @@index([insuranceProfileId])
  @@map("vet_pre_authorizations")
}

model VetReminder {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  clientId            Int
  animalId            Int
  reminderType        String
  dueDate             DateTime  @db.Date
  messageContent      String?   @db.Text
  deliveryChannel     String    @default("SMS")
  deliveryStatus      String    @default("PENDING")
  providerMessageId   String?   @db.VarChar(200)
  sentAt              DateTime?
  linkedAppointmentId Int?
  // Sprint 2/3 Batch 8 (#44) — source traceability + status for list filtering
  sourceType          String?   @db.VarChar(50)
  sourceId            Int?
  status              String    @default("pending") @db.VarChar(30)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, dueDate])
  @@index([companyId, deliveryStatus])
  @@map("vet_reminders")
}

model VetCampaign {
  id               Int       @id @default(autoincrement())
  companyId        Int
  name             String
  messageTemplate  String    @db.Text
  audienceSegment  Json?
  scheduledSendAt  DateTime?
  batchSize        Int       @default(200)
  status           String    @default("DRAFT")
  totalTargeted    Int       @default(0)
  totalSent        Int       @default(0)
  totalDelivered   Int       @default(0)
  totalFailed      Int       @default(0)
  totalOptedOut    Int       @default(0)
  createdById      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status])
  @@map("vet_campaigns")
}

model VetCampaignRecipient {
  id              Int       @id @default(autoincrement())
  campaignId      Int
  clientId        Int
  deliveryChannel String
  messageContent  String?   @db.Text
  deliveryStatus  String    @default("QUEUED")
  sentAt          DateTime?
  deliveredAt     DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())

  @@index([campaignId, deliveryStatus])
  @@map("vet_campaign_recipients")
}

model VetFeedbackSurvey {
  id                Int       @id @default(autoincrement())
  companyId         Int
  visitId           Int
  clientId          Int
  surveyTemplate    Json?
  sentAt            DateTime?
  completedAt       DateTime?
  responses         Json?
  overallRating     Int?
  freeTextComments  String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([companyId, visitId])
  @@map("vet_feedback_surveys")
}

model VetIncidentReport {
  id                        Int       @id @default(autoincrement())
  companyId                 Int
  dispatchAssignmentId      Int?
  visitId                   Int?
  reporterId                Int
  incidentType              String
  severity                  String
  description               String    @db.Text
  photos                    Json?
  latitude                  Decimal?  @db.Decimal(10, 7)
  longitude                 Decimal?  @db.Decimal(10, 7)
  timestamp                 DateTime  @default(now())
  firstAidAdministered      String?
  hospitalReferralNeeded    Boolean   @default(false)
  biohazardDisposalLogged   Boolean   @default(false)
  followUpStatus            String    @default("PENDING")
  followUpNotes             String?   @db.Text
  reviewedById              Int?
  reviewedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId, severity])
  @@index([companyId, followUpStatus])
  @@map("vet_incident_reports")
}

// ============================================================================
// Veterinary Phase 3: AI & Optimization
// ============================================================================

enum VetAiSuggestionType {
  TRIAGE
  DIAGNOSIS
  TREATMENT
  SOAP_OBJECTIVE
  SOAP_ASSESSMENT
}

enum VetDrugInteractionSeverity {
  CONTRAINDICATED
  MAJOR
  MODERATE
  MINOR
}

enum VetForecastMethod {
  SIMPLE_MOVING_AVERAGE
  EXPONENTIAL_SMOOTHING
  SEASONAL_DECOMPOSITION
}

enum VetAutoRequisitionStatus {
  SUGGESTED
  APPROVED
  REQUISITION_CREATED
  DISMISSED
}

enum VetOutbreakSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VetOutbreakAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  FALSE_ALARM
}

enum VetEngagementTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  INACTIVE
}

enum VetReportType {
  CASE_MIX_ANALYSIS
  REVENUE_BREAKDOWN
  INVENTORY_TURNOVER
  AMBULATORY_KPIS
  PROVIDER_PRODUCTIVITY
  VACCINATION_COVERAGE
  CUSTOM
}

enum VetReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Immutable audit record of every AI-assisted clinical suggestion event
model VetAiSuggestionLog {
  id                       Int                   @id @default(autoincrement())
  companyId                Int
  branchId                 Int
  visitId                  Int?
  animalId                 Int?
  soapNoteId               Int?
  suggestionType           VetAiSuggestionType
  inputContext             Json
  systemPrompt            String                @db.Text
  suggestions             Json
  triageLevel             String?
  acceptedSuggestionIndex Int?
  vetAction               String?
  vetModification         Json?
  rejectionReason         String?               @db.Text
  confidenceDisclaimer    Boolean               @default(false)
  responseTimeMs          Int?
  tokensCounted           Int?
  modelUsed               String?
  createdById             Int
  createdAt               DateTime              @default(now())

  @@index([companyId, visitId])
  @@index([companyId, createdById, createdAt])
  @@index([companyId, suggestionType, createdAt])
  @@index([companyId, createdAt])
  @@map("vet_ai_suggestion_logs")
}

// Lookup table defining known interactions between two drugs
model VetDrugInteraction {
  id                     Int                          @id @default(autoincrement())
  companyId              Int
  drug1Name              String
  drug1ItemId            Int?
  drug2Name              String
  drug2ItemId            Int?
  interactionType        VetDrugInteractionSeverity
  description            String                       @db.Text
  clinicalEffect         String?
  recommendedAlternative String?
  speciesSpecific        Boolean                      @default(false)
  applicableSpeciesIds   Json?
  allergyRelated         Boolean                      @default(false)
  allergyClass           String?
  source                 String?
  isActive               Boolean                      @default(true)
  createdById            Int?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@unique([companyId, drug1Name, drug2Name, interactionType])
  @@index([companyId, drug1Name, drug2Name])
  @@index([companyId, drug1ItemId])
  @@index([companyId, drug2ItemId])
  @@index([companyId, allergyClass])
  @@index([companyId, isActive])
  @@map("vet_drug_interactions")
}

// Formulary reference for drug dosing guidelines per species
model VetFormularyDosing {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  drugName               String
  drugItemId             Int?
  speciesId              Int
  indication             String?
  route                  String
  doseMinPerKg           Decimal   @db.Decimal(10, 4)
  doseMaxPerKg           Decimal   @db.Decimal(10, 4)
  doseRecommendedPerKg   Decimal   @db.Decimal(10, 4)
  doseUnit               String    @default("mg/kg")
  frequency              String
  typicalDurationDays    Int?
  maxDurationDays        Int?
  warnings               String?   @db.Text
  source                 String?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyId, drugName, speciesId])
  @@index([companyId, drugItemId, speciesId])
  @@index([companyId, speciesId])
  @@map("vet_formulary_dosing")
}

// Computed projection record for an inventory item's future consumption
model VetDemandForecast {
  id                      Int               @id @default(autoincrement())
  companyId               Int
  branchId                Int
  itemId                  Int
  forecastDate            DateTime
  periodDays              Int
  predictedQuantity       Decimal           @db.Decimal(15, 4)
  predictedDailyRate      Decimal           @db.Decimal(15, 4)
  actualQuantity          Decimal?          @db.Decimal(15, 4)
  confidence              Decimal           @db.Decimal(5, 4)
  method                  VetForecastMethod
  seasonalFactor          Decimal?          @db.Decimal(5, 4)
  currentStock            Decimal           @db.Decimal(15, 4)
  estimatedStockoutDate   DateTime?
  leadTimeDays            Int
  reorderPoint            Decimal           @db.Decimal(15, 4)
  recommendedReorderQty   Decimal?          @db.Decimal(15, 4)
  lookbackMonths          Int               @default(6)
  insufficientData        Boolean           @default(false)
  createdAt               DateTime          @default(now())

  @@index([companyId, branchId, itemId, forecastDate])
  @@index([companyId, branchId, estimatedStockoutDate])
  @@index([companyId, branchId, forecastDate])
  @@map("vet_demand_forecasts")
}

// System-generated draft purchase requisition triggered by demand forecasting
model VetAutoRequisition {
  id                      Int                        @id @default(autoincrement())
  companyId               Int
  branchId                Int
  itemId                  Int
  forecastId              Int?
  currentStock            Decimal                    @db.Decimal(15, 4)
  reorderPoint            Decimal                    @db.Decimal(15, 4)
  leadTimeDays            Int
  bufferDays              Int
  estimatedStockoutDate   DateTime
  suggestedQuantity       Decimal                    @db.Decimal(15, 4)
  preferredSupplierId     Int?
  triggerReason           String
  status                  VetAutoRequisitionStatus   @default(SUGGESTED)
  adjustedQuantity        Decimal?                   @db.Decimal(15, 4)
  requisitionId           Int?
  reviewedById            Int?
  reviewedAt              DateTime?
  reviewNotes             String?                    @db.Text
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([companyId, branchId, status])
  @@index([companyId, branchId, itemId])
  @@index([companyId, status, createdAt])
  @@map("vet_auto_requisitions")
}

// Computed summary of vaccination coverage by species and vaccine type
model VetVaccinationCoverage {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  branchId                Int?
  speciesId               Int
  vaccineType             String
  areaName                String?
  areaLatitude            Decimal?  @db.Decimal(10, 7)
  areaLongitude           Decimal?  @db.Decimal(10, 7)
  totalAnimals            Int
  vaccinatedAnimals       Int
  overdueAnimals          Int
  neverVaccinatedAnimals  Int
  coveragePercentage      Decimal   @db.Decimal(5, 2)
  targetPercentage        Decimal   @default(80.00) @db.Decimal(5, 2)
  computedAt              DateTime
  createdAt               DateTime  @default(now())

  @@index([companyId, speciesId, vaccineType, computedAt])
  @@index([companyId, branchId, computedAt])
  @@index([companyId, computedAt])
  @@map("vet_vaccination_coverage")
}

// Alert record triggered when disease cluster thresholds are exceeded
model VetOutbreakAlert {
  id                   Int                     @id @default(autoincrement())
  companyId            Int
  branchId             Int?
  diagnosisCode        String
  diagnosisName        String
  caseCount            Int
  threshold            Int
  radiusKm             Decimal                 @db.Decimal(10, 2)
  periodDays           Int
  centerLatitude       Decimal?                @db.Decimal(10, 7)
  centerLongitude      Decimal?                @db.Decimal(10, 7)
  affectedVisitIds     Json
  affectedClientIds    Json
  firstCaseDate        DateTime
  latestCaseDate       DateTime
  severity             VetOutbreakSeverity
  status               VetOutbreakAlertStatus  @default(ACTIVE)
  detectedAt           DateTime
  acknowledgedById     Int?
  acknowledgedAt       DateTime?
  escalationNotes      String?                 @db.Text
  escalatedAt          DateTime?
  resolvedAt           DateTime?
  resolvedById         Int?
  resolutionNotes      String?                 @db.Text
  linkedCampaignId     Int?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([companyId, status, severity])
  @@index([companyId, diagnosisCode, status])
  @@index([companyId, detectedAt])
  @@index([companyId, branchId, status])
  @@map("vet_outbreak_alerts")
}

// Computed engagement score for a client, calculated nightly
model VetClientEngagementScore {
  id                      Int                @id @default(autoincrement())
  companyId               Int
  clientId                Int
  visitFrequencyScore     Decimal            @db.Decimal(5, 2)
  complianceScore         Decimal            @db.Decimal(5, 2)
  reminderResponseScore   Decimal            @db.Decimal(5, 2)
  recencyScore            Decimal            @db.Decimal(5, 2)
  totalScore              Decimal            @db.Decimal(5, 2)
  tier                    VetEngagementTier
  previousScore           Decimal?           @db.Decimal(5, 2)
  scoreChange             Decimal?           @db.Decimal(5, 2)
  weightsUsed             Json
  computedAt              DateTime
  createdAt               DateTime           @default(now())

  @@unique([companyId, clientId, computedAt])
  @@index([companyId, clientId, computedAt])
  @@index([companyId, tier, computedAt])
  @@index([companyId, totalScore(sort: Desc), computedAt])
  @@map("vet_client_engagement_scores")
}

// Computed provider productivity metrics per period
model VetProviderMetric {
  id                           Int       @id @default(autoincrement())
  companyId                    Int
  branchId                     Int
  providerId                   Int
  periodStart                  DateTime
  periodEnd                    DateTime
  totalVisits                  Int       @default(0)
  ambulatoryVisits             Int       @default(0)
  totalRevenue                 Decimal   @default(0) @db.Decimal(15, 2)
  avgVisitDurationMinutes      Decimal?  @db.Decimal(8, 2)
  totalWorkingDays             Int
  visitsPerDay                 Decimal?  @db.Decimal(8, 2)
  noShowCount                  Int       @default(0)
  totalBookedAppointments      Int       @default(0)
  noShowRate                   Decimal?  @db.Decimal(5, 2)
  returnPatientCount           Int       @default(0)
  totalPatientsCount           Int       @default(0)
  returnRate                   Decimal?  @db.Decimal(5, 2)
  estimatedTravelTimeMinutes   Decimal?  @db.Decimal(10, 2)
  actualTravelTimeMinutes      Decimal?  @db.Decimal(10, 2)
  routeEfficiencyScore         Decimal?  @db.Decimal(5, 2)
  computedAt                   DateTime
  createdAt                    DateTime  @default(now())

  @@unique([companyId, branchId, providerId, periodStart, periodEnd])
  @@index([companyId, branchId, providerId, periodStart])
  @@index([companyId, branchId, periodStart, periodEnd])
  @@index([companyId, providerId, computedAt])
  @@map("vet_provider_metrics")
}

// Report definition and configuration
model VetReportTemplate {
  id                Int            @id @default(autoincrement())
  companyId         Int
  name              String
  description       String?        @db.Text
  reportType        VetReportType
  configuration     Json
  availableFilters  Json
  isSystem          Boolean        @default(false)
  isActive          Boolean        @default(true)
  createdById       Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyId, reportType])
  @@index([companyId, isActive])
  @@map("vet_report_templates")
}

// Scheduled report delivery configuration
model VetReportSchedule {
  id                      Int                 @id @default(autoincrement())
  companyId               Int
  branchId                Int?
  reportTemplateId        Int
  dateRangeType           String
  customDateRangeConfig   Json?
  additionalFilters       Json?
  frequency               VetReportFrequency
  dayOfWeek               Int?
  dayOfMonth              Int?
  timeOfDay               String              @default("08:00")
  recipients              Json
  exportFormat            String              @default("PDF")
  lastRunAt               DateTime?
  nextRunAt               DateTime?
  lastRunStatus           String?
  lastRunError            String?             @db.Text
  isActive                Boolean             @default(true)
  createdById             Int?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([companyId, isActive, nextRunAt])
  @@index([companyId, reportTemplateId])
  @@index([companyId, frequency])
  @@map("vet_report_schedules")
}

// =============================================================================
// PHASE 4: PACS/DICOM, Telemedicine & IoT
// =============================================================================

// --- Imaging Enums ---

enum VetImagingModality {
  X_RAY
  ULTRASOUND
  CT
  MRI
  PHOTO
}

enum VetImagingPriority {
  ROUTINE
  URGENT
  STAT
}

enum VetImagingOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  REPORTED
  CANCELLED
}

enum VetImagingStudyStatus {
  PENDING
  COMPLETE
}

enum VetImagingUploadMethod {
  DIRECT_UPLOAD
  PACS_LINK
}

enum VetImagingFileFormat {
  JPEG
  PNG
  DICOM
}

enum VetRadiologyReportStatus {
  DRAFT
  FINAL
}

// --- Telemedicine Enums ---

enum VetTelemedicineSessionStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  DISCONNECTED
  CANCELLED
}

enum VetTelemedicineParticipantRole {
  PRIMARY_VET
  CLIENT
  SPECIALIST
  OBSERVER
}

enum VetTelemedicineJoinMethod {
  SYSTEM_USER
  EXTERNAL_LINK
}

// --- IoT Enums ---

enum VetIotDeviceType {
  GPS_COLLAR
  TEMPERATURE_SENSOR
  RUMINATION_MONITOR
  ACTIVITY_MONITOR
  HEART_RATE_MONITOR
}

enum VetIotDeviceStatus {
  ACTIVE
  INACTIVE
  DECOMMISSIONED
}

enum VetIotMetricType {
  TEMPERATURE
  HEART_RATE
  ACTIVITY
  RUMINATION
  GPS
  BATTERY_LEVEL
}

enum VetIotTelemetryQuality {
  NORMAL
  SUSPECT
}

enum VetIotAlertComparison {
  GREATER_THAN
  LESS_THAN
  OUTSIDE_RANGE
}

enum VetIotAlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum VetIotAlertRuleStatus {
  ACTIVE
  DISABLED
}

enum VetIotAlertStatus {
  ACTIVE
  UNDER_REVIEW
  DISMISSED
  RESOLVED
}

enum VetGeofenceType {
  PASTURE
  QUARANTINE_ZONE
  BARN
  CUSTOM
}

enum VetGeofenceStatus {
  ACTIVE
  INACTIVE
}

enum VetGeofenceBreachStatus {
  ACTIVE
  RETURNED
  ACKNOWLEDGED
}

// --- Imaging Tables ---

model VetImagingOrder {
  id                   Int                    @id @default(autoincrement())
  companyId            Int
  branchId             Int
  visitId              Int?
  animalId             Int
  orderingVetId        Int
  modality             VetImagingModality
  bodyRegion           String
  numberOfViews        Int?
  clinicalIndication   String                 @db.Text
  priority             VetImagingPriority     @default(ROUTINE)
  status               VetImagingOrderStatus  @default(ORDERED)
  completionTimestamp  DateTime?
  cancellationReason   String?                @db.Text
  cancelledById        Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([companyId, status])
  @@index([companyId, animalId])
  @@index([companyId, branchId, status])
  @@map("vet_imaging_orders")
}

model VetImagingStudy {
  id                    Int                    @id @default(autoincrement())
  companyId             Int
  imagingOrderId        Int?
  animalId              Int
  studyType             VetImagingModality
  bodyRegion            String
  studyDate             DateTime
  pacsStudyInstanceUid  String?
  imageCount            Int                    @default(0)
  uploadMethod          VetImagingUploadMethod @default(DIRECT_UPLOAD)
  uploadedById          Int
  status                VetImagingStudyStatus  @default(PENDING)
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([companyId, animalId])
  @@index([companyId, imagingOrderId])
  @@index([companyId, pacsStudyInstanceUid])
  @@map("vet_imaging_studies")
}

model VetImagingFile {
  id               Int                   @id @default(autoincrement())
  companyId        Int
  imagingStudyId   Int
  filePath         String
  thumbnailPath    String?
  fileFormat       VetImagingFileFormat
  fileSize         Int
  originalFilename String
  dicomMetadata    Json?
  displayOrder     Int                   @default(0)
  createdAt        DateTime              @default(now())

  @@index([companyId, imagingStudyId])
  @@map("vet_imaging_files")
}

model VetRadiologyReport {
  id                 Int                        @id @default(autoincrement())
  companyId          Int
  imagingStudyId     Int
  reportingUserId    Int
  findings           String                     @db.Text
  findingsStructured Json?
  impression         String                     @db.Text
  recommendations    String?                    @db.Text
  status             VetRadiologyReportStatus   @default(DRAFT)
  finalizedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([companyId, imagingStudyId])
  @@map("vet_radiology_reports")
}

// --- Telemedicine Tables ---

model VetTelemedicineSession {
  id                    Int                            @id @default(autoincrement())
  companyId             Int
  branchId              Int
  appointmentId         Int?
  visitId               Int?
  primaryVetId          Int
  clientId              Int?
  animalId              Int?
  status                VetTelemedicineSessionStatus   @default(SCHEDULED)
  waitingRoomToken      String                         @unique
  waitingRoomUrl        String
  earlyJoinMinutes      Int                            @default(10)
  gracePeriodMinutes    Int                            @default(30)
  callStartedAt         DateTime?
  callEndedAt           DateTime?
  callDurationSeconds   Int?
  recordingEnabled      Boolean                        @default(false)
  recordingFilePath     String?
  recordingFileSize     Int?
  recordingStartedAt    DateTime?
  recordingEndedAt      DateTime?
  billingLineItemId     Int?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@index([companyId, status])
  @@index([companyId, primaryVetId, status])
  @@index([waitingRoomToken])
  @@map("vet_telemedicine_sessions")
}

model VetTelemedicineParticipant {
  id                Int                              @id @default(autoincrement())
  companyId         Int
  sessionId         Int
  userId            Int?
  role              VetTelemedicineParticipantRole
  displayName       String
  joinMethod        VetTelemedicineJoinMethod
  email             String?
  phone             String?
  joinedAt          DateTime?
  leftAt            DateTime?
  consentGiven      Boolean                          @default(false)
  consentTimestamp   DateTime?
  createdAt         DateTime                         @default(now())

  @@index([companyId, sessionId])
  @@map("vet_telemedicine_participants")
}

// --- IoT Tables ---

model VetIotDevice {
  id                  Int                @id @default(autoincrement())
  companyId           Int
  deviceId            String
  deviceType          VetIotDeviceType
  animalId            Int?
  apiKeyHash          String
  manufacturer        String?
  model               String?
  firmwareVersion     String?
  installationDate    DateTime?
  lastTelemetryAt     DateTime?
  batteryLevel        Decimal?           @db.Decimal(5, 2)
  status              VetIotDeviceStatus @default(ACTIVE)
  decommissionReason  String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([companyId, deviceId])
  @@index([companyId, animalId])
  @@index([companyId, status])
  @@map("vet_iot_devices")
}

model VetIotTelemetry {
  id          Int                      @id @default(autoincrement())
  companyId   Int
  deviceId    Int
  animalId    Int?
  timestamp   DateTime
  metricType  VetIotMetricType
  value       Decimal                  @db.Decimal(12, 4)
  unit        String
  latitude    Decimal?                 @db.Decimal(10, 7)
  longitude   Decimal?                 @db.Decimal(10, 7)
  qualityFlag VetIotTelemetryQuality   @default(NORMAL)
  ingestedAt  DateTime                 @default(now())

  @@index([companyId, deviceId, timestamp])
  @@index([companyId, animalId, metricType, timestamp])
  @@index([companyId, ingestedAt])
  @@map("vet_iot_telemetry")
}

model VetIotDailySummary {
  id            Int              @id @default(autoincrement())
  companyId     Int
  deviceId      Int
  animalId      Int?
  metricType    VetIotMetricType
  date          DateTime
  minValue      Decimal          @db.Decimal(12, 4)
  maxValue      Decimal          @db.Decimal(12, 4)
  avgValue      Decimal          @db.Decimal(12, 4)
  readingCount  Int
  unit          String
  createdAt     DateTime         @default(now())

  @@unique([companyId, deviceId, metricType, date])
  @@index([companyId, animalId, metricType, date])
  @@map("vet_iot_daily_summaries")
}

model VetIotAlertRule {
  id              Int                    @id @default(autoincrement())
  companyId       Int
  species         String
  metricType      VetIotMetricType
  comparison      VetIotAlertComparison
  thresholdValue  Decimal?               @db.Decimal(12, 4)
  thresholdMin    Decimal?               @db.Decimal(12, 4)
  thresholdMax    Decimal?               @db.Decimal(12, 4)
  severity        VetIotAlertSeverity
  notifyUserIds   Json
  cooldownHours   Int                    @default(4)
  status          VetIotAlertRuleStatus  @default(ACTIVE)
  createdById     Int
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([companyId, species, metricType, status])
  @@index([companyId, status])
  @@map("vet_iot_alert_rules")
}

model VetIotAlert {
  id               Int                 @id @default(autoincrement())
  companyId        Int
  alertRuleId      Int
  deviceId         Int
  animalId         Int?
  metricType       VetIotMetricType
  recordedValue    Decimal             @db.Decimal(12, 4)
  thresholdValue   Decimal             @db.Decimal(12, 4)
  severity         VetIotAlertSeverity
  triggeredAt      DateTime
  status           VetIotAlertStatus   @default(ACTIVE)
  linkedVisitId    Int?
  dismissedById    Int?
  dismissalReason  String?             @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([companyId, status])
  @@index([companyId, animalId, status])
  @@index([companyId, alertRuleId, animalId, triggeredAt])
  @@map("vet_iot_alerts")
}

// --- Geofence Tables ---

model VetGeofence {
  id             Int              @id @default(autoincrement())
  companyId      Int
  branchId       Int
  name           String
  description    String?          @db.Text
  geofenceType   VetGeofenceType
  polygon        Json
  bufferMeters   Int              @default(50)
  animalIds      Json?
  status         VetGeofenceStatus @default(ACTIVE)
  createdById    Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId, status])
  @@index([companyId, branchId, status])
  @@map("vet_geofences")
}

model VetGeofenceBreach {
  id                       Int                     @id @default(autoincrement())
  companyId                Int
  geofenceId               Int
  animalId                 Int
  deviceId                 Int
  breachLatitude           Decimal                 @db.Decimal(10, 7)
  breachLongitude          Decimal                 @db.Decimal(10, 7)
  distanceMeters           Decimal                 @db.Decimal(10, 2)
  breachedAt               DateTime
  reEntryAt                DateTime?
  totalTimeOutsideSeconds  Int?
  status                   VetGeofenceBreachStatus @default(ACTIVE)
  acknowledgedById         Int?
  acknowledgedAt           DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([companyId, geofenceId, status])
  @@index([companyId, animalId, status])
  @@index([companyId, status, breachedAt])
  @@map("vet_geofence_breaches")
}

// ============================================================================
// LIVESTOCK MODULE ENUMS
// ============================================================================

enum LskSiteStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  DECOMMISSIONED
}

enum LskUnitType {
  POND
  TANK
  HOUSE
  SHED
  PEN
  PADDOCK
  PARLOR
  STORE
  PROCESSING
  HATCHERY
  NURSERY
  FARROWING_CRATE
  OTHER
}

enum LskUnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  QUARANTINE
  DECOMMISSIONED
}

enum LskSpeciesCategory {
  FISH
  POULTRY
  CATTLE
  GOAT
  SHEEP
  PIG
  OTHER
}

enum LskProductionType {
  MEAT
  EGGS
  MILK
  BREEDING
  DUAL_PURPOSE
  FINGERLINGS
  TABLE_FISH
  OTHER
}

enum LskFeedCategory {
  STARTER
  GROWER
  FINISHER
  LAYER_MASH
  BROILER_STARTER
  BROILER_FINISHER
  CREEP_FEED
  SOW_FEED
  BOAR_FEED
  TMR
  CONCENTRATE
  SUPPLEMENT
  PREMIX
  RAW_INGREDIENT
  OTHER
}

enum LskMortalityCategory {
  DISEASE
  PREDATOR
  ENVIRONMENTAL
  HANDLING
  UNKNOWN
  CULLING
  NATURAL
  ACCIDENT
  OTHER
}

enum LskDiseaseCategory {
  BACTERIAL
  VIRAL
  PARASITIC
  FUNGAL
  NUTRITIONAL
  METABOLIC
  ENVIRONMENTAL
  GENETIC
  UNKNOWN
  OTHER
}

enum LskMedicationRoute {
  ORAL
  INJECTION_IM
  INJECTION_IV
  INJECTION_SC
  TOPICAL
  IN_WATER
  IN_FEED
  SPRAY
  POUR_ON
  INTRAMAMMARY
  OTHER
}

enum LskVaccineRoute {
  ORAL
  INJECTION_IM
  INJECTION_SC
  EYE_DROP
  SPRAY
  IN_WATER
  WING_WEB
  OTHER
}

// ============================================================================
// LIVESTOCK MODULE — Phase 1: Foundation & Master Data
// ============================================================================

// --- Settings ---

model LskSettings {
  id                    Int       @id @default(autoincrement())
  companyId             Int       @unique
  defaultCurrencyCode   String?   @db.VarChar(10)
  weightUnit            String    @default("kg") @db.VarChar(10)
  temperatureUnit       String    @default("celsius") @db.VarChar(10)
  volumeUnit            String    @default("liters") @db.VarChar(10)
  enableIotIntegration  Boolean   @default(false)
  enableBiosecurity     Boolean   @default(true)
  mortalityAlertThreshold Decimal? @db.Decimal(5,2)
  fcrAlertThreshold     Decimal?  @db.Decimal(5,2)
  autoNumberPrefix      String    @default("LSK") @db.VarChar(10)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("lsk_settings")
}

// --- Sites & Location Hierarchy ---

model LskSite {
  id              Int           @id @default(autoincrement())
  companyId       Int
  siteCode        String        @db.VarChar(30)
  name            String        @db.VarChar(150)
  siteType        String        @db.VarChar(50)
  description     String?       @db.Text
  address         String?       @db.Text
  latitude        Decimal?      @db.Decimal(10,7)
  longitude       Decimal?      @db.Decimal(10,7)
  contactPerson   String?       @db.VarChar(150)
  contactPhone    String?       @db.VarChar(30)
  contactEmail    String?       @db.VarChar(150)
  status          LskSiteStatus @default(ACTIVE)
  isActive        Boolean       @default(true)
  createdById     Int?
  updatedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, siteCode])
  @@index([companyId, status])
  @@index([companyId, isActive])
  @@map("lsk_sites")
}

model LskSiteUnit {
  id              Int           @id @default(autoincrement())
  companyId       Int
  siteId          Int
  unitCode        String        @db.VarChar(30)
  name            String        @db.VarChar(150)
  unitType        LskUnitType
  status          LskUnitStatus @default(AVAILABLE)
  capacity        Decimal?      @db.Decimal(15,2)
  capacityUnit    String?       @db.VarChar(20)
  areaSize        Decimal?      @db.Decimal(15,2)
  areaSizeUnit    String?       @db.VarChar(20)
  volumeCapacity  Decimal?      @db.Decimal(15,2)
  volumeUnit      String?       @db.VarChar(20)
  description     String?       @db.Text
  notes           String?       @db.Text
  isActive        Boolean       @default(true)
  createdById     Int?
  updatedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([companyId, siteId, unitCode])
  @@index([companyId, siteId])
  @@index([companyId, unitType])
  @@index([companyId, status])
  @@map("lsk_site_units")
}

// --- Species & Breeds ---

model LskSpecies {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  speciesCode       String              @db.VarChar(20)
  name              String              @db.VarChar(100)
  scientificName    String?             @db.VarChar(150)
  category          LskSpeciesCategory
  description       String?             @db.Text
  defaultProductionType LskProductionType?
  iconUrl           String?             @db.VarChar(500)
  isActive          Boolean             @default(true)
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([companyId, speciesCode])
  @@index([companyId, category])
  @@index([companyId, isActive])
  @@map("lsk_species")
}

model LskBreed {
  id                Int                @id @default(autoincrement())
  companyId         Int
  speciesId         Int
  breedCode         String             @db.VarChar(20)
  name              String             @db.VarChar(100)
  origin            String?            @db.VarChar(100)
  description       String?            @db.Text
  traits            Json?
  avgMatureWeight   Decimal?           @db.Decimal(10,2)
  avgDailyGain      Decimal?           @db.Decimal(8,4)
  avgFcr            Decimal?           @db.Decimal(6,3)
  gestationDays     Int?
  maturityDays      Int?
  isActive          Boolean            @default(true)
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, speciesId, breedCode])
  @@index([companyId, speciesId])
  @@index([companyId, isActive])
  @@map("lsk_breeds")
}

model LskProductionTypeConfig {
  id                Int                @id @default(autoincrement())
  companyId         Int
  speciesId         Int
  productionType    LskProductionType
  name              String             @db.VarChar(100)
  description       String?            @db.Text
  targetMetrics     Json?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, speciesId, productionType])
  @@index([companyId, speciesId])
  @@map("lsk_production_type_configs")
}

// --- Mortality & Cull Reason Codes ---

model LskMortalityReason {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  code            String                @db.VarChar(30)
  name            String                @db.VarChar(100)
  category        LskMortalityCategory
  speciesCategory LskSpeciesCategory?
  description     String?               @db.Text
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, category])
  @@index([companyId, speciesCategory])
  @@map("lsk_mortality_reasons")
}

model LskCullReason {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  code            String                @db.VarChar(30)
  name            String                @db.VarChar(100)
  speciesCategory LskSpeciesCategory?
  description     String?               @db.Text
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, speciesCategory])
  @@map("lsk_cull_reasons")
}

// --- Disease & Medication Catalog ---

model LskDiseaseCode {
  id              Int                   @id @default(autoincrement())
  companyId       Int
  code            String                @db.VarChar(30)
  name            String                @db.VarChar(150)
  category        LskDiseaseCategory
  speciesCategory LskSpeciesCategory?
  symptoms        String?               @db.Text
  prevention      String?               @db.Text
  commonTreatment String?               @db.Text
  isNotifiable    Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([companyId, code])
  @@index([companyId, category])
  @@index([companyId, speciesCategory])
  @@map("lsk_disease_codes")
}

model LskMedicationCatalog {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  code              String              @db.VarChar(30)
  name              String              @db.VarChar(150)
  genericName       String?             @db.VarChar(150)
  category          String              @db.VarChar(50)
  route             LskMedicationRoute
  dosageUnit        String              @db.VarChar(30)
  defaultDosage     String?             @db.VarChar(50)
  withdrawalDaysMeat  Int?
  withdrawalDaysMilk  Int?
  withdrawalDaysEggs  Int?
  withdrawalDaysFish  Int?
  storageConditions String?             @db.VarChar(200)
  requiresVetApproval Boolean           @default(false)
  speciesCategories Json?
  isActive          Boolean             @default(true)
  createdById       Int?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([companyId, code])
  @@index([companyId, route])
  @@index([companyId, isActive])
  @@map("lsk_medication_catalog")
}

model LskVaccineSchedule {
  id                Int                 @id @default(autoincrement())
  companyId         Int
  speciesId         Int
  name              String              @db.VarChar(150)
  vaccineName       String              @db.VarChar(150)
  diseaseTarget     String              @db.VarChar(150)
  route             LskVaccineRoute
  flockPurpose      LskFlockPurpose?
  ageAtAdminDays    Int?
  repeatIntervalDays Int?
  dosage            String?             @db.VarChar(50)
  dosageUnit        String?             @db.VarChar(30)
  withdrawalDaysMeat  Int?
  withdrawalDaysMilk  Int?
  withdrawalDaysEggs  Int?
  notes             String?             @db.Text
  isMandatory       Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([companyId, speciesId])
  @@index([companyId, flockPurpose])
  @@index([companyId, isMandatory])
  @@map("lsk_vaccine_schedules")
}

// --- Feed Reference Data ---

model LskFeedType {
  id              Int              @id @default(autoincrement())
  companyId       Int
  code            String           @db.VarChar(30)
  name            String           @db.VarChar(100)
  category        LskFeedCategory
  speciesCategory LskSpeciesCategory?
  proteinPercent  Decimal?         @db.Decimal(5,2)
  energyKcalPerKg Decimal?         @db.Decimal(8,2)
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([companyId, code])
  @@index([companyId, category])
  @@index([companyId, speciesCategory])
  @@map("lsk_feed_types")
}

model LskFeedProgram {
  id              Int                  @id @default(autoincrement())
  companyId       Int
  speciesId       Int
  breedId         Int?
  productionType  LskProductionType?
  name            String               @db.VarChar(150)
  description     String?              @db.Text
  totalDays       Int?
  isDefault       Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdById     Int?
  updatedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([companyId, speciesId])
  @@index([companyId, isDefault])
  @@map("lsk_feed_programs")
}

model LskFeedProgramPhase {
  id              Int              @id @default(autoincrement())
  companyId       Int
  feedProgramId   Int
  phaseName       String           @db.VarChar(100)
  phaseOrder      Int
  startDay        Int
  endDay          Int
  feedTypeId      Int?
  targetIntakePerDay Decimal?      @db.Decimal(10,4)
  targetIntakeUnit   String?       @db.VarChar(20)
  proteinTarget   Decimal?         @db.Decimal(5,2)
  energyTarget    Decimal?         @db.Decimal(8,2)
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId, feedProgramId])
  @@index([feedProgramId, phaseOrder])
  @@map("lsk_feed_program_phases")
}

// --- Number Sequences ---

model LskNumberSequence {
  id              Int       @id @default(autoincrement())
  companyId       Int
  entityType      String    @db.VarChar(50)
  prefix          String    @db.VarChar(20)
  currentNumber   Int       @default(0)
  paddingLength   Int       @default(5)
  separator       String    @default("-") @db.VarChar(5)
  includeYear     Boolean   @default(true)
  includeMonth    Boolean   @default(false)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, entityType])
  @@map("lsk_number_sequences")
}

// ============================================================================
// LIVESTOCK MODULE — Phase 2: Fish (Aquaculture) Enums
// ============================================================================

enum LskCohortStatus {
  PLANNED
  STOCKING
  GROWING
  HARVESTING
  CLOSED
  CANCELLED
}

enum LskWaterParamType {
  DISSOLVED_OXYGEN
  PH
  TEMPERATURE
  AMMONIA
  NITRITE
  NITRATE
  TURBIDITY
  SALINITY
  ALKALINITY
  HARDNESS
  OTHER
}

enum LskHarvestMethod {
  SEINE_NET
  DRAIN_HARVEST
  PARTIAL_HARVEST
  CAST_NET
  TRAP
  OTHER
}

enum LskFishGradeCategory {
  JUMBO
  LARGE
  MEDIUM
  SMALL
  UNDERSIZED
  REJECT
}

// ============================================================================
// LIVESTOCK MODULE — Phase 2: Fish (Aquaculture) Models
// ============================================================================

model LskFishCohort {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  siteId              Int
  siteUnitId          Int
  cohortCode          String           @db.VarChar(30)
  speciesId           Int
  breedId             Int?
  status              LskCohortStatus  @default(PLANNED)
  stockingDate        DateTime?        @db.Date
  stockingQty         Int?
  avgStockingWeightG  Decimal?         @db.Decimal(10,2)
  initialBiomassKg    Decimal?         @db.Decimal(15,4)
  targetHarvestDate   DateTime?        @db.Date
  targetHarvestWeightG Decimal?        @db.Decimal(10,2)
  feedProgramId       Int?
  currentEstBiomassKg Decimal?         @db.Decimal(15,4)
  currentEstAliveQty  Int?
  currentAvgWeightG   Decimal?         @db.Decimal(10,2)
  totalFeedIssuedKg   Decimal          @default(0) @db.Decimal(15,4)
  totalMortalities    Int              @default(0)
  totalHarvestedQty   Int              @default(0)
  totalHarvestedKg    Decimal          @default(0) @db.Decimal(15,4)
  closedAt            DateTime?
  closureNotes        String?          @db.Text
  notes               String?          @db.Text
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([companyId, cohortCode])
  @@index([companyId, status])
  @@index([companyId, siteId])
  @@index([companyId, siteUnitId])
  @@index([companyId, speciesId])
  @@map("lsk_fish_cohorts")
}

model LskFishCohortStatusLog {
  id          Int              @id @default(autoincrement())
  companyId   Int
  cohortId    Int
  fromStatus  LskCohortStatus?
  toStatus    LskCohortStatus
  changedById Int?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([companyId, cohortId])
  @@map("lsk_fish_cohort_status_log")
}

model LskFishPondPrep {
  id              Int       @id @default(autoincrement())
  companyId       Int
  siteUnitId      Int
  prepDate        DateTime  @db.Date
  limingDone      Boolean   @default(false)
  limingQtyKg     Decimal?  @db.Decimal(10,2)
  waterFilledDate DateTime? @db.Date
  waterDepthCm    Decimal?  @db.Decimal(8,2)
  baselineDo      Decimal?  @db.Decimal(6,2)
  baselinePh      Decimal?  @db.Decimal(5,2)
  baselineTemp    Decimal?  @db.Decimal(5,2)
  baselineAmmonia Decimal?  @db.Decimal(8,4)
  notes           String?   @db.Text
  preparedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, siteUnitId])
  @@map("lsk_fish_pond_prep")
}

model LskFishWaterReading {
  id            Int               @id @default(autoincrement())
  companyId     Int
  cohortId      Int?
  siteUnitId    Int
  paramType     LskWaterParamType
  value         Decimal           @db.Decimal(10,4)
  unit          String            @db.VarChar(20)
  readingTime   DateTime
  isIotReading  Boolean           @default(false)
  deviceId      String?           @db.VarChar(50)
  isAlert       Boolean           @default(false)
  alertMessage  String?           @db.VarChar(500)
  recordedById  Int?
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())

  @@index([companyId, siteUnitId, paramType])
  @@index([companyId, cohortId])
  @@index([companyId, readingTime])
  @@index([companyId, isAlert])
  @@map("lsk_fish_water_readings")
}

model LskFishWaterThreshold {
  id            Int               @id @default(autoincrement())
  companyId     Int
  speciesId     Int?
  paramType     LskWaterParamType
  minValue      Decimal?          @db.Decimal(10,4)
  maxValue      Decimal?          @db.Decimal(10,4)
  unit          String            @db.VarChar(20)
  alertEnabled  Boolean           @default(true)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([companyId, speciesId, paramType])
  @@index([companyId, speciesId])
  @@map("lsk_fish_water_thresholds")
}

model LskFishFeedingEvent {
  id              Int       @id @default(autoincrement())
  companyId       Int
  cohortId        Int
  feedDate        DateTime  @db.Date
  feedTypeId      Int?
  feedItemName    String?   @db.VarChar(150)
  quantityKg      Decimal   @db.Decimal(10,4)
  costPerKg       Decimal?  @db.Decimal(15,2)
  totalCost       Decimal?  @db.Decimal(15,2)
  estBiomassAtFeedKg Decimal? @db.Decimal(15,4)
  feedingRate     Decimal?  @db.Decimal(6,4)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, cohortId])
  @@index([companyId, feedDate])
  @@map("lsk_fish_feeding_events")
}

model LskFishSampling {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  cohortId            Int
  samplingDate        DateTime  @db.Date
  sampleCount         Int
  avgWeightG          Decimal   @db.Decimal(10,2)
  minWeightG          Decimal?  @db.Decimal(10,2)
  maxWeightG          Decimal?  @db.Decimal(10,2)
  stdDevWeightG       Decimal?  @db.Decimal(10,2)
  estimatedAliveQty   Int?
  estimatedBiomassKg  Decimal?  @db.Decimal(15,4)
  sgr                 Decimal?  @db.Decimal(8,4)
  cumulativeFcr       Decimal?  @db.Decimal(8,4)
  notes               String?   @db.Text
  sampledById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, cohortId])
  @@index([companyId, samplingDate])
  @@map("lsk_fish_samplings")
}

model LskFishGrowthTarget {
  id              Int       @id @default(autoincrement())
  companyId       Int
  speciesId       Int
  breedId         Int?
  dayFromStocking Int
  targetWeightG   Decimal   @db.Decimal(10,2)
  targetSgr       Decimal?  @db.Decimal(8,4)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, speciesId])
  @@index([companyId, speciesId, breedId])
  @@map("lsk_fish_growth_targets")
}

model LskFishMortality {
  id              Int       @id @default(autoincrement())
  companyId       Int
  cohortId        Int
  mortalityDate   DateTime  @db.Date
  quantity        Int
  estimatedWeightLostKg Decimal? @db.Decimal(10,4)
  reasonId        Int?
  reasonNotes     String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, cohortId])
  @@index([companyId, mortalityDate])
  @@map("lsk_fish_mortalities")
}

model LskFishHarvest {
  id                Int              @id @default(autoincrement())
  companyId         Int
  cohortId          Int
  harvestCode       String           @db.VarChar(30)
  harvestDate       DateTime         @db.Date
  harvestMethod     LskHarvestMethod
  totalQuantity     Int
  totalWeightKg     Decimal          @db.Decimal(15,4)
  avgWeightG        Decimal?         @db.Decimal(10,2)
  yieldPercent      Decimal?         @db.Decimal(5,2)
  lossQuantity      Int?
  lossWeightKg      Decimal?         @db.Decimal(10,4)
  isPartialHarvest  Boolean          @default(false)
  notes             String?          @db.Text
  harvestedById     Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([companyId, harvestCode])
  @@index([companyId, cohortId])
  @@index([companyId, harvestDate])
  @@map("lsk_fish_harvests")
}

model LskFishHarvestGrade {
  id              Int                @id @default(autoincrement())
  companyId       Int
  harvestId       Int
  gradeCategory   LskFishGradeCategory
  quantity        Int
  weightKg        Decimal            @db.Decimal(15,4)
  pricePerKg      Decimal?           @db.Decimal(15,2)
  totalValue      Decimal?           @db.Decimal(15,2)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())

  @@index([companyId, harvestId])
  @@map("lsk_fish_harvest_grades")
}

model LskFishTransfer {
  id              Int       @id @default(autoincrement())
  companyId       Int
  fromCohortId    Int
  toCohortId      Int?
  fromSiteUnitId  Int
  toSiteUnitId    Int
  transferDate    DateTime  @db.Date
  quantity        Int
  avgWeightG      Decimal?  @db.Decimal(10,2)
  reason          String?   @db.VarChar(200)
  notes           String?   @db.Text
  transferredById Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, fromCohortId])
  @@index([companyId, toCohortId])
  @@map("lsk_fish_transfers")
}

model LskFishCostItem {
  id              Int       @id @default(autoincrement())
  companyId       Int
  cohortId        Int
  costType        String    @db.VarChar(50)
  description     String    @db.VarChar(200)
  amount          Decimal   @db.Decimal(15,2)
  costDate        DateTime  @db.Date
  referenceType   String?   @db.VarChar(50)
  referenceId     Int?
  notes           String?   @db.Text
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, cohortId])
  @@index([companyId, costType])
  @@map("lsk_fish_cost_items")
}

model LskFishCycleSummary {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  cohortId            Int       @unique
  cycleDays           Int?
  stockedQty          Int?
  harvestedQty        Int?
  totalMortalities    Int?
  survivalPercent     Decimal?  @db.Decimal(5,2)
  totalFeedKg         Decimal?  @db.Decimal(15,4)
  totalWeightGainKg   Decimal?  @db.Decimal(15,4)
  fcr                 Decimal?  @db.Decimal(8,4)
  avgSgr              Decimal?  @db.Decimal(8,4)
  totalCost           Decimal?  @db.Decimal(15,2)
  totalRevenue        Decimal?  @db.Decimal(15,2)
  costPerKg           Decimal?  @db.Decimal(15,2)
  profitMargin        Decimal?  @db.Decimal(8,2)
  computedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@map("lsk_fish_cycle_summaries")
}

enum LskFlockStatus {
  PLANNED
  BROODING
  GROWING
  LAYING
  FINISHING // broiler finishing stage (DTO uses this; not on legacy schemas — added 2026-04-28-011)
  DEPLETED  // flock fully sold/processed
  CULLING
  CLOSED
  CANCELLED
}

enum LskFlockPurpose {
  BROILER
  LAYER
  BREEDER
  DUAL_PURPOSE
}

enum LskEggGrade {
  A
  B
  DIRTY
  CRACKED
  BROKEN
  REJECT
}

enum LskVaccinationStatus {
  SCHEDULED
  COMPLETED
  MISSED
  PARTIAL
  CANCELLED
}

// ============================================================================
// LIVESTOCK MODULE — Phase 3: Poultry
// ============================================================================

model LskFlock {
  id                    Int              @id @default(autoincrement())
  companyId             Int
  siteId                Int
  siteUnitId            Int
  flockCode             String           @db.VarChar(30)
  speciesId             Int
  breedId               Int?
  hatcherySourceId      Int?
  hatcheryBatchRef      String?          @db.VarChar(80)
  purpose               LskFlockPurpose
  status                LskFlockStatus   @default(PLANNED)
  placementDate         DateTime?        @db.Date
  placementQty          Int?
  avgPlacementWeightG   Decimal?         @db.Decimal(10,2)
  targetMarketDate      DateTime?        @db.Date
  targetMarketWeightG   Decimal?         @db.Decimal(10,2)
  feedProgramId         Int?
  currentEstAliveQty    Int?
  currentAvgWeightG     Decimal?         @db.Decimal(10,2)
  totalFeedIssuedKg     Decimal          @default(0) @db.Decimal(15,4)
  totalMortalities      Int              @default(0)
  totalCulls            Int              @default(0)
  totalEggsCollected    Int              @default(0)
  closedAt              DateTime?
  closureNotes          String?          @db.Text
  notes                 String?          @db.Text
  createdById           Int?
  updatedById           Int?
  deletedAt             DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([companyId, flockCode])
  @@index([companyId, status])
  @@index([companyId, purpose])
  @@index([companyId, siteId])
  @@index([companyId, speciesId])
  @@index([companyId, hatcherySourceId])
  @@map("lsk_flocks")
}

model LskFlockStatusLog {
  id          Int             @id @default(autoincrement())
  companyId   Int
  flockId     Int
  fromStatus  LskFlockStatus?
  toStatus    LskFlockStatus
  changedById Int?
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())

  @@index([companyId, flockId])
  @@map("lsk_flock_status_log")
}

model LskFlockBrooding {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  recordDate      DateTime  @db.Date
  temperatureC    Decimal?  @db.Decimal(5,2)
  humidityPercent Decimal?  @db.Decimal(5,2)
  ventilationRate String?   @db.VarChar(50)
  lighthours      Decimal?  @db.Decimal(4,1)
  ammoniaPpm      Decimal?  @db.Decimal(8,2)
  co2Ppm          Decimal?  @db.Decimal(8,2)
  isWithinSpec    Boolean   @default(true)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, recordDate])
  @@map("lsk_flock_brooding")
}

model LskFlockEnvironment {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int?
  siteUnitId      Int
  recordTime      DateTime
  temperatureC    Decimal?  @db.Decimal(5,2)
  humidityPercent Decimal?  @db.Decimal(5,2)
  ammoniaPpm      Decimal?  @db.Decimal(8,2)
  co2Ppm          Decimal?  @db.Decimal(8,2)
  lightLux        Decimal?  @db.Decimal(10,2)
  ventilationRate String?   @db.VarChar(50)
  isIotReading    Boolean   @default(false)
  deviceId        String?   @db.VarChar(50)
  isAlert         Boolean   @default(false)
  alertMessage    String?   @db.VarChar(500)
  recordedById    Int?
  createdAt       DateTime  @default(now())

  @@index([companyId, siteUnitId])
  @@index([companyId, flockId])
  @@index([companyId, recordTime])
  @@map("lsk_flock_environment")
}

model LskFlockEnvThreshold {
  id            Int       @id @default(autoincrement())
  companyId     Int
  paramName     String    @db.VarChar(30)
  minValue      Decimal?  @db.Decimal(10,4)
  maxValue      Decimal?  @db.Decimal(10,4)
  unit          String    @db.VarChar(20)
  flockPurpose  LskFlockPurpose?
  ageFromDays   Int?
  ageToDays     Int?
  alertEnabled  Boolean   @default(true)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, paramName])
  @@map("lsk_flock_env_thresholds")
}

model LskFlockFeedingEvent {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  flockId             Int
  feedDate            DateTime  @db.Date
  feedTypeId          Int?
  feedItemName        String?   @db.VarChar(150)
  feedPhase           String?   @db.VarChar(50)
  quantityKg          Decimal   @db.Decimal(10,4)
  costPerKg           Decimal?  @db.Decimal(15,2)
  totalCost           Decimal?  @db.Decimal(15,2)
  notes               String?   @db.Text
  recordedById        Int?
  fedById             Int?
  fedByName           String?   @db.VarChar(120)
  witnessedById       Int?
  witnessedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, feedDate])
  @@index([companyId, fedById])
  @@map("lsk_flock_feeding_events")
}

model LskFlockWaterIntake {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  recordDate      DateTime  @db.Date
  intakeLiters    Decimal   @db.Decimal(10,2)
  waterPerBird    Decimal?  @db.Decimal(8,4)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())

  @@index([companyId, flockId])
  @@index([companyId, recordDate])
  @@map("lsk_flock_water_intake")
}

model LskFlockWeightSample {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  flockId             Int
  sampleDate          DateTime  @db.Date
  sampleCount         Int
  avgWeightG          Decimal   @db.Decimal(10,2)
  minWeightG          Decimal?  @db.Decimal(10,2)
  maxWeightG          Decimal?  @db.Decimal(10,2)
  uniformityPercent   Decimal?  @db.Decimal(5,2)
  targetWeightG       Decimal?  @db.Decimal(10,2)
  deviationPercent    Decimal?  @db.Decimal(6,2)
  cumulativeFcr       Decimal?  @db.Decimal(8,4)
  notes               String?   @db.Text
  sampledById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, sampleDate])
  @@map("lsk_flock_weight_samples")
}

model LskFlockWeightTarget {
  id              Int             @id @default(autoincrement())
  companyId       Int
  speciesId       Int
  breedId         Int?
  purpose         LskFlockPurpose
  dayFromPlacement Int
  targetWeightG   Decimal         @db.Decimal(10,2)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([companyId, speciesId, purpose])
  @@map("lsk_flock_weight_targets")
}

// Voice notes captured by farm managers (audio blob uploaded from phone).
// Stored per flock so the notes travel with the flock across transfers and
// survive on the detail view. No transcription in MVP — future paid add-on.
model LskFlockVoiceNote {
  id           Int       @id @default(autoincrement())
  companyId    Int
  flockId      Int
  uploadedById Int?
  fileName     String    @db.VarChar(255)
  filePath     String    @db.VarChar(512) // relative path under uploads/
  mimeType     String    @db.VarChar(100)
  durationSec  Int?
  sizeBytes    Int
  category     String?   @db.VarChar(30) // general, mortality, health, feeding
  transcript   String?   @db.Text // optional — farmer or staff can add later
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId, flockId, createdAt])
  @@map("lsk_flock_voice_notes")
}

// Buyer marketplace listings (Sprint 3B). A tenant publishes a listing
// ("500 ready broilers, Ibadan, available 2026-05-01, N4500/bird") and
// the public marketplace aggregates across all tenants for buyers. No
// PII about the farm beyond the company's registered location.
model LskMarketListing {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  // Optional link back to the source flock/batch — informational only
  flockId            Int?
  title              String    @db.VarChar(200)
  category           String    @db.VarChar(30) // broiler, layer, eggs, doc, feed, equipment, other
  unitOfSale         String    @db.VarChar(30) // bird, crate, kg, bag, tonne, piece
  quantityAvailable  Int
  pricePerUnit       Decimal   @db.Decimal(15, 2)
  minOrderQty        Int       @default(1)
  readyByDate        DateTime? @db.Date
  locationState      String?   @db.VarChar(100)
  locationCity       String?   @db.VarChar(100)
  description        String?   @db.Text
  // Cover photo path; richer gallery can be a later add-on
  coverPhotoPath     String?   @db.VarChar(512)
  isPublished        Boolean   @default(false)
  publishedAt        DateTime?
  unpublishedAt      DateTime?
  views              Int       @default(0)
  contactName        String?   @db.VarChar(150)
  contactPhone       String?   @db.VarChar(50)
  createdById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  quoteRequests      LskMarketQuoteRequest[]
  photos             LskMarketListingPhoto[]

  @@index([companyId, isPublished])
  @@index([category, isPublished])
  @@map("lsk_market_listings")
}

// Additional photos for a marketplace listing (beyond the cover photo).
// Stored in order of `sortOrder` ascending. The cover photo lives on the
// LskMarketListing itself; this table is for the gallery behind it.
model LskMarketListingPhoto {
  id         Int       @id @default(autoincrement())
  companyId  Int
  listingId  Int
  filePath   String    @db.VarChar(512)
  mimeType   String    @db.VarChar(100)
  sizeBytes  Int
  sortOrder  Int       @default(0)
  uploadedById Int?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  listing    LskMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([companyId, listingId, sortOrder])
  @@map("lsk_market_listing_photos")
}

model LskMarketQuoteRequest {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  listingId           Int
  buyerName           String    @db.VarChar(150)
  buyerPhone          String    @db.VarChar(50)
  buyerEmail          String?   @db.VarChar(150)
  requestedQty        Int
  deliveryLocation    String?   @db.VarChar(200)
  message             String?   @db.Text
  status              String    @default("new") @db.VarChar(20) // new, responded, converted, declined
  respondedAt         DateTime?
  respondedById       Int?
  convertedPreorderId Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  listing             LskMarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([listingId])
  @@map("lsk_market_quote_requests")
}

model LskFlockMortality {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  mortalityDate   DateTime  @db.Date
  deadQty         Int       @default(0)
  cullQty         Int       @default(0)
  reasonId        Int?
  cullReasonId    Int?
  reasonNotes     String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, mortalityDate])
  @@map("lsk_flock_mortalities")
}

model LskFlockVaccination {
  id                  Int                  @id @default(autoincrement())
  companyId           Int
  flockId             Int
  vaccineScheduleId   Int?
  vaccineName         String               @db.VarChar(150)
  diseaseTarget       String?              @db.VarChar(150)
  route               String?              @db.VarChar(30)
  batchNumber         String?              @db.VarChar(50)
  scheduledDate       DateTime?            @db.Date
  administeredDate    DateTime?            @db.Date
  dosage              String?              @db.VarChar(50)
  dosageUnit          String?              @db.VarChar(30)
  birdsVaccinated     Int?
  status              LskVaccinationStatus @default(SCHEDULED)
  withdrawalDaysMeat  Int?
  withdrawalDaysEggs  Int?
  clearanceDate       DateTime?            @db.Date
  administeredById    Int?
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, status])
  @@index([companyId, scheduledDate])
  @@map("lsk_flock_vaccinations")
}

model LskFlockEggCollection {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  collectionDate  DateTime  @db.Date
  totalEggs       Int
  gradeA          Int       @default(0)
  gradeB          Int       @default(0)
  dirty           Int       @default(0)
  cracked         Int       @default(0)
  broken          Int       @default(0)
  reject          Int       @default(0)
  henCount        Int?
  henDayPercent   Decimal?  @db.Decimal(5,2)
  feedPerDozen    Decimal?  @db.Decimal(8,4)
  notes           String?   @db.Text
  collectedById   Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, collectionDate])
  @@map("lsk_flock_egg_collections")
}

model LskFlockEggTarget {
  id                  Int             @id @default(autoincrement())
  companyId           Int
  speciesId           Int
  breedId             Int?
  weekFromPlacement   Int
  targetHenDayPercent Decimal         @db.Decimal(5,2)
  notes               String?         @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([companyId, speciesId])
  @@map("lsk_flock_egg_targets")
}

model LskFlockHealthEvent {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  eventDate       DateTime  @db.Date
  diseaseCodeId   Int?
  severity        String?   @db.VarChar(20)
  affectedQty     Int?
  symptoms        String?   @db.Text
  diagnosis       String?   @db.Text
  treatment       String?   @db.Text
  medicationId    Int?
  dosage          String?   @db.VarChar(50)
  withdrawalDays  Int?
  resolvedDate    DateTime? @db.Date
  notes           String?   @db.Text
  reportedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, eventDate])
  @@map("lsk_flock_health_events")
}

model LskFlockCostItem {
  id              Int       @id @default(autoincrement())
  companyId       Int
  flockId         Int
  costType        String    @db.VarChar(50)
  description     String    @db.VarChar(200)
  amount          Decimal   @db.Decimal(15,2)
  costDate        DateTime  @db.Date
  referenceType   String?   @db.VarChar(50)
  referenceId     Int?
  notes           String?   @db.Text
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, flockId])
  @@index([companyId, costType])
  @@map("lsk_flock_cost_items")
}

model LskFlockCycleSummary {
  id                  Int             @id @default(autoincrement())
  companyId           Int
  flockId             Int             @unique
  purpose             LskFlockPurpose
  cycleDays           Int?
  placedQty           Int?
  harvestedQty        Int?
  totalMortalities    Int?
  totalCulls          Int?
  mortalityPercent    Decimal?        @db.Decimal(5,2)
  totalFeedKg         Decimal?        @db.Decimal(15,4)
  totalWeightGainKg   Decimal?        @db.Decimal(15,4)
  fcr                 Decimal?        @db.Decimal(8,4)
  avgMarketWeightG    Decimal?        @db.Decimal(10,2)
  totalEggs           Int?
  avgHenDayPercent    Decimal?        @db.Decimal(5,2)
  totalCost           Decimal?        @db.Decimal(15,2)
  totalRevenue        Decimal?        @db.Decimal(15,2)
  costPerKg           Decimal?        @db.Decimal(15,2)
  costPerDozen        Decimal?        @db.Decimal(15,2)
  profitMargin        Decimal?        @db.Decimal(8,2)
  computedAt          DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([companyId])
  @@index([companyId, purpose])
  @@map("lsk_flock_cycle_summaries")
}

// ============================================================================
// LIVESTOCK MODULE — Phase 4: Large Animals (Cattle & Small Ruminants) Enums
// ============================================================================

enum LskAnimalStatus {
  ACTIVE
  DRY
  PREGNANT
  LACTATING
  GROWING
  FATTENING
  SOLD
  DECEASED
  CULLED
  TRANSFERRED
}

enum LskAnimalSex {
  MALE
  FEMALE
  CASTRATED
  UNKNOWN
}

enum LskBreedingMethod {
  NATURAL
  ARTIFICIAL_INSEMINATION
  EMBRYO_TRANSFER
}

enum LskBreedingResult {
  PENDING
  CONFIRMED_PREGNANT
  NOT_PREGNANT
  ABORTED
  UNKNOWN
}

enum LskCalvingEase {
  UNASSISTED
  EASY_PULL
  HARD_PULL
  SURGICAL
  UNKNOWN
}

enum LskMilkSession {
  AM
  PM
  MIDDAY
}

enum LskConditionScore {
  SCORE_1
  SCORE_2
  SCORE_3
  SCORE_4
  SCORE_5
}

// ============================================================================
// LIVESTOCK MODULE — Phase 4: Large Animals (Cattle & Small Ruminants)
// ============================================================================

model LskAnimal {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  siteId              Int
  siteUnitId          Int?
  animalTag           String           @db.VarChar(50)
  name                String?          @db.VarChar(100)
  speciesId           Int
  breedId             Int?
  sex                 LskAnimalSex
  dateOfBirth         DateTime?        @db.Date
  status              LskAnimalStatus  @default(ACTIVE)
  productionType      LskProductionType?
  sireId              Int?
  damId               Int?
  registrationNumber  String?          @db.VarChar(50)
  rfidTag             String?          @db.VarChar(50)
  colorMarkings       String?          @db.VarChar(200)
  birthWeight         Decimal?         @db.Decimal(10,2)
  currentWeight       Decimal?         @db.Decimal(10,2)
  lastWeighDate       DateTime?        @db.Date
  parity              Int              @default(0)
  isBreeder           Boolean          @default(false)
  acquisitionDate     DateTime?        @db.Date
  acquisitionType     String?          @db.VarChar(30)
  acquisitionCost     Decimal?         @db.Decimal(15,2)
  disposalDate        DateTime?        @db.Date
  disposalType        String?          @db.VarChar(30)
  disposalAmount      Decimal?         @db.Decimal(15,2)
  notes               String?          @db.Text
  photoPath           String?          @db.VarChar(500)
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([companyId, animalTag])
  @@index([companyId, status])
  @@index([companyId, speciesId])
  @@index([companyId, siteId])
  @@index([companyId, sex])
  @@index([companyId, sireId])
  @@index([companyId, damId])
  @@index([companyId, rfidTag])
  @@map("lsk_animals")
}

model LskAnimalGroup {
