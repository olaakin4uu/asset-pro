// SalvagePro ERP - Tenant Database Schema
// This schema contains models for tenant-specific databases
// Each tenant has their own isolated database with this schema
//
// Modules included:
// 1. Core - Users, companies, branches, customers, suppliers, approvals
// 2. Accounts - IFRS accounts, journals, transactions, bank reconciliation
// 3. Inventory - Items, warehouses, stock, batches
// 4. Sales - Orders, deliveries, invoices
// 5. Purchase - Requisitions, RFQs, POs, GRNs
// 6. POS - Cash registers, receipts
// 7. HRPayroll - Employees, payroll, leaves
// 8. FleetManagement - Vehicles, maintenance, tyres
// 9. Manufacturing - BOMs, production orders, quality
// 10. Assets - Fixed assets, depreciation
// 11. Budget - Budgets, allocations
// 12. Payables - Payments, allocations
// 13. Receivables - Receipts, credit notes
// 14. ProjectManagement - Projects, tasks, time entries
// 15. Printing - Templates
// 16. AI - Conversations
// 17. Veterinary - Clients, animals, appointments, visits, prescriptions, lab

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  // URL is passed via --url CLI flag in Prisma 7+
}

// ============================================================================
// INFRASTRUCTURE — Migration tracking
// ============================================================================
// Tracker for runtime tenant migrations (see tenant-migrations.ts).
// MUST be declared here so `prisma db push` doesn't drop it. When this table
// gets dropped, all migrations re-run from a clean slate on next backend boot,
// which has historically caused dependency-order crashes (column-not-found).
model TenantMigration {
  id          String    @id @db.VarChar(255)
  description String?   @db.Text
  appliedAt   DateTime? @default(now()) @db.Timestamp(6)

  @@map("_tenant_migrations")
}

// ============================================================================
// CORE MODULE - Users, Companies, Branches
// ============================================================================

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  emailVerifiedAt        DateTime?
  password               String
  companyId              Int?
  branchId               Int?
  entityId               Int?
  rememberToken          String?
  twoFactorSecret        String?   @db.Text
  twoFactorRecoveryCodes String?   @db.Text
  twoFactorConfirmedAt   DateTime?
  userType               UserType  @default(EMPLOYEE)
  themePreference        String?
  locale                 String    @default("en") // UI language: en|yo|ha|ig (Livestock pilot 2026-04-24)
  signaturePath          String?
  inviteToken            String?
  inviteExpiresAt        DateTime?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Unified login - link to entity based on userType
  // Only one of these should be set based on userType
  employeeId Int? @unique // Set when userType = EMPLOYEE (employee with user access)
  customerId Int? @unique // Set when userType = CUSTOMER (customer portal user)
  supplierId Int? @unique // Set when userType = SUPPLIER (supplier portal user)
  investorId Int? @unique // Set when userType = INVESTOR (investor portal user)

  // Relations
  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  entity  IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // Unified login relations (opposite side of FK)
  linkedEmployee Employee? @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: Cascade)
  linkedCustomer Customer? @relation("CustomerPortalUser", fields: [customerId], references: [id], onDelete: Cascade)
  linkedSupplier Supplier? @relation("SupplierPortalUser", fields: [supplierId], references: [id], onDelete: Cascade)
  linkedInvestor FmInvestor? @relation("InvestorPortalUser", fields: [investorId], references: [id], onDelete: Cascade)

  // Created records (audit trail)
  createdCompanies Company[]  @relation("CompanyCreator")
  createdBranches  Branch[]   @relation("BranchCreator")
  createdCustomers Customer[] @relation("CustomerCreator")
  createdSuppliers Supplier[] @relation("SupplierCreator")
  createdRoles     Role[]     @relation("RoleCreator")
  createdUsers     User[]     @relation("UserCreator")

  // Updated records (audit trail)
  updatedCompanies Company[] @relation("CompanyUpdater")
  updatedBranches  Branch[]  @relation("BranchUpdater")
  updatedRoles     Role[]    @relation("RoleUpdater")
  updatedUsers     User[]    @relation("UserUpdater")

  // Self-referential audit (who created/updated this user)
  createdById   Int?
  updatedById   Int?
  createdByUser User? @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("UserUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  // Approvals
  processApprovals ProcessApproval[]

  // Personal access tokens
  tokens PersonalAccessToken[]

  // Audit logs
  auditLogs AuditLog[]

  // Messages sent
  sentMessages Message[] @relation("MessageSender")

  // Legacy HR relation (to be deprecated - use linkedEmployee instead)
  employee Employee? @relation("LegacyEmployeeUser")

  // Roles and permissions (Spatie-like)
  roles       UserRole[]
  permissions UserPermission[]

  // Commission relations
  createdCommissionRules        CommissionRule[]        @relation("CommissionRuleCreator")
  createdCommissionCalculations CommissionCalculation[] @relation("CommissionCalculationCreator")
  approvedCommissions           CommissionCalculation[] @relation("CommissionApprover")

  // Sales Rep relations
  createdSalesReps              SalesRep[]             @relation("SalesRepCreator")
  approvedCommissionPayables    CommissionPayable[]    @relation("CommissionPayableApprover")
  createdCommissionPayables     CommissionPayable[]    @relation("CommissionPayableCreator")

  // Multi-company / multi-branch access grants
  companyAccess UserCompanyAccess[]
  branchAccess  UserBranchAccess[]

  @@index([companyId])
  @@index([branchId])
  @@index([entityId])
  @@index([companyId, userType])
  @@index([branchId, userType])
  @@index([employeeId])
  @@index([customerId])
  @@index([supplierId])
  @@map("users")
}

enum UserType {
  EMPLOYEE // Employee with user access (counts against plan limit)
  CUSTOMER // Customer portal user (unlimited)
  SUPPLIER // Supplier portal user (unlimited)
  INVESTOR // Investor/Investee portal user (unlimited)
  ADMIN // System admin
  SYSTEM // System/service account
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String
  token      String    @unique @db.VarChar(64)
  abilities  Json?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

model Company {
  id                 Int       @id @default(autoincrement())
  entityId           Int?
  name               String
  displayName        String?
  email              String?
  phone              String?
  address            String?   @db.Text
  city               String?
  state              String?
  country            String?
  postalCode         String?
  businessType       String    @default("general")
  currency           String    @default("NGN") @db.VarChar(3)
  taxNumber          String?
  registrationNumber String?
  website            String?
  logoPath           String?
  isActive           Boolean   @default(true)
  createdById        Int?
  updatedById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  entity    IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("CompanyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  branches  Branch[]
  users     User[]
  customers Customer[]
  suppliers Supplier[]
  employees Employee[]

  // Process approvals
  approvalFlows     ProcessApprovalFlow[]
  approvalFlowSteps ProcessApprovalFlowStep[]
  processApprovals  ProcessApproval[]
  approvalStatuses  ProcessApprovalStatus[]

  // Accounting
  accounts            IfrsAccount[]
  currencies          IfrsCurrency[]
  transactions        IfrsTransaction[]
  journalEntries      JournalEntry[]
  fiscalYears         FiscalYear[]
  periodLocks         PeriodLock[]
  banks               Bank[]
  bankReconciliations BankReconciliation[]
  withholdingTaxes    WithholdingTax[]

  // Inventory
  warehouses     Warehouse[]
  items          Item[]
  itemCategories ItemCategory[]
  stockMovements StockMovement[]

  // Sales
  salesOrders     SalesOrder[]
  salesDeliveries SalesDelivery[]
  salesInvoices   SalesInvoice[]
  loadingOrders   LoadingOrder[]
  salesSettings   SalesSetting?
  salesAreas      SalesArea[]

  // Purchase
  purchaseRequisitions PurchaseRequisition[]
  rfqs                 RequestForQuotation[]
  purchaseOrders       PurchaseOrder[]
  goodsReceivedNotes   GoodsReceivedNote[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseSettings     PurchaseSetting?
  serviceOrders        ServiceOrder[]

  // POS
  companySettings  CompanySettings?
  cashRegisters    CashRegister[]
  paymentReceipts  PaymentReceipt[]
  customerDeposits CustomerDeposit[]

  // HR
  departments       Department[]
  positions         Position[]
  gradeLevels       GradeLevel[]
  payrollComponents PayrollComponent[]
  payElements       PayElement[]
  salaryStructures  SalaryStructure[]
  payrolls          Payroll[]
  loanTypes         LoanType[]
  employeeDeductions EmployeeDeduction[]
  appointments      Appointment[]
  exitInterviews    ExitInterview[]
  hrPayrollSetting  HRPayrollSetting?

  // Fleet
  vehicleGroups VehicleGroup[]
  vehicles      Vehicle[]

  // Manufacturing
  workCenters            WorkCenter[]
  billOfMaterials        BillOfMaterial[]
  productionOrders       ProductionOrder[]
  manufacturingSetting   ManufacturingSetting?
  productionSchedules    ProductionSchedule[]
  productionShifts       ProductionShift[]

  // Assets
  assetClasses  AssetClass[]
  assets        Asset[]
  assetSettings    AssetSettings?
  payablesSettings PayablesSettings?

  // Budget
  budgetSettings BudgetSetting? @relation(fields: [budgetSettingId], references: [id])
  budgets        Budget[]

  // Petty Cash
  pettyCashSettings PettyCashSettings?
  pettyCashFunds    PettyCashFund[]

  // Projects
  projects Project[]

  // Messages
  messages Message[]

  // Expense requests
  expenseRequests ExpenseRequest[]

  // Bank transfers
  bankTransfers BankTransfer[]

  // Unposted accounting entries
  unpostedAccountingEntries UnpostedAccountingEntry[]

  // Notifications
  notifications       Notification[]
  budgetSettingId     Int?
  supplierQuotations  SupplierQuotation[]
  purchaseInspections PurchaseInspection[]

  // Commission & Sales Reps
  salesReps              SalesRep[]
  commissionRules        CommissionRule[]
  commissionCalculations CommissionCalculation[]
  commissionPayables     CommissionPayable[]

  // Sales Forecasting
  salesForecasts SalesForecast[]

  // Fund Management
  fmFunds                    FmFund[]
  fmBenchmarks               FmBenchmark[]
  fmNavCalendars             FmNavCalendar[]
  fmCustodians               FmCustodian[]
  fmInvestors                FmInvestor[]
  fmInvestorAccounts         FmInvestorAccount[]
  fmSubscriptions            FmSubscription[]
  fmRedemptions              FmRedemption[]
  fmDistributions            FmDistribution[]
  fmSecurities               FmSecurity[]
  fmPortfolios               FmPortfolio[]
  fmTrades                   FmTrade[]
  fmCashMovements            FmCashMovement[]
  fmNavCalculations          FmNavCalculation[]
  fmAccruals                 FmAccrual[]
  fmFeeCalculations          FmFeeCalculation[]
  fmFxRates                  FmFxRate[]
  fmComplianceRules          FmComplianceRule[]
  fmComplianceChecks         FmComplianceCheck[]
  fmShariaScreenings         FmShariaScreening[]
  fmPurificationRecords      FmPurificationRecord[]
  fmShariaBoardDecisions     FmShariaBoardDecision[]
  fmInvestorStatements       FmInvestorStatement[]
  fmRegulatoryReturns        FmRegulatoryReturn[]
  fmPerformanceReports       FmPerformanceReport[]
  fmCustodianReconciliations FmCustodianReconciliation[]
  fmCapitalCommitments       FmCapitalCommitment[]
  fmCapitalCalls             FmCapitalCall[]

  // IIoT
  iiotDevices            IiotDevice[]
  iiotDeviceTags         IiotDeviceTag[]
  iiotDeviceEvents       IiotDeviceEvent[]
  iiotTagGroups          IiotTagGroup[]
  iiotWorkCenterBindings IiotWorkCenterBinding[]
  iiotAlarms             IiotAlarm[]
  iiotAlarmEvents        IiotAlarmEvent[]
  iiotScaleProfiles      IiotScaleProfile[]
  iiotWeightRecords      IiotWeightRecord[]
  iiotDashboardConfigs   IiotDashboardConfig[]
  iiotSettings           IiotSettings[]
  iiotWriteLogs          IiotWriteLog[]

  // School Management
  smAcademicSessions SmAcademicSession[]
  smTerms            SmTerm[]
  smClassLevels      SmClassLevel[]
  smSubjects         SmSubject[]
  smGradingScales    SmGradingScale[]
  smStudents         SmStudent[]
  smGuardians        SmGuardian[]
  smEnrolments       SmEnrolment[]
  smStaff            SmStaff[]
  smFeeCategories    SmFeeCategory[]
  smFeeStructures    SmFeeStructure[]
  smFeeInvoices      SmFeeInvoice[]
  smFeePayments      SmFeePayment[]
  smFeeDiscounts       SmFeeDiscount[]
  smAssessments        SmAssessment[]
  smScores             SmScore[]
  smResults            SmResult[]
  smResultSummaries    SmResultSummary[]
  smPsychomotorRatings SmPsychomotorRating[]
  smAttendances        SmAttendance[]

  // Import Management
  importOrders           ImportOrder[]
  importFormMs           ImportFormM[]
  importLettersOfCredit  ImportLetterOfCredit[]
  importPayments         ImportPayment[]
  importShipments        ImportShipment[]
  importCustomsClearance ImportCustomsClearance[]
  importDutyAssessments  ImportDutyAssessment[]
  importDocuments        ImportDocument[]
  importCertifications   ImportCertification[]
  importLandedCosts      ImportLandedCost[]

  // Fund Management Documents
  investorDocuments FmInvestorDocument[]

  // Fund Management Credit Facilities
  creditFacilityTypes      FmCreditFacilityType[]
  creditFacilities         FmCreditFacility[]
  creditProfitAllocations  FmCreditProfitAllocation[]

  // Fund Management Zakat, Notifications, Sukuk
  zakatConfigs             FmZakatConfig[]
  zakatCalculations        FmZakatCalculation[]
  sukukRentalSchedules     FmSukukRentalSchedule[]
  notificationTemplates    FmNotificationTemplate[]
  notificationLogs         FmNotificationLog[]
  creditScores             FmCreditScore[]
  provisions               FmProvision[]
  collaterals              FmCollateral[]
  salesInspectionOfficers  SalesInspectionOfficer[] @relation("SalesInspectionOfficerCompany")

  @@index([isActive, country])
  @@index([createdById])
  @@map("companies")

  userAccess UserCompanyAccess[]
}

model Branch {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String
  code         String
  email        String?
  phone        String?
  address      String?   @db.Text
  city         String?
  state        String?
  country      String?
  postalCode   String?
  timezone     String    @default("Africa/Lagos")
  isActive     Boolean   @default(true)
  isHeadOffice Boolean   @default(false)
  createdById  Int?
  updatedById  Int?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("BranchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("BranchUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  users     User[]
  employees Employee[]
  customers BranchCustomer[]
  suppliers BranchSupplier[]
  banks     Bank[]

  // Warehouses
  warehouses Warehouse[]

  // Cash registers
  cashRegisters CashRegister[]

  // Sales
  salesOrdersByBranch    SalesOrder[]    @relation("SalesOrderBranch")
  salesDeliveriesByBranch SalesDelivery[] @relation("SalesDeliveryBranch")
  salesInvoicesByBranch  SalesInvoice[]  @relation("SalesInvoiceBranch")
  loadingOrdersByBranch  LoadingOrder[]  @relation("LoadingOrderBranch")
  salesRepBranches       SalesRepBranch[] @relation("SalesRepBranches")

  userAccess UserBranchAccess[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, isHeadOffice])
  @@index([code])
  @@index([createdById])
  @@map("branches")
}

model CompanySettings {
  id                                Int      @id @default(autoincrement())
  companyId                         Int      @unique
  defaultCashAccountId              Int?
  defaultBankAccountId              Int?
  defaultSalesRevenueAccountId      Int?
  defaultAccountsReceivableAccountId Int?
  defaultVatOutputAccountId         Int?
  defaultCustomerDepositsAccountId  Int?
  defaultDiscountAllowedAccountId   Int?
  useExpenseApproval                Boolean  @default(true)
  requireJournalApproval            Boolean  @default(false)
  // POS Settings
  defaultWarehouseId                Int?
  defaultPaymentMethodId            Int?
  defaultCashRegisterId             Int?
  defaultPriceListId                Int?
  allowNegativeStock                Boolean  @default(false)
  requireCustomerForSale            Boolean  @default(false)
  requireCustomerForCreditSale      Boolean  @default(false)
  allowCreditSales                  Boolean  @default(true)
  autoPostSales                     Boolean  @default(false)
  autoPostPayments                  Boolean  @default(false)
  autoPostExpenses                  Boolean  @default(false)
  receiptPrintFormat                String   @default("thermal")
  receiptHeaderText                 String?  @db.Text
  receiptFooterText                 String?  @db.Text
  enableDepositTracking             Boolean  @default(false)
  defaultVatId                      Int?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@map("company_settings")
}

// ============================================================================
// CORE MODULE - Customers & Suppliers
// ============================================================================

model Customer {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  code                  String?   @db.VarChar(20)
  name                  String
  email                 String
  phone                 String?
  contactPerson         String?
  address               String?   @db.Text
  deliveryAddress       String?   @db.Text
  deliveryContactPerson String?
  deliveryPhone         String?
  deliveryNotes         String?   @db.Text
  city                  String?
  state                 String?
  country               String?
  taxId                 String?
  creditLimit           Decimal?  @db.Decimal(15, 2)
  paymentTerms          String?
  customerType          String
  userId                Int?
  currencyId            Int?
  warehouseId           Int?
  salesRepId            Int?
  salesAreaId           Int?
  itemPriceGroupId      Int?
  accountsReceivableId  Int?
  openingBalance        Decimal   @default(0) @db.Decimal(15, 2)
  openingBalanceDate    DateTime? @db.Date
  isActive              Boolean   @default(false)
  isWalkInCustomer      Boolean   @default(false)
  portalEnabled         Boolean   @default(false) // Customer portal access enabled
  portalInvitedAt       DateTime? // When portal invitation was sent
  portalActivatedAt     DateTime? // When customer activated portal access
  createdById           Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User?           @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  portalUser         User?           @relation("CustomerPortalUser") // User account for portal login
  currency           IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  warehouse          Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  salesRep           SalesRep?       @relation("CustomerSalesRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  salesArea          SalesArea?      @relation("CustomerSalesArea", fields: [salesAreaId], references: [id], onDelete: SetNull)
  itemPriceGroup     ItemPriceGroup? @relation(fields: [itemPriceGroupId], references: [id], onDelete: SetNull)
  accountsReceivable IfrsAccount?    @relation("CustomerReceivableAccount", fields: [accountsReceivableId], references: [id], onDelete: SetNull)

  branches         BranchCustomer[]
  customerBranches CustomerBranch[]

  // Sales
  salesOrders     SalesOrder[]
  salesDeliveries SalesDelivery[]
  salesInvoices   SalesInvoice[]

  // POS
  deposits        CustomerDeposit[]
  paymentReceipts PaymentReceipt[]

  // Receivables
  customerReceipts CustomerReceipt[]

  // Commission
  commissionRules CommissionRule[]
  commissionCalculations CommissionCalculation[] @relation("CommissionCustomer")

  // Veterinary bridge — VetClient rows that share AR with this Customer.
  vetClients VetClient[] @relation("CustomerVetClient")

  // Hotel bridge — every reservation links to a standard customer for AR aging.
  hotelReservations HotelReservation[]

  // Fleet — staff can book vehicles on behalf of a customer; the FK lets
  // bookings reports group/filter by customer without a name-string match.
  vehicleBookings VehicleBooking[]

  @@index([companyId, code])
  @@index([portalEnabled])
  @@map("customers")
}

model BranchCustomer {
  id         Int      @id @default(autoincrement())
  branchId   Int
  customerId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([branchId, customerId])
  @@index([customerId])
  @@map("branch_customer")
}

model CustomerBranch {
  id            Int      @id @default(autoincrement())
  customerId    Int
  salesAreaId   Int?
  name          String
  code          String?
  address       String?  @db.Text
  city          String?
  state         String?
  country       String?
  contactPerson String?
  phone         String?
  email         String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  salesArea SalesArea? @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)

  salesOrders     SalesOrder[]
  salesDeliveries SalesDelivery[]
  salesInvoices   SalesInvoice[] @relation("SalesInvoiceCustomerBranch")

  @@index([customerId])
  @@map("customer_branches")
}

model Supplier {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String?   @db.VarChar(20)
  name              String
  email             String
  phone             String?
  contactPerson     String?
  address           String?   @db.Text
  city              String?
  state             String?
  country           String?
  taxId             String?
  bankName          String?
  bankAccount       String?
  paymentTerms      String?
  supplierType      String
  category          String?
  website           String?
  userId            Int?
  currencyId        Int?
  accountsPayableId Int?
  isActive          Boolean   @default(false)
  status            String    @default("active") @db.VarChar(20) // active, approved, on_hold, suspended
  isBlacklisted     Boolean   @default(false)
  portalEnabled     Boolean   @default(false) // Supplier portal access enabled
  portalInvitedAt   DateTime? // When portal invitation was sent
  portalActivatedAt DateTime? // When supplier activated portal access
  createdById       Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User?         @relation("SupplierCreator", fields: [createdById], references: [id], onDelete: SetNull)
  portalUser      User?         @relation("SupplierPortalUser") // User account for portal login
  currency        IfrsCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  accountsPayable IfrsAccount?  @relation("SupplierPayableAccount", fields: [accountsPayableId], references: [id], onDelete: SetNull)

  branches BranchSupplier[]

  // Purchase
  rfqSuppliers       RfqSupplier[]
  supplierQuotations SupplierQuotation[]
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]
  purchaseInvoices   PurchaseInvoice[]
  serviceOrders      ServiceOrder[]

  // Payables
  supplierPayments SupplierPayment[]

  // Import Management
  importOrders    ImportOrder[]
  clearanceOrders ImportCustomsClearance[] @relation("ClearingAgent")

  // Fund Management — Murabaha facilities where this supplier was paid directly
  murabahaFacilities FmCreditFacility[] @relation("FacilitySupplier")

  @@index([companyId, code])
  @@index([portalEnabled])
  @@map("suppliers")
}

model BranchSupplier {
  id         Int      @id @default(autoincrement())
  branchId   Int
  supplierId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([branchId, supplierId])
  @@index([supplierId])
  @@map("branch_supplier")
}

// ============================================================================
// CORE MODULE - Process Approvals
// ============================================================================

model ProcessApprovalFlow {
  id                   Int      @id @default(autoincrement())
  name                 String
  approvableType       String
  entitySlug           String?
  description          String?  @db.Text
  conditions           Json?
  notificationSettings Json?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  priority             Int      @default(10)
  autoSubmit           Boolean  @default(false)
  parallelApproval     Boolean  @default(false)
  companyId            Int?
  createdById          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  steps ProcessApprovalFlowStep[]

  @@index([companyId])
  @@index([approvableType])
  @@map("process_approval_flows")
}

model ProcessApprovalFlowStep {
  id                    Int            @id @default(autoincrement())
  processApprovalFlowId Int
  name                  String?
  description           String?        @db.Text
  roleId                Int?
  approverType          String         @default("role")
  approverIds           Json?
  approvalMode          String         @default("any")
  permissions           Json?
  employees             Json?
  escalationEmployees   Json?
  order                 Int?
  stepOrder             Int            @default(0)
  action                ApprovalAction @default(APPROVE)
  conditions            Json?
  isRequired            Boolean        @default(true)
  timeoutHours          Int?
  escalationRoleId      Int?
  escalationUserId      Int?
  isActive              Boolean        @default(true)
  stepType              String         @default("approve") // "approve" | "accountant"
  // Override authority — who can bypass the entire remaining flow from this step
  overrideAllowed       Boolean        @default(false)
  overrideApproverType  String?        // 'role' | 'employee' | 'department_head'
  overrideApproverIds   Json?          // role IDs or user IDs
  overrideNoteMinLength Int            @default(30)
  overrideNotifySkipped Boolean        @default(true)
  // Branch scope — null = all branches, set = specific branch only
  branchId              Int?
  branchScope           String         @default("all") // 'all' | 'specific'
  // Protected steps — locked means only approver/mode/branch are editable; isFinalStep always stays last
  isLocked              Boolean        @default(false)
  isFinalStep           Boolean        @default(false)
  companyId             Int?
  tenantId              String?        @db.VarChar(38)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  // Relations
  processApprovalFlow ProcessApprovalFlow @relation(fields: [processApprovalFlowId], references: [id], onDelete: Cascade)
  role                Role?               @relation(fields: [roleId], references: [id])
  company             Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  approvals ProcessApproval[]

  @@index([roleId])
  @@index([order])
  @@index([tenantId])
  @@map("process_approval_flow_steps")
}

enum ApprovalAction {
  APPROVE
  VERIFY
  CHECK
}

model ProcessApproval {
  id                        Int       @id @default(autoincrement())
  approvableType            String
  approvableId              Int
  processApprovalFlowStepId Int?
  approvalAction            String    @default("Approved") @db.VarChar(64)
  approverName              String?   @db.Text
  comment                   String?   @db.Text
  signaturePath             String?
  approvedAt                DateTime?
  userId                    Int
  employeeId                Int?
  companyId                 Int?
  tenantId                  String?   @db.VarChar(38)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  processApprovalFlowStep ProcessApprovalFlowStep? @relation(fields: [processApprovalFlowStepId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employee                Employee?                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([approvableType, approvableId])
  @@index([tenantId])
  @@map("process_approvals")
}

model ProcessApprovalStatus {
  id             Int      @id @default(autoincrement())
  approvableType String
  approvableId   Int
  steps          Json?
  status         String   @default("CREATED") @db.VarChar(10)
  creatorId      Int?
  companyId      Int?
  tenantId       String?  @db.VarChar(38)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([approvableType, approvableId])
  @@index([tenantId])
  @@map("process_approval_statuses")
}

model ApprovableModelRegistry {
  id                    Int      @id @default(autoincrement())
  modelClass            String   @unique
  displayName           String
  moduleName            String
  availableFields       Json?
  defaultConditions     Json?
  notificationTemplates Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("approvable_model_registry")
}

// ============================================================================
// CORE MODULE - Roles & Permissions (Spatie-like)
// ============================================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  guardName   String   @default("web")
  description String?
  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy User? @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RoleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  permissions   RolePermission[]
  users         UserRole[]
  approvalSteps ProcessApprovalFlowStep[]

  @@unique([name, guardName])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  guardName   String   @default("web")
  module      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[]

  @@unique([name, guardName])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       Int
  permissionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserCompanyAccess {
  userId    Int
  companyId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@id([userId, companyId])
  @@map("user_company_access")
}

model UserBranchAccess {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([userId, branchId])
  @@map("user_branch_access")
}

// ============================================================================
// CORE MODULE - Messages & Notifications
// ============================================================================

model Message {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  companyId         Int
  senderId          Int
  subject           String
  body              String          @db.Text
  bodyHtml          String?         @db.Text
  priority          MessagePriority @default(NORMAL)
  referenceableType String?
  referenceableId   Int?
  parentId          Int?
  isDraft           Boolean         @default(false)
  sentAt            DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender  User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  parent  Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageReplies")

  recipients MessageRecipient[]

  @@index([companyId])
  @@index([senderId])
  @@index([sentAt])
  @@index([parentId])
  @@index([isDraft, sentAt])
  @@map("messages")
}

enum MessagePriority {
  NORMAL
  HIGH
  URGENT
}

model MessageRecipient {
  id            Int           @id @default(autoincrement())
  messageId     Int
  recipientId   Int
  recipientType RecipientType @default(TO)
  readAt        DateTime?
  starredAt     DateTime?
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
  @@index([recipientId, deletedAt, readAt])
  @@index([recipientId, starredAt])
  @@index([recipientId, archivedAt])
  @@map("message_recipients")
}

enum RecipientType {
  TO
  CC
  BCC
}

model Notification {
  id             String    @id @default(uuid())
  type           String
  notifiableType String
  notifiableId   Int
  data           Json
  readAt         DateTime?
  companyId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([notifiableType, notifiableId])
  @@index([readAt])
  @@map("notifications")
}

// ============================================================================
// CORE MODULE - Audit Log
// ============================================================================

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  event         String // created, updated, deleted
  auditableType String
  auditableId   Int
  oldValues     Json?
  newValues     Json?
  url           String?
  ipAddress     String?
  userAgent     String?  @db.Text
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([auditableType, auditableId])
  @@index([userId])
  @@index([createdAt])
  @@map("audits")
}

// ============================================================================
// CORE MODULE - Backups
// ============================================================================

model Backup {
  id           Int       @id @default(autoincrement())
  filename     String
  path         String
  disk         String    @default("local")
  size         BigInt
  type         String    @default("full") // full, incremental
  status       String    @default("pending") // pending, completed, failed
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("backups")
}

// ============================================================================
// CORE MODULE - Onboarding Progress
// ============================================================================

model OnboardingProgress {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  completedSteps Json      @default("[]")
  currentStep    String?
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("onboarding_progress")
}

// ============================================================================
// HELP MODULE - Categories & Articles
// ============================================================================

model HelpCategory {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.VarChar(500)
  icon        String?   @db.VarChar(10)
  sortOrder   Int       @default(0)
  parentId    Int?
  isActive    Boolean   @default(true)
  createdBy   Int?
  updatedBy   Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  parent   HelpCategory?  @relation("HelpCategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children HelpCategory[] @relation("HelpCategoryParent")
  articles HelpArticle[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("help_categories")
}

model HelpArticle {
  id                Int       @id @default(autoincrement())
  title             String    @db.VarChar(200)
  slug              String    @unique @db.VarChar(200)
  summary           String    @db.VarChar(500)
  content           String    @db.Text
  categoryId        Int
  tags              Json?     @default("[]")
  relatedArticleIds Json?     @default("[]")
  status            String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  visibility        String    @default("PUBLIC") // PUBLIC, AUTHENTICATED, ADMIN_ONLY
  sortOrder         Int       @default(0)
  author            String?   @db.VarChar(100)
  publishedAt       DateTime?
  isFeatured        Boolean   @default(false)
  enableComments    Boolean   @default(true)
  viewCount         Int       @default(0)
  helpfulCount      Int       @default(0)
  version           Int       @default(1)
  createdBy         Int?
  updatedBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  category HelpCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status, visibility])
  @@index([isFeatured])
  @@map("help_articles")
}

// ============================================================================
// ACCOUNTS MODULE - IFRS Entities & Categories
// ============================================================================

model IfrsEntity {
  id              Int       @id @default(autoincrement())
  name            String
  currencyId      Int?
  parentEntityId  Int?
  year            Int?
  multiCurrency   Boolean   @default(false)
  midYearBalances Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  currency      IfrsCurrency? @relation("EntityCurrency", fields: [currencyId], references: [id], onDelete: SetNull)
  parentEntity  IfrsEntity?   @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities IfrsEntity[]  @relation("EntityHierarchy")

  users            User[]
  companies        Company[]
  accounts         IfrsAccount[]
  categories       IfrsCategory[]
  reportingPeriods IfrsReportingPeriod[]
  vats             IfrsVat[]
  balances         IfrsBalance[]
  transactions     IfrsTransaction[]
  ledgers          IfrsLedger[]

  // Sales
  salesOrdersByEntity    SalesOrder[]    @relation("SalesOrderEntity")
  salesDeliveriesByEntity SalesDelivery[] @relation("SalesDeliveryEntity")
  salesInvoicesByEntity  SalesInvoice[]  @relation("SalesInvoiceEntity")
  loadingOrdersByEntity  LoadingOrder[]  @relation("LoadingOrderEntity")

  @@map("ifrs_entities")
}

model IfrsCurrency {
  id            Int       @id @default(autoincrement())
  name          String
  code          String    @db.VarChar(3)
  symbol        String?
  decimalPlaces Int       @default(2)
  entityId      Int?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  entities  IfrsEntity[]  @relation("EntityCurrency")
  accounts  IfrsAccount[]
  customers Customer[]
  suppliers Supplier[]

  // Inventory
  items Item[]

  // Sales
  salesOrders   SalesOrder[]
  salesInvoices SalesInvoice[]

  // Purchase
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]

  // Import Management
  importOrders          ImportOrder[]
  importFormMs          ImportFormM[]
  importLettersOfCredit ImportLetterOfCredit[]
  importPayments        ImportPayment[]

  // Exchange rates
  exchangeRatesFrom IfrsExchangeRate[] @relation("ExchangeRateFrom")
  exchangeRatesTo   IfrsExchangeRate[] @relation("ExchangeRateTo")
  company           Company?           @relation(fields: [companyId], references: [id])
  companyId         Int?

  @@unique([entityId, code])
  @@index([entityId])
  @@map("ifrs_currencies")
}

model IfrsReportingPeriod {
  id           Int       @id @default(autoincrement())
  entityId     Int
  calendarYear Int
  number       Int       // 1-12 (or 13 for adjustment period)
  label        String    // "Jan '26", "Feb '26"
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  status       String    @default("OPEN") // OPEN, ADJUSTING, CLOSED
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  entity IfrsEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, calendarYear, number])
  @@index([entityId, calendarYear])
  @@map("ifrs_reporting_periods")
}

model IfrsCategory {
  id           Int       @id @default(autoincrement())
  entityId     Int?
  name         String
  categoryType String // asset, liability, equity, revenue, expense
  code         String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  entity   IfrsEntity?   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  accounts IfrsAccount[]

  @@index([entityId])
  @@index([categoryType])
  @@map("ifrs_categories")
}

// ============================================================================
// ACCOUNTS MODULE - Chart of Accounts
// ============================================================================

model IfrsAccount {
  id                Int       @id @default(autoincrement())
  entityId          Int?
  companyId         Int?
  categoryId        Int?
  currencyId        Int?
  code              String
  name              String
  description       String?   @db.Text
  accountType       String // asset, liability, equity, revenue, expense
  ifrs18AccountType String? // For IFRS 18 compliance
  parentId          Int?
  isPosting         Boolean   @default(true)
  closingRate       Boolean   @default(false)
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  entity   IfrsEntity?   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  company  Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category IfrsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currency IfrsCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  parent   IfrsAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children IfrsAccount[] @relation("AccountHierarchy")

  balances           IfrsBalance[]
  debitTransactions  IfrsTransaction[]  @relation("DebitAccount")
  creditTransactions IfrsTransaction[]  @relation("CreditAccount")
  ledgers            IfrsLedger[]
  journalLines       JournalEntryLine[]

  // Relations to other modules
  customersReceivable Customer[] @relation("CustomerReceivableAccount")
  suppliersPayable    Supplier[] @relation("SupplierPayableAccount")

  // Bank accounts
  bankAccounts Bank[]

  // Items
  itemsSales     Item[]       @relation("ItemSalesAccount")
  itemsCogs      Item[]       @relation("ItemCogsAccount")
  itemsInventory Item[]       @relation("ItemInventoryAccount")
  budgetLines    BudgetLine[]

  // Sales Commission Accounts
  salesSettingsCommissionExpense SalesSetting[] @relation("CommissionExpense")
  salesSettingsCommissionPayable SalesSetting[] @relation("CommissionPayable")
  commRuleExpenseAccounts  CommissionRule[] @relation("CommRuleExpense")
  commRulePayableAccounts  CommissionRule[] @relation("CommRulePayable")
  commRuleWHTAccounts      CommissionRule[] @relation("CommRuleWHT")
  commCatExpenseAccounts   ItemCategory[]   @relation("CommCatExpense")
  commCatLiabilityAccounts ItemCategory[]   @relation("CommCatLiability")

  // Service Category GL accounts (Purchase module)
  serviceCategoriesExpense ServiceCategory[] @relation("ServiceCategoryExpense")
  serviceCategoriesAccrual ServiceCategory[] @relation("ServiceCategoryAccrual")
  serviceCategoriesWip     ServiceCategory[] @relation("ServiceCategoryWip")

  // Bank transfer items
  transferItemsSource BankTransferItem[] @relation("TransferItemSourceAccount")
  transferItemsDest   BankTransferItem[] @relation("TransferItemDestAccount")

  // School Management Fee accounts
  smFeeCategories  SmFeeCategory[]    @relation("FeeCategoryGLAccount")
  smInvoiceItems   SmFeeInvoiceItem[] @relation("FeeInvoiceItemGLAccount")
  smFeeDiscounts   SmFeeDiscount[]    @relation("FeeDiscountGLAccount")

  normalBalance String @default("debit") @db.VarChar(20)

  @@unique([entityId, code])
  @@unique([companyId, code])
  @@index([categoryId])
  @@index([accountType])
  @@map("ifrs_accounts")
}

model IfrsVat {
  id             Int       @id @default(autoincrement())
  entityId       Int?
  name           String
  code           String
  rate           Decimal   @db.Decimal(5, 2)
  accountId      Int? // Output VAT GL account (VAT Payable — liability)
  inputAccountId Int? // Input VAT GL account (VAT Recoverable — asset)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  entity IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  // Items
  items Item[]

  // Sales
  salesInvoiceLines  SalesInvoiceLine[]
  salesOrderLines    SalesOrderLine[]   @relation("SalesOrderLineVat")
  loadingOrderLines  LoadingOrderLine[] @relation("LoadingOrderLineVat")

  // Purchase
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@index([entityId])
  @@map("ifrs_vats")
}

model IfrsBalance {
  id                 Int       @id @default(autoincrement())
  entityId           Int
  accountId          Int
  year               Int
  period             Int
  balance            Decimal   @db.Decimal(15, 2)
  balanceType        String    @default("debit") // debit, credit
  // Audit & approval
  createdBy          Int?
  approvedAt         DateTime?
  approvedBy         Int?
  approvalComment    String?   @db.Text
  lastModifiedBy     Int?
  modificationReason String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  entity  IfrsEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account IfrsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entityId, accountId, year, period])
  @@map("ifrs_balances")
}

model IfrsTransaction {
  id              Int       @id @default(autoincrement())
  entityId        Int
  companyId       Int?
  transactionDate DateTime  @db.Date
  transactionNo   String?
  transactionType String? // journal, invoice, payment, etc.
  debitAccountId  Int
  creditAccountId Int
  amount          Decimal   @db.Decimal(15, 2)
  narration       String?   @db.Text
  reference       String?
  referenceType   String?
  referenceId     Int?
  currency        String?   @db.VarChar(3)
  exchangeRate    Decimal?  @db.Decimal(15, 6)
  baseAmount      Decimal?  @db.Decimal(15, 2)
  isCleared       Boolean   @default(false)
  clearedDate     DateTime?
  isReversed      Boolean   @default(false)
  reversedBy      Int?
  reversalOf      Int?
  posted          Boolean   @default(false)
  postedAt        DateTime?
  postedBy        Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  entity        IfrsEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debitAccount  IfrsAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount IfrsAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([entityId])
  @@index([companyId])
  @@index([transactionDate])
  @@index([transactionNo])
  @@map("ifrs_transactions")
}

model IfrsLedger {
  id            Int       @id @default(autoincrement())
  entityId      Int
  accountId     Int
  transactionId Int?
  date          DateTime  @db.Date
  narration     String?   @db.Text
  debit         Decimal?  @db.Decimal(15, 2)
  credit        Decimal?  @db.Decimal(15, 2)
  balance       Decimal   @db.Decimal(15, 2)
  reference     String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  entity  IfrsEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account IfrsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([entityId, accountId])
  @@index([date])
  @@map("ifrs_ledgers")
}

model IfrsExchangeRate {
  id             Int       @id @default(autoincrement())
  fromCurrencyId Int
  toCurrencyId   Int
  rate           Decimal   @db.Decimal(15, 6)
  validFrom      DateTime  @db.Date
  validTo        DateTime? @db.Date
  source         String?   // CBN, Bloomberg, Manual, etc.
  isActive       Boolean   @default(true)
  createdBy      Int?
  approvedBy     Int?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  fromCurrency IfrsCurrency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id], onDelete: Cascade)
  toCurrency   IfrsCurrency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id], onDelete: Cascade)

  @@index([fromCurrencyId, toCurrencyId, validFrom])
  @@map("ifrs_exchange_rates")
}

// ============================================================================
// ACCOUNTS MODULE - Journal Entries
// ============================================================================

model JournalEntry {
  id           Int       @id @default(autoincrement())
  companyId    Int
  entryNumber  String
  entryDate    DateTime  @db.Date
  reference    String?
  narration    String?   @db.Text
  totalDebit   Decimal   @db.Decimal(15, 2)
  totalCredit  Decimal   @db.Decimal(15, 2)
  status              String    @default("draft") // draft, pending, reviewed, approved, posted, reversed
  journalType         String? // general, adjusting, closing, opening, reversing
  sourceType          String? // manual, sales, purchase, payroll, etc.
  sourceId            Int?
  // Approval workflow
  requiresApproval    Boolean   @default(false)
  approvalLevel       Int       @default(0) // 0=none, 1=reviewed, 2=approved
  reviewedAt          DateTime?
  reviewedBy          Int?
  reviewComment       String?   @db.Text
  approvedAt          DateTime?
  approvedBy          Int?
  approvalComment     String?   @db.Text
  rejectedAt          DateTime?
  rejectedBy          Int?
  rejectionReason     String?   @db.Text
  // Posting
  postedAt            DateTime?
  postedBy            Int?
  // Reversal
  reversedAt          DateTime?
  reversedBy          Int?
  reversalOf          Int?
  reversalReason      String?   @db.Text
  // Audit
  fiscalYearId        Int?
  createdBy           Int?
  lastModifiedBy      Int?
  modificationReason  String?   @db.Text
  deletedAt           DateTime?
  deletedBy           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear? @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)

  lines JournalEntryLine[]

  // Commission payments
  commissionPayments          CommissionCalculation[]
  commissionPayableJournals   CommissionPayable[]     @relation("CommissionPayableJE")

  // School Management Fee entries
  smFeeInvoices SmFeeInvoice[]
  smFeePayments SmFeePayment[]

  @@unique([companyId, entryNumber])
  @@index([entryDate])
  @@index([status])
  @@index([companyId, status, entryDate])
  @@index([requiresApproval, status])
  @@index([createdBy])
  @@map("journal_entries")
}

model JournalEntryLine {
  id               Int      @id @default(autoincrement())
  journalEntryId   Int
  accountId        Int
  debit            Decimal? @db.Decimal(15, 2)
  credit           Decimal? @db.Decimal(15, 2)
  narration        String?  @db.Text
  reference        String?
  currencyCode     String?  @db.VarChar(3)
  foreignDebit     Decimal? @db.Decimal(15, 2)
  foreignCredit    Decimal? @db.Decimal(15, 2)
  exchangeRate     Decimal? @db.Decimal(15, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      IfrsAccount  @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_line_items")
}

model FiscalYear {
  id               Int       @id @default(autoincrement())
  companyId        Int
  name             String
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  status           String    @default("open") // open, adjusting, pending_close, closed
  isCurrent        Boolean   @default(false)
  // Close approval
  closeRequestedAt DateTime?
  closeRequestedBy Int?
  closeApprovedAt  DateTime?
  closeApprovedBy  Int?
  closeComment     String?   @db.Text
  closedAt         DateTime?
  closedBy         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]
  budgets        Budget[]
  @@index([companyId])
  @@index([isCurrent])
  @@map("fiscal_years")
}


// ============================================================================
// ACCOUNTS MODULE - Period Locks
// ============================================================================

model PeriodLock {
  id           Int       @id @default(autoincrement())
  companyId    Int
  year         Int
  period       Int       // 0=full year, 1-12=month
  isLocked     Boolean   @default(true)
  lockedAt     DateTime  @default(now())
  lockedBy     Int
  lockedReason String?   @db.Text
  unlockedAt   DateTime?
  unlockedBy   Int?
  unlockReason String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, period])
  @@index([companyId, isLocked])
  @@map("period_locks")
}

// ============================================================================
// ACCOUNTS MODULE - Banks & Reconciliation
// ============================================================================

model Bank {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  name                  String
  accountName           String?
  accountNumber         String
  bankName              String
  branchCode            String?
  swiftCode             String?
  iban                  String?
  routingNumber         String?
  contactPerson         String?
  contactPhone          String?
  contactEmail          String?
  glAccountId           Int?
  currencyCode          String    @default("NGN") @db.VarChar(3)
  openingBalance        Decimal   @default(0) @db.Decimal(15, 2)
  openingBalanceDate    DateTime?
  currentBalance        Decimal   @default(0) @db.Decimal(15, 2)
  isActive              Boolean   @default(true)
  isDefault             Boolean   @default(false)
  lastReconciledDate    DateTime?
  lastReconciledBalance Decimal?  @db.Decimal(15, 2)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  glAccount IfrsAccount? @relation(fields: [glAccountId], references: [id], onDelete: SetNull)

  reconciliations BankReconciliation[]
  authorizations  BankAuthorization[]
  transfers       BankTransfer[]       @relation("TransferFromBank")
  transfersTo     BankTransfer[]       @relation("TransferToBank")

  // Payables & Receivables
  supplierPayments         SupplierPayment[]
  payablesPaymentMethods   PayablesPaymentMethod[]   @relation("PayablesPaymentBank")
  customerReceipts         CustomerReceipt[]
  receiptPaymentMethods    ReceiptPaymentMethod[]    @relation("ReceiptPaymentBank")

  // POS
  depositRefunds DepositRefund[]

  // Sales
  invoicePayments InvoicePayment[] @relation("InvoicePaymentBank")

  // Import Management
  importFormMs          ImportFormM[]
  importLettersOfCredit ImportLetterOfCredit[] @relation("LCIssuingBank")
  importPayments        ImportPayment[]

  @@index([companyId])
  @@index([isActive])
  @@map("banks")
}

model BankAuthorization {
  id          Int      @id @default(autoincrement())
  bankId      Int
  employeeId  Int
  canView     Boolean  @default(true)
  canDeposit  Boolean  @default(false)
  canWithdraw Boolean  @default(false)
  canTransfer Boolean  @default(false)
  maxAmount   Decimal? @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  bank     Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([bankId, employeeId])
  @@map("bank_authorizations")
}

model BankReconciliation {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  branchId                 Int?
  bankId                   Int
  reconciliationDate       DateTime  @db.Date
  statementDate            DateTime  @db.Date
  statementBalance         Decimal   @db.Decimal(15, 2)
  bookBalance              Decimal   @db.Decimal(15, 2)
  reconciledBalance        Decimal?  @db.Decimal(15, 2)
  difference               Decimal?  @db.Decimal(15, 2)
  differenceExplanation    String?   @db.Text
  status                   String    @default("draft") // draft, in_progress, pending_approval, completed, locked
  notes                    String?   @db.Text
  completedAt              DateTime?
  completedBy              Int?
  // Approval
  approvedAt               DateTime?
  approvedBy               Int?
  approvalComment          String?   @db.Text
  // Locking
  lockedAt                 DateTime?
  lockedBy                 Int?
  createdBy                Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank    Bank    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  items BankReconciliationItem[]

  @@index([companyId])
  @@index([bankId])
  @@index([reconciliationDate])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id                   Int       @id @default(autoincrement())
  bankReconciliationId Int
  transactionType      String // deposit, withdrawal, transfer, charge, interest
  referenceType        String? // payment, receipt, journal, etc.
  referenceId          Int?
  transactionDate      DateTime  @db.Date
  description          String?
  amount               Decimal   @db.Decimal(15, 2)
  isCleared            Boolean   @default(false)
  clearedAt            DateTime?
  clearedBy            Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  bankReconciliation BankReconciliation @relation(fields: [bankReconciliationId], references: [id], onDelete: Cascade)

  @@index([bankReconciliationId])
  @@map("bank_reconciliation_items")
}

model BankTransfer {
  id             Int       @id @default(autoincrement())
  companyId      Int
  fromBankId     Int
  toBankId       Int
  transferNumber String
  branchId       Int?
  entityId       Int?
  amount         Decimal   @db.Decimal(15, 2)
  totalAmount    Decimal   @default(0) @db.Decimal(15, 2)
  currencyId     Int?
  exchangeRate   Decimal   @default(1) @db.Decimal(10, 6)
  transferDate   DateTime  @db.Date
  reference      String?
  description    String?   @db.Text
  status         String    @default("draft") // draft, pending, approved, posted, cancelled
  journalEntryId Int?
  approvedBy     Int?
  approvedAt     DateTime?
  approvalNotes  String?   @db.Text
  postedBy       Int?
  postedAt       DateTime?
  completedAt    DateTime?
  createdBy             Int?
  updatedBy             Int?
  chargesAccountId      Int?
  transferType          String   @default("local") @db.VarChar(20)
  sourceCurrencyId      Int?
  destinationCurrencyId Int?
  destinationAmount     Decimal? @db.Decimal(15, 2)
  bankCharges           Decimal  @default(0) @db.Decimal(15, 2)
  forexGainLoss         Decimal  @default(0) @db.Decimal(15, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromBank Bank    @relation("TransferFromBank", fields: [fromBankId], references: [id])
  toBank   Bank    @relation("TransferToBank", fields: [toBankId], references: [id])

  items BankTransferItem[]

  @@unique([companyId, transferNumber])
  @@index([transferDate])
  @@index([companyId, status])
  @@map("bank_transfers")
}

model BankTransferItem {
  id                   Int      @id @default(autoincrement())
  bankTransferId       Int
  lineNumber           Int      @default(1)
  transferType         String   // cash_to_bank, bank_to_bank
  sourceAccountId      Int
  sourceBankId         Int?
  destinationBankId    Int
  destinationAccountId Int
  amount               Decimal  @db.Decimal(15, 2)
  description          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  bankTransfer       BankTransfer @relation(fields: [bankTransferId], references: [id], onDelete: Cascade)
  sourceAccount      IfrsAccount  @relation("TransferItemSourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount IfrsAccount  @relation("TransferItemDestAccount", fields: [destinationAccountId], references: [id])

  @@index([bankTransferId])
  @@map("bank_transfer_items")
}

// ============================================================================
// ACCOUNTS MODULE - Withholding Tax
// ============================================================================

model WithholdingTax {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  name                String
  code                String
  rate                Decimal   @db.Decimal(5, 2)
  accountId           Int? // WHT payable account
  receivableAccountId Int? // WHT receivable account
  category            String? // services, goods, professional, dividend, rent, royalty
  description         String?   @db.Text
  isActive            Boolean   @default(true)
  effectiveFrom       DateTime? @db.Date
  effectiveTo         DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Purchase
  purchaseInvoiceLines PurchaseInvoiceLine[]

  // Expense
  expenseRequestLines ExpenseRequestLine[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, category])
  @@map("withholding_taxes")
}

// ============================================================================
// ACCOUNTS MODULE - Expense Requests
// ============================================================================

model ExpenseRequest {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  branchId                 Int?
  departmentId             Int?
  requestNumber            String
  requesterId              Int?
  requesterName            String?   @db.VarChar(255)
  requestDate              DateTime  @db.Date
  description              String    @db.Text
  // Beneficiary info
  beneficiaryName          String?
  beneficiaryAccountNumber String?
  beneficiaryBankName      String?
  beneficiaryBankId        Int?
  // Memo fields
  memoFrom                 String?
  memoTo                   String?
  subject                  String?
  background               String?   @db.Text
  justification            String?   @db.Text
  prayer                   String?   @db.Text
  // Amounts
  totalAmount              Decimal   @db.Decimal(15, 2)
  whtAmount                Decimal   @default(0) @db.Decimal(15, 2)
  netAmount                Decimal   @default(0) @db.Decimal(15, 2)
  currency                 String    @default("NGN") @db.VarChar(3)
  approvedAmount           Decimal?  @db.Decimal(15, 2)
  // Accounting
  expenseAccountId         Int?
  bankAccountId            Int?
  whtApplicable            Boolean   @default(false)
  whtRate                  Decimal?  @db.Decimal(5, 2)
  // Budget
  budgetNotes              String?   @db.Text
  budgetExceeded           Boolean   @default(false)
  // Status & Approval
  status                   String    @default("draft") // draft, pending_hod_approval, hod_approved, pending_audit_approval, audit_approved, pending_accountant_processing, accountant_processed, pending_management_approval, management_approved, pending_payment, paid, rejected, cancelled
  submittedAt              DateTime?
  approvedAt               DateTime?
  approvedBy               Int?
  // Payment
  paymentVoucherNumber     String?
  transferMemoNumber       String?
  paymentDate              DateTime? @db.Date
  paymentReference         String?
  journalEntryId           Int?
  rejectionReason          String?   @db.Text
  paidAt                   DateTime?
  paidBy                   Int?
  notes                    String?   @db.Text
  // Fleet linking — only populated when fleet-management module is enabled
  tripId                   Int?
  vehicleId                Int?
  fleetCostType            String?   @db.VarChar(50)
  // Batch import tagging. batchRef is set when the row was created via a
  // bulk upload (either live batch or historical load) and reused to
  // deduplicate re-uploads. isHistoricalLoad marks rows posted via the
  // Super-Admin historical-load flow, so audit reports can filter
  // "real new activity" from "backfilled prior facts".
  batchRef                 String?
  isHistoricalLoad         Boolean   @default(false)
  // Audit
  createdBy                Int?
  updatedBy                Int?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester Employee? @relation(fields: [requesterId], references: [id])

  lines       ExpenseRequestLine[]
  attachments ExpenseRequestAttachment[]

  @@unique([companyId, requestNumber])
  @@index([status])
  @@index([companyId, status])
  @@index([requesterId, status])
  @@index([batchRef])
  @@map("expense_requests")
}

model ExpenseRequestAttachment {
  id               Int      @id @default(autoincrement())
  expenseRequestId Int
  filename         String
  originalName     String
  path             String
  url              String
  mimeType         String?
  size             Int?
  uploadedBy       Int?
  createdAt        DateTime @default(now())

  expenseRequest ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)

  @@index([expenseRequestId])
  @@map("expense_request_attachments")
}

model ExpenseRequestLine {
  id               Int      @id @default(autoincrement())
  expenseRequestId Int
  description      String
  accountId        Int?
  expenseAccountId Int?
  whtId            Int?
  amount           Decimal  @db.Decimal(15, 2)
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  whtApplicable    Boolean  @default(false)
  whtRate          Decimal? @db.Decimal(5, 2)
  whtAmount        Decimal  @default(0) @db.Decimal(15, 2)
  netAmount        Decimal  @default(0) @db.Decimal(15, 2)
  remarks          String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  expenseRequest ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  wht            WithholdingTax? @relation(fields: [whtId], references: [id])

  @@index([expenseRequestId])
  @@map("expense_request_lines")
}

// ============================================================================
// INVENTORY MODULE - Categories & Units
// ============================================================================

model ItemCategory {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  categoryCode          String    @db.VarChar(50)
  categoryDescription   String    @db.VarChar(255)
  inventoryType         String    @db.VarChar(50) // Finished Goods, Raw Material, Work in Progress, Service
  vatId                 Int?
  glAccountMappings     Json?     // GL account ID mappings per inventory type
  isActive              Boolean   @default(true)
  status                String    @default("approved") @db.VarChar(20) // draft, submitted, approved, active, rejected, returned, discarded, inactive
  notes                 String?   @db.Text
  // Approval workflow
  submittedById         Int?
  submittedAt           DateTime?
  approvedById          Int?
  approvedAt            DateTime?
  approvalNotes         String?   @db.Text
  // Commission settings (configured per-category)
  commissionEnabled              Boolean   @default(false)
  commissionRate                 Decimal?  @db.Decimal(10, 2)
  commissionPaidOn               String?   @db.VarChar(20) // invoice | payment
  commissionApplicableTo         String?   @db.VarChar(20) // sales_rep | customer | both
  commissionExpenseAccountId     Int?
  commissionLiabilityAccountId   Int?

  // Metadata
  createdById           Int?
  updatedById           Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissionExpenseAccount   IfrsAccount? @relation("CommCatExpense", fields: [commissionExpenseAccountId], references: [id], onDelete: SetNull)
  commissionLiabilityAccount IfrsAccount? @relation("CommCatLiability", fields: [commissionLiabilityAccountId], references: [id], onDelete: SetNull)

  items                  Item[]
  commissionRules        CommissionRule[]
  commissionCalculations CommissionCalculation[]

  @@unique([companyId, categoryCode])
  @@index([companyId])
  @@index([companyId, inventoryType])
  @@index([status])
  @@index([commissionEnabled])
  @@map("inv_item_categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  companyId   Int?
  name        String
  brandCode   String?   @db.VarChar(50)
  brandUrl    String?
  description String?   @db.Text
  logoPath    String?
  isActive    Boolean   @default(true)
  createdById Int?
  updatedById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items Item[]

  @@map("inv_brands")
}

model UnitOfMeasure {
  id               Int       @id @default(autoincrement())
  companyId        Int?
  uomCode          String?   @db.VarChar(50)
  name             String
  symbol           String    @db.VarChar(10)
  uomType          String?   @db.VarChar(50) // quantity, weight, volume, length, area, time, pack
  baseUomId        Int?
  conversionFactor Decimal?  @db.Decimal(10, 2)
  description      String?
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items           Item[]
  conversionsFrom UnitConversion[] @relation("ConversionFrom")
  conversionsTo   UnitConversion[] @relation("ConversionTo")

  // Sales lines
  salesOrderLines    SalesOrderLine[]    @relation("SalesOrderLineUom")
  salesDeliveryLines SalesDeliveryLine[] @relation("SalesDeliveryLineUom")
  salesInvoiceLines  SalesInvoiceLine[]  @relation("SalesInvoiceLineUom")
  loadingOrderLines  LoadingOrderLine[]  @relation("LoadingOrderLineUom")

  // Inventory
  beginningBalances  ItemBeginningBalance[]
  itemBarcodes       ItemBarcode[]      @relation("BarcodeUom")
  isrLines           InternalStockRequestLine[] @relation("IsrLineUom")

  @@map("inv_unit_of_measures")
}

model UnitConversion {
  id                    Int      @id @default(autoincrement())
  companyId             Int?
  fromUnitId            Int
  toUnitId              Int
  conversionFactor      Decimal  @db.Decimal(15, 6)
  isBidirectional       Boolean  @default(false)
  itemId                Int? // If specific to an item
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  fromUnit UnitOfMeasure @relation("ConversionFrom", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit   UnitOfMeasure @relation("ConversionTo", fields: [toUnitId], references: [id], onDelete: Cascade)
  item     Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([fromUnitId, toUnitId, itemId])
  @@map("inv_unit_conversions")
}

model ItemPriceGroup {
  id                 Int       @id @default(autoincrement())
  companyId          Int?
  code               String?   @db.VarChar(50)
  name               String
  branchId           Int?
  currencyId         Int?
  priceEffectiveFrom DateTime? @db.Date
  priceEffectiveTo   DateTime? @db.Date
  description        String?   @db.Text
  isDefault          Boolean   @default(false)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customers       Customer[]
  itemPrices      ItemPrice[]
  defaultForItems Item[]            @relation("ItemDefaultPriceGroup")
  priceHistories  ItemPriceHistory[] @relation("PriceHistoryGroup")

  @@map("inv_item_price_groups")
}

// ============================================================================
// INVENTORY MODULE - Items & Warehouses
// ============================================================================

model Item {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  code               String
  name               String
  description        String?   @db.Text
  categoryId         Int?
  brandId            Int?
  unitOfMeasureId    Int?
  currencyId         Int?
  itemPriceGroupId   Int?
  itemType           String    @default("inventory") // inventory, service, non_inventory
  assemblyType       String    @default("product") @db.VarChar(50) // product, service, kit, purchased, manufactured
  itemStatus         String    @default("draft") @db.VarChar(50) // draft, active, discontinued, obsolete
  imagePath          String?
  primaryBarcode     String?   @db.VarChar(100)
  barcodeType        String?   @db.VarChar(20) // EAN13, UPC, CODE128, CODE39, QR
  // Tracking
  trackInventory     Boolean   @default(true)
  trackBatches       Boolean   @default(false)
  trackSerials       Boolean   @default(false)
  isPerishable       Boolean   @default(false)
  // Batch/Lot tracking
  batchNumberFormat        String?  @db.VarChar(100) // BATCH-{YYYY}-{MM}-{###}
  lotNumberFormat          String?  @db.VarChar(100)
  requireBatchOnReceipt    Boolean  @default(false)
  requireBatchOnIssue      Boolean  @default(false)
  serialNumberFormat       String?  @db.VarChar(100)
  serialNumberSource       String   @default("auto") @db.VarChar(20) // auto, manual, vendor
  requireSerialOnReceipt   Boolean  @default(false)
  requireSerialOnIssue     Boolean  @default(false)
  shelfLifeDays            Int?
  expiryAlertDays          Int      @default(30)
  allowExpiredIssue        Boolean  @default(false)
  requireManufactureDate   Boolean  @default(false)
  // Costing
  costingMethod      String    @default("average") // average, fifo, lifo, standard, specific
  standardCost       Decimal?  @db.Decimal(15, 4)
  averageCost        Decimal?  @db.Decimal(15, 4)
  lastPurchasePrice  Decimal?  @db.Decimal(15, 4)
  lastLandedCost     Decimal?  @db.Decimal(15, 4)
  lastPurchaseDate   DateTime? @db.Date
  // Pricing
  sellingPrice              Decimal?  @db.Decimal(15, 4)
  minimumSellingPrice       Decimal?  @db.Decimal(15, 4)
  suggestedRetailPrice      Decimal?  @db.Decimal(15, 4)
  currentMarginPercentage   Decimal?  @db.Decimal(8, 2)
  currentMarkupPercentage   Decimal?  @db.Decimal(8, 2)
  // Units
  purchaseUnit       String?   @db.VarChar(50)
  salesUnit          String?   @db.VarChar(50)
  decimalPlacesQty   Int       @default(2)
  // Tax
  vatId              Int?
  defaultVatId       Int?
  // GL accounts
  salesAccountId     Int?
  cogsAccountId      Int?
  inventoryAccountId Int?
  // Stock levels
  reorderPoint       Decimal?  @db.Decimal(15, 4)
  reorderQuantity    Decimal?  @db.Decimal(15, 4)
  minStockLevel      Decimal?  @db.Decimal(15, 4)
  maxStockLevel      Decimal?  @db.Decimal(15, 4)
  economicOrderQuantity Decimal? @db.Decimal(15, 4)
  // Physical properties
  netWeightKg              Decimal?  @db.Decimal(10, 3)
  weightUnit               String    @default("kg") @db.VarChar(10) // kg, g, lb, oz
  packagedVolumeCubicFeet  Decimal?  @db.Decimal(10, 3)
  volumeUnit               String    @default("cubic_meter") @db.VarChar(20) // cubic_feet, cubic_meter, liter, gallon
  packagedGrossWeightKg    Decimal?  @db.Decimal(10, 3)
  panSize                  Decimal?  @db.Decimal(10, 2)
  shrinkageFactor          Decimal?  @db.Decimal(5, 2)
  dimensions               Json?
  // Risk & safety
  categoryRisk       String    @default("Low") @db.VarChar(20) // Low, Medium, High, Critical
  isHazardous        Boolean   @default(false)
  hazardClass        String?   @db.VarChar(100)
  // Flags
  isActive           Boolean   @default(true)
  isPurchasable      Boolean   @default(true)
  isSellable         Boolean   @default(true)
  isManufacturable   Boolean   @default(false)
  isVisibleOnPortal  Boolean   @default(false)
  discountCategoryId Int?
  // Approval workflow
  status             String    @default("draft") @db.VarChar(20) // draft, submitted, approved, active, rejected, returned, discarded
  submittedById      Int?
  submittedAt        DateTime?
  approvedById       Int?
  approvedAt         DateTime?
  approvalNotes      String?   @db.Text
  // Metadata
  createdById        Int?
  updatedById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category         ItemCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand            Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitOfMeasure    UnitOfMeasure? @relation(fields: [unitOfMeasureId], references: [id], onDelete: SetNull)
  currency         IfrsCurrency?  @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  vat              IfrsVat?       @relation(fields: [vatId], references: [id], onDelete: SetNull)
  salesAccount     IfrsAccount?   @relation("ItemSalesAccount", fields: [salesAccountId], references: [id], onDelete: SetNull)
  cogsAccount      IfrsAccount?   @relation("ItemCogsAccount", fields: [cogsAccountId], references: [id], onDelete: SetNull)
  inventoryAccount IfrsAccount?   @relation("ItemInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: SetNull)
  priceGroup       ItemPriceGroup? @relation("ItemDefaultPriceGroup", fields: [itemPriceGroupId], references: [id], onDelete: SetNull)

  unitConversions UnitConversion[]
  prices          ItemPrice[]
  priceHistory    ItemPriceHistory[]
  costHistory     ItemCostHistory[]
  barcodes        ItemBarcode[]
  stockLevels     StockLevel[]
  stockBatches    StockBatch[]
  stockMovements  StockMovement[]
  costLayers      InventoryCostLayer[]
  branchItems     BranchItem[]
  beginningBalances ItemBeginningBalance[]

  // Sales
  salesOrderLines    SalesOrderLine[]
  salesDeliveryLines SalesDeliveryLine[]
  salesInvoiceLines  SalesInvoiceLine[]
  loadingOrderLines  LoadingOrderLine[]
  salesForecasts     SalesForecast[]

  // Purchase
  purchaseRequisitionLines PurchaseRequisitionLine[]
  rfqLines                 RfqLine[]
  purchaseOrderLines       PurchaseOrderLine[]
  grnLines                 GrnLine[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]

  // Manufacturing
  finishedGoodsBoms  BillOfMaterial[]          @relation("FinishedGoods")
  componentBomLines  BomLine[]                 @relation("ComponentItem")
  bomByProducts      BomByProduct[]            @relation("BomByProduct")
  routings           Routing[]
  productionOrders   ProductionOrder[]
  materialIssues     MaterialIssue[]           @relation("MaterialIssueProduct")
  materialReturns    MaterialReturn[]          @relation("MaterialReturnProduct")
  productionReceipts ProductionReceipt[]       @relation("ProductionReceiptProduct")

  // Import Management
  importOrderLines ImportOrderLine[]

  // Veterinary consumable packs (Sprint 1.3)
  consumablePackItems VetConsumablePackItem[] @relation("ConsumablePackItems")

  @@unique([companyId, code])
  @@index([categoryId])
  @@index([itemType])
  @@index([assemblyType])
  @@index([status])
  @@map("inv_items")
}

model ItemPrice {
  id                Int       @id @default(autoincrement())
  companyId         Int?
  itemId            Int
  priceGroupId      Int?
  branchId          Int?
  currencyId        Int?
  price             Decimal   @db.Decimal(15, 4)
  minimumPrice      Decimal?  @db.Decimal(15, 4)
  maximumPrice      Decimal?  @db.Decimal(15, 4)
  costPrice         Decimal?  @db.Decimal(15, 4)
  minQuantity       Decimal?  @db.Decimal(15, 4)
  maxQuantity       Decimal?  @db.Decimal(15, 4)
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  priceType         String    @default("standard") @db.VarChar(50) // standard, promotional, clearance, contract
  promotionCode     String?   @db.VarChar(50)
  markupPercentage  Decimal?  @db.Decimal(8, 2)
  marginPercentage  Decimal?  @db.Decimal(8, 2)
  isActive          Boolean   @default(true)
  notes             String?   @db.Text
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  priceGroup ItemPriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  priceHistories ItemPriceHistory[] @relation("PriceHistoryPrice")

  @@index([itemId])
  @@index([priceGroupId])
  @@index([priceType])
  @@index([startDate, endDate])
  @@map("inv_item_prices")
}

model ItemPriceHistory {
  id                     Int       @id @default(autoincrement())
  companyId              Int?
  itemId                 Int
  itemPriceId            Int?
  itemPriceGroupId       Int?
  branchId               Int?
  currencyId             Int?
  changeType             String?   @db.VarChar(50) // created, updated, deleted, activated, deactivated, expired
  oldPrice               Decimal?  @db.Decimal(15, 4)
  newPrice               Decimal?  @db.Decimal(15, 4)
  priceDifference        Decimal?  @db.Decimal(15, 4)
  priceChangePercentage  Decimal?  @db.Decimal(8, 2)
  reason                 String?
  changeNotes            String?   @db.Text
  effectiveDate          DateTime? @db.Date
  approvedById           Int?
  approvedAt             DateTime?
  changedBy              Int?
  changedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  item       Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemPrice  ItemPrice?      @relation("PriceHistoryPrice", fields: [itemPriceId], references: [id], onDelete: SetNull)
  priceGroup ItemPriceGroup? @relation("PriceHistoryGroup", fields: [itemPriceGroupId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([itemId, changedAt])
  @@index([changeType])
  @@map("item_price_history")
}

model ItemCostHistory {
  id                       Int       @id @default(autoincrement())
  companyId                Int?
  itemId                   Int
  branchId                 Int?
  warehouseId              Int?
  currencyId               Int?
  sourceType               String?   @db.VarChar(50) // purchase_order, goods_receipt, invoice, stock_adjustment, production, manual_entry, opening_balance
  sourceId                 Int?
  sourceReference          String?   @db.VarChar(100)
  vendorId                 Int?
  vendorName               String?
  vendorInvoiceNumber      String?   @db.VarChar(100)
  unitCost                 Decimal?  @db.Decimal(15, 4)
  quantity                 Decimal?  @db.Decimal(15, 4)
  totalCost                Decimal?  @db.Decimal(15, 4)
  freightCost              Decimal   @default(0) @db.Decimal(15, 4)
  dutyCost                 Decimal   @default(0) @db.Decimal(15, 4)
  handlingCost             Decimal   @default(0) @db.Decimal(15, 4)
  otherCost                Decimal   @default(0) @db.Decimal(15, 4)
  totalLandedCost          Decimal?  @db.Decimal(15, 4)
  landedCostPerUnit        Decimal?  @db.Decimal(15, 4)
  previousCost             Decimal?  @db.Decimal(15, 4)
  costVariance             Decimal?  @db.Decimal(15, 4)
  costVariancePercentage   Decimal?  @db.Decimal(8, 2)
  exchangeRate             Decimal   @default(1) @db.Decimal(15, 6)
  baseCurrencyCost         Decimal?  @db.Decimal(15, 4)
  transactionDate          DateTime? @db.Date
  receiptDate              DateTime? @db.Date
  invoiceDate              DateTime? @db.Date
  weightedAverageBefore    Decimal?  @db.Decimal(15, 4)
  weightedAverageAfter     Decimal?  @db.Decimal(15, 4)
  standardCostAtTime       Decimal?  @db.Decimal(15, 4)
  quantityRemaining        Decimal   @default(0) @db.Decimal(15, 4)
  isDepleted               Boolean   @default(false)
  depletedDate             DateTime? @db.Date
  batchNumber              String?   @db.VarChar(100)
  expiryDate               DateTime? @db.Date
  qualityNotes             String?   @db.Text
  isApproved               Boolean   @default(false)
  approvedById             Int?
  approvedAt               DateTime?
  // Legacy compatibility
  oldCost                  Decimal?  @db.Decimal(15, 2)
  newCost                  Decimal?  @db.Decimal(15, 2)
  reference                String?
  changedBy                Int?
  createdById              Int?
  updatedById              Int?
  notes                    String?   @db.Text
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([itemId, transactionDate])
  @@index([sourceType, sourceId])
  @@index([vendorId, transactionDate])
  @@map("item_cost_history")
}

model ItemBarcode {
  id              Int       @id @default(autoincrement())
  companyId       Int?
  itemId          Int
  barcode         String
  barcodeType     String    @default("ean13") @db.VarChar(50) // EAN13, UPC, CODE128, CODE39, QR, EAN8, ITF, CODABAR
  batchId         Int?
  uomId           Int?
  uomQuantity     Decimal?  @db.Decimal(10, 2)
  barcodePurpose  String?   @db.VarChar(50) // primary, alternate, batch, case, pallet
  region          String?
  isPrimary       Boolean   @default(false)
  // Approval workflow
  status          String    @default("active") @db.VarChar(20) // draft, submitted, approved, active, rejected
  submittedById   Int?
  submittedAt     DateTime?
  approvedById    Int?
  approvedAt      DateTime?
  approvalNotes   String?   @db.Text
  createdById     Int?
  updatedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  item Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uom  UnitOfMeasure? @relation("BarcodeUom", fields: [uomId], references: [id], onDelete: SetNull)

  @@unique([barcode])
  @@index([itemId])
  @@index([barcodePurpose])
  @@map("inv_item_barcodes")
}

model Warehouse {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  code                String
  name                String
  address             String?   @db.Text
  city                String?
  state               String?
  country             String?
  contactPerson       String?
  phone               String?
  email               String?
  warehouseType       String?   @db.VarChar(50)
  allowsNegativeStock Boolean   @default(false)
  isDefault           Boolean   @default(false)
  isActive            Boolean   @default(true)
  // Approval workflow
  status              String    @default("draft") @db.VarChar(20) // draft, submitted, approved, active, rejected, returned, discarded
  submittedById       Int?
  submittedAt         DateTime?
  approvedById        Int?
  approvedAt          DateTime?
  approvalNotes       String?   @db.Text
  // Metadata
  createdById         Int?
  updatedById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customers          Customer[]
  stockLevels        StockLevel[]
  stockBatches       StockBatch[]
  stockMovementsFrom StockMovement[]          @relation("MovementFromWarehouse")
  stockMovementsTo   StockMovement[]          @relation("MovementToWarehouse")
  binLocations       BinLocation[]
  authorizations     WarehouseAuthorization[]
  costLayers         InventoryCostLayer[]     @relation("CostLayerWarehouse")
  beginningBalances  ItemBeginningBalance[]

  // Sales
  salesDeliveries        SalesDelivery[]
  salesOrdersByWarehouse SalesOrder[]    @relation("SalesOrderWarehouse")
  salesInvoicesByWarehouse SalesInvoice[] @relation("SalesInvoiceWarehouse")
  loadingOrdersByWarehouse LoadingOrder[] @relation("LoadingOrderWarehouse")

  // Purchase
  goodsReceivedNotes GoodsReceivedNote[]

  // Internal requests
  internalRequestsFrom InternalStockRequest[] @relation("RequestFromWarehouse")
  internalRequestsTo   InternalStockRequest[] @relation("RequestToWarehouse")

  @@unique([companyId, code])
  @@index([branchId])
  @@index([status])
  @@map("inv_warehouses")
}

model WarehouseAuthorization {
  id          Int      @id @default(autoincrement())
  warehouseId Int
  employeeId  Int
  canView     Boolean  @default(true)
  canSell     Boolean  @default(false)
  canReceive  Boolean  @default(false)
  canIssue    Boolean  @default(false)
  canTransfer Boolean  @default(false)
  canAdjust   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, employeeId])
  @@map("warehouse_authorizations")
}

model BinLocation {
  id                       Int       @id @default(autoincrement())
  companyId                Int?
  warehouseId              Int
  code                     String
  name                     String?
  zone                     String?   @db.VarChar(20)
  aisle                    String?   @db.VarChar(20)
  rack                     String?   @db.VarChar(20)
  shelf                    String?   @db.VarChar(20)
  bin                      String?   @db.VarChar(20)
  level                    String?
  position                 String?
  locationPath             String?   @db.VarChar(100) // Full path e.g., Zone A > Aisle 3 > Rack 2 > Shelf B
  binType                  String    @default("general") @db.VarChar(50) // general, picking, bulk, receiving, staging, quarantine, damaged
  // Capacity
  maxWeightKg              Decimal?  @db.Decimal(10, 2)
  maxVolumeM3              Decimal?  @db.Decimal(10, 4)
  maxItems                 Int?
  maxQuantity              Int?
  currentWeightKg          Decimal   @default(0) @db.Decimal(10, 2)
  currentVolumeM3          Decimal   @default(0) @db.Decimal(10, 4)
  currentItemsCount        Int       @default(0)
  currentTotalQuantity     Int       @default(0)
  // Flags
  isDefault                Boolean   @default(false)
  isActive                 Boolean   @default(true)
  isAvailable              Boolean   @default(true)
  isPickable               Boolean   @default(true)
  // Environment
  isTemperatureControlled  Boolean   @default(false)
  minTemperatureC          Decimal?  @db.Decimal(5, 2)
  maxTemperatureC          Decimal?  @db.Decimal(5, 2)
  isHumidityControlled     Boolean   @default(false)
  targetHumidityPercent    Decimal?  @db.Decimal(5, 2)
  notes                    String?   @db.Text
  // Metadata
  createdById              Int?
  updatedById              Int?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  assignments BinItemAssignment[]

  @@unique([warehouseId, code])
  @@index([binType])
  @@index([zone])
  @@index([warehouseId, isActive, isAvailable])
  @@map("inv_bin_locations")
}

// ============================================================================
// INVENTORY MODULE - Stock Management
// ============================================================================

model StockLevel {
  id                Int       @id @default(autoincrement())
  companyId         Int?
  itemId            Int
  branchId          Int?
  warehouseId       Int
  quantity          Decimal   @db.Decimal(15, 3)
  reservedQuantity  Decimal   @default(0) @db.Decimal(15, 3)
  quantityOnOrder   Decimal?  @db.Decimal(15, 3)
  availableQuantity Decimal   @db.Decimal(15, 3)
  totalValue        Decimal?  @db.Decimal(15, 2)
  avgCost           Decimal?  @db.Decimal(15, 2)
  lastMovementDate  DateTime?
  lastMovementType  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([companyId, warehouseId])
  @@index([companyId, branchId])
  @@map("inv_stock_levels")
}

model StockBatch {
  id                  Int       @id @default(autoincrement())
  companyId           Int?
  itemId              Int
  warehouseId         Int
  batchNumber         String
  lotNumber           String?
  batchBarcode        String?
  manufactureDate     DateTime? @db.Date
  expiryDate          DateTime? @db.Date
  receivedDate        DateTime? @db.Date
  originalQuantity    Decimal?  @db.Decimal(15, 3)
  quantity            Decimal   @db.Decimal(15, 3)
  allocatedQuantity   Decimal?  @db.Decimal(15, 3)
  availableQuantity   Decimal?  @db.Decimal(15, 3)
  cost                Decimal?  @db.Decimal(15, 2)
  unitCost            Decimal?  @db.Decimal(15, 2)
  batchValue          Decimal?  @db.Decimal(15, 2)
  totalValue          Decimal?  @db.Decimal(15, 2)
  batchStatus         String    @default("available") @db.VarChar(50) // available, reserved, expired, quarantine, depleted, recalled
  notes               String?   @db.Text
  // Supplier
  supplierId          Int?
  supplierBatchRef    String?
  // Quality
  qualityCheckDate    DateTime?
  qualityStatus       String?   @db.VarChar(50)
  qualityNotes        String?   @db.Text
  // Approval workflow
  status              String    @default("active") @db.VarChar(20) // draft, submitted, approved, active, rejected, returned, discarded
  submittedById       Int?
  submittedAt         DateTime?
  approvedById        Int?
  approvedAt          DateTime?
  approvalNotes       String?   @db.Text
  // Metadata
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  stockMovements    StockMovement[]     @relation("MovementBatch")
  costLayers        InventoryCostLayer[] @relation("CostLayerBatch")
  binAssignments    BinItemAssignment[]
  stockCountLines   StockCountLine[]    @relation("CountLineBatch")

  @@unique([itemId, warehouseId, batchNumber])
  @@index([expiryDate])
  @@index([batchBarcode])
  @@index([batchStatus, expiryDate])
  @@index([status])
  @@map("inv_stock_batches")
}

model StockMovement {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  movementNumber      String?   @db.VarChar(100) // Auto-generated STK-YYYYMM-XXXX
  movementType        String    @db.VarChar(50) // Receipt, Issue, Transfer, Adjustment, Write-off, Return to Supplier, Customer Return
  itemId              Int
  fromWarehouseId     Int?
  toWarehouseId       Int?
  quantity            Decimal   @db.Decimal(15, 4)
  unitCost            Decimal?  @db.Decimal(15, 2)
  totalCost           Decimal?  @db.Decimal(15, 2)
  // Multi-currency
  originalCurrency    String?   @db.VarChar(3)
  originalUnitCost    Decimal?  @db.Decimal(15, 2)
  originalTotalCost   Decimal?  @db.Decimal(15, 2)
  exchangeRate        Decimal?  @db.Decimal(15, 6)
  exchangeRateDate    DateTime? @db.Date
  // References
  reference           String?
  referenceType       String?   @db.VarChar(50) // grn, delivery, transfer, adjustment, production_order, sales_order
  referenceId         Int?
  batchId             Int?
  batchNumber         String?
  serialNumber        String?   @db.VarChar(100)
  expiryDate          DateTime? @db.Date
  journalEntryId      Int?
  movementDate        DateTime  @db.Date
  notes               String?   @db.Text
  reason              String?   @db.Text
  // Approval workflow
  status              String    @default("draft") @db.VarChar(20) // draft, submitted, approved, posted, rejected, returned, discarded
  submittedById       Int?
  submittedAt         DateTime?
  approvedById        Int?
  approvedAt          DateTime?
  approvalNotes       String?   @db.Text
  approvalThreshold   Decimal   @default(10000) @db.Decimal(15, 2)
  // Metadata
  createdBy           Int?
  updatedBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item          Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouse   Warehouse? @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  batch         StockBatch? @relation("MovementBatch", fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, branchId])
  @@index([itemId])
  @@index([movementDate])
  @@index([movementNumber])
  @@index([referenceType, referenceId])
  @@index([status])
  @@map("inv_stock_movements")
}

model InventoryCostLayer {
  id                  Int       @id @default(autoincrement())
  companyId           Int?
  itemId              Int
  warehouseId         Int?
  branchId            Int?
  layerReference      String?   @db.VarChar(100)
  stockMovementId     Int?
  stockBatchId        Int?
  originalQuantity    Decimal?  @db.Decimal(15, 4)
  quantity            Decimal   @db.Decimal(15, 4)
  remainingQty        Decimal   @db.Decimal(15, 4)
  allocatedQuantity   Decimal   @default(0) @db.Decimal(15, 4)
  unitCost            Decimal   @db.Decimal(15, 4)
  landedCost          Decimal?  @db.Decimal(15, 4)
  currencyCode        String    @default("NGN") @db.VarChar(3)
  exchangeRate        Decimal   @default(1) @db.Decimal(12, 6)
  originalUnitCost    Decimal?  @db.Decimal(15, 4)
  layerDate           DateTime  @db.Date
  receivedAt          DateTime?
  expiryDate          DateTime? @db.Date
  referenceType       String?
  referenceId         Int?
  status              String    @default("active") @db.VarChar(20) // active, depleted, expired, written_off
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse  Warehouse?  @relation("CostLayerWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  stockBatch StockBatch? @relation("CostLayerBatch", fields: [stockBatchId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([itemId, warehouseId, status])
  @@index([itemId, status, layerDate])
  @@index([itemId, status, expiryDate])
  @@index([layerDate])
  @@map("inventory_cost_layers")
}

model StockCount {
  id                      Int       @id @default(autoincrement())
  companyId               Int?
  branchId                Int?
  warehouseId             Int
  countNumber             String?   @db.VarChar(50)
  countDate               DateTime  @db.Date
  countType               String    @default("full") @db.VarChar(50) // full, cycle, spot, annual
  countMethod             String    @default("blind") @db.VarChar(50) // blind, informed
  categoryId              Int?
  binLocation             String?   @db.VarChar(100)
  status                  String    @default("draft") @db.VarChar(20) // draft, in_progress, pending_review, approved, posted, cancelled
  // Statistics
  totalItems              Int       @default(0)
  countedItems            Int       @default(0)
  varianceItems           Int       @default(0)
  totalVarianceValue      Decimal   @default(0) @db.Decimal(15, 2)
  totalPositiveVariance   Decimal   @default(0) @db.Decimal(15, 2)
  totalNegativeVariance   Decimal   @default(0) @db.Decimal(15, 2)
  notes                   String?   @db.Text
  reviewNotes             String?   @db.Text
  // Workflow tracking
  countedBy               Int?
  countingStartedAt       DateTime?
  countingCompletedAt     DateTime?
  reviewedBy              Int?
  reviewedAt              DateTime?
  approvedBy              Int?
  approvedAt              DateTime?
  postedBy                Int?
  postedAt                DateTime?
  completedAt             DateTime?
  completedBy             Int?
  // Metadata
  createdBy               Int?
  updatedBy               Int?
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  lines StockCountLine[]

  @@index([companyId, warehouseId, countDate])
  @@index([warehouseId])
  @@index([countDate])
  @@index([status])
  @@index([countType])
  @@map("stock_counts")
}

model StockCountLine {
  id                    Int       @id @default(autoincrement())
  stockCountId          Int
  itemId                Int
  stockBatchId          Int?
  binLocation           String?   @db.VarChar(100)
  shelfLocation         String?   @db.VarChar(100)
  systemQuantity        Decimal   @db.Decimal(15, 4)
  countedQuantity       Decimal?  @db.Decimal(15, 4)
  variance              Decimal?  @db.Decimal(15, 4)
  unitCost              Decimal?  @db.Decimal(15, 4)
  systemValue           Decimal?  @db.Decimal(15, 2)
  countedValue          Decimal?  @db.Decimal(15, 2)
  varianceValue         Decimal?  @db.Decimal(15, 2)
  lineStatus            String    @default("pending") @db.VarChar(20) // pending, counted, recounted, skipped
  countAttempts         Int       @default(0)
  lastCountedAt         DateTime?
  lastCountedBy         Int?
  varianceApproved      Boolean   @default(false)
  varianceReason        String?   @db.Text
  adjustmentMovementId  Int?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  stockCount StockCount  @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  stockBatch StockBatch? @relation("CountLineBatch", fields: [stockBatchId], references: [id], onDelete: SetNull)

  @@unique([stockCountId, itemId, stockBatchId])
  @@index([stockCountId])
  @@index([stockCountId, lineStatus])
  @@map("stock_count_lines")
}

model CycleCountSchedule {
  id                Int       @id @default(autoincrement())
  companyId         Int?
  warehouseId       Int
  name              String    @db.VarChar(255)
  description       String?   @db.Text
  abcClassification String?   @db.VarChar(10) // A, B, C
  frequency         String    @db.VarChar(50) // weekly, biweekly, monthly, quarterly, annually
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  nextRunDate       DateTime? @db.Date
  assignedUserId    Int?
  isActive          Boolean   @default(true)
  createdById       Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assignments CycleCountAssignment[]

  @@index([companyId])
  @@index([warehouseId])
  @@index([isActive])
  @@map("inv_cycle_count_schedules")
}

model CycleCountAssignment {
  id              Int       @id @default(autoincrement())
  scheduleId      Int
  itemId          Int
  warehouseId     Int
  companyId       Int?
  scheduledDate   DateTime  @db.Date
  status          String    @default("pending") @db.VarChar(20) // pending, completed, skipped
  assignedUserId  Int?
  completedDate   DateTime?
  completedById   Int?
  stockCountId    Int?
  skipReason      String?   @db.Text
  skippedById     Int?
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schedule CycleCountSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([itemId])
  @@index([status])
  @@map("inv_cycle_count_assignments")
}

model InternalStockRequest {
  id              Int       @id @default(autoincrement())
  companyId       Int?
  branchId        Int?
  requestNumber   String    @db.VarChar(50)
  requestDate     DateTime  @db.Date
  requesterId     Int?
  departmentId    Int?
  costCenter      String?   @db.VarChar(100)
  purpose         String?   @db.VarChar(500)
  notes           String?   @db.Text
  priority        String    @default("normal") @db.VarChar(20) // low, normal, high, urgent
  status          String    @default("draft") @db.VarChar(50) // draft, pending_hod_approval, hod_approved, pending_audit_approval, audit_approved, pending_issue, partially_issued, issued, rejected, cancelled
  issuedDate      DateTime? @db.Date
  issuedBy        Int?
  mivNumber       String?   @db.VarChar(50) // Material Issue Voucher number
  journalEntryId  Int?
  // Legacy warehouse references (kept for backward compat)
  fromWarehouseId Int
  toWarehouseId   Int
  requiredDate    DateTime? @db.Date
  requestedBy     Int?
  approvedBy      Int?
  approvedAt      DateTime?
  fulfilledAt     DateTime?
  // Metadata
  createdById     Int?
  updatedById     Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  fromWarehouse Warehouse @relation("RequestFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("RequestToWarehouse", fields: [toWarehouseId], references: [id])

  lines     InternalStockRequestLine[]
  approvals IsrApproval[]

  @@unique([requestNumber])
  @@index([companyId, status])
  @@index([companyId, requestDate])
  @@index([status])
  @@index([priority])
  @@map("inv_isr_requests")
}

model InternalStockRequestLine {
  id                     Int       @id @default(autoincrement())
  internalStockRequestId Int
  itemId                 Int
  warehouseId            Int?
  uomId                  Int?
  requestedQuantity      Decimal   @db.Decimal(15, 4)
  approvedQuantity       Decimal?  @db.Decimal(15, 4)
  issuedQuantity         Decimal   @default(0) @db.Decimal(15, 4)
  unitCost               Decimal?  @db.Decimal(15, 4)
  totalCost              Decimal?  @db.Decimal(15, 4)
  costingMethod          String?   @db.VarChar(20) // FIFO, LIFO, Weighted Average
  inventoryGlAccountId   Int?
  expenseGlAccountId     Int?
  remarks                String?   @db.VarChar(500)
  lineStatus             String    @default("pending") @db.VarChar(20) // pending, approved, partially_issued, issued, rejected
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  internalStockRequest InternalStockRequest @relation(fields: [internalStockRequestId], references: [id], onDelete: Cascade)
  uom                  UnitOfMeasure?       @relation("IsrLineUom", fields: [uomId], references: [id], onDelete: SetNull)

  @@index([internalStockRequestId])
  @@index([internalStockRequestId, lineStatus])
  @@map("inv_isr_lines")
}

model IsrApproval {
  id              Int       @id @default(autoincrement())
  isrRequestId    Int
  approvalType    String    @db.VarChar(20) // hod, audit, store_issue
  approverId      Int?
  approverName    String?
  approverTitle   String?
  status          String    @default("pending") @db.VarChar(20) // pending, approved, rejected
  comments        String?   @db.Text
  approvedAt      DateTime?
  signaturePath   String?
  hasStamp        Boolean   @default(false)
  stampType       String?   @db.VarChar(50) // approval, issued, etc.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  isrRequest InternalStockRequest @relation(fields: [isrRequestId], references: [id], onDelete: Cascade)

  @@unique([isrRequestId, approvalType])
  @@index([approverId, status])
  @@map("inv_isr_approvals")
}

model BranchItem {
  id                  Int       @id @default(autoincrement())
  branchId            Int
  itemId              Int
  companyId           Int?
  isActive            Boolean   @default(true)
  isSellable          Boolean   @default(true)
  isPurchasable       Boolean   @default(true)
  reorderLevel        Decimal?  @db.Decimal(15, 4)
  reorderQuantity     Decimal?  @db.Decimal(15, 4)
  minimumStockLevel   Decimal?  @db.Decimal(15, 4)
  maximumStockLevel   Decimal?  @db.Decimal(15, 4)
  binLocation         String?   @db.VarChar(100)
  shelfLocation       String?   @db.VarChar(100)
  createdById         Int?
  updatedById         Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([branchId, itemId])
  @@index([companyId, branchId, isActive])
  @@index([itemId, isSellable])
  @@map("inv_branch_items")
}

model ItemBeginningBalance {
  id                Int       @id @default(autoincrement())
  companyId         Int?
  branchId          Int?
  userId            Int?
  itemId            Int
  warehouseId       Int?
  financialYearId   Int?
  balanceDate       DateTime  @db.Date
  openingQuantity   Decimal   @db.Decimal(15, 4)
  uomId             Int?
  unitCost          Decimal   @db.Decimal(15, 4)
  totalValue        Decimal?  @db.Decimal(15, 2)
  valuationMethod   String?   @db.VarChar(50)
  batchNumber       String?   @db.VarChar(100)
  expiryDate        DateTime? @db.Date
  manufactureDate   DateTime? @db.Date
  journalEntryId    Int?
  status            String    @default("draft") @db.VarChar(20)
  approvedAt        DateTime?
  approvedById      Int?
  postedAt          DateTime?
  sourceSystem      String?
  sourceReference   String?
  notes             String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  item      Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  uom       UnitOfMeasure? @relation(fields: [uomId], references: [id], onDelete: SetNull)

  @@unique([itemId, warehouseId, financialYearId, batchNumber])
  @@index([status])
  @@index([balanceDate])
  @@index([status, financialYearId])
  @@map("inv_item_beginning_balances")
}

model BinItemAssignment {
  id                     Int       @id @default(autoincrement())
  binLocationId          Int
  itemId                 Int
  stockBatchId           Int?
  quantity               Decimal   @db.Decimal(15, 4)
  allocatedQuantity      Decimal   @default(0) @db.Decimal(15, 4)
  assignmentType         String    @default("storage") @db.VarChar(30) // storage, pick_face, reserve, staging
  isPrimary              Boolean   @default(false)
  minQuantity            Decimal?  @db.Decimal(15, 4)
  maxQuantity            Decimal?  @db.Decimal(15, 4)
  replenishmentQuantity  Decimal?  @db.Decimal(15, 4)
  lastMovementAt         DateTime?
  lastMovementType       String?   @db.VarChar(50)
  lastCountedBy          Int?
  lastCountedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  binLocation BinLocation @relation(fields: [binLocationId], references: [id], onDelete: Cascade)
  stockBatch  StockBatch? @relation(fields: [stockBatchId], references: [id], onDelete: SetNull)

  @@unique([binLocationId, itemId, stockBatchId])
  @@index([itemId, isPrimary])
  @@index([assignmentType])
  @@map("inv_bin_item_assignments")
}

// ============================================================================
// INVENTORY MODULE - Settings
// ============================================================================

model InvSettings {
  id                            Int       @id @default(autoincrement())
  companyId                     Int       @unique
  defaultCostingMethod          String    @default("FIFO")
  allowNegativeStock            Boolean   @default(false)
  negativeStockPolicy           String    @default("Block")
  allowBackdatedMovements       Boolean   @default(false)
  maxBackdateDays               Int       @default(30)
  enableBatchTracking           Boolean   @default(true)
  enableSerialTracking          Boolean   @default(false)
  enableExpiryTracking          Boolean   @default(true)
  enableBinLocations            Boolean   @default(true)
  enableQualityInspection       Boolean   @default(false)
  autoPostMovements             Boolean   @default(false)
  // Item Defaults
  defaultTrackInventory         Boolean   @default(true)
  defaultBatchControl           Boolean   @default(false)
  defaultSerialControl          Boolean   @default(false)
  // Alerts
  enableLowStockAlerts          Boolean   @default(true)
  lowStockAlertThreshold        Decimal?  @db.Decimal(10, 2)
  enableExpiryAlerts            Boolean   @default(true)
  defaultExpiryAlertDays        Int       @default(30)
  lowStockAlertDays             Int       @default(7)
  expiryAlertDays               Int       @default(30)
  enableReorderAlerts           Boolean   @default(true)
  // Batch & Serial
  batchNumberGeneration         String    @default("Manual")
  batchNumberPrefix             String?   @default("BAT")
  batchNumberLength             Int       @default(8)
  batchNumberFormat             String?   @db.VarChar(100)
  serialNumberPrefix            String?   @db.VarChar(20)
  serialNumberFormat            String?   @db.VarChar(100)
  // Approvals
  requireApprovalForAdjustments Boolean   @default(true)
  adjustmentApprovalThreshold   Decimal?  @db.Decimal(15, 2)
  requireApprovalForTransfers   Boolean   @default(false)
  transferApprovalThreshold     Decimal?  @db.Decimal(15, 2)
  // ISR
  enableIsrWorkflow             Boolean   @default(false)
  requireIsrHodApproval         Boolean   @default(false)
  requireIsrAuditApproval       Boolean   @default(false)
  isrNumberPrefix               String?   @db.VarChar(20)
  // Other
  defaultWarehouseId            Int?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@map("inv_settings")
}

model InvWarehouseSettings {
  id                     Int       @id @default(autoincrement())
  warehouseId            Int
  companyId              Int
  allowNegativeStock     Boolean   @default(false)
  requireBinLocation     Boolean   @default(false)
  enableFifo             Boolean   @default(true)
  enableFefo             Boolean   @default(false)
  enablePickingWaves     Boolean   @default(false)
  enablePutawayRules     Boolean   @default(false)
  defaultReceivingBinId  Int?
  defaultShippingBinId   Int?
  maxCapacity            Decimal?  @db.Decimal(15, 4)
  currentUtilization     Decimal?  @db.Decimal(5, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([companyId, warehouseId])
  @@map("inv_warehouse_settings")
}

model InvNumberSequence {
  id             Int       @id @default(autoincrement())
  companyId      Int
  sequenceType   String
  prefix         String
  suffix         String?
  nextNumber     Int       @default(1)
  numberLength   Int       @default(6)
  resetPeriod    String?
  lastResetDate  DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, sequenceType])
  @@map("inv_number_sequences")
}

// ============================================================================
// SALES MODULE - Settings & Areas
// ============================================================================

model SalesSetting {
  id        Int @id @default(autoincrement())
  companyId Int @unique

  // ============================================================================
  // 1. INVENTORY & STOCK SETTINGS (7 fields)
  // ============================================================================
  allowNegativeStock        Boolean @default(false)
  strictStockValidation     Boolean @default(true)
  requireWarehouseSelection Boolean @default(true)
  reserveStockOnOrder       Boolean @default(false)
  autoAllocateStock         Boolean @default(false)
  checkStockOnOrder         Boolean @default(true)
  checkStockOnDelivery      Boolean @default(true)

  // ============================================================================
  // 2. WORKFLOW SETTINGS (16 fields)
  // ============================================================================
  requireSalesOrder            Boolean @default(false)
  allowDirectInvoice           Boolean @default(true)
  requireCustomerPoNumber      Boolean @default(false)
  requireDeliveryBeforeInvoice Boolean @default(false)
  requireDeliveryNote          Boolean @default(false)
  requireOrderApproval         Boolean @default(false)
  allowOrderEditAfterApproval  Boolean @default(true)
  autoApproveOrder             Boolean @default(true)
  autoCloseOrderOnFullDelivery Boolean @default(true)
  allowPartialDelivery         Boolean @default(true)
  allowPartialInvoicing        Boolean @default(true)
  requireCustomerOrder         Boolean @default(false)
  allowQuoteToOrder            Boolean @default(true)
  allowOrderToDelivery         Boolean @default(true)
  allowDeliveryToInvoice       Boolean @default(true)
  allowOverDelivery            Boolean @default(false)
  autoCreateInvoice            Boolean @default(false)
  requireDeliveryApproval      Boolean @default(false)
  requireInvoiceApproval       Boolean @default(false)
  requireLoadingOrder              Boolean @default(false)
  requireLoadingOrderApproval      Boolean @default(false)
  requireInspectionBeforeDispatch  Boolean @default(true)
  autoDispatchOnInspectionPass     Boolean @default(true)
  inspectionQcOfficerIds           Json?
  inspectionAuditOfficerIds        Json?
  inspectionApprovalMode           String  @default("any") // "any" = one from each category, "all" = all officers
  inspectionChecklist              Json?
  requireDeliveryAddress           Boolean @default(false)

  // ============================================================================
  // 3. APPROVAL SETTINGS (5 fields)
  // ============================================================================
  autoApproveBelowAmount Decimal? @db.Decimal(15, 2)
  lockApprovedOrders     Boolean  @default(false)

  // ============================================================================
  // 4. PRICING & DISCOUNT SETTINGS (12 fields)
  // ============================================================================
  allowPriceOverride               Boolean  @default(true)
  priceOverrideRequiresApproval    Boolean  @default(false)
  requireApprovalForPriceOverride  Boolean  @default(false)
  maxDiscountPercentage            Decimal  @default(10.00) @db.Decimal(5, 2)
  discountRequiresApproval         Boolean  @default(false)
  requireDiscountApproval          Boolean  @default(false)
  allowLineItemDiscount            Boolean  @default(true)
  allowOrderLevelDiscount          Boolean  @default(true)
  allowManualDiscount              Boolean  @default(true)
  allowZeroPrice                   Boolean  @default(false)
  defaultPriceListId               Int?
  defaultPriceList                 String?
  pricesIncludeTax                 Boolean  @default(false)
  allowDiscountOnDiscounted        Boolean  @default(false)
  minOrderAmount                   Decimal? @db.Decimal(15, 2)
  maxOrderAmount                   Decimal? @db.Decimal(15, 2)
  minimumOrderAmount               Decimal? @db.Decimal(15, 2)
  maximumOrderAmount               Decimal? @db.Decimal(15, 2)
  applyPromotionalPrices           Boolean  @default(false)
  applyQuantityDiscounts           Boolean  @default(false)

  // ============================================================================
  // 5. CUSTOMER SETTINGS (12 fields)
  // ============================================================================
  enforceCreditLimit             Boolean @default(false)
  allowCreditLimitOverride       Boolean @default(true)
  creditOverrideRequiresApproval Boolean @default(false)
  defaultCreditTerms             Int     @default(30)
  defaultPaymentTerms            String? @default("Net 30")
  blockOrdersOnOverdueInvoices   Boolean @default(false)
  overdueToleranceDays           Int     @default(0)
  allowOnHoldCustomers           Boolean @default(false)
  checkOverdueInvoices           Boolean @default(false)
  requireCustomerCreditCheck     Boolean @default(false)
  allowCustomerPriceOverride     Boolean @default(false)
  requireCustomerApproval        Boolean @default(false)
  validateCustomerCreditLimit    Boolean @default(false)

  // ============================================================================
  // 6. RETURNS & CANCELLATIONS (8 fields)
  // ============================================================================
  allowReturns                   Boolean @default(true)
  returnWindowDays               Int     @default(30)
  returnRequiresApproval         Boolean @default(true)
  requireReturnApproval          Boolean @default(true)
  autoIssueCreditmemo            Boolean @default(false)
  requireApprovalForCancellation Boolean @default(false)
  allowPartialReturns            Boolean @default(true)
  allowSalesReturns              Boolean @default(true)
  allowOrderCancellation         Boolean @default(true)
  cancellationReasonRequired     Boolean @default(false)

  // ============================================================================
  // 7. TAX SETTINGS (10 fields)
  // ============================================================================
  defaultVatId                    Int?
  defaultVatRate                  Decimal @default(7.50) @db.Decimal(5, 2)
  defaultWhtId                    Int?
  defaultWhtRate                  Decimal @default(0) @db.Decimal(5, 2)
  calculateTaxAutomatically       Boolean @default(true)
  autoCalculateTax                Boolean @default(true)
  applyWhtOnInvoice               Boolean @default(false)
  applyWithholdingTax             Boolean @default(false)
  // Cash-basis VAT (Nigerian VAT Act default). "accrual" = post VAT to payable on invoice;
  // "cash" = post VAT to a holding account on invoice, transfer to payable when receipt allocates.
  vatBasis                        String  @default("accrual")
  // GL account to hold deferred VAT when vatBasis='cash'. Transfers to VAT Output Payable on receipt.
  vatOutputHoldingAccountId       Int?
  applyTaxInclusive               Boolean @default(false)
  separateTaxLineItems            Boolean @default(false)
  requireTaxExemptionCertificate  Boolean @default(false)
  generatePdfOnApproval           Boolean @default(false)

  // ============================================================================
  // 8. DOCUMENT NUMBERING (17 fields)
  // ============================================================================
  orderNumberFormat     String @default("SO-{YEAR}-{SEQUENCE}")
  deliveryNoteFormat    String @default("DN-{YEAR}-{SEQUENCE}")
  invoiceNumberFormat   String @default("INV-{YEAR}-{SEQUENCE}")
  returnNumberFormat    String @default("RET-{YEAR}-{SEQUENCE}")
  creditNoteFormat      String @default("CN-{YEAR}-{SEQUENCE}")
  quotationNumberFormat String @default("QT-{YEAR}-{SEQUENCE}")
  loadingOrderFormat    String @default("LO-{YEAR}-{SEQUENCE}")
  loadingOrderNumberFormat String @default("LO-{YEAR}-{SEQUENCE}")
  proformaInvoiceFormat String @default("PI-{YEAR}-{SEQUENCE}")
  sequencePadding       Int    @default(5)
  orderPrefix           String @default("SO")
  deliveryPrefix        String @default("DN")
  invoicePrefix         String @default("INV")
  returnPrefix          String @default("RET")
  creditNotePrefix      String @default("CN")
  quotationPrefix       String @default("QT")
  loadingOrderPrefix    String @default("LO")
  proformaPrefix        String @default("PI")

  // ============================================================================
  // 9. NOTIFICATIONS (11 fields)
  // ============================================================================
  autoSendOrderConfirmation Boolean @default(false)
  autoSendInvoice           Boolean @default(false)
  autoSendDeliveryNote      Boolean @default(false)
  notifyLowStockOnOrder     Boolean @default(false)
  notifyOnOrderCreated      Boolean @default(false)
  notifyOnOrderApproved     Boolean @default(false)
  notifyOnDeliveryCreated   Boolean @default(false)
  notifyLowStock            Boolean @default(false)
  emailOrderConfirmation    Boolean @default(false)
  emailDeliveryNote         Boolean @default(false)
  emailInvoice              Boolean @default(false)

  // ============================================================================
  // 10. COMMISSION SETTINGS (8 fields)
  // ============================================================================
  calculateCommission        Boolean @default(false)
  defaultCommissionRate      Decimal @default(5.00) @db.Decimal(5, 2)
  commissionBasis            String  @default("net_sale") // net_sale, gross_sale, margin
  commissionPaidOn           String  @default("payment") // invoice, payment
  commissionOnPayment        Boolean @default(true)
  commissionExpenseAccountId Int? // GL account for commission expense (P&L)
  commissionPayableAccountId Int? // GL account for commission payable (Liability)

  // ============================================================================
  // 11. PAYMENT SETTINGS (6 fields)
  // ============================================================================
  requireDeposit               Boolean  @default(false)
  defaultDepositPercentage     Decimal  @default(0) @db.Decimal(5, 2)
  requirePaymentTerms          Boolean  @default(false)
  allowPartialPayments         Boolean  @default(true)
  paymentTermsApprovalRequired Boolean  @default(false)

  // ============================================================================
  // 12. QUOTATION SETTINGS (3 fields)
  // ============================================================================
  quotationValidityDays    Int     @default(30)
  quoteValidityDays        Int     @default(30)
  autoExpireQuotations     Boolean @default(false)
  requireQuotationApproval Boolean @default(false)

  // ============================================================================
  // 13. PROFORMA INVOICE SETTINGS (2 fields)
  // ============================================================================
  requireProformaInvoice Boolean @default(false)
  proformaValidityDays   Int     @default(30)

  // ============================================================================
  // 14. DOCUMENT SETTINGS (7 fields)
  // ============================================================================
  printCompanyLogo          Boolean @default(true)
  printCompanyAddress       Boolean @default(true)
  printTermsAndConditions   Boolean @default(true)
  defaultTermsAndConditions String? @db.Text
  defaultDeliveryTerms      String? @db.Text
  emailInvoiceOnCreate      Boolean @default(false)
  emailDeliveryNoteOnCreate Boolean @default(false)

  // ============================================================================
  // 15. INTEGRATION SETTINGS (5 fields)
  // ============================================================================
  autoPostToGL                Boolean @default(false)
  defaultSalesAccountId       Int?
  defaultReceivablesAccountId Int?
  defaultDiscountAccountId    Int?
  defaultReturnAccountId      Int?

  // ============================================================================
  // 16. MISCELLANEOUS (4 fields)
  // ============================================================================
  trackSalesByProject Boolean @default(false)
  allowBackorders     Boolean @default(false)
  allowZeroCost            Boolean @default(false)
  blockBelowCostSelling    Boolean @default(false)

  // ============================================================================
  // TIMESTAMPS
  // ============================================================================
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company                  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commissionExpenseAccount IfrsAccount? @relation("CommissionExpense", fields: [commissionExpenseAccountId], references: [id], onDelete: SetNull)
  commissionPayableAccount IfrsAccount? @relation("CommissionPayable", fields: [commissionPayableAccountId], references: [id], onDelete: SetNull)

  @@map("sales_settings")
}

model SalesInspectionOfficer {
  id         Int      @id @default(autoincrement())
  companyId  Int
  employeeId Int
  role       String   // 'quality_control' | 'inspection_officer'
  branchIds  Json?    // null = all branches; [1, 2] = specific branches
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation("SalesInspectionOfficerCompany", fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation("SalesInspectionOfficerEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("sales_inspection_officers")
}

model SalesArea {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  code        String?
  description String?
  managerId   Int? // Employee who manages this area
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager Employee? @relation(fields: [managerId], references: [id], onDelete: SetNull)

  salesOrders      SalesOrder[]
  customerBranches CustomerBranch[]
  customers        Customer[]       @relation("CustomerSalesArea")

  // Commission & Sales Reps
  commissionRules CommissionRule[]
  salesReps       SalesRep[]       @relation("SalesRepArea")

  @@unique([companyId, code])
  @@map("sales_areas")
}

// ============================================================================
// SALES MODULE - Orders, Deliveries, Invoices
// ============================================================================

model SalesOrder {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  customerId           Int
  customerBranchId     Int?
  salesAreaId          Int?
  orderNumber          String
  orderDate            DateTime  @db.Date
  deliveryDate         DateTime? @db.Date
  expectedDeliveryDate DateTime? @db.Date
  currencyId           Int?
  exchangeRate         Decimal?  @db.Decimal(15, 6)
  subtotal             Decimal   @db.Decimal(15, 2)
  taxAmount            Decimal   @db.Decimal(15, 2)
  discountAmount       Decimal?  @db.Decimal(15, 2)
  totalAmount          Decimal   @db.Decimal(15, 2)
  status               String    @default("draft") // draft, pending, confirmed, partially_delivered, delivered, invoiced, cancelled
  paymentTerms         String?
  shippingAddress      String?   @db.Text
  notes                String?   @db.Text
  internalNotes        String?   @db.Text
  createdBy            Int?
  approvedBy           Int?
  approvedAt           DateTime?
  cancelledAt          DateTime?
  cancelledBy          Int?
  cancellationReason   String?   @db.Text
  branchId             Int?
  entityId             Int?
  customerPoNumber     String?
  salesRepId           Int?
  warehouseId          Int?
  priority             String    @default("normal") // low, normal, high, urgent
  invoiceStatus        String?   // not_invoiced, partially_invoiced, fully_invoiced
  termsConditions      String?   @db.Text
  submittedAt          DateTime?
  reference            String?
  proformaInvoiceId    Int?      // source proforma that was converted to this order
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id])
  customerBranch CustomerBranch? @relation(fields: [customerBranchId], references: [id], onDelete: SetNull)
  salesArea      SalesArea?      @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)
  currency       IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation("SalesOrderBranch", fields: [branchId], references: [id], onDelete: SetNull)
  entity         IfrsEntity?     @relation("SalesOrderEntity", fields: [entityId], references: [id], onDelete: SetNull)
  salesRep       SalesRep?       @relation("SalesOrderRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?      @relation("SalesOrderWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  lines         SalesOrderLine[]
  deliveries    SalesDelivery[]
  invoices      SalesInvoice[]
  loadingOrders LoadingOrder[]

  @@unique([companyId, orderNumber])
  @@index([customerId])
  @@index([orderDate])
  @@index([status])
  @@index([branchId])
  @@index([salesRepId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id              Int      @id @default(autoincrement())
  salesOrderId    Int
  itemId          Int
  lineNumber      Int?
  description     String?
  quantity        Decimal  @db.Decimal(15, 3)
  unitPrice       Decimal  @db.Decimal(15, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(15, 2)
  uomId           Int?
  vatId           Int?
  taxPercent      Decimal? @db.Decimal(5, 2)
  taxAmount       Decimal? @db.Decimal(15, 2)
  lineTotal       Decimal  @db.Decimal(15, 2)
  lineStatus      String   @default("open") // open, partially_delivered, delivered, invoiced, cancelled
  deliveredQty    Decimal  @default(0) @db.Decimal(15, 3)
  invoicedQty     Decimal  @default(0) @db.Decimal(15, 3)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
  uom        UnitOfMeasure? @relation("SalesOrderLineUom", fields: [uomId], references: [id], onDelete: SetNull)
  vat        IfrsVat?      @relation("SalesOrderLineVat", fields: [vatId], references: [id], onDelete: SetNull)

  deliveryLines     SalesDeliveryLine[]
  invoiceLines      SalesInvoiceLine[]
  loadingOrderLines LoadingOrderLine[]

  @@index([salesOrderId])
  @@index([itemId])
  @@map("sales_order_lines")
}

model SalesDelivery {
  id               Int       @id @default(autoincrement())
  companyId        Int
  salesOrderId     Int
  customerId       Int
  customerBranchId Int?
  warehouseId      Int?
  branchId         Int?
  entityId         Int?
  driverId         Int?
  deliveryNumber   String
  deliveryDate     DateTime  @db.Date
  deliveryTime     DateTime?
  status           String    @default("draft") // draft, pending, dispatched, delivered, cancelled
  shippingAddress  String?   @db.Text
  driverName       String?
  vehicleNumber    String?
  notes            String?   @db.Text
  receivedBy           String?
  receivedByEmployeeId Int?
  receivedAt           DateTime?
  journalEntryId       Int?
  createdBy            Int?
  approvedBy       Int?
  approvedAt       DateTime?
  submittedAt      DateTime?
  dispatchedBy     Int?
  dispatchedAt     DateTime?
  // Auto-invoice failure surface. When confirmDelivery triggers auto-invoice
  // and the call throws, we store the reason here so it shows in the UI
  // instead of being silently logged to the backend. NULL means success or
  // not yet attempted.
  autoInvoiceError      String?   @db.Text
  autoInvoiceAttemptedAt DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder      @relation(fields: [salesOrderId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  customerBranch CustomerBranch? @relation(fields: [customerBranchId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation("SalesDeliveryBranch", fields: [branchId], references: [id], onDelete: SetNull)
  entity         IfrsEntity?     @relation("SalesDeliveryEntity", fields: [entityId], references: [id], onDelete: SetNull)
  driver         Employee?       @relation("SalesDeliveryDriver", fields: [driverId], references: [id], onDelete: SetNull)

  lines    SalesDeliveryLine[]
  invoices SalesInvoice[]      @relation("SalesInvoiceDelivery")

  @@unique([companyId, deliveryNumber])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([deliveryDate])
  @@index([branchId])
  @@map("sales_deliveries")
}

model SalesDeliveryLine {
  id               Int      @id @default(autoincrement())
  salesDeliveryId  Int
  salesOrderLineId Int
  itemId           Int
  lineNumber       Int?
  description      String?
  quantity         Decimal  @db.Decimal(15, 3)
  unitCost         Decimal? @db.Decimal(15, 2)
  uomId            Int?
  batchNumber      String?
  serialNumbers    Json?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  salesDelivery  SalesDelivery  @relation(fields: [salesDeliveryId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  item           Item           @relation(fields: [itemId], references: [id])
  uom            UnitOfMeasure? @relation("SalesDeliveryLineUom", fields: [uomId], references: [id], onDelete: SetNull)

  invoiceLines SalesInvoiceLine[]

  @@index([salesDeliveryId])
  @@map("sales_delivery_lines")
}

model SalesInvoice {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  salesOrderId           Int?
  salesDeliveryId        Int?
  customerId             Int
  currencyId             Int?
  branchId               Int?
  entityId               Int?
  customerBranchId       Int?
  salesRepId             Int?
  warehouseId            Int?
  loadingOrderId         Int?
  // Optional link back to a fleet booking. Populated when the invoice
  // (proforma or final) was generated from a vehicle booking. The
  // ProformaForBooking relation lets us list "all proformas for this booking".
  vehicleBookingId       Int?
  invoiceNumber          String
  invoiceDate            DateTime  @db.Date
  dueDate                DateTime  @db.Date
  expectedDeliveryDate   DateTime? @db.Date
  invoiceType            String    @default("direct") // direct, order_based, proforma, credit_note
  exchangeRate           Decimal?  @db.Decimal(15, 6)
  subtotal               Decimal   @db.Decimal(15, 2)
  taxAmount              Decimal   @db.Decimal(15, 2)
  discountAmount         Decimal?  @db.Decimal(15, 2)
  withholdingTaxAmount   Decimal   @default(0) @db.Decimal(15, 2)
  transportation         Decimal   @default(0) @db.Decimal(15, 2)
  // Stamped from sales_settings.vatBasis at invoice creation. Determines whether VAT posts
  // to Output Payable (accrual) or Output Holding (cash) on posting.
  vatBasis               String    @default("accrual")
  totalAmount            Decimal   @db.Decimal(15, 2)
  paidAmount             Decimal   @default(0) @db.Decimal(15, 2)
  balanceAmount          Decimal   @db.Decimal(15, 2)
  status                 String    @default("draft") // draft, pending, sent, partial, paid, overdue, cancelled
  paymentStatus          String    @default("unpaid") // unpaid, partial, paid, overpaid
  paymentTerms           String?
  priority               String?   // low, normal, high, urgent
  deliveryAddress        String?   @db.Text
  termsConditions        String?   @db.Text
  notes                  String?   @db.Text
  internalNotes          String?   @db.Text
  reference              String?
  createdBy              Int?
  approvedBy             Int?
  approvedAt             DateTime?
  approvalComment        String?   @db.Text
  sentAt                 DateTime?
  paidAt                 DateTime?
  postedAt               DateTime?
  cancelledAt            DateTime?
  cancelledBy            Int?
  cancellationReason     String?   @db.Text
  journalEntryId         Int?
  clientInvoiceId        Int?
  updatedBy              Int?
  convertedOrderId       Int?      // sales order created when this proforma was converted
  validUntil             DateTime? @db.Date  // proforma validity date
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesDelivery  SalesDelivery?  @relation("SalesInvoiceDelivery", fields: [salesDeliveryId], references: [id], onDelete: SetNull)
  customer       Customer        @relation(fields: [customerId], references: [id])
  currency       IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation("SalesInvoiceBranch", fields: [branchId], references: [id], onDelete: SetNull)
  entity         IfrsEntity?     @relation("SalesInvoiceEntity", fields: [entityId], references: [id], onDelete: SetNull)
  customerBranch CustomerBranch? @relation("SalesInvoiceCustomerBranch", fields: [customerBranchId], references: [id], onDelete: SetNull)
  salesRep       SalesRep?       @relation("SalesInvoiceRep", fields: [salesRepId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?      @relation("SalesInvoiceWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  loadingOrder   LoadingOrder?   @relation("SalesInvoiceLoadingOrder", fields: [loadingOrderId], references: [id], onDelete: SetNull)
  vehicleBooking VehicleBooking? @relation("ProformaForBooking", fields: [vehicleBookingId], references: [id], onDelete: SetNull)

  lines    SalesInvoiceLine[]
  payments InvoicePayment[]

  // Receivables
  receipts ReceiptAllocation[]

  // POS
  posPaymentAllocations PosPaymentAllocation[]

  // Commission
  commissionCalculations CommissionCalculation[]

  @@unique([companyId, invoiceNumber])
  // One invoice per delivery. PostgreSQL treats NULLs as distinct, so many
  // invoices can still have a NULL salesDeliveryId (invoices not created from
  // a delivery) — this only constrains the "one real delivery → one invoice"
  // rule, which is the invariant that was being violated in the wild.
  @@unique([companyId, salesDeliveryId])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([branchId])
  @@index([salesRepId])
  @@index([paymentStatus])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id                   Int      @id @default(autoincrement())
  salesInvoiceId       Int
  salesOrderLineId     Int?
  loadingOrderLineId   Int?
  salesDeliveryLineId  Int?
  itemId               Int
  lineNumber           Int?
  description          String?
  quantity             Decimal  @db.Decimal(15, 3)
  unitPrice            Decimal  @db.Decimal(15, 2)
  discountPercent      Decimal? @db.Decimal(5, 2)
  discountAmount       Decimal? @db.Decimal(15, 2)
  uomId                Int?
  vatId                Int?
  taxPercent           Decimal? @db.Decimal(5, 2)
  taxAmount            Decimal? @db.Decimal(15, 2)
  withholdingTaxRate   Decimal? @db.Decimal(5, 2)
  withholdingTaxAmount Decimal? @db.Decimal(15, 2)
  lineTotal            Decimal  @db.Decimal(15, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  salesInvoice      SalesInvoice       @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesOrderLine    SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  item              Item               @relation(fields: [itemId], references: [id])
  vat               IfrsVat?           @relation(fields: [vatId], references: [id], onDelete: SetNull)
  uom               UnitOfMeasure?     @relation("SalesInvoiceLineUom", fields: [uomId], references: [id], onDelete: SetNull)
  loadingOrderLine  LoadingOrderLine?  @relation("InvoiceLineLoadingOrderLine", fields: [loadingOrderLineId], references: [id], onDelete: SetNull)
  salesDeliveryLine SalesDeliveryLine? @relation(fields: [salesDeliveryLineId], references: [id], onDelete: SetNull)
  commissionCalculations CommissionCalculation[]

  @@index([salesInvoiceId])
  @@map("sales_invoice_lines")
}

model InvoicePayment {
  id              Int       @id @default(autoincrement())
  salesInvoiceId  Int
  companyId       Int?
  paymentMethodId Int?
  bankId          Int?
  amount          Decimal   @db.Decimal(15, 2)
  transactionFee  Decimal?  @db.Decimal(15, 2)
  totalAmount     Decimal?  @db.Decimal(15, 2)
  paymentDate     DateTime  @db.Date
  paymentMethod   String
  reference       String?
  notes           String?
  status          String    @default("pending") // pending, confirmed, reversed, cancelled
  approvalStatus  String?   // pending, approved, rejected
  approvedBy      Int?
  approvedAt      DateTime?
  approvalNotes   String?   @db.Text
  createdBy       Int?
  updatedBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  salesInvoice      SalesInvoice   @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  paymentMethodRef  PaymentMethod? @relation("InvoicePaymentMethod", fields: [paymentMethodId], references: [id], onDelete: SetNull)
  bank              Bank?          @relation("InvoicePaymentBank", fields: [bankId], references: [id], onDelete: SetNull)

  // Commission
  commissionCalculations CommissionCalculation[]

  @@index([salesInvoiceId])
  @@index([status])
  @@map("invoice_payments")
}

// ============================================================================
// SALES MODULE - Loading Orders
// ============================================================================

model LoadingOrder {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  salesOrderId         Int
  branchId             Int?
  entityId             Int?
  warehouseId          Int?
  loadingNumber        String
  loadingDate          DateTime  @db.Date
  vehicleId            Int?
  driverId             Int?
  status               String    @default("draft") // draft, loading, loaded, dispatched, delivered, cancelled
  loadingInstructions  String?   @db.Text
  totalQuantityOrdered Decimal?  @db.Decimal(15, 3)
  totalQuantityLoaded  Decimal?  @db.Decimal(15, 3)
  notes                String?   @db.Text
  vehicleNumber        String?
  driverName           String?
  driverPhone          String?
  loadedBy             Int?
  loadedAt             DateTime?
  completedAt          DateTime?
  dispatchedBy         Int?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  createdBy            Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesOrder    SalesOrder  @relation(fields: [salesOrderId], references: [id])
  vehicle       Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver        Employee?   @relation("LoadingOrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  branch        Branch?     @relation("LoadingOrderBranch", fields: [branchId], references: [id], onDelete: SetNull)
  entity        IfrsEntity? @relation("LoadingOrderEntity", fields: [entityId], references: [id], onDelete: SetNull)
  warehouse     Warehouse?  @relation("LoadingOrderWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  lines    LoadingOrderLine[]
  invoices SalesInvoice[]    @relation("SalesInvoiceLoadingOrder")

  inspectionStatus      String    @default("pending") // pending, in_progress, completed, failed
  loadingInspectionId   Int?

  @@unique([companyId, loadingNumber])
  @@index([salesOrderId])
  @@index([loadingDate])
  @@index([branchId])
  @@map("loading_orders")
}

model LoadingInspection {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  loadingOrderId       Int
  inspectionNumber     String    @unique
  permitNo             String?
  inspectionDate       DateTime  @default(now()) @db.Date
  status               String    @default("pending") // pending, in_progress, completed, failed
  overallResult        String    @default("pending") // pending, passed, failed
  vehicleRegNo         String?
  driverName           String?
  driverPhone          String?
  salesRepName         String?
  productDestination   String?
  checklist            Json?
  notes                String?   @db.Text
  completionNotes      String?   @db.Text
  submittedById        Int?
  submittedAt          DateTime?
  completedById        Int?
  completedAt          DateTime?
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  officers LoadingInspectionOfficer[]

  @@index([loadingOrderId])
  @@index([companyId])
  @@map("loading_inspections")
}

model LoadingInspectionOfficer {
  id                     Int       @id @default(autoincrement())
  loadingInspectionId    Int
  employeeId             Int
  role                   String    @default("quality_control") // quality_control, inspection_officer
  status                 String    @default("pending") // pending, completed
  result                 String    @default("pending") // pending, approved, rejected
  signature              String?   @db.Text
  comments               String?   @db.Text
  stampedAt              DateTime?
  completedAt            DateTime?
  actedAt                DateTime?
  assignedAt             DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  inspection LoadingInspection @relation(fields: [loadingInspectionId], references: [id], onDelete: Cascade)

  @@unique([loadingInspectionId, employeeId])
  @@map("loading_inspection_officers")
}

model LoadingOrderLine {
  id               Int      @id @default(autoincrement())
  loadingOrderId   Int
  salesOrderLineId Int
  itemId           Int
  lineNumber       Int?
  description      String?
  orderedQuantity  Decimal  @db.Decimal(15, 3)
  loadedQuantity   Decimal? @db.Decimal(15, 3)
  unitPrice        Decimal? @db.Decimal(15, 2)
  discountPercent  Decimal? @db.Decimal(5, 2)
  discountAmount   Decimal? @db.Decimal(15, 2)
  vatId            Int?
  uomId            Int?
  taxAmount        Decimal? @db.Decimal(15, 2)
  lineTotal        Decimal? @db.Decimal(15, 2)
  lineStatus       String?  @default("pending") // pending, partially_loaded, loaded, invoiced
  quantityInvoiced Decimal? @db.Decimal(15, 3)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  loadingOrder   LoadingOrder   @relation(fields: [loadingOrderId], references: [id], onDelete: Cascade)
  salesOrderLine SalesOrderLine @relation(fields: [salesOrderLineId], references: [id])
  item           Item           @relation(fields: [itemId], references: [id])
  vat            IfrsVat?       @relation("LoadingOrderLineVat", fields: [vatId], references: [id], onDelete: SetNull)
  uom            UnitOfMeasure? @relation("LoadingOrderLineUom", fields: [uomId], references: [id], onDelete: SetNull)

  invoiceLines SalesInvoiceLine[] @relation("InvoiceLineLoadingOrderLine")

  @@index([loadingOrderId])
  @@map("loading_order_lines")
}

// ============================================================================
// SALES FORECASTING
// ============================================================================

model SalesForecast {
  id              Int       @id @default(autoincrement())
  companyId       Int
  itemId          Int?
  period          String?   // e.g. "2026-Q1", "2026-01"
  forecastDate    DateTime? @db.Date
  forecastQty     Decimal?  @db.Decimal(15, 3)
  actualQty       Decimal?  @db.Decimal(15, 3)
  variance        Decimal?  @db.Decimal(15, 3)
  method          String?   // moving_average, exponential_smoothing, manual
  confidenceLevel Decimal?  @db.Decimal(5, 2)
  notes           String?   @db.Text
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([itemId])
  @@index([period])
  @@map("sales_forecasts")
}

// ============================================================================
// SALES COMMISSION MODULE
// ============================================================================

model CommissionRule {
  id             Int       @id @default(autoincrement())
  companyId      Int
  salesRepId     Int?      // If null, applies to all sales reps
  salesAreaId    Int?      // If specified, only for this area
  customerId     Int?      // If specified, only for this customer
  itemCategoryId Int?      // If specified, only for items in this category
  rate           Decimal   @db.Decimal(5, 2) // Percentage (e.g., 5.00 for 5%)
  basis          String    @default("net_sale") // net_sale, gross_sale, margin
  paidOn         String    @default("payment") // invoice, payment
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  notes          String?   @db.Text
  // GL Account Mappings (optional, falls back to company SalesSetting defaults)
  commissionExpenseAccountId  Int?  // DR: Commission Expense (P&L)
  commissionPayableAccountId  Int?  // CR: Commission Payable (Liability)
  whtPayableAccountId         Int?  // CR: WHT Payable (Liability)
  createdBy      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep     SalesRep?     @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  salesArea    SalesArea?    @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  itemCategory ItemCategory? @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull)
  commissionExpenseAccount  IfrsAccount? @relation("CommRuleExpense", fields: [commissionExpenseAccountId], references: [id], onDelete: SetNull)
  commissionPayableAccount  IfrsAccount? @relation("CommRulePayable", fields: [commissionPayableAccountId], references: [id], onDelete: SetNull)
  whtPayableAccount         IfrsAccount? @relation("CommRuleWHT", fields: [whtPayableAccountId], references: [id], onDelete: SetNull)
  creator      User?         @relation("CommissionRuleCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  calculations CommissionCalculation[]

  @@index([companyId])
  @@index([salesRepId])
  @@index([salesAreaId])
  @@index([customerId])
  @@index([itemCategoryId])
  @@index([isActive])
  @@map("commission_rules")
}

model CommissionCalculation {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  salesRepId             Int
  commissionRuleId       Int?      // Which rule generated this calculation (legacy)
  itemCategoryId         Int?      // Which category generated this calculation
  beneficiaryType        String?   @db.VarChar(20) // sales_rep | customer
  customerId             Int?      // For customer-type commissions
  salesInvoiceId         Int?      // Commission source invoice
  salesInvoiceLineId     Int?      // Specific invoice line (for category-based)
  invoicePaymentId       Int?      // If paidOn = payment
  creditNoteId           Int?      // If clawback from credit note
  calculationDate        DateTime  @default(now())
  baseAmount             Decimal   @db.Decimal(15, 2) // Amount used for calculation
  commissionRate         Decimal   @db.Decimal(5, 2)  // Applied rate
  commissionAmount       Decimal   @db.Decimal(15, 2) // Calculated commission
  basis                  String    // net_sale, gross_sale, margin
  paidOn                 String    // invoice, payment
  status                 String    @default("pending") // pending, calculated, approved, paid, cancelled
  approvedBy             Int?
  approvedAt             DateTime?
  paidDate               DateTime?
  paymentJournalEntryId  Int?      // Link to GL posting
  clawbackFromId         Int?      // If this is reversing another calculation
  notes                  String?   @db.Text
  bankAccountId          Int?
  settlementCreditNoteId Int?
  createdBy              Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep            SalesRep         @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  commissionRule      CommissionRule?  @relation(fields: [commissionRuleId], references: [id], onDelete: SetNull)
  itemCategory        ItemCategory?    @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull)
  customer            Customer?        @relation("CommissionCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  salesInvoice        SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  salesInvoiceLine    SalesInvoiceLine? @relation(fields: [salesInvoiceLineId], references: [id], onDelete: SetNull)
  invoicePayment      InvoicePayment?  @relation(fields: [invoicePaymentId], references: [id], onDelete: SetNull)
  creditNote          CreditNote?      @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  approver            User?            @relation("CommissionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  paymentJournalEntry JournalEntry?    @relation(fields: [paymentJournalEntryId], references: [id], onDelete: SetNull)
  clawbackFrom        CommissionCalculation? @relation("CommissionClawback", fields: [clawbackFromId], references: [id], onDelete: SetNull)
  clawbacks           CommissionCalculation[] @relation("CommissionClawback")
  creator             User?            @relation("CommissionCalculationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  payableLines        CommissionPayableLine[]

  @@index([companyId])
  @@index([salesRepId])
  @@index([commissionRuleId])
  @@index([itemCategoryId])
  @@index([customerId])
  @@index([beneficiaryType])
  @@index([salesInvoiceId])
  @@index([salesInvoiceLineId])
  @@index([invoicePaymentId])
  @@index([creditNoteId])
  @@index([status])
  @@index([calculationDate])
  @@map("commission_calculations")
}

// ============================================================================
// SALES MODULE - Sales Representatives
// ============================================================================

model SalesRep {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  code                 String    @db.VarChar(20)
  firstName            String    @db.VarChar(100)
  lastName             String    @db.VarChar(100)
  email                String?   @db.VarChar(255)
  phone                String?   @db.VarChar(50)
  type                 String    @default("external") @db.VarChar(20) // internal, external
  employeeId           Int?      // Link to employee if internal (on payroll)

  // Commission defaults
  commissionRate       Decimal?  @db.Decimal(5, 2)  // Default rate %
  commissionBasis      String    @default("net_sale") @db.VarChar(20) // net_sale, gross_sale, margin
  commissionPaidOn     String    @default("payment") @db.VarChar(20) // invoice, payment
  paymentMethod        String    @default("payables") @db.VarChar(20) // payables, payroll (internal only)

  // Bank details (for external rep payments)
  bankName             String?   @db.VarChar(100)
  bankAccountNumber    String?   @db.VarChar(50)
  bankAccountName      String?   @db.VarChar(100)
  bankSortCode         String?   @db.VarChar(20)

  // Tax (WHT for external reps)
  taxId                String?   @db.VarChar(50) // TIN number
  whtRate              Decimal?  @db.Decimal(5, 2) // Withholding tax rate

  // Assignment
  salesAreaId          Int?
  managerId            Int?      // Self-ref for hierarchy (optional)

  // Meta
  isActive             Boolean   @default(true)
  notes                String?   @db.Text
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee  Employee?  @relation("SalesRepEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  salesArea SalesArea? @relation("SalesRepArea", fields: [salesAreaId], references: [id], onDelete: SetNull)
  manager   SalesRep?  @relation("SalesRepHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  creator   User?      @relation("SalesRepCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  // Reverse relations
  subordinates           SalesRep[]              @relation("SalesRepHierarchy")
  branches               SalesRepBranch[]
  customers              Customer[]              @relation("CustomerSalesRep")
  salesOrders            SalesOrder[]             @relation("SalesOrderRep")
  salesInvoices          SalesInvoice[]           @relation("SalesInvoiceRep")
  commissionRules        CommissionRule[]
  commissionCalculations CommissionCalculation[]
  commissionPayables     CommissionPayable[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([employeeId])
  @@index([salesAreaId])
  @@index([type])
  @@index([isActive])
  @@map("sales_reps")
}

model SalesRepBranch {
  id         Int      @id @default(autoincrement())
  salesRepId Int
  branchId   Int
  createdAt  DateTime @default(now())

  salesRep SalesRep @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  branch   Branch   @relation("SalesRepBranches", fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([salesRepId, branchId])
  @@map("sales_rep_branches")
}

// ============================================================================
// SALES MODULE - Commission Payables
// ============================================================================

model CommissionPayable {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  salesRepId           Int
  period               String    @db.VarChar(7)  // YYYY-MM
  payableNumber        String    @db.VarChar(50)
  totalGrossSales      Decimal   @default(0) @db.Decimal(15, 2)
  totalCommission      Decimal   @default(0) @db.Decimal(15, 2)
  whtAmount            Decimal   @default(0) @db.Decimal(15, 2)
  netPayable           Decimal   @default(0) @db.Decimal(15, 2)
  status               String    @default("pending") @db.VarChar(20) // pending, approved, paid, cancelled
  // Bank details snapshot
  bankName             String?   @db.VarChar(100)
  bankAccountNumber    String?   @db.VarChar(50)
  bankAccountName      String?   @db.VarChar(100)
  // Payment tracking
  approvedBy           Int?
  approvedAt           DateTime?
  paymentDate          DateTime?
  paymentReference     String?   @db.VarChar(100)
  journalEntryId       Int?
  notes                String?   @db.Text
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesRep      SalesRep      @relation(fields: [salesRepId], references: [id], onDelete: Cascade)
  approver      User?         @relation("CommissionPayableApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  journalEntry  JournalEntry? @relation("CommissionPayableJE", fields: [journalEntryId], references: [id], onDelete: SetNull)
  creator       User?         @relation("CommissionPayableCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  lines         CommissionPayableLine[]

  @@unique([companyId, payableNumber])
  @@index([companyId])
  @@index([salesRepId])
  @@index([period])
  @@index([status])
  @@map("commission_payables")
}

model CommissionPayableLine {
  id                       Int      @id @default(autoincrement())
  commissionPayableId      Int
  commissionCalculationId  Int
  invoiceNumber            String?  @db.VarChar(50)
  invoiceDate              DateTime? @db.Date
  baseAmount               Decimal  @db.Decimal(15, 2)
  commissionRate           Decimal  @db.Decimal(5, 2)
  commissionAmount         Decimal  @db.Decimal(15, 2)
  itemCategoryId           Int?     // Denormalized for reporting
  itemCategoryName         String?  @db.VarChar(255)
  createdAt                DateTime @default(now())

  // Relations
  commissionPayable     CommissionPayable     @relation(fields: [commissionPayableId], references: [id], onDelete: Cascade)
  commissionCalculation CommissionCalculation @relation(fields: [commissionCalculationId], references: [id], onDelete: Cascade)

  @@index([commissionPayableId])
  @@index([commissionCalculationId])
  @@map("commission_payable_lines")
}

// ============================================================================
// PURCHASE MODULE - Settings & Configuration
// ============================================================================

model PurchaseSetting {
  id        Int  @id @default(autoincrement())
  companyId Int  @unique
  userId    Int?

  // Workflow settings
  requireRequisition         Boolean  @default(false)
  requireRequisitionApproval Boolean  @default(false)
  requireRfq                 Boolean  @default(false)
  minimumRfqSuppliers        Int?
  requireQuotationComparison Boolean  @default(false)
  requirePoApproval          Boolean  @default(false)
  autoApproveBelowAmount     Decimal? @db.Decimal(15, 2)
  requireGrnInspection       Boolean  @default(false)
  allowOverReceipt           Boolean  @default(false)
  overReceiptTolerance       Decimal? @db.Decimal(5, 2)
  requireThreeWayMatch       Boolean  @default(false)
  matchTolerancePercentage   Decimal? @db.Decimal(5, 2)

  // Tax settings
  autoCalculateTax    Boolean @default(false)
  applyWithholdingTax Boolean @default(false)

  // Number formats
  requisitionNumberFormat String?
  rfqNumberFormat         String?
  poNumberFormat          String?
  grnNumberFormat         String?
  invoiceNumberFormat     String?
  sequencePadding         Int?

  // Defaults
  defaultPaymentTerms String?
  defaultVatId        Int?

  // Tax settings - extended
  defaultVatRate   Decimal? @db.Decimal(5, 2)
  defaultWhtRate   Decimal? @db.Decimal(5, 2)
  applyVatByDefault  Boolean @default(false)
  applyWhtByDefault  Boolean @default(false)

  // Extended settings
  allowDirectPo               Boolean  @default(true)
  allowPartialReceiving       Boolean  @default(true)
  requireApprovedSuppliers    Boolean  @default(false)
  priceVarianceThreshold      Decimal? @db.Decimal(5, 2)
  quantityTolerancePercentage Decimal? @db.Decimal(5, 2)

  // Document numbering - prefixes
  requisitionPrefix         String?
  rfqPrefix                 String?
  quotationPrefix           String?
  poPrefix                  String?
  grnPrefix                 String?
  inspectionPrefix          String?
  invoicePrefix             String?
  serviceOrderPrefix        String?
  serviceInspectionPrefix   String?
  certificatePrefix         String?
  returnPrefix              String?

  // Approval thresholds
  requisitionApprovalThreshold   Decimal? @db.Decimal(15, 2)
  poApprovalThreshold            Decimal? @db.Decimal(15, 2)
  requireRfqApproval             Boolean  @default(false)
  rfqApprovalThreshold           Decimal? @db.Decimal(15, 2)
  requireInvoiceApproval         Boolean  @default(false)
  invoiceApprovalThreshold       Decimal? @db.Decimal(15, 2)
  requireServiceOrderApproval    Boolean  @default(false)
  serviceOrderApprovalThreshold  Decimal? @db.Decimal(15, 2)

  // Quality Control - inspection specifics
  requireInspection                Boolean  @default(false)
  inspectionOfficerCount           Int?
  allowPartialDelivery             Boolean  @default(false)
  requireServiceInspection         Boolean  @default(false)
  serviceInspectionOfficerCount    Int?
  allowPartialServiceCompletion    Boolean  @default(false)
  inspectionAutoAssignOfficers     Boolean  @default(false)
  inspectionRequireAllOfficers     Boolean  @default(false)
  inspectionRequireSignature       Boolean  @default(false)
  inspectionQualityRatingType      String?

  // Notifications
  emailOnRequisitionSubmit   Boolean  @default(false)
  emailOnPOApproval          Boolean  @default(false)
  emailOnGRNReceive          Boolean  @default(false)
  emailOnInvoiceApproval     Boolean  @default(false)
  emailRecipients            String?
  autoSendPoToSupplier       Boolean  @default(false)
  autoSendRfqToSuppliers     Boolean  @default(false)

  // RFQ Settings
  defaultRfqValidityDays       Int?
  defaultQuotationValidityDays Int?
  allowMultipleQuotations      Boolean  @default(false)
  requireMinimumQuotations     Boolean  @default(false)
  minimumQuotationCount        Int?
  skipRfqForApprovedRequisitions Boolean @default(false)
  skipSupplierQuotation          Boolean @default(false)

  // Budget Control
  enableBudgetControl          Boolean  @default(false)
  budgetCheckLevel             String?
  allowOverBudget              Boolean  @default(false)
  overBudgetApprovalRequired   Boolean  @default(false)

  // Supplier Management
  requireSupplierApproval      Boolean  @default(false)
  supplierEvaluationEnabled    Boolean  @default(false)
  evaluationFrequencyMonths    Int?
  allowOnHoldSuppliers         Boolean  @default(false)
  checkSupplierBlacklist       Boolean  @default(false)

  // General
  defaultCurrency              String?
  fiscalYearStart              String?
  autoCloseCompletedPOs        Boolean  @default(false)
  poAutoCloseThresholdPercent  Decimal? @db.Decimal(5, 2)

  // Pricing Controls
  allowPriceOverride                Boolean  @default(false)
  requireApprovalForPriceOverride   Boolean  @default(false)
  maxDiscountPercentage             Decimal? @db.Decimal(5, 2)
  comparePricesToLastPurchase       Boolean  @default(false)

  // Payment Terms
  requirePrepayment                 Boolean  @default(false)
  defaultPrepaymentPercentage       Decimal? @db.Decimal(5, 2)
  earlyPaymentDiscountDays          Int?
  earlyPaymentDiscountPercentage    Decimal? @db.Decimal(5, 2)

  // Inventory/GRN Controls
  requireWarehouseSelection         Boolean  @default(false)
  reserveStockOnPo                  Boolean  @default(false)
  trackBatchNumbers                 Boolean  @default(true)
  trackExpiryDates                  Boolean  @default(true)
  autoReceiveToInventory            Boolean  @default(true)
  requireGrnApproval                Boolean  @default(false)

  // Invoice Controls
  requirePoForInvoice               Boolean  @default(false)
  requireGrnForInvoice              Boolean  @default(true)
  autoMatchInvoices                 Boolean  @default(false)

  // Tax Defaults
  defaultVatInclusive               Boolean  @default(false)

  // Inspection extended
  inspectionQualityRatingRequired   Boolean  @default(false)
  inspectionChecklist               Json?    // Default checklist template (sections with items)
  inspectionDefaultOfficerRoles     Json?    // Default officer roles to auto-assign e.g. ["quality_control","internal_audit"]
  inspectionQcOfficerIds            Json?    // Explicit employee IDs for Quality Control officers
  inspectionAuditOfficerIds         Json?    // Explicit employee IDs for Internal Audit officers
  inspectionAdditionalOfficerIds    Json?    // Explicit employee IDs for additional default officers
  inspectionDeadlineHours           Int?     // Hours before inspection is considered overdue

  // Granular Notifications
  notifyInspectionOfficers          Boolean  @default(true)
  notifyOnInspectionCompletion      Boolean  @default(true)
  notifyOnInvoiceDue                Boolean  @default(true)
  notifyOnPrApproval                Boolean  @default(true)
  notifyOnPrRejection               Boolean  @default(true)
  notifyOnPoRejection               Boolean  @default(true)

  // Stamp configuration for inspection officers
  stampShowName              Boolean @default(true)
  stampShowEmployeeNumber    Boolean @default(true)
  stampShowRole              Boolean @default(true)
  stampShowDepartment        Boolean @default(false)
  stampShowDesignation       Boolean @default(false)
  stampShowDate              Boolean @default(true)
  stampShowTime              Boolean @default(false)
  stampShowSignature         Boolean @default(true)
  stampCustomTitle           String?
  stampCustomText            String?
  stampColor                 String?
  stampStyle                 String? @default("rectangular")

  createdBy Int?
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("purchase_settings")
}

// ============================================================================
// PURCHASE MODULE - Requisitions
// ============================================================================

model PurchaseRequisition {
  id                Int       @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  requisitionNumber String
  entityId          Int?
  requesterId       Int?
  department        String?
  requiredDate      DateTime? @db.Date
  priority          String? // low, normal, high, urgent
  status            String    @default("draft") // draft, pending, approved, rejected, cancelled, converted
  estimatedTotal    Decimal?  @db.Decimal(18, 2)
  currencyId        Int?
  purpose           String?   @db.Text
  justification     String?   @db.Text
  notes             String?   @db.Text
  submittedAt       DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  lines PurchaseRequisitionLine[]
  rfqs  RequestForQuotation[]

  @@unique([companyId, requisitionNumber])
  @@index([status])
  @@index([requiredDate])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id                    Int          @id @default(autoincrement())
  purchaseRequisitionId Int
  lineType              LineItemType @default(INVENTORY_ITEM)
  itemId                Int?
  assetClassId          Int?
  serviceCategoryId     Int?
  lineNumber            Int?
  description           String?      @db.Text
  uomId                 Int?
  quantity              Decimal      @db.Decimal(15, 3)
  estimatedUnitPrice    Decimal?     @db.Decimal(15, 2)
  estimatedLineTotal    Decimal?     @db.Decimal(15, 2)
  notes                 String?      @db.Text
  lineStatus            String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  purchaseRequisition PurchaseRequisition @relation(fields: [purchaseRequisitionId], references: [id], onDelete: Cascade)
  item                Item?               @relation(fields: [itemId], references: [id], onDelete: SetNull)

  rfqLines RfqLine[]

  @@index([purchaseRequisitionId])
  @@map("purchase_requisition_lines")
}

enum LineItemType {
  INVENTORY_ITEM
  ASSET
  SERVICE
}

// ============================================================================
// PURCHASE MODULE - Request for Quotations (RFQ)
// ============================================================================

model RequestForQuotation {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  rfqNumber             String
  entityId              Int?
  purchaseRequisitionId Int?
  issueDate             DateTime? @db.Date
  closingDate           DateTime? @db.Date
  requiredDeliveryDate  DateTime? @db.Date
  status                String    @default("draft") // draft, issued, closed, cancelled
  currencyId            Int?
  estimatedTotal        Decimal?  @db.Decimal(18, 2)
  termsConditions       String?   @db.Text
  deliveryTerms         String?
  paymentTerms          String?
  notes                 String?   @db.Text
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequisition PurchaseRequisition? @relation(fields: [purchaseRequisitionId], references: [id], onDelete: SetNull)

  lines        RfqLine[]
  rfqSuppliers RfqSupplier[]

  @@unique([companyId, rfqNumber])
  @@index([status])
  @@map("request_for_quotations")
}

model RfqLine {
  id                        Int      @id @default(autoincrement())
  requestForQuotationId     Int
  purchaseRequisitionLineId Int?
  itemId                    Int?
  lineNumber                Int?
  description               String?  @db.Text
  uomId                     Int?
  quantity                  Decimal  @db.Decimal(15, 3)
  specifications            String?  @db.Text
  notes                     String?  @db.Text
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  requestForQuotation     RequestForQuotation      @relation(fields: [requestForQuotationId], references: [id], onDelete: Cascade)
  purchaseRequisitionLine PurchaseRequisitionLine? @relation(fields: [purchaseRequisitionLineId], references: [id], onDelete: SetNull)
  item                    Item?                    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  supplierQuotationLines SupplierQuotationLine[]

  @@index([requestForQuotationId])
  @@map("rfq_lines")
}

model RfqSupplier {
  id                    Int       @id @default(autoincrement())
  requestForQuotationId Int
  supplierId            Int
  invitedAt             DateTime?
  responseStatus        String? // pending, responded, declined
  responseDate          DateTime?
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  requestForQuotation RequestForQuotation @relation(fields: [requestForQuotationId], references: [id], onDelete: Cascade)
  supplier            Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  supplierQuotations SupplierQuotation[]

  @@unique([requestForQuotationId, supplierId])
  @@map("rfq_suppliers")
}

// ============================================================================
// PURCHASE MODULE - Supplier Quotations
// ============================================================================

model SupplierQuotation {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  quotationNumber       String?
  requestForQuotationId Int?
  rfqSupplierId         Int?
  supplierId            Int
  quotationDate         DateTime? @db.Date
  validityDate          DateTime? @db.Date
  currencyId            Int?
  subtotal              Decimal?  @db.Decimal(15, 2)
  discountAmount        Decimal?  @db.Decimal(15, 2)
  taxAmount             Decimal?  @db.Decimal(15, 2)
  totalAmount           Decimal?  @db.Decimal(15, 2)
  deliveryTerms         String?
  deliveryDays          Int?
  paymentTerms          String?
  status                String    @default("received") // received, under_review, selected, rejected
  isSelected            Boolean   @default(false)
  selectionReason       String?   @db.Text
  notes                 String?   @db.Text
  documentPath          String?
  committeeNotes        String?   @db.Text
  committeeMemberIds    Json?     @default("[]")
  committeeApprovalRequired Boolean @default(false)
  receivedBy            Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  rfqSupplier RfqSupplier? @relation(fields: [rfqSupplierId], references: [id], onDelete: SetNull)

  lines          SupplierQuotationLine[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
  @@index([supplierId])
  @@map("supplier_quotations")
}

model SupplierQuotationLine {
  id                  Int      @id @default(autoincrement())
  supplierQuotationId Int
  rfqLineId           Int?
  itemId              Int?
  lineNumber          Int?
  description         String?  @db.Text
  uomId               Int?
  quantity            Decimal  @db.Decimal(15, 3)
  unitPrice           Decimal  @db.Decimal(15, 2)
  discountPercent     Decimal? @db.Decimal(5, 2)
  discountAmount      Decimal? @db.Decimal(15, 2)
  vatId               Int?
  taxAmount           Decimal? @db.Decimal(15, 2)
  lineTotal           Decimal  @db.Decimal(15, 2)
  deliveryDays        Int?
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  supplierQuotation SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  rfqLine           RfqLine?          @relation(fields: [rfqLineId], references: [id], onDelete: SetNull)

  purchaseOrderLines PurchaseOrderLine[]

  @@index([supplierQuotationId])
  @@map("supplier_quotation_lines")
}

// ============================================================================
// PURCHASE MODULE - Purchase Orders
// ============================================================================

model PurchaseOrder {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  orderNumber           String
  entityId              Int?
  purchaseRequisitionId Int?
  supplierQuotationId   Int?
  supplierId            Int
  orderDate             DateTime? @db.Date
  expectedDeliveryDate  DateTime? @db.Date
  deliveryBranchId      Int?
  warehouseId           Int?
  currencyId            Int?
  exchangeRate          Decimal?  @db.Decimal(15, 6)
  paymentTerms          String?
  validityDate          DateTime? @db.Date
  status                String    @default("draft") // draft, pending, approved, sent, confirmed, partial, received, cancelled
  priority              String?
  subtotal              Decimal?  @db.Decimal(15, 2)
  discountAmount        Decimal?  @db.Decimal(15, 2)
  taxAmount             Decimal?  @db.Decimal(15, 2)
  totalAmount           Decimal?  @db.Decimal(15, 2)
  amountReceived        Decimal?  @db.Decimal(15, 2)
  amountInvoiced        Decimal?  @db.Decimal(15, 2)
  deliveryAddress       String?   @db.Text
  shippingMethod        String?
  notes                 String?   @db.Text
  termsConditions       String?   @db.Text
  documentPath          String?
  sentAt                DateTime?
  createdBy             Int?
  approvedBy            Int?
  approvedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  supplierQuotation SupplierQuotation? @relation(fields: [supplierQuotationId], references: [id], onDelete: SetNull)
  currency          IfrsCurrency?      @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  lines               PurchaseOrderLine[]
  goodsReceivedNotes  GoodsReceivedNote[]
  purchaseInspections PurchaseInspection[]
  purchaseInvoices    PurchaseInvoice[]

  @@unique([companyId, orderNumber])
  @@index([supplierId])
  @@index([orderDate])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id                      Int      @id @default(autoincrement())
  purchaseOrderId         Int
  itemId                  Int
  supplierQuotationLineId Int?
  lineNumber              Int?
  description             String?  @db.Text
  uomId                   Int?
  quantity                Decimal  @db.Decimal(15, 3)
  quantityReceived        Decimal  @default(0) @db.Decimal(15, 3)
  quantityInvoiced        Decimal  @default(0) @db.Decimal(15, 3)
  unitPrice               Decimal  @db.Decimal(15, 2)
  discountPercent         Decimal? @db.Decimal(5, 2)
  discountAmount          Decimal? @db.Decimal(15, 2)
  vatId                   Int?
  taxAmount               Decimal? @db.Decimal(15, 2)
  lineTotal               Decimal  @db.Decimal(15, 2)
  lineStatus              String?
  notes                   String?  @db.Text
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  purchaseOrder         PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item                  Item                   @relation(fields: [itemId], references: [id])
  supplierQuotationLine SupplierQuotationLine? @relation(fields: [supplierQuotationLineId], references: [id], onDelete: SetNull)

  grnLines                GrnLine[]
  purchaseInvoiceLines    PurchaseInvoiceLine[]
  purchaseInspectionLines PurchaseInspectionLine[]

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

// ============================================================================
// PURCHASE MODULE - Goods Received Notes (GRN)
// ============================================================================

model GoodsReceivedNote {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  branchId             Int?
  grnNumber            String
  entityId             Int?
  purchaseOrderId      Int?
  purchaseInspectionId Int?
  supplierId           Int
  warehouseId          Int?
  receivedDate         DateTime  @db.Date
  receivedTime         String?
  deliveryNoteNumber   String?
  deliveryNoteDate     DateTime? @db.Date
  receivedBy           Int?
  inspectedBy          Int?
  status               String    @default("draft") // draft, pending, received, partial, complete
  inspectionStatus     String? // pending, passed, failed
  totalAmount          Decimal?  @db.Decimal(15, 2)
  accruedAmount        Decimal?  @db.Decimal(15, 2)
  notes                String?   @db.Text
  rejectionNotes       String?   @db.Text
  ifrsTransactionId    Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  warehouse          Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchaseInspection PurchaseInspection? @relation(fields: [purchaseInspectionId], references: [id], onDelete: SetNull)

  lines            GrnLine[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([companyId, grnNumber])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([receivedDate])
  @@map("goods_received_notes")
}

model GrnLine {
  id                  Int       @id @default(autoincrement())
  goodsReceivedNoteId Int
  purchaseOrderLineId Int?
  itemId              Int
  lineNumber          Int?
  description         String?   @db.Text
  uomId               Int?
  quantityOrdered     Decimal?  @db.Decimal(15, 3)
  quantityReceived    Decimal   @db.Decimal(15, 3)
  quantityAccepted    Decimal?  @db.Decimal(15, 3)
  quantityRejected    Decimal?  @db.Decimal(15, 3)
  unitCost            Decimal?  @db.Decimal(15, 2)
  lineTotal           Decimal?  @db.Decimal(15, 2)
  batchNumber         String?
  serialNumbers       Json?
  manufactureDate     DateTime? @db.Date
  expiryDate          DateTime? @db.Date
  inspectionStatus    String?
  rejectionReason     String?   @db.Text
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  goodsReceivedNote GoodsReceivedNote  @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  item              Item               @relation(fields: [itemId], references: [id])

  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@index([goodsReceivedNoteId])
  @@map("grn_lines")
}

// ============================================================================
// PURCHASE MODULE - Purchase Inspections
// ============================================================================

model PurchaseInspection {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  branchId               Int?
  inspectionNumber       String    @unique
  purchaseOrderId        Int
  supplierId             Int?
  warehouseId            Int?
  inspectionDate         DateTime  @db.Date
  deliveryNoteNumber     String?
  deliveryNoteDate       DateTime? @db.Date
  status                 String    @default("draft") // draft, pending, in_progress, completed, failed, cancelled
  overallResult          String    @default("pending") // pending, passed, failed, partial
  totalQuantityInspected Decimal   @default(0) @db.Decimal(15, 2)
  totalQuantityAccepted  Decimal   @default(0) @db.Decimal(15, 2)
  totalQuantityRejected  Decimal   @default(0) @db.Decimal(15, 2)
  notes                  String?   @db.Text
  completionNotes        String?   @db.Text
  checklist              Json?     // Filled checklist data (copy of template + responses)
  countryOfOrigin        String?
  vehicleNo              String?
  driverNamePhone        String?
  finalDecision          String?   // accepted, accepted_with_condition, rejected
  rejectionReason        String?   @db.Text
  deadlineAt             DateTime? // Inspection SLA deadline
  conditionalNotes       String?   @db.Text // Notes for conditional acceptance
  conditionResolved      Boolean   @default(false) // Whether conditional acceptance is resolved
  conditionResolvedAt    DateTime?
  conditionResolvedBy    Int?
  submittedAt            DateTime?
  submittedBy            Int?
  completedAt            DateTime?
  completedBy            Int?
  createdBy              Int?
  updatedBy              Int?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  lines              PurchaseInspectionLine[]
  officers           PurchaseInspectionOfficer[]
  goodsReceivedNotes GoodsReceivedNote[]

  @@index([companyId, status])
  @@index([purchaseOrderId, status])
  @@index([inspectionDate])
  @@map("purchase_inspections")
}

model PurchaseInspectionLine {
  id                   Int       @id @default(autoincrement())
  purchaseInspectionId Int
  purchaseOrderLineId  Int?
  itemId               Int
  lineNumber           Int       @default(1)
  description          String?
  uomId                Int?
  quantityOrdered      Decimal   @default(0) @db.Decimal(15, 2)
  quantityDelivered    Decimal   @default(0) @db.Decimal(15, 2)
  quantityInspected    Decimal   @default(0) @db.Decimal(15, 2)
  quantityAccepted     Decimal   @default(0) @db.Decimal(15, 2)
  quantityRejected     Decimal   @default(0) @db.Decimal(15, 2)
  inspectionStatus     String    @default("pending") // pending, inspected, accepted, rejected, partial
  qualityRating        String?
  batchNumber          String?
  serialNumbers        Json?
  manufactureDate      DateTime? @db.Date
  expiryDate           DateTime? @db.Date
  rejectionReason      String?
  inspectionNotes      String?   @db.Text
  inspectedBy          Int?
  inspectedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  purchaseInspection PurchaseInspection @relation(fields: [purchaseInspectionId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  @@index([purchaseInspectionId, inspectionStatus])
  @@index([itemId])
  @@map("purchase_inspection_lines")
}

model PurchaseInspectionOfficer {
  id                   Int       @id @default(autoincrement())
  purchaseInspectionId Int
  employeeId           Int
  branchId             Int?
  role                 String    @default("primary") // primary, secondary, quality_control, supervisor
  status               String    @default("pending") // pending, in_progress, completed, skipped
  assignedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  result               String    @default("pending") // pending, approved, rejected, conditional, skipped
  signature            String?   @db.Text
  comments             String?   @db.Text
  branchOfficerId      Int?
  stampContent         Json?
  stampedAt            DateTime?
  assignedBy           Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  purchaseInspection PurchaseInspection @relation(fields: [purchaseInspectionId], references: [id], onDelete: Cascade)
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([purchaseInspectionId, employeeId])
  @@index([employeeId, status])
  @@index([branchId, status])
  @@map("purchase_inspection_officers")
}

model BranchInspectionOfficer {
  id         Int      @id @default(autoincrement())
  companyId  Int
  branchId   Int
  employeeId Int
  role       String   @default("primary") // primary, secondary, quality_control, supervisor
  isActive   Boolean  @default(true)
  isRequired Boolean  @default(true)
  priority   Int      @default(1)

  // Stamp configuration
  stampShowName           Boolean @default(true)
  stampShowEmployeeNumber Boolean @default(true)
  stampShowRole           Boolean @default(true)
  stampShowDepartment     Boolean @default(false)
  stampShowDesignation    Boolean @default(false)
  stampShowDate           Boolean @default(true)
  stampShowTime           Boolean @default(false)
  stampShowSignature      Boolean @default(true)
  stampCustomTitle        String?
  stampCustomText         String?
  stampColor              String?
  stampStyle              String? @default("rectangular")

  createdBy  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([branchId, employeeId, role])
  @@index([branchId, isActive])
  @@map("branch_inspection_officers")
}

// ============================================================================
// PURCHASE MODULE - Purchase Invoices
// ============================================================================

model PurchaseInvoice {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  branchId                 Int?
  invoiceNumber            String
  entityId                 Int?
  supplierInvoiceNumber    String?
  supplierId               Int
  purchaseOrderId          Int?
  goodsReceivedNoteId      Int?
  invoiceDate              DateTime  @db.Date
  receivedDate             DateTime? @db.Date
  dueDate                  DateTime  @db.Date
  currencyId               Int?
  exchangeRate             Decimal?  @db.Decimal(15, 6)
  paymentTerms             String?
  subtotal                 Decimal   @db.Decimal(15, 2)
  discountAmount           Decimal?  @db.Decimal(15, 2)
  taxAmount                Decimal   @db.Decimal(15, 2)
  withholdingTaxAmount     Decimal?  @db.Decimal(15, 2)
  totalAmount              Decimal   @db.Decimal(15, 2)
  amountPaid               Decimal   @default(0) @db.Decimal(15, 2)
  balanceDue               Decimal   @db.Decimal(15, 2)
  status                   String    @default("draft") // draft, pending, approved, partial, paid, cancelled
  matchStatus              String? // matched, unmatched, variance
  paymentStatus            String? // not_due, due, overdue, paid
  notes                    String?   @db.Text
  matchingNotes            String?   @db.Text
  documentPath             String?
  ifrsTransactionId        Int?
  priceVarianceData        Json?
  varianceAmount           Decimal?  @default(0) @db.Decimal(15, 2)
  threeWayMatchResult      Json?     // Full 3-way match result (PO/GRN/Invoice)
  requiresVarianceApproval Boolean   @default(false)
  varianceApprovedBy       Int?
  varianceApprovedAt       DateTime?
  createdBy                Int?
  updatedBy                Int?
  submittedAt              DateTime?
  approvedBy               Int?
  approvedAt               DateTime?
  rejectedBy               Int?
  rejectedAt               DateTime?
  rejectionReason          String?   @db.Text
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceivedNote GoodsReceivedNote? @relation(fields: [goodsReceivedNoteId], references: [id], onDelete: SetNull)
  currency          IfrsCurrency?      @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  lines PurchaseInvoiceLine[]

  // Payables
  paymentAllocations SupplierPaymentAllocation[]

  @@unique([companyId, invoiceNumber])
  @@index([supplierId])
  @@index([invoiceDate])
  @@index([status])
  @@index([dueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                   Int      @id @default(autoincrement())
  purchaseInvoiceId    Int
  purchaseOrderLineId  Int?
  grnLineId            Int?
  itemId               Int
  lineNumber           Int?
  description          String?  @db.Text
  uomId                Int?
  quantityInvoiced     Decimal  @db.Decimal(15, 3)
  quantityMatched      Decimal? @db.Decimal(15, 3)
  unitPrice            Decimal  @db.Decimal(15, 2)
  poUnitPrice          Decimal? @db.Decimal(15, 2)
  grnUnitCost          Decimal? @db.Decimal(15, 2)
  priceVariance        Decimal? @db.Decimal(15, 2)
  quantityVariance     Decimal? @db.Decimal(15, 3)
  discountPercent      Decimal? @db.Decimal(5, 2)
  discountAmount       Decimal? @db.Decimal(15, 2)
  vatId                Int?
  taxAmount            Decimal? @db.Decimal(15, 2)
  withholdingTaxId     Int?
  withholdingTaxAmount Decimal? @db.Decimal(15, 2)
  lineTotal            Decimal  @db.Decimal(15, 2)
  matchStatus          String?
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  purchaseInvoice   PurchaseInvoice    @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  grnLine           GrnLine?           @relation(fields: [grnLineId], references: [id], onDelete: SetNull)
  item              Item               @relation(fields: [itemId], references: [id])
  vat               IfrsVat?           @relation(fields: [vatId], references: [id], onDelete: SetNull)
  withholdingTax    WithholdingTax?    @relation(fields: [withholdingTaxId], references: [id], onDelete: SetNull)

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

// ============================================================================
// PURCHASE MODULE - Service Orders
// ============================================================================

model ServiceOrder {
  id                Int       @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  orderNumber       String
  supplierId        Int
  serviceCategoryId Int?
  requisitionId     Int?
  orderDate         DateTime  @db.Date
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  description       String    @db.Text
  scope             String?   @db.Text
  deliverables      Json?
  subtotal          Decimal   @db.Decimal(15, 2)
  discountAmount    Decimal?  @db.Decimal(15, 2)
  taxAmount         Decimal?  @db.Decimal(15, 2)
  totalAmount       Decimal   @db.Decimal(15, 2)
  amountCompleted   Decimal   @default(0) @db.Decimal(15, 2)
  amountInvoiced    Decimal   @default(0) @db.Decimal(15, 2)
  currencyId        Int?
  exchangeRate      Decimal   @default(1) @db.Decimal(15, 6)
  status            String    @default("draft") // draft, pending, approved, rejected, in_progress, completed, cancelled
  paymentTerms      String?
  deliveryTerms     String?
  expectedCompletionDate DateTime? @db.Date
  deliveryBranchId  Int?
  deliveryAddress   String?   @db.Text
  termsConditions   String?   @db.Text
  documentPath      String?
  notes             String?   @db.Text
  sentAt            DateTime?
  createdBy         Int?
  submittedAt       DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  completedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  company         Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier                  @relation(fields: [supplierId], references: [id])
  serviceCategory ServiceCategory?          @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  lines           ServiceOrderLine[]
  inspections     ServiceInspection[]
  certificates    CertificateOfCompletion[]

  @@unique([companyId, orderNumber])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("service_orders")
}

model ServiceOrderLine {
  id                         Int      @id @default(autoincrement())
  serviceOrderId             Int
  purchaseRequisitionLineId  Int?
  serviceCategoryId          Int?
  lineNumber                 Int      @default(1)
  description                String   @db.Text
  uom                        String?
  quantity                   Decimal  @db.Decimal(15, 4)
  unitPrice                  Decimal  @db.Decimal(15, 2)
  discountPercent            Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent                 Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal                  Decimal  @db.Decimal(15, 2)
  completedQuantity          Decimal  @default(0) @db.Decimal(15, 4)
  invoicedQuantity           Decimal  @default(0) @db.Decimal(15, 4)
  specifications             String?  @db.Text
  status                     String?  @default("pending")
  notes                      String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  // Relations
  serviceOrder           ServiceOrder              @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serviceInspectionLines ServiceInspectionLine[]
  certificateLines       CertificateOfCompletionLine[]

  @@index([serviceOrderId])
  @@map("service_order_lines")
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  name        String
  code        String   @unique
  description String?  @db.Text
  serviceExpenseGlAccountId Int?
  serviceAccrualGlAccountId Int?
  serviceWipGlAccountId     Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  serviceOrders         ServiceOrder[]
  expenseGlAccount      IfrsAccount?   @relation("ServiceCategoryExpense", fields: [serviceExpenseGlAccountId], references: [id], onDelete: SetNull)
  accrualGlAccount      IfrsAccount?   @relation("ServiceCategoryAccrual", fields: [serviceAccrualGlAccountId], references: [id], onDelete: SetNull)
  wipGlAccount          IfrsAccount?   @relation("ServiceCategoryWip", fields: [serviceWipGlAccountId], references: [id], onDelete: SetNull)

  @@index([companyId, isActive])
  @@index([companyId, code])
  @@map("service_categories")
}

// ============================================================================
// PURCHASE MODULE - Service Inspections & Certificates
// ============================================================================

model ServiceInspection {
  id               Int       @id @default(autoincrement())
  companyId        Int
  branchId         Int?
  inspectionNumber String
  serviceOrderId   Int
  supplierId       Int?
  inspectionDate   DateTime  @db.Date
  inspectorId      Int?
  overallResult    String    @default("pending") // pending, passed, failed, partial
  status           String    @default("draft") // draft, pending, in_progress, completed, cancelled
  notes            String?   @db.Text
  completionNotes  String?   @db.Text
  createdBy        Int?
  submittedBy      Int?
  submittedAt      DateTime?
  completedAt      DateTime?
  completedBy      Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  serviceOrder ServiceOrder              @relation(fields: [serviceOrderId], references: [id])
  lines        ServiceInspectionLine[]
  certificates CertificateOfCompletion[]

  @@unique([companyId, inspectionNumber])
  @@index([serviceOrderId])
  @@index([status])
  @@map("service_inspections")
}

model ServiceInspectionLine {
  id                  Int      @id @default(autoincrement())
  serviceInspectionId Int
  serviceOrderLineId  Int
  lineNumber          Int?
  description         String?  @db.Text
  quantityOrdered     Decimal  @default(0) @db.Decimal(15, 4)
  quantityCompleted   Decimal  @default(0) @db.Decimal(15, 4)
  quantityAccepted    Decimal  @default(0) @db.Decimal(15, 4)
  quantityRejected    Decimal  @default(0) @db.Decimal(15, 4)
  inspectionResult    String   @default("pending") // pending, passed, failed, partial
  qualityRating       Int?
  rejectionReason     String?  @db.Text
  remarks             String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  serviceInspection ServiceInspection @relation(fields: [serviceInspectionId], references: [id], onDelete: Cascade)
  serviceOrderLine  ServiceOrderLine  @relation(fields: [serviceOrderLineId], references: [id])

  @@index([serviceInspectionId])
  @@index([serviceInspectionId, lineNumber])
  @@map("service_inspection_lines")
}

model CertificateOfCompletion {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  certificateNumber   String
  serviceOrderId      Int
  serviceInspectionId Int?
  supplierId          Int?
  completionDate      DateTime  @db.Date
  completionTime      String?
  verifiedById        Int?
  verifiedAt          DateTime?
  approvedById        Int?
  approvedAt          DateTime?
  entityId            Int?
  status              String    @default("draft") // draft, pending, verified, approved, rejected
  totalAmount         Decimal   @default(0) @db.Decimal(15, 2)
  accrualAmount       Decimal?  @db.Decimal(15, 2)
  ifrsTransactionId   Int?
  notes               String?   @db.Text
  rejectionReason     String?   @db.Text
  createdBy           Int?
  rejectedBy          Int?
  submittedAt         DateTime?
  rejectedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  serviceOrder      ServiceOrder       @relation(fields: [serviceOrderId], references: [id])
  serviceInspection ServiceInspection? @relation(fields: [serviceInspectionId], references: [id], onDelete: SetNull)
  lines             CertificateOfCompletionLine[]

  @@unique([companyId, certificateNumber])
  @@index([serviceOrderId])
  @@index([status])
  @@index([completionDate])
  @@map("certificates_of_completion")
}

model CertificateOfCompletionLine {
  id                 Int      @id @default(autoincrement())
  certificateId      Int
  serviceOrderLineId Int
  serviceCategoryId  Int?
  lineNumber         Int?
  description        String?  @db.Text
  uom                String?
  quantityOrdered    Decimal  @default(0) @db.Decimal(15, 4)
  quantityCompleted  Decimal  @default(0) @db.Decimal(15, 4)
  quantityAccepted   Decimal  @default(0) @db.Decimal(15, 4)
  unitPrice          Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal          Decimal  @default(0) @db.Decimal(15, 2)
  inspectionStatus   String?
  notes              String?  @db.Text
  remarks            String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  certificate      CertificateOfCompletion @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  serviceOrderLine ServiceOrderLine        @relation(fields: [serviceOrderLineId], references: [id])

  @@index([certificateId])
  @@map("certificate_of_completion_lines")
}

// ============================================================================
// POS MODULE - Payment Methods & Cash Registers
// ============================================================================

model PaymentMethod {
  id                    Int      @id @default(autoincrement())
  companyId             Int?
  name                  String
  code                  String   @unique
  description           String?
  type                  String // cash, bank_transfer, card, mobile_money, cheque
  isCash                Boolean  @default(false)
  bankId                Int?
  glAccountId           Int?
  accountId             Int? // GL account for POS posting
  feeAccountId          Int?
  cardType              String?
  mobileProvider        String?
  mobileNumber          String?
  transactionFeePercent Decimal  @default(0) @db.Decimal(5, 2)
  transactionFeeFixed   Decimal  @default(0) @db.Decimal(15, 2)
  isActive              Boolean  @default(true)
  requiresRef           Boolean  @default(false)
  requiresApproval      Boolean  @default(false)
  approvalThreshold     Decimal? @db.Decimal(15, 2)
  allowPartialPayment   Boolean  @default(true)
  isDefault             Boolean  @default(false)
  sortOrder             Int      @default(0)
  icon                  String?
  color                 String?
  createdBy             Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  paymentReceipts           PaymentReceipt[]
  expensePayments           ExpensePayment[]
  customerDeposits          CustomerDeposit[]
  depositRefunds            DepositRefund[]
  paymentAllocations        PaymentAllocationDetail[]
  depositPaymentAllocations DepositPaymentAllocation[]
  sessionPaymentMethods     CashRegisterSessionPaymentMethod[]
  receiptPaymentMethods     ReceiptPaymentMethod[]
  payablesPaymentMethods    PayablesPaymentMethod[]
  invoicePayments           InvoicePayment[] @relation("InvoicePaymentMethod")
  posPaymentAllocations     PosPaymentAllocation[]

  @@index([companyId])
  @@index([type])
  @@index([isActive])
  @@map("payment_methods")
}

model CashRegister {
  id           Int       @id @default(autoincrement())
  companyId    Int
  branchId     Int
  registerName String
  registerCode String
  location     String?
  isActive     Boolean   @default(true)
  openingFloat Decimal   @default(0) @db.Decimal(15, 2)
  description  String?   @db.Text
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  sessions CashRegisterSession[]

  @@unique([companyId, registerCode])
  @@unique([branchId, registerName])
  @@index([branchId, isActive])
  @@map("cash_registers")
}

model CashRegisterSession {
  id             Int       @id @default(autoincrement())
  companyId      Int
  branchId       Int
  cashRegisterId Int
  sessionNumber  String
  openingAmount  Decimal   @db.Decimal(15, 2)
  closingAmount  Decimal?  @db.Decimal(15, 2)
  expectedAmount Decimal?  @db.Decimal(15, 2)
  varianceAmount Decimal?  @db.Decimal(15, 2)
  openedAt       DateTime
  closedAt       DateTime?
  status         String    @default("open") // open, closing, closed
  openingNotes   String?   @db.Text
  closingNotes   String?   @db.Text
  createdBy      Int?
  updatedBy      Int?
  openedBy       Int?
  closedBy       Int?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  paymentReceipts     PaymentReceipt[]
  expensePayments     ExpensePayment[]
  customerDeposits    CustomerDeposit[]
  depositApplications DepositApplication[]
  depositRefunds      DepositRefund[]
  paymentMethods      CashRegisterSessionPaymentMethod[]
  customerReceipts    CustomerReceipt[]

  @@index([companyId, branchId, status, openedAt])
  @@map("cash_register_sessions")
}

model CashRegisterSessionPaymentMethod {
  id              Int      @id @default(autoincrement())
  sessionId       Int
  paymentMethodId Int
  openingAmount   Decimal  @default(0) @db.Decimal(15, 2)
  closingAmount   Decimal? @db.Decimal(15, 2)
  expectedAmount  Decimal? @db.Decimal(15, 2)
  varianceAmount  Decimal? @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  session       CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([sessionId, paymentMethodId])
  @@map("cash_register_session_payment_methods")
}

model PosPaymentAllocation {
  id              Int      @id @default(autoincrement())
  companyId       Int
  salesInvoiceId  Int
  paymentMethodId Int
  amount          Decimal  @db.Decimal(15, 2)
  reference       String?
  bankId          Int?
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  salesInvoice  SalesInvoice  @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([salesInvoiceId])
  @@index([paymentMethodId])
  @@map("pos_payment_allocations")
}

// ============================================================================
// POS MODULE - Payment Receipts
// ============================================================================

model PaymentReceipt {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int
  receiptNumber         String
  receiptDate           DateTime  @db.Date
  customerId            Int
  customerName          String?
  paymentMethodId       Int
  cashRegisterSessionId Int?
  totalAmount           Decimal   @db.Decimal(15, 2)
  allocatedAmount       Decimal?  @db.Decimal(15, 2)
  unallocatedAmount     Decimal?  @db.Decimal(15, 2)
  paymentStatus         String    @default("received") // received, allocated, partial
  notes                 String?   @db.Text
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id])
  paymentMethod PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  session       CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  items                 PaymentReceiptItem[]
  allocationDetails     PaymentAllocationDetail[]
  posReceiptAllocations PosReceiptAllocation[]

  @@unique([companyId, receiptNumber])
  @@index([customerId])
  @@index([receiptDate])
  @@map("payment_receipts")
}

model PaymentReceiptItem {
  id               Int       @id @default(autoincrement())
  paymentReceiptId Int
  salesInvoiceId   Int
  amountAllocated  Decimal   @db.Decimal(15, 2)
  notes            String?   @db.Text
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  paymentReceipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id], onDelete: Cascade)

  @@index([paymentReceiptId])
  @@map("payment_receipt_items")
}

model PosReceiptAllocation {
  id               Int       @id @default(autoincrement())
  companyId        Int
  paymentReceiptId Int
  salesInvoiceId   Int
  allocatedAmount  Decimal   @db.Decimal(15, 2)
  allocationDate   DateTime  @db.Date
  notes            String?   @db.Text
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  paymentReceipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id], onDelete: Cascade)

  @@index([paymentReceiptId])
  @@map("pos_receipt_allocations")
}

model PaymentAllocationDetail {
  id               Int      @id @default(autoincrement())
  paymentReceiptId Int
  paymentMethodId  Int
  amount           Decimal  @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  paymentReceipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id], onDelete: Cascade)
  paymentMethod  PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@index([paymentReceiptId])
  @@index([paymentMethodId])
  @@map("payment_allocation_details")
}

// ============================================================================
// POS MODULE - Customer Deposits
// ============================================================================

model CustomerDeposit {
  id                    Int           @id @default(autoincrement())
  depositNumber         String        @unique
  customerId            Int
  companyId             Int
  branchId              Int
  depositDate           DateTime      @db.Date
  amount                Decimal       @db.Decimal(15, 2)
  availableBalance      Decimal       @db.Decimal(15, 2)
  appliedAmount         Decimal       @default(0) @db.Decimal(15, 2)
  refundedAmount        Decimal       @default(0) @db.Decimal(15, 2)
  paymentMethodId       Int
  referenceNumber       String?
  purpose               String?       @db.Text
  cashRegisterSessionId Int?
  journalEntryId        Int?
  status                String        @default("ACTIVE")
  linkedSalesOrderId    Int?
  expiryDate            DateTime?     @db.Date
  createdBy             Int?
  refundedBy            Int?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  // Relations
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  session       CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  applications       DepositApplication[]
  refunds            DepositRefund[]
  paymentAllocations DepositPaymentAllocation[]

  @@index([customerId, status, availableBalance])
  @@index([companyId, branchId, depositDate])
  @@index([status, expiryDate])
  @@map("customer_deposits")
}

model DepositApplication {
  id                    Int      @id @default(autoincrement())
  depositId             Int
  salesInvoiceId        Int
  amountApplied         Decimal  @db.Decimal(15, 2)
  appliedDate           DateTime @db.Date
  cashRegisterSessionId Int?
  appliedBy             Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  deposit CustomerDeposit      @relation(fields: [depositId], references: [id], onDelete: Cascade)
  session CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  @@index([depositId, salesInvoiceId])
  @@index([appliedDate])
  @@map("deposit_applications")
}

model DepositRefund {
  id                    Int       @id @default(autoincrement())
  depositId             Int
  refundNumber          String    @unique
  amount                Decimal   @db.Decimal(15, 2)
  refundDate            DateTime  @db.Date
  refundReason          String    @db.Text
  paymentMethodId       Int
  bankId                Int?
  cashRegisterSessionId Int?
  journalEntryId        Int?
  requestedBy           Int
  approvedBy            Int?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  deposit       CustomerDeposit      @relation(fields: [depositId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  bank          Bank?                @relation(fields: [bankId], references: [id], onDelete: SetNull)
  session       CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  @@index([refundDate])
  @@map("deposit_refunds")
}

model DepositPaymentAllocation {
  id              Int      @id @default(autoincrement())
  depositId       Int
  paymentMethodId Int
  amount          Decimal  @db.Decimal(15, 2)
  referenceNumber String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  deposit       CustomerDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod   @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@index([depositId, paymentMethodId])
  @@map("deposit_payment_allocations")
}

// ============================================================================
// POS MODULE - Expense Payments
// ============================================================================

model ExpensePayment {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int
  expenseNumber         String    @unique
  expenseDate           DateTime  @db.Date
  payeeName             String
  description           String?   @db.Text
  notes                 String?   @db.Text
  totalAmount           Decimal   @db.Decimal(15, 2)
  taxAmount             Decimal   @default(0) @db.Decimal(15, 2)
  netAmount             Decimal   @db.Decimal(15, 2)
  paymentMethodId       Int
  referenceNumber       String?
  cashRegisterSessionId Int?
  journalEntryId        Int?
  postingStatus         String    @default("draft") // draft, posted, reversed
  postedAt              DateTime?
  postedBy              Int?
  approvalStatus        String    @default("pending") // pending, approved, rejected
  approvedBy            Int?
  approvedAt            DateTime?
  approvalNotes         String?   @db.Text
  createdBy             Int?
  updatedBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  paymentMethod PaymentMethod        @relation(fields: [paymentMethodId], references: [id])
  session       CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  items ExpensePaymentItem[]

  @@index([companyId, branchId])
  @@index([expenseDate])
  @@index([postingStatus])
  @@index([approvalStatus])
  @@map("expense_payments")
}

model ExpensePaymentItem {
  id               Int      @id @default(autoincrement())
  expensePaymentId Int
  itemDescription  String
  notes            String?  @db.Text
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineAmount       Decimal  @db.Decimal(15, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal  @db.Decimal(15, 2)
  expenseAccountId Int?
  accountCode      String?
  accountName      String?
  costCenterId     Int?
  costCenterName   String?
  createdBy        Int?
  updatedBy        Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  expensePayment ExpensePayment @relation(fields: [expensePaymentId], references: [id], onDelete: Cascade)

  @@index([expensePaymentId])
  @@index([expenseAccountId])
  @@map("expense_payment_items")
}

// ============================================================================
// HR PAYROLL MODULE - Departments, Positions, Cadres, Grade Levels
// ============================================================================

model Department {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  parentDepartmentId Int?
  name               String
  code               String
  description        String?   @db.Text
  departmentHead     String?
  headEmployeeId     Int?
  budgetAllocation   Decimal?  @db.Decimal(15, 2)
  costCenter         String?
  phone              String?
  email              String?
  location           String?   @db.Text
  isActive           Boolean   @default(true)
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  children     Department[] @relation("DepartmentHierarchy")
  headEmployee Employee?    @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  employees   Employee[]
  positions   Position[]
  jobPostings JobPosting[]

  @@unique([companyId, branchId, name])
  @@unique([companyId, branchId, code])
  @@index([companyId, branchId])
  @@map("departments")
}

model Cadre {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  code        String
  description String?  @db.Text
  minSalary   Decimal? @db.Decimal(15, 2)
  maxSalary   Decimal? @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  positions                    Position[]
  gradeLevels                  GradeLevel[]
  salaryStructures             SalaryStructure[]
  employeeGradeAssignments     EmployeeGradeAssignment[]
  employeeGradeAssignmentsPrev EmployeeGradeAssignment[] @relation("PreviousCadre")

  @@unique([companyId, code])
  @@map("cadres")
}

model GradeLevel {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  cadreId              Int
  name                 String
  code                 String
  level                Int      @default(1)
  description          String?  @db.Text
  minSalary            Decimal  @db.Decimal(15, 2)
  maxSalary            Decimal  @db.Decimal(15, 2)
  annualIncrement      Decimal? @db.Decimal(15, 2)
  incrementPercentage  Decimal? @db.Decimal(5, 2)
  maxSteps             Int      @default(10)
  stepAmount           Decimal? @db.Decimal(15, 2)
  minYearsForPromotion Int?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cadre   Cadre   @relation(fields: [cadreId], references: [id], onDelete: Cascade)

  salaryStructures             SalaryStructure[]
  payrollItems                 GradeLevelPayrollItem[]
  employeeGradeAssignments     EmployeeGradeAssignment[]
  employeeGradeAssignmentsPrev EmployeeGradeAssignment[] @relation("PreviousGradeLevel")

  @@unique([companyId, code])
  @@index([cadreId, isActive])
  @@map("grade_levels")
}

model Position {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  departmentId        Int?
  cadreId             Int?
  title               String
  code                String
  description         String?   @db.Text
  responsibilities    String?   @db.Text
  requirements        String?   @db.Text
  reportsToPositionId Int?
  positionMinSalary   Decimal?  @db.Decimal(15, 2)
  positionMaxSalary   Decimal?  @db.Decimal(15, 2)
  educationLevel      String?
  experienceYears     Int       @default(0)
  requiredSkills      Json?
  preferredSkills     Json?
  isActive            Boolean   @default(true)
  isRecruiting        Boolean   @default(false)
  availableSlots      Int       @default(1)
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cadre        Cadre?      @relation(fields: [cadreId], references: [id], onDelete: SetNull)
  reportsTo    Position?   @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  subordinates Position[]  @relation("PositionHierarchy")

  employees   Employee[]
  contracts   EmployeeContract[]
  company     Company            @relation(fields: [companyId], references: [id])
  jobPostings JobPosting[]

  @@unique([companyId, branchId, title])
  @@unique([companyId, branchId, code])
  @@index([companyId, branchId, departmentId])
  @@index([cadreId, isActive])
  @@map("positions")
}

// ============================================================================
// HR PAYROLL MODULE - Employees
// ============================================================================

model Employee {
  id                           Int              @id @default(autoincrement())
  userId                       Int?             @unique // Nullable - not all employees need user accounts
  departmentId                 Int?
  positionId                   Int?
  salaryStructureId            Int?
  employeeCode                 String
  staffId                      String?
  firstName                    String
  middleName                   String?
  lastName                     String
  personalEmail                String?
  phone                        String?
  alternatePhone               String?
  dateOfBirth                  DateTime?        @db.Date
  gender                       Gender?
  maritalStatus                MaritalStatus?
  nationality                  String           @default("Nigerian")
  stateOfOrigin                String?
  localGovernment              String?
  hireDate                     DateTime?        @db.Date
  confirmationDate             DateTime?        @db.Date
  terminationDate              DateTime?        @db.Date
  employmentStatus             EmploymentStatus @default(ACTIVE)
  employmentType               EmploymentType   @default(FULL_TIME)
  lifecycleStage               LifecycleStage   @default(JOB_PLACEMENT)
  jobTitle                     String?
  salaryType                   SalaryType       @default(STRUCTURED)
  payMode                      PayMode?
  unstructuredSalary           Decimal?         @db.Decimal(15, 2)
  voluntaryPensionContribution Decimal?         @db.Decimal(15, 2) // Annual voluntary pension — tax relief
  annualRentPaid               Decimal?         @db.Decimal(15, 2) // Actual annual rent — for rent relief (20%, max ₦500K)
  payFrequency                 PayFrequency     @default(MONTHLY)
  bankName                     String?
  accountNumber                String?
  accountName                  String?
  address                      String?          @db.Text
  city                         String?
  state                        String?
  country                      String           @default("Nigeria")
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  nin                          String?
  bvn                          String?
  pensionPin                   String? // PENCOM RSA PIN (e.g. PENXXXXXXXXXXXX)
  pensionAdministratorId       Int? // FK to pension_fund_administrators
  taxId                        String?
  isActive                     Boolean          @default(true)
  isUser                       Boolean          @default(false) // Counts against plan user limit when true
  metadata                     Json?
  deletedAt                    DateTime?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  // Relations
  // Legacy relation (userId FK on Employee) - to be deprecated
  user            User?            @relation("LegacyEmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  // New relation (employeeId FK on User) - preferred approach
  portalUser      User?            @relation("EmployeeUser")
  department      Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId Int

  // Relations to other modules
  contracts           EmployeeContract[]
  documents           EmployeeDocument[]
  leaves              Leave[]
  payrolls            Payroll[]
  statutoryDeductions StatutoryDeduction[]
  gradeAssignments    EmployeeGradeAssignment[]
  benefitEnrollments  BenefitEnrollment[]
  dependents          Dependent[]
  branches            BranchEmployee[]

  // Approvals and authorizations
  processApprovals           ProcessApproval[]
  bankAuthorizations         BankAuthorization[]
  warehouseAuthorizations    WarehouseAuthorization[]
  purchaseInspectionOfficers PurchaseInspectionOfficer[]

  // Message recipients
  messageRecipients MessageRecipient[]

  // Sales
  salesAreas              SalesArea[]
  loadingOrdersAsDriver   LoadingOrder[] @relation("LoadingOrderDriver")
  salesDeliveriesAsDriver SalesDelivery[] @relation("SalesDeliveryDriver")
  salesRepLink            SalesRep[]     @relation("SalesRepEmployee")

  // Expense requests
  expenseRequests ExpenseRequest[]

  // Loans
  loans EmployeeLoan[]
  deductions EmployeeDeduction[]

  // Performance
  performanceReviewsAsEmployee PerformanceReview[] @relation("ReviewEmployee")
  performanceReviewsAsReviewer PerformanceReview[] @relation("ReviewReviewer")
  performanceGoals             PerformanceGoal[]

  // Training
  trainingEnrollments TrainingEnrollment[]

  // Time & Attendance
  overtimeRequests OvertimeRequest[]

  // Onboarding / Offboarding
  onboardings  EmployeeOnboarding[]
  offboardings EmployeeOffboarding[]

  // Expense Claims
  expenseClaims ExpenseClaim[]

  // Department head
  departmentsHeaded Department[] @relation("DepartmentHead")
  branch            Branch?      @relation(fields: [branchId], references: [id])
  branchId          Int?

  // Pension administrator (PFA)
  pensionAdministrator PensionFundAdministrator? @relation(fields: [pensionAdministratorId], references: [id], onDelete: SetNull)

  // Time & Attendance (new)
  timeClockRecords       TimeClockRecord[]
  shiftAssignments       ShiftAssignment[]
  employeeWorkSchedules  EmployeeWorkSchedule[]

  // Employment Lifecycle (new)
  probations             Probation[]
  reimbursements         Reimbursement[]
  payslips               PayslipGeneration[]

  // Pivot tables (new)
  employeeSkills         EmployeeSkill[]
  employeeCertifications EmployeeCertification[]
  employeeKpis           EmployeeKpi[]
  kpiAchievements        KpiAchievement[]

  // Appointments & Exit
  appointments   Appointment[]
  exitInterviews ExitInterview[]

  // School Management
  smStaff SmStaff[]

  salesInspectionOfficerAssignments SalesInspectionOfficer[] @relation("SalesInspectionOfficerEmployee")

  @@index([userId, isActive])
  @@index([departmentId, employmentStatus])
  @@index([lifecycleStage, employmentStatus])
  @@index([salaryType, isActive])
  @@map("employees")
}

// ============================================================================
// HR & Payroll - Pension Fund Administrators (Nigeria PFA lookup)
// ============================================================================
// Seeded with currently licensed Nigerian PFAs on tenant provisioning.
// Companies can add/edit their own; the seed is a starting point.
model PensionFundAdministrator {
  id            Int       @id @default(autoincrement())
  companyId     Int
  name          String    @db.VarChar(200)
  code          String?   @db.VarChar(20) // Optional internal code (e.g. PFA-001)
  licenseNumber String?   @db.VarChar(50) // PenCom license reference if known
  address       String?   @db.VarChar(500)
  phone         String?   @db.VarChar(50)
  email         String?   @db.VarChar(200)
  website       String?   @db.VarChar(200)
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  isSeeded      Boolean   @default(false) // True for system-seeded entries; UI can flag for protection
  createdBy     Int?
  updatedBy     Int?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("pension_fund_administrators")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  SUSPENDED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum LifecycleStage {
  JOB_PLACEMENT
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  ONBOARDING
  PROBATION
  CONFIRMED
  TERMINATED
}

enum SalaryType {
  STRUCTURED
  UNSTRUCTURED
}

// ============================================================================
// HR PAYROLL MODULE - Pay Elements (consolidation of PayrollComponent + PayrollItem)
// ============================================================================
// Single canonical table for every earning, deduction, allowance, benefit.
// Replaces the older split between `payroll_components` (formula-driven, used
// by SalaryStructure) and `payroll_items` (flat-amount, used by GradeLevel).
// The mode flag tells the calculation engine which path to take.
//
// Phase 1 (now): new table seeded from both legacy tables. Old tables kept
//   intact so existing flows keep working.
// Phase 2 (future): migrate salary_structure_components.payrollComponentId
//   and grade_level_payroll_item.payrollItemId to FK pay_elements; update
//   payroll-calculation.service; deprecate the old CRUDs.
// ============================================================================

enum PayMode {
  GRADE_BASED   // flat amounts attached to a grade level (replaces PayrollItem usage)
  FORMULA_BASED // formula / percentage-driven, used inside SalaryStructure (replaces PayrollComponent)
  LUMP_SUM      // single gross amount, system auto-splits per company convention
}

enum PayElementType {
  EARNING
  DEDUCTION
  BENEFIT
}

model PayElement {
  id                         Int             @id @default(autoincrement())
  companyId                  Int
  branchId                   Int?
  name                       String          @db.VarChar(150)
  code                       String          @db.VarChar(30)
  shortName                  String?         @db.VarChar(50)
  description                String?         @db.Text
  type                       PayElementType  @default(EARNING)
  // The mode determines which calculation engine path applies. An element
  // can be reused across modes — for example a "Housing Allowance" element
  // can be GRADE_BASED for one grade and FORMULA_BASED for another. The
  // mode here is the element's PRIMARY mode; the relation table (grade or
  // structure component) overrides per assignment.
  mode                       PayMode         @default(FORMULA_BASED)
  category                   String          @default("allowance") // basic, allowance, bonus, overtime, deduction, statutory, benefit, other
  // Calculation defaults (override per assignment)
  calculationType            String          @default("fixed") // fixed | percentage | formula | manual
  baseOn                     String?         @db.VarChar(20) // basic_salary, gross_salary, flat_amount, annual_salary
  defaultRate                Decimal?        @db.Decimal(8, 4)
  defaultAmount              Decimal?        @db.Decimal(15, 2)
  defaultPercentage          Decimal?        @db.Decimal(8, 4)
  minimumAmount              Decimal?        @db.Decimal(15, 2)
  maximumAmount              Decimal?        @db.Decimal(15, 2)
  calculationFormula         String?         @db.Text
  formulaParameters          Json?
  // Statutory / regulatory flags
  isStatutory                Boolean         @default(false)
  statutoryAgency            String?         @db.VarChar(50)
  employerRate               Decimal?        @db.Decimal(8, 4)
  employeeRate               Decimal?        @db.Decimal(8, 4)
  // Tax / pension behaviour
  taxable                    Boolean         @default(true)
  affectsPensionCalculation  Boolean         @default(true)
  affectsGratuityCalculation Boolean         @default(true)
  proRatable                 Boolean         @default(true)
  // Display
  showOnPayslip              Boolean         @default(true)
  displayOrder               Int             @default(0)
  frequency                  String          @default("monthly")
  // Lifecycle
  effectiveFrom              DateTime        @db.Date
  effectiveTo                DateTime?       @db.Date
  isActive                   Boolean         @default(true)
  isSystemElement            Boolean         @default(false)
  // Phase-1 traceability (so we can map back to legacy rows during cutover)
  legacyTable                String?         @db.VarChar(30) // 'payroll_components' | 'payroll_items'
  legacyId                   Int?
  // Audit
  createdBy                  Int
  approvedBy                 Int?
  approvedAt                 DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salaryStructureComponents SalaryStructureComponent[]
  gradeLevelPayrollItems    GradeLevelPayrollItem[]

  @@unique([companyId, branchId, code])
  @@unique([companyId, branchId, name])
  @@index([companyId, mode, isActive])
  @@index([category, type])
  @@index([legacyTable, legacyId])
  @@map("pay_elements")
}

enum PayFrequency {
  MONTHLY
  BI_WEEKLY
  WEEKLY
}

model BranchEmployee {
  id         Int       @id @default(autoincrement())
  branchId   Int
  employeeId Int
  isPrimary  Boolean   @default(false)
  isActive   Boolean   @default(true)
  assignedBy Int?
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([branchId, employeeId])
  @@map("branch_employee")
}

// ============================================================================
// HR PAYROLL MODULE - Contracts & Documents
// ============================================================================

model EmployeeContract {
  id                     Int            @id @default(autoincrement())
  companyId              Int
  branchId               Int?
  employeeId             Int
  contractNumber         String
  contractTitle          String
  contractType           ContractType
  version                Int            @default(1)
  isCurrent              Boolean        @default(true)
  startDate              DateTime       @db.Date
  endDate                DateTime?      @db.Date
  durationMonths         Int?
  probationPeriodMonths  Int?
  isRenewable            Boolean        @default(false)
  renewalNoticeDays      Int?
  positionId             Int
  departmentId           Int?
  jobTitle               String
  gradeLevel             String?
  step                   Int?
  jobDescription         String?        @db.Text
  keyResponsibilities    Json?
  reportingRelationships Json?
  basicSalary            Decimal        @db.Decimal(15, 2)
  salaryFrequency        String // monthly, bi-weekly, weekly
  salaryStructureId      Int?
  allowances             Json?
  benefitsPackage        Json?
  annualSalary           Decimal?       @db.Decimal(15, 2)
  workingHoursPerWeek    Int            @default(40)
  workSchedule           String?
  workMode               WorkMode       @default(ON_SITE)
  workLocation           String
  overtimeEligible       Boolean        @default(true)
  overtimeRateMultiplier Decimal        @default(1.5) @db.Decimal(3, 2)
  annualLeaveDays        Int            @default(21)
  sickLeaveDays          Int            @default(12)
  maternityLeaveDays     Int            @default(90)
  paternityLeaveDays     Int            @default(10)
  otherLeaveEntitlements Json?
  noticePeriodDays       Int?
  terminationConditions  String?        @db.Text
  severanceTerms         Json?
  nonCompeteClause       Boolean        @default(false)
  nonCompeteMonths       Int?
  confidentialityClause  Boolean        @default(true)
  status                 ContractStatus @default(DRAFT)
  preparedBy             Int
  approvedBy             Int?
  approvedAt             DateTime?
  approvalNotes          String?        @db.Text
  signedByEmployee       Boolean        @default(false)
  employeeSignedAt       DateTime?
  signedByEmployer       Boolean        @default(false)
  employerSignedAt       DateTime?
  employerSignatory      Int?
  contractFilePath       String?
  previousContractId     Int?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relations
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position           Position           @relation(fields: [positionId], references: [id])
  salaryStructure    SalaryStructure?   @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  previousContract   EmployeeContract?  @relation("ContractHistory", fields: [previousContractId], references: [id], onDelete: SetNull)
  replacedByContract EmployeeContract[] @relation("ContractHistory")

  @@unique([companyId, contractNumber])
  @@index([companyId, branchId, employeeId])
  @@index([contractType, status])
  @@index([startDate, endDate])
  @@map("employee_contracts")
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  CASUAL
  CONTRACT
  TEMPORARY
  PROBATIONARY
  INTERNSHIP
  APPRENTICESHIP
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum ContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

model EmployeeDocument {
  id                 Int            @id @default(autoincrement())
  employeeId         Int
  documentCode       String
  documentName       String
  documentType       DocumentType
  documentCategory   String
  description        String?        @db.Text
  documentNumber     String?
  issueDate          DateTime?      @db.Date
  expiryDate         DateTime?      @db.Date
  issuingAuthority   String?
  issuingCountry     String         @default("Nigeria")
  fileName           String
  originalFileName   String
  filePath           String
  fileExtension      String
  mimeType           String
  fileSize           BigInt
  fileHash           String
  status             DocumentStatus @default(UPLOADED)
  isMandatory        Boolean        @default(false)
  isConfidential     Boolean        @default(false)
  isVerified         Boolean        @default(false)
  verifiedDate       DateTime?      @db.Date
  verifiedBy         Int?
  verificationNotes  String?        @db.Text
  hasExpiry          Boolean        @default(false)
  expiryReminderDays Int?
  expiryReminderSent Boolean        @default(false)
  version            Int            @default(1)
  isCurrentVersion   Boolean        @default(true)
  previousVersionId  Int?
  uploadedBy         Int
  uploadedAt         DateTime       @default(now())
  internalNotes      String?        @db.Text
  tags               Json?
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousVersion EmployeeDocument?  @relation("DocumentVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  newerVersions   EmployeeDocument[] @relation("DocumentVersions")

  @@unique([employeeId, documentCode])
  @@index([employeeId, documentType])
  @@index([status, isVerified])
  @@index([hasExpiry, expiryDate])
  @@map("employee_documents")
}

enum DocumentType {
  IDENTIFICATION
  EDUCATIONAL
  PROFESSIONAL
  EMPLOYMENT
  MEDICAL
  FINANCIAL
  LEGAL
  REFERENCE
  CERTIFICATE
  LICENSE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REPLACED
}

// ============================================================================
// HR PAYROLL MODULE - Payroll Calendars & Periods
// ============================================================================

model PayrollCalendar {
  id           Int              @id @default(autoincrement())
  companyId    Int
  branchId     Int?
  departmentId Int?
  name         String
  code         String
  description  String?          @db.Text
  frequency    PayrollFrequency @default(MONTHLY)
  payDay       Int              @default(25)
  periodStart  DateTime         @db.Date
  periodEnd    DateTime         @db.Date
  payDate      DateTime         @db.Date
  status       String           @default("draft") // draft, active, processed, closed
  isActive     Boolean          @default(true)
  metadata     Json?
  notes        String?          @db.Text
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  periods  PayrollPeriod[]
  payrolls    Payroll[]
  payrollRuns PayrollRun[]

  @@unique([companyId, branchId, code])
  @@unique([companyId, branchId, name])
  @@index([frequency, status])
  @@map("payroll_calendars")
}

enum PayrollFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

model PayrollPeriod {
  id                Int       @id @default(autoincrement())
  companyId         Int
  payrollCalendarId Int
  periodStart       DateTime  @db.Date
  periodEnd         DateTime  @db.Date
  payDate           DateTime  @db.Date
  name              String
  code              String?
  status            String    @default("draft") // draft, open, processing, processed, approved, closed
  employeeCount     Int       @default(0)
  totalGross        Decimal   @default(0) @db.Decimal(15, 2)
  totalNet          Decimal   @default(0) @db.Decimal(15, 2)
  totalDeductions   Decimal   @default(0) @db.Decimal(15, 2)
  openedAt          DateTime?
  processedAt       DateTime?
  approvedAt        DateTime?
  closedAt          DateTime?
  processedBy       Int?
  approvedBy        Int?
  closedBy          Int?
  color             String?
  metadata          Json?
  notes             String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  payrollCalendar PayrollCalendar @relation(fields: [payrollCalendarId], references: [id], onDelete: Cascade)

  @@unique([payrollCalendarId, periodStart, periodEnd])
  @@index([companyId, periodStart, periodEnd])
  @@index([payrollCalendarId, status])
  @@map("payroll_periods")
}

// ============================================================================
// HR PAYROLL MODULE - Payroll Components & Items
// ============================================================================

model PayrollComponent {
  id                         Int               @id @default(autoincrement())
  companyId                  Int
  branchId                   Int?
  name                       String
  code                       String
  shortName                  String?
  description                String?           @db.Text
  type                       ComponentType     @default(EARNINGS)
  category                   String
  calculationMethod          CalculationMethod @default(FIXED_AMOUNT)
  defaultRate                Decimal?          @db.Decimal(8, 4)
  defaultAmount              Decimal?          @db.Decimal(15, 2)
  minimumAmount              Decimal?          @db.Decimal(15, 2)
  maximumAmount              Decimal?          @db.Decimal(15, 2)
  calculationFormula         String?           @db.Text
  formulaParameters          Json?
  isStatutory                Boolean           @default(false)
  statutoryAgency            String?
  employerRate               Decimal?          @db.Decimal(8, 4)
  employeeRate               Decimal?          @db.Decimal(8, 4)
  taxable                    Boolean           @default(true)
  affectsPensionCalculation  Boolean           @default(true)
  affectsGratuityCalculation Boolean           @default(true)
  proRatable                 Boolean           @default(true)
  requiresApproval           Boolean           @default(false)
  showOnPayslip              Boolean           @default(true)
  displayOrder               Int               @default(0)
  frequency                  String            @default("monthly")
  isActive                   Boolean           @default(true)
  isSystemComponent          Boolean           @default(false)
  effectiveFrom              DateTime          @db.Date
  effectiveTo                DateTime?         @db.Date
  createdBy                  Int
  approvedBy                 Int?
  approvedAt                 DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  salaryStructureComponents SalaryStructureComponent[]
  payrollComponentValues    PayrollComponentValue[]

  @@unique([companyId, branchId, code])
  @@unique([companyId, branchId, name])
  @@index([companyId, type, isActive])
  @@index([category, isStatutory])
  @@map("payroll_components")
}

enum ComponentType {
  EARNINGS
  DEDUCTIONS
}

enum CalculationMethod {
  FIXED_AMOUNT
  PERCENTAGE_OF_BASIC
  PERCENTAGE_OF_GROSS
  FORMULA
  MANUAL
}

model PayrollItem {
  id                Int       @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  name              String
  code              String
  description       String?   @db.Text
  calculationType   String    @default("fixed") // fixed, percentage
  baseOn            String    @default("flat_amount") // basic_salary, gross_salary, flat_amount, annual_salary
  defaultPercentage Decimal?  @db.Decimal(8, 4)
  defaultAmount     Decimal?  @db.Decimal(15, 2)
  isTaxable         Boolean   @default(true)
  isPensionable     Boolean   @default(false)
  affectsGross      Boolean   @default(true)
  isDeduction       Boolean   @default(false)
  category          String    @default("allowance") // basic, allowance, bonus, overtime, deduction, statutory, benefit, other
  displayOrder      Int       @default(0)
  showOnPayslip     Boolean   @default(true)
  isActive          Boolean   @default(true)
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  createdBy         Int
  approvedBy        Int?
  approvedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  gradeLevels GradeLevelPayrollItem[]

  @@unique([companyId, branchId, code])
  @@index([companyId, branchId, isActive])
  @@index([category, isActive])
  @@map("payroll_items")
}

model GradeLevelPayrollItem {
  id                      Int      @id @default(autoincrement())
  gradeLevelId            Int
  payrollItemId           Int
  // Phase-2 forward FK — see comment on SalaryStructureComponent.payElementId.
  payElementId            Int?
  amount                  Decimal? @db.Decimal(15, 2)
  percentage              Decimal? @db.Decimal(8, 4)
  calculationTypeOverride String?
  stepIncrement           Decimal  @default(0) @db.Decimal(15, 2)
  stepIncrementPercentage Decimal? @db.Decimal(8, 4)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  gradeLevel  GradeLevel  @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  payElement  PayElement? @relation(fields: [payElementId], references: [id], onDelete: SetNull)

  @@unique([gradeLevelId, payrollItemId])
  @@index([gradeLevelId, isActive])
  @@index([payElementId])
  @@map("grade_level_payroll_item")
}

// ============================================================================
// HR PAYROLL MODULE - Salary Structures
// ============================================================================

model SalaryStructure {
  id                     Int            @id @default(autoincrement())
  companyId              Int
  branchId               Int?
  name                   String
  code                   String
  description            String?        @db.Text
  structureType          StructureType  @default(GRADE_BASED)
  salaryApproach         SalaryApproach @default(STRUCTURED)
  cadreId                Int?
  gradeLevelId           Int?
  baseAmount             Decimal?       @db.Decimal(15, 2)
  baseCalculationMethod  String         @default("fixed")
  baseCalculationFormula String?        @db.Text
  lumpSumAmount          Decimal?       @db.Decimal(15, 2)
  lumpSumTaxable         Boolean        @default(true)
  requiresApproval       Boolean        @default(true)
  approvalWorkflow       Json?
  isActive               Boolean        @default(true)
  isDefaultForCadre      Boolean        @default(false)
  isDefaultForGrade      Boolean        @default(false)
  effectiveFrom          DateTime       @db.Date
  effectiveTo            DateTime?      @db.Date
  createdBy              Int
  approvedBy             Int?
  approvedAt             DateTime?
  approvalNotes          String?        @db.Text
  metadata               Json?
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relations
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cadre      Cadre?      @relation(fields: [cadreId], references: [id], onDelete: SetNull)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)

  employees        Employee[]
  contracts        EmployeeContract[]
  components       SalaryStructureComponent[]
  payrolls         Payroll[]
  gradeAssignments EmployeeGradeAssignment[]

  @@unique([companyId, branchId, code])
  @@unique([companyId, branchId, name])
  @@index([companyId, branchId, isActive])
  @@index([structureType, salaryApproach])
  @@map("salary_structures")
}

enum StructureType {
  CADRE_BASED
  GRADE_BASED
  POSITION_BASED
  CUSTOM
}

enum SalaryApproach {
  STRUCTURED
  UNSTRUCTURED
}

model SalaryStructureComponent {
  id                 Int       @id @default(autoincrement())
  salaryStructureId  Int
  payrollComponentId Int
  // Phase-2 forward FK to the consolidated pay_elements table.
  // Nullable during the transition; backfilled from legacyId on existing rows.
  // payroll-calculation reads this first, falls back to payrollComponentId.
  payElementId       Int?
  amount             Decimal?  @db.Decimal(15, 2)
  rate               Decimal?  @db.Decimal(8, 4)
  calculationFormula String?   @db.Text
  minimumAmount      Decimal?  @db.Decimal(15, 2)
  maximumAmount      Decimal?  @db.Decimal(15, 2)
  isMandatory        Boolean   @default(true)
  isVariable         Boolean   @default(false)
  calculationMethod  String?
  proRatable         Boolean   @default(true)
  taxableOverride    Boolean?
  displayOrder       Int       @default(0)
  showOnPayslip      Boolean   @default(true)
  displayName        String?
  effectiveFrom      DateTime  @db.Date
  effectiveTo        DateTime? @db.Date
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  salaryStructure  SalaryStructure  @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  payrollComponent PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade)
  payElement       PayElement?      @relation(fields: [payElementId], references: [id], onDelete: SetNull)

  @@unique([salaryStructureId, payrollComponentId])
  @@index([isActive, salaryStructureId])
  @@index([payElementId])
  @@map("salary_structure_components")
}

// ============================================================================
// HR PAYROLL MODULE - Payrolls & Component Values
// ============================================================================

model Payroll {
  id                          Int           @id @default(autoincrement())
  employeeId                  Int
  payrollCalendarId           Int?
  salaryStructureId           Int?
  employeeGradeAssignmentId   Int?
  payrollPeriod               String
  payDate                     DateTime      @db.Date
  periodStart                 DateTime      @db.Date
  periodEnd                   DateTime      @db.Date
  workingDaysInPeriod         Int           @default(0)
  daysWorked                  Int           @default(0)
  attendancePercentage        Decimal       @default(100) @db.Decimal(5, 2)
  salaryType                  SalaryType    @default(STRUCTURED)
  baseSalaryAmount            Decimal       @default(0) @db.Decimal(15, 2)
  proratedBaseAmount          Decimal       @default(0) @db.Decimal(15, 2)
  lumpSumGross                Decimal?      @db.Decimal(15, 2)
  lumpSumDescription          String?       @db.Text
  totalEarnings               Decimal       @default(0) @db.Decimal(15, 2)
  totalDeductions             Decimal       @default(0) @db.Decimal(15, 2)
  grossPay                    Decimal       @default(0) @db.Decimal(15, 2)
  netPay                      Decimal       @default(0) @db.Decimal(15, 2)
  taxableIncome               Decimal       @default(0) @db.Decimal(15, 2)
  taxReliefAmount             Decimal       @default(0) @db.Decimal(15, 2)
  chargeableIncome            Decimal       @default(0) @db.Decimal(15, 2)
  payeTax                     Decimal       @default(0) @db.Decimal(15, 2)
  employeePensionContribution Decimal       @default(0) @db.Decimal(15, 2)
  nhfEmployee                 Decimal       @default(0) @db.Decimal(15, 2)
  nhisEmployee                Decimal       @default(0) @db.Decimal(15, 2)
  employerPensionContribution Decimal       @default(0) @db.Decimal(15, 2)
  employerNhisContribution    Decimal       @default(0) @db.Decimal(15, 2)
  employerNsitfContribution   Decimal       @default(0) @db.Decimal(15, 2)
  employerItfContribution     Decimal       @default(0) @db.Decimal(15, 2)
  totalEmployerCost           Decimal       @default(0) @db.Decimal(15, 2)
  status                      PayrollStatus @default(DRAFT)
  isManualOverride            Boolean       @default(false)
  overrideReason              String?       @db.Text
  calculationLog              Json?
  calculatedBy                Int?
  calculatedAt                DateTime?
  reviewedBy                  Int?
  reviewedAt                  DateTime?
  approvedBy                  Int?
  approvedAt                  DateTime?
  approvalNotes               String?       @db.Text
  isPaid                      Boolean       @default(false)
  paidDate                    DateTime?     @db.Date
  paymentReference            String?
  paymentMethod               String?
  notes                       String?       @db.Text
  metadata                    Json?
  deletedAt                   DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  // Relations
  employee        Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollCalendar PayrollCalendar?         @relation(fields: [payrollCalendarId], references: [id], onDelete: SetNull)
  salaryStructure SalaryStructure?         @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  gradeAssignment EmployeeGradeAssignment? @relation(fields: [employeeGradeAssignmentId], references: [id], onDelete: SetNull)

  componentValues     PayrollComponentValue[]
  statutoryDeductions StatutoryDeduction[]
  company             Company?                @relation(fields: [companyId], references: [id])
  companyId           Int?
  payrollRunId        Int?
  payrollRun          PayrollRun?             @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@unique([employeeId, payrollPeriod])
  @@index([employeeId, payDate])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  PROCESSED
  PAID
  CANCELLED
}

model PayrollRun {
  id                Int              @id @default(autoincrement())
  companyId         Int
  payrollCalendarId Int?
  payrollPeriod     String
  periodStart       DateTime         @db.Date
  periodEnd         DateTime         @db.Date
  payDate           DateTime         @db.Date
  totalEmployees    Int              @default(0)
  totalGrossPay     Decimal          @default(0) @db.Decimal(15, 2)
  totalNetPay       Decimal          @default(0) @db.Decimal(15, 2)
  totalDeductions   Decimal          @default(0) @db.Decimal(15, 2)
  totalEmployerCost Decimal          @default(0) @db.Decimal(15, 2)
  totalPayeTax      Decimal          @default(0) @db.Decimal(15, 2)
  totalPension      Decimal          @default(0) @db.Decimal(15, 2)
  status            PayrollRunStatus @default(DRAFT)
  submittedById     Int?
  submittedAt       DateTime?
  approvedById      Int?
  approvedAt        DateTime?
  bankAccountId     Int?
  paymentReference  String?
  paymentDate       DateTime?        @db.Date
  paidById          Int?
  paidAt            DateTime?
  journalEntryId    Int?
  notes             String?          @db.Text
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  payrollCalendar PayrollCalendar? @relation(fields: [payrollCalendarId], references: [id], onDelete: SetNull)
  payrolls        Payroll[]

  @@index([companyId, payrollPeriod])
  @@map("payroll_runs")
}

enum PayrollRunStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model PayrollComponentValue {
  id                           Int       @id @default(autoincrement())
  payrollId                    Int
  payrollComponentId           Int
  calculatedAmount             Decimal   @default(0) @db.Decimal(15, 2)
  overrideAmount               Decimal?  @db.Decimal(15, 2)
  finalAmount                  Decimal   @default(0) @db.Decimal(15, 2)
  baseAmount                   Decimal?  @db.Decimal(15, 2)
  rateUsed                     Decimal?  @db.Decimal(8, 4)
  calculationFormulaUsed       String?   @db.Text
  formulaVariables             Json?
  isProrated                   Boolean   @default(false)
  prorationFactor              Decimal   @default(1) @db.Decimal(8, 4)
  prorationReason              String?   @db.Text
  adjustmentAmount             Decimal   @default(0) @db.Decimal(15, 2)
  adjustmentReason             String?   @db.Text
  isManualOverride             Boolean   @default(false)
  overriddenBy                 Int?
  overriddenAt                 DateTime?
  overrideReason               String?   @db.Text
  originalCalculatedAmount     Decimal?  @db.Decimal(15, 2)
  isTaxable                    Boolean   @default(true)
  affectsStatutoryCalculations Boolean   @default(true)
  taxImpact                    Decimal   @default(0) @db.Decimal(15, 2)
  status                       String    @default("calculated")
  requiresApproval             Boolean   @default(false)
  approvedBy                   Int?
  approvedAt                   DateTime?
  calculationAuditTrail        Json?
  hasVarianceFromStructure     Boolean   @default(false)
  varianceAmount               Decimal   @default(0) @db.Decimal(15, 2)
  varianceExplanation          String?   @db.Text
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  // Relations
  payroll          Payroll          @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  payrollComponent PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade)

  @@unique([payrollId, payrollComponentId])
  @@index([status, payrollId])
  @@map("payroll_component_values")
}

// ============================================================================
// HR PAYROLL MODULE - Statutory Deductions
// ============================================================================

model StatutoryDeduction {
  id                              Int       @id @default(autoincrement())
  employeeId                      Int
  payrollId                       Int?
  deductionCode                   String
  deductionName                   String
  deductionCategory               String // tax, pension, housing, health, insurance, training, withholding
  grossSalary                     Decimal   @default(0) @db.Decimal(15, 2)
  taxableIncome                   Decimal   @default(0) @db.Decimal(15, 2)
  deductionRate                   Decimal   @default(0) @db.Decimal(8, 4)
  fixedAmount                     Decimal   @default(0) @db.Decimal(15, 2)
  minimumAmount                   Decimal   @default(0) @db.Decimal(15, 2)
  maximumAmount                   Decimal   @default(0) @db.Decimal(15, 2)
  calculatedAmount                Decimal   @default(0) @db.Decimal(15, 2)
  employerContribution            Decimal   @default(0) @db.Decimal(15, 2)
  employeeContribution            Decimal   @default(0) @db.Decimal(15, 2)
  totalContribution               Decimal   @default(0) @db.Decimal(15, 2)
  annualSalary                    Decimal?  @db.Decimal(15, 2)
  consolidatedRelief              Decimal?  @db.Decimal(15, 2)
  lifeAssuranceRelief             Decimal?  @db.Decimal(15, 2)
  nhfRelief                       Decimal?  @db.Decimal(15, 2)
  pensionRelief                   Decimal?  @db.Decimal(15, 2)
  totalReliefs                    Decimal?  @db.Decimal(15, 2)
  chargeableIncome                Decimal?  @db.Decimal(15, 2)
  taxBracket                      String?
  pensionAdministrator            String?
  pensionAccountNumber            String?
  additionalVoluntaryContribution Decimal   @default(0) @db.Decimal(15, 2)
  nhfNumber                       String?
  nhfEligible                     Boolean   @default(true)
  nhisNumber                      String?
  healthMaintenanceOrganization   String?
  numberOfDependents              Int       @default(0)
  remittancePeriod                String // monthly, quarterly, annually
  dueDate                         DateTime  @db.Date
  remitted                        Boolean   @default(false)
  remittanceDate                  DateTime? @db.Date
  remittanceReference             String?
  remittanceAmount                Decimal?  @db.Decimal(15, 2)
  agencyName                      String
  agencyCode                      String?
  collectionAccount               String?
  taxYear                         Int
  payPeriodMonth                  Int
  payPeriodYear                   String
  isProrated                      Boolean   @default(false)
  prorationReason                 String?   @db.Text
  status                          String    @default("calculated") // calculated, verified, approved, remitted, failed
  calculatedBy                    Int
  verifiedBy                      Int?
  verifiedAt                      DateTime?
  approvedBy                      Int?
  approvedAt                      DateTime?
  calculationDetails              Json?
  notes                           String?   @db.Text
  hasVariance                     Boolean   @default(false)
  varianceExplanation             String?   @db.Text
  deletedAt                       DateTime?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payroll  Payroll? @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([employeeId, deductionCode, payPeriodMonth, payPeriodYear])
  @@index([deductionCode, payPeriodMonth, payPeriodYear])
  @@index([status, dueDate])
  @@index([remitted, remittanceDate])
  @@map("statutory_deductions")
}

model StatutoryDeductionConfig {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  code                   String
  name                   String
  description            String?   @db.Text
  category               String // tax, pension, housing, health, insurance, training, withholding, other
  calculationType        String    @default("percentage") // percentage, fixed, graduated, tiered
  employeeRate           Decimal?  @db.Decimal(8, 4)
  employerRate           Decimal?  @db.Decimal(8, 4)
  fixedAmount            Decimal?  @db.Decimal(15, 2)
  minimumAmount          Decimal?  @db.Decimal(15, 2)
  maximumAmount          Decimal?  @db.Decimal(15, 2)
  isEmployeeContribution Boolean   @default(true)
  isEmployerContribution Boolean   @default(false)
  agencyName             String?
  agencyCode             String?
  collectionAccount      String?
  remittancePeriod       String    @default("monthly")
  remittanceDay          Int       @default(15)
  isTaxable              Boolean   @default(false)
  affectsGross           Boolean   @default(false)
  affectsNet             Boolean   @default(true)
  priority               Int       @default(0)
  isActive               Boolean   @default(true)
  effectiveFrom          DateTime? @db.Date
  effectiveTo            DateTime? @db.Date
  notes                  String?   @db.Text
  createdBy              Int?
  updatedBy              Int?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("statutory_deduction_configs")
}

// ============================================================================
// HR PAYROLL MODULE - Leave Management
// ============================================================================

model Leave {
  id             Int         @id @default(autoincrement())
  employeeId     Int
  leaveCode      String
  leaveType      LeaveType   @default(ANNUAL)
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  resumptionDate DateTime?   @db.Date
  daysRequested  Int
  daysApproved   Int?
  reason         String      @db.Text
  status         LeaveStatus @default(DRAFT)
  balanceBefore  Int         @default(0)
  balanceAfter   Int         @default(0)
  affectsPayroll Boolean     @default(false)
  attachments    Json?
  notes          String?     @db.Text
  approvedBy     Int?
  approvedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveCode])
  @@index([employeeId, status])
  @@index([status, leaveType])
  @@index([startDate, endDate])
  @@map("leaves")
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  CASUAL
  COMPASSIONATE
  STUDY
  UNPAID
}

enum LeaveStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================================
// HR PAYROLL MODULE - Grade Assignments
// ============================================================================

model EmployeeGradeAssignment {
  id                        Int                   @id @default(autoincrement())
  employeeId                Int
  cadreId                   Int
  gradeLevelId              Int
  salaryStructureId         Int?
  currentStep               Int                   @default(1)
  assignmentDate            DateTime              @db.Date
  stepEffectiveDate         DateTime              @db.Date
  nextStepDueDate           DateTime?             @db.Date
  currentBasicSalary        Decimal               @db.Decimal(15, 2)
  stepIncrementAmount       Decimal               @default(0) @db.Decimal(15, 2)
  totalSalary               Decimal               @db.Decimal(15, 2)
  assignmentType            AssignmentType        @default(INITIAL_PLACEMENT)
  assignmentReason          String?               @db.Text
  referenceDocument         String?
  previousCadreId           Int?
  previousGradeLevelId      Int?
  previousStep              Int?
  previousSalary            Decimal?              @db.Decimal(15, 2)
  previousAssignmentEndDate DateTime?             @db.Date
  eligibleForNextStep       Boolean               @default(true)
  lastStepIncrementDate     DateTime?             @db.Date
  eligibleForPromotion      Boolean               @default(true)
  eligibleForPromotionDate  DateTime?             @db.Date
  lastPerformanceScore      Decimal?              @db.Decimal(4, 2)
  lastPerformanceReviewDate DateTime?             @db.Date
  status                    GradeAssignmentStatus @default(DRAFT)
  recommendedBy             Int?
  recommendedAt             DateTime?
  approvedBy                Int?
  approvedAt                DateTime?
  approvalNotes             String?               @db.Text
  effectiveFrom             DateTime              @db.Date
  effectiveTo               DateTime?             @db.Date
  isCurrent                 Boolean               @default(true)
  payrollUpdated            Boolean               @default(false)
  payrollEffectiveDate      DateTime?             @db.Date
  relatedPayrollId          Int?
  calculatedBenefits        Json?
  customAdjustments         Json?
  benefitsRecalculated      Boolean               @default(false)
  createdBy                 Int
  changeHistory             Json?
  notes                     String?               @db.Text
  deletedAt                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  // Relations
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cadre              Cadre            @relation(fields: [cadreId], references: [id], onDelete: Cascade)
  gradeLevel         GradeLevel       @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  salaryStructure    SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  previousCadre      Cadre?           @relation("PreviousCadre", fields: [previousCadreId], references: [id], onDelete: SetNull)
  previousGradeLevel GradeLevel?      @relation("PreviousGradeLevel", fields: [previousGradeLevelId], references: [id], onDelete: SetNull)

  payrolls Payroll[]

  @@unique([employeeId, isCurrent])
  @@index([employeeId, isCurrent])
  @@index([cadreId, gradeLevelId, currentStep])
  @@index([status, assignmentType])
  @@index([effectiveFrom, effectiveTo])
  @@map("employee_grade_assignments")
}

enum AssignmentType {
  INITIAL_PLACEMENT
  PROMOTION
  LATERAL_TRANSFER
  DEMOTION
  STEP_INCREMENT
  SALARY_REVIEW
  STRUCTURE_CHANGE
}

enum GradeAssignmentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  CANCELLED
}

// ============================================================================
// HR PAYROLL MODULE - Benefits & Dependents
// ============================================================================

model Benefit {
  id                    Int          @id @default(autoincrement())
  companyId             Int
  name                  String
  code                  String       @unique
  description           String?      @db.Text
  type                  BenefitType  @default(HEALTH)
  coverageType          CoverageType @default(INDIVIDUAL)
  employerContribution  Decimal      @default(0) @db.Decimal(15, 2)
  employeeContribution  Decimal      @default(0) @db.Decimal(15, 2)
  contributionFrequency String       @default("monthly")
  effectiveDate         DateTime?    @db.Date
  terminationDate       DateTime?    @db.Date
  providerName          String?
  policyNumber          String?
  eligibilityRules      Json?
  waitingPeriodDays     Int          @default(0)
  isTaxable             Boolean      @default(false)
  isActive              Boolean      @default(true)
  createdBy             Int?
  updatedBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  enrollments BenefitEnrollment[]

  @@index([companyId, isActive])
  @@index([companyId, type])
  @@map("benefits")
}

enum BenefitType {
  HEALTH
  DENTAL
  VISION
  LIFE
  RETIREMENT
  DISABILITY
  WELLNESS
  OTHER
}

enum CoverageType {
  INDIVIDUAL
  FAMILY
  INDIVIDUAL_PLUS_SPOUSE
  INDIVIDUAL_PLUS_CHILDREN
}

model Dependent {
  id                 Int                   @id @default(autoincrement())
  companyId          Int
  employeeId         Int
  firstName          String
  lastName           String
  relationship       DependentRelationship @default(SPOUSE)
  dateOfBirth        DateTime?             @db.Date
  gender             Gender?
  nationalId         String?
  phone              String?
  email              String?
  address            String?               @db.Text
  isEmergencyContact Boolean               @default(false)
  isCovered          Boolean               @default(true)
  isDisabled         Boolean               @default(false)
  isStudent          Boolean               @default(false)
  coverageStartDate  DateTime?             @db.Date
  coverageEndDate    DateTime?             @db.Date
  documents          Json?
  notes              String?               @db.Text
  createdBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  enrollments BenefitEnrollmentDependent[]

  @@index([employeeId, relationship])
  @@index([employeeId, isCovered])
  @@map("dependents")
}

enum DependentRelationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  DOMESTIC_PARTNER
  OTHER
}

model BenefitEnrollment {
  id                   Int              @id @default(autoincrement())
  companyId            Int
  employeeId           Int
  benefitId            Int
  enrollmentNumber     String           @unique
  enrollmentDate       DateTime         @db.Date
  coverageStartDate    DateTime         @db.Date
  coverageEndDate      DateTime?        @db.Date
  coverageLevel        CoverageLevel    @default(EMPLOYEE_ONLY)
  employeeContribution Decimal          @default(0) @db.Decimal(15, 2)
  employerContribution Decimal          @default(0) @db.Decimal(15, 2)
  totalPremium         Decimal          @default(0) @db.Decimal(15, 2)
  status               EnrollmentStatus @default(DRAFT)
  cancellationReason   String?          @db.Text
  cancellationDate     DateTime?        @db.Date
  coveredDependents    Json?
  notes                String?          @db.Text
  createdBy            Int?
  approvedBy           Int?
  approvedAt           DateTime?
  rejectedBy           Int?
  rejectedAt           DateTime?
  rejectionReason      String?          @db.Text
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefit  Benefit  @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  dependents BenefitEnrollmentDependent[]

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([benefitId, status])
  @@map("benefit_enrollments")
}

enum CoverageLevel {
  EMPLOYEE_ONLY
  EMPLOYEE_SPOUSE
  EMPLOYEE_CHILDREN
  FAMILY
}

enum EnrollmentStatus {
  DRAFT
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model BenefitEnrollmentDependent {
  id                  Int       @id @default(autoincrement())
  benefitEnrollmentId Int
  dependentId         Int
  coverageStartDate   DateTime? @db.Date
  coverageEndDate     DateTime? @db.Date
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  benefitEnrollment BenefitEnrollment @relation(fields: [benefitEnrollmentId], references: [id], onDelete: Cascade)
  dependent         Dependent         @relation(fields: [dependentId], references: [id], onDelete: Cascade)

  @@unique([benefitEnrollmentId, dependentId])
  @@map("benefit_enrollment_dependent")
}

// ============================================================================
// HR PAYROLL MODULE - Loans
// ============================================================================

model LoanType {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  name                  String
  code                  String
  description           String?   @db.Text
  interestRate          Decimal   @default(0) @db.Decimal(8, 4)
  interestType          String    @default("flat") // flat, reducing_balance
  maxAmount             Decimal?  @db.Decimal(15, 2)
  minAmount             Decimal?  @db.Decimal(15, 2)
  maxTenure             Int       @default(12) // max months
  minTenure             Int       @default(1)
  maxPercentageOfSalary Decimal?  @db.Decimal(8, 4) // max % of salary that can be borrowed
  requiresGuarantor     Boolean   @default(false)
  minGuarantors         Int       @default(0)
  eligibilityMonths     Int       @default(6) // min months of service
  processingFee         Decimal   @default(0) @db.Decimal(15, 2)
  processingFeeType     String    @default("fixed") // fixed, percentage
  isActive              Boolean   @default(true)
  requiresApproval      Boolean   @default(true)
  approvalLevels        Int       @default(1)
  deductionStartOption  String    @default("next_month") // same_month, next_month, custom
  allowMultipleActive   Boolean   @default(false)
  createdBy             Int?
  updatedBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  loans   EmployeeLoan[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("loan_types")
}

model EmployeeLoan {
  id                    Int        @id @default(autoincrement())
  companyId             Int
  employeeId            Int
  loanTypeId            Int
  loanNumber            String     @unique
  applicationDate       DateTime   @db.Date
  approvalDate          DateTime?  @db.Date
  disbursementDate      DateTime?  @db.Date
  principalAmount       Decimal    @db.Decimal(15, 2)
  interestAmount        Decimal    @default(0) @db.Decimal(15, 2)
  totalAmount           Decimal    @db.Decimal(15, 2)
  processingFee         Decimal    @default(0) @db.Decimal(15, 2)
  interestRate          Decimal    @db.Decimal(8, 4)
  tenureMonths          Int
  monthlyDeduction      Decimal    @db.Decimal(15, 2)
  deductionStartDate    DateTime?  @db.Date
  deductionEndDate      DateTime?  @db.Date
  totalDeducted         Decimal    @default(0) @db.Decimal(15, 2)
  outstandingBalance    Decimal    @db.Decimal(15, 2)
  deductionsRemaining   Int
  status                LoanStatus @default(PENDING)
  purpose               String?    @db.Text
  guarantors            Json? // Array of guarantor employee IDs
  bankAccountId         Int?
  disbursementMethod    String     @default("bank") // bank, cash, payroll
  disbursementReference String?
  applicationNotes      String?    @db.Text
  approvalNotes         String?    @db.Text
  rejectionReason       String?    @db.Text
  documents             Json?
  metadata              Json?
  appliedBy             Int
  approvedBy            Int?
  rejectedBy            Int?
  rejectedAt            DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelledBy           Int?
  cancellationReason    String?    @db.Text
  deletedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanType   LoanType        @relation(fields: [loanTypeId], references: [id], onDelete: Restrict)
  deductions LoanDeduction[]
  repayments LoanRepayment[]

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([loanTypeId, status])
  @@index([employeeId, status])
  @@map("employee_loans")
}

enum LoanStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
  DEFAULTED
}

model LoanDeduction {
  id              Int       @id @default(autoincrement())
  employeeLoanId  Int
  payrollPeriodId Int?
  deductionDate   DateTime  @db.Date
  amount          Decimal   @db.Decimal(15, 2)
  principalPart   Decimal   @db.Decimal(15, 2)
  interestPart    Decimal   @default(0) @db.Decimal(15, 2)
  balanceAfter    Decimal   @db.Decimal(15, 2)
  status          String    @default("pending") // pending, processed, failed, reversed
  processedAt     DateTime?
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  employeeLoan EmployeeLoan @relation(fields: [employeeLoanId], references: [id], onDelete: Cascade)

  @@index([employeeLoanId, status])
  @@index([payrollPeriodId])
  @@map("loan_deductions")
}

model LoanRepayment {
  id             Int      @id @default(autoincrement())
  employeeLoanId Int
  repaymentDate  DateTime @db.Date
  amount         Decimal  @db.Decimal(15, 2)
  principalPart  Decimal  @db.Decimal(15, 2)
  interestPart   Decimal  @default(0) @db.Decimal(15, 2)
  balanceAfter   Decimal  @db.Decimal(15, 2)
  paymentMethod  String   @default("payroll") // payroll, cash, bank, other
  reference      String?
  receiptNumber  String?
  notes          String?  @db.Text
  receivedBy     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  employeeLoan EmployeeLoan @relation(fields: [employeeLoanId], references: [id], onDelete: Cascade)

  @@index([employeeLoanId])
  @@index([repaymentDate])
  @@map("loan_repayments")
}

// ============================================================================
// HR PAYROLL MODULE - Ad-hoc Employee Deductions (penalties, adjustments, etc.)
// ============================================================================

model EmployeeDeduction {
  id            Int       @id @default(autoincrement())
  companyId     Int
  employeeId    Int
  code          String    // e.g. PENALTY, DAMAGE, ADVANCE_RECOVERY
  description   String    @db.Text
  amount        Decimal   @db.Decimal(15, 2)
  deductionType String    @default("one_time") // one_time, recurring
  frequency     String?   // monthly, quarterly (for recurring)
  remainingCount Int?     // for recurring: how many more times to deduct
  effectiveDate DateTime  @db.Date // when to start deducting
  endDate       DateTime? @db.Date // optional end date for recurring
  status        String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  isProcessed   Boolean   @default(false) // true after deducted in payroll (for one_time)
  processedInPayrollId Int? // which payroll run deducted this
  approvedBy    Int?
  notes         String?   @db.Text
  createdBy     Int
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, status])
  @@index([effectiveDate, status])
  @@map("employee_deductions")
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Geofencing
// ============================================================================

model Geofence {
  id                Int          @id @default(autoincrement())
  companyId         Int
  name              String
  code              String       @unique
  description       String?      @db.Text
  type              GeofenceType @default(POLYGON)
  coordinates       Json // Array of lat/lng points
  centerLatitude    Decimal?     @db.Decimal(10, 8)
  centerLongitude   Decimal?     @db.Decimal(11, 8)
  radius            Decimal?     @db.Decimal(10, 2) // meters for circle type
  color             String       @default("#3B82F6")
  address           String?      @db.Text
  speedLimit        Int? // km/h
  alertOnEntry      Boolean      @default(true)
  alertOnExit       Boolean      @default(true)
  alertOnSpeedLimit Boolean      @default(false)
  alertRecipients   Json? // Array of user IDs or emails
  isActive          Boolean      @default(true)
  metadata          Json?
  createdBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  alerts             GeofenceAlert[]
  vehicleAssignments VehicleGeofence[]

  @@index([companyId, isActive])
  @@map("geofences")
}

enum GeofenceType {
  POLYGON
  CIRCLE
  RECTANGLE
}

model GeofenceAlert {
  id             Int               @id @default(autoincrement())
  geofenceId     Int
  vehicleId      Int
  alertType      GeofenceAlertType @default(ENTRY)
  latitude       Decimal           @db.Decimal(10, 8)
  longitude      Decimal           @db.Decimal(11, 8)
  speed          Decimal?          @db.Decimal(6, 2)
  address        String?           @db.Text
  driverId       Int?
  tripId         Int?
  acknowledgedBy Int?
  acknowledgedAt DateTime?
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())

  // Relations
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([geofenceId, createdAt])
  @@index([vehicleId, createdAt])
  @@map("geofence_alerts")
}

enum GeofenceAlertType {
  ENTRY
  EXIT
  SPEED_VIOLATION
  DWELL_TIME
}

model VehicleGeofence {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  geofenceId Int
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  // Relations
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, geofenceId])
  @@map("vehicle_geofences")
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Vehicle Groups & Vehicles
// ============================================================================

model VehicleGroup {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String
  code        String    @unique
  description String?   @db.Text
  parentId    Int?
  isActive    Boolean   @default(true)
  createdBy   Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  parent   VehicleGroup?  @relation("VehicleGroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children VehicleGroup[] @relation("VehicleGroupHierarchy")
  vehicles Vehicle[]
  company  Company        @relation(fields: [companyId], references: [id])

  @@index([companyId, isActive])
  @@map("vehicle_groups")
}

model Vehicle {
  id                     Int              @id @default(autoincrement())
  companyId              Int
  branchId               Int?
  vehicleGroupId         Int?
  registrationNumber     String           @unique
  name                   String?
  make                   String
  model                  String
  year                   Int?
  vin                    String?          @unique
  engineNumber           String?
  chassisNumber          String?
  color                  String?
  fuelType               FuelType         @default(PETROL)
  fuelCapacity           Decimal?         @db.Decimal(10, 2)
  ownershipType          String?          @db.VarChar(20) // OWNED / LEASED / RENTED — enum lives in DTO
  transmissionType       TransmissionType @default(MANUAL)
  vehicleType            String?
  seatingCapacity        Int              @default(1)
  loadCapacity           Decimal?         @db.Decimal(10, 2)
  loadCapacityUnit       String?          @default("kg")
  purchaseDate           DateTime?        @db.Date
  purchasePrice          Decimal?         @db.Decimal(15, 2)
  currentValue           Decimal?         @db.Decimal(15, 2)
  depreciationRate       Decimal?         @db.Decimal(5, 2)
  insuranceProvider      String?
  insurancePolicyNumber  String?
  insuranceExpiryDate    DateTime?        @db.Date
  registrationExpiryDate DateTime?        @db.Date
  roadworthinessExpiry   DateTime?        @db.Date
  currentOdometer        Decimal          @default(0) @db.Decimal(12, 2)
  lastServiceMileage     Decimal?         @db.Decimal(12, 2)
  nextServiceMileage     Decimal?         @db.Decimal(12, 2)
  lastServiceDate        DateTime?        @db.Date
  nextServiceDate        DateTime?        @db.Date
  status                 VehicleStatus    @default(ACTIVE)
  currentDriverId        Int?
  currentLocationLat     Decimal?         @db.Decimal(10, 8)
  currentLocationLng     Decimal?         @db.Decimal(11, 8)
  lastLocationUpdate     DateTime?
  trackerDeviceId        String?
  trackerImei            String?
  fuelCardNumber         String?
  image                  String?
  documents              Json?
  notes                  String?          @db.Text
  metadata               Json?
  // Per-vehicle default rates — override the per-service-type defaults
  // when set. Booking pricing cascades: booking-override → vehicle → service
  // type → manual.
  defaultFlatRate        Decimal?         @db.Decimal(15, 2)
  defaultHourlyRate      Decimal?         @db.Decimal(15, 2)
  defaultDailyRate       Decimal?         @db.Decimal(15, 2)
  defaultKmRate          Decimal?         @db.Decimal(15, 2)
  defaultChargeModel     String?          // FLAT | HOURLY | DAILY | PER_KM
  isActive               Boolean          @default(true)
  createdBy              Int?
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Relations
  vehicleGroup VehicleGroup? @relation(fields: [vehicleGroupId], references: [id], onDelete: SetNull)

  tyres              Tyre[]
  maintenanceRecords VehicleMaintenance[]
  fuelRecords        FuelRecord[]
  bookings           VehicleBooking[]
  trips              Trip[]
  geofenceAlerts     GeofenceAlert[]
  geofences          VehicleGeofence[]
  inspections        VehicleInspection[]
  incidentRecords    VehicleIncident[]
  company            Company              @relation(fields: [companyId], references: [id])
  loadingOrders      LoadingOrder[]

  @@index([companyId, status])
  @@index([companyId, vehicleGroupId])
  @@index([registrationNumber])
  @@map("vehicles")
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  SEMI_AUTOMATIC
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  SOLD
  SCRAPPED
  // Legacy values left in place for tenants whose enum still carries them.
  // Postgres can't easily drop enum values; the migration remaps any row
  // using these to the new equivalents (see 2026-04-28-006).
  AVAILABLE
  IN_USE
  MAINTENANCE
  RESERVED
  DISPOSED
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Vehicle Cost Entries (internal cost tracking)
// ============================================================================
// One row per cost not tied to a specific trip — e.g. annual insurance,
// licensing, tracker subscription, depreciation posting, periodic maintenance.
// Feeds the Vehicle Cost Report alongside trip-level direct costs.
// ============================================================================
model VehicleCostEntry {
  id           Int                   @id @default(autoincrement())
  companyId    Int
  vehicleId    Int
  costType     VehicleCostType
  amount       Decimal               @db.Decimal(15, 2)
  costDate     DateTime              @db.Date
  // Period-amortized entries (e.g. 12-month insurance) populate both period
  // dates so the report can pro-rate them across overlapping report windows.
  // Point-in-time entries leave periodEnd null and are summed by costDate only.
  periodStart  DateTime?             @db.Date
  periodEnd    DateTime?             @db.Date
  source       VehicleCostEntrySource @default(MANUAL)
  sourceId     Int?
  reference    String?               @db.VarChar(100)
  notes        String?               @db.Text
  createdBy    Int?
  updatedBy    Int?
  deletedAt    DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([companyId, vehicleId])
  @@index([companyId, costType])
  @@index([companyId, costDate])
  @@index([companyId, deletedAt])
  @@map("vehicle_cost_entries")
}

enum VehicleCostType {
  MAINTENANCE
  INSURANCE
  LICENSING
  ROADWORTHINESS
  DEPRECIATION
  TRACKER_SUBSCRIPTION
  TYRE
  OVERHAUL
  PERMIT
  OTHER
}

enum VehicleCostEntrySource {
  MANUAL
  JOURNAL_ENTRY
  MAINTENANCE_RECORD
  DEPRECIATION_POSTING
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Tyres
// ============================================================================

model Tyre {
  id                  Int           @id @default(autoincrement())
  companyId           Int
  vehicleId           Int?
  serialNumber        String        @unique
  brand               String
  model               String?
  size                String
  type                TyreType      @default(RADIAL)
  position            String? // e.g., "FL", "FR", "RL", "RR", "Spare"
  purchaseDate        DateTime?     @db.Date
  purchasePrice       Decimal?      @db.Decimal(10, 2)
  purchaseMileage     Decimal?      @db.Decimal(12, 2)
  installationDate    DateTime?     @db.Date
  installationMileage Decimal?      @db.Decimal(12, 2)
  currentTreadDepth   Decimal?      @db.Decimal(5, 2) // mm
  minimumTreadDepth   Decimal       @default(1.6) @db.Decimal(5, 2)
  maxMileage          Decimal?      @db.Decimal(12, 2)
  currentMileage      Decimal       @default(0) @db.Decimal(12, 2)
  lastRotationDate    DateTime?     @db.Date
  lastRotationMileage Decimal?      @db.Decimal(12, 2)
  nextRotationMileage Decimal?      @db.Decimal(12, 2)
  retreadCount        Int           @default(0)
  maxRetreads         Int           @default(3)
  status              TyreStatus    @default(NEW)
  removalDate         DateTime?     @db.Date
  removalMileage      Decimal?      @db.Decimal(12, 2)
  removalReason       String?       @db.Text
  condition           TyreCondition @default(GOOD)
  notes               String?       @db.Text
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  rotations   TyreRotation[]
  inspections TyreInspection[]

  @@index([companyId, status])
  @@index([vehicleId, position])
  @@map("tyres")
}

enum TyreType {
  RADIAL
  BIAS
  RUN_FLAT
  TUBELESS
  TUBE_TYPE
}

enum TyreStatus {
  NEW
  IN_USE
  IN_STOCK
  RETREADING
  DISPOSED
}

enum TyreCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CONDEMNED
}

model TyreRotation {
  id                Int      @id @default(autoincrement())
  tyreId            Int
  vehicleId         Int
  rotationDate      DateTime @db.Date
  mileageAtRotation Decimal  @db.Decimal(12, 2)
  previousPosition  String
  newPosition       String
  treadDepthBefore  Decimal? @db.Decimal(5, 2)
  treadDepthAfter   Decimal? @db.Decimal(5, 2)
  performedBy       Int?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  // Relations
  tyre Tyre @relation(fields: [tyreId], references: [id], onDelete: Cascade)

  @@index([tyreId, rotationDate])
  @@map("tyre_rotations")
}

model TyreInspection {
  id                  Int           @id @default(autoincrement())
  tyreId              Int
  vehicleId           Int?
  inspectionDate      DateTime      @db.Date
  mileageAtInspection Decimal?      @db.Decimal(12, 2)
  treadDepth          Decimal       @db.Decimal(5, 2)
  pressure            Decimal?      @db.Decimal(5, 2) // PSI
  condition           TyreCondition
  damageNotes         String?       @db.Text
  recommendation      String?       @db.Text
  inspectedBy         Int?
  createdAt           DateTime      @default(now())

  // Relations
  tyre Tyre @relation(fields: [tyreId], references: [id], onDelete: Cascade)

  @@index([tyreId, inspectionDate])
  @@map("tyre_inspections")
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Maintenance
// ============================================================================

model VehicleMaintenance {
  id                 Int                 @id @default(autoincrement())
  companyId          Int
  vehicleId          Int
  maintenanceNumber  String              @unique
  maintenanceType    MaintenanceType     @default(SCHEDULED)
  category           String? // e.g., "Engine", "Brakes", "Electrical"
  description        String              @db.Text
  scheduledDate      DateTime?           @db.Date
  startDate          DateTime?           @db.Date
  completionDate     DateTime?           @db.Date
  mileageAtService   Decimal?            @db.Decimal(12, 2)
  nextServiceMileage Decimal?            @db.Decimal(12, 2)
  nextServiceDate    DateTime?           @db.Date
  vendorId           Int?
  vendorName         String?
  laborCost          Decimal             @default(0) @db.Decimal(12, 2)
  partsCost          Decimal             @default(0) @db.Decimal(12, 2)
  otherCost          Decimal             @default(0) @db.Decimal(12, 2)
  totalCost          Decimal             @default(0) @db.Decimal(12, 2)
  invoiceNumber      String?
  invoiceDate        DateTime?           @db.Date
  warrantyInfo       String?             @db.Text
  status             MaintenanceStatus   @default(SCHEDULED)
  priority           MaintenancePriority @default(NORMAL)
  assignedTo         Int?
  documents          Json?
  notes              String?             @db.Text
  approvedBy         Int?
  approvedAt         DateTime?
  createdBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  parts        MaintenancePart[]
  laborEntries MaintenanceLabor[]

  @@index([companyId, status])
  @@index([vehicleId, maintenanceType])
  @@index([scheduledDate, status])
  @@map("vehicle_maintenance")
}

enum MaintenanceType {
  SCHEDULED
  UNSCHEDULED
  PREVENTIVE
  CORRECTIVE
  BREAKDOWN
  INSPECTION
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model MaintenancePart {
  id                    Int      @id @default(autoincrement())
  maintenanceId         Int
  itemId                Int?
  partNumber            String?
  partName              String
  description           String?  @db.Text
  quantity              Decimal  @db.Decimal(10, 2)
  unit                  String   @default("PCS")
  unitCost              Decimal  @db.Decimal(12, 2)
  totalCost             Decimal  @db.Decimal(12, 2)
  isWarrantyReplacement Boolean  @default(false)
  createdAt             DateTime @default(now())

  // Relations
  maintenance VehicleMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_parts")
}

model MaintenanceLabor {
  id             Int       @id @default(autoincrement())
  maintenanceId  Int
  description    String
  technicianName String?
  technicianId   Int?
  hoursWorked    Decimal   @db.Decimal(6, 2)
  hourlyRate     Decimal   @db.Decimal(10, 2)
  totalCost      Decimal   @db.Decimal(12, 2)
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  maintenance VehicleMaintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_labor")
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Fuel Records
// ============================================================================

model FuelRecord {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  vehicleId           Int
  driverId            Int?
  tripId              Int?
  fuelDate            DateTime  @db.Date
  fuelTime            DateTime? @db.Time()
  fuelType            FuelType  @default(PETROL)
  quantity            Decimal   @db.Decimal(10, 3)
  unit                String    @default("liters")
  pricePerUnit        Decimal   @db.Decimal(10, 2)
  totalCost           Decimal   @db.Decimal(12, 2)
  mileageAtFueling    Decimal   @db.Decimal(12, 2)
  previousMileage     Decimal?  @db.Decimal(12, 2)
  distanceTraveled    Decimal?  @db.Decimal(12, 2)
  fuelEfficiency      Decimal?  @db.Decimal(6, 2) // km per liter or mpg
  isFillUp            Boolean   @default(true)
  fuelStation         String?
  fuelStationLocation String?   @db.Text
  receiptNumber       String?
  paymentMethod       String?
  fuelCardNumber      String?
  latitude            Decimal?  @db.Decimal(10, 8)
  longitude           Decimal?  @db.Decimal(11, 8)
  receiptImage        String?
  notes               String?   @db.Text
  verifiedBy          Int?
  verifiedAt          DateTime?
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([companyId, fuelDate])
  @@index([vehicleId, fuelDate])
  @@map("fuel_records")
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Bookings
// ============================================================================

model VehicleBooking {
  id                  Int             @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  // vehicleId is now nullable — the actual vehicle is assigned at trip-start,
  // not at booking creation. Existing rows keep their vehicleId; new bookings
  // can sit in PENDING with no vehicle until the fleet desk approves and
  // dispatches.
  vehicleId           Int?
  bookingNumber       String          @unique
  requestedBy         Int
  requestedByName     String?
  departmentId        Int?
  purpose             String          @db.Text
  // pickupLocation = where the requester wants to be picked up.
  // destination already exists and now plays the role of "drop-off location".
  pickupLocation      String?
  destination         String?
  startDateTime       DateTime
  endDateTime         DateTime
  actualStartDateTime DateTime?
  actualEndDateTime   DateTime?
  startMileage        Decimal?        @db.Decimal(12, 2)
  endMileage          Decimal?        @db.Decimal(12, 2)
  assignedDriverId    Int?
  passengers          Json? // Array of passenger names
  numberOfPassengers  Int             @default(1)
  // useChauffeur, airline, airlineLocation, paymentType, officeLocation,
  // vehicleServiceType — all optional service-detail fields surfaced by the
  // create form. They sit in their own column rather than free-form notes so
  // reports can group by them later. vehicleServiceType captures the requested
  // *kind* of vehicle (Truck, Van, Car, …) at booking time; the actual vehicle
  // is assigned later at trip-start and stored in vehicleId.
  //
  // vehicleServiceType is kept as a TEXT column for backwards-compat with rows
  // created before the FleetVehicleServiceType table existed. New bookings
  // also write vehicleServiceTypeId pointing at the catalog row so reports
  // can join cleanly.
  useChauffeur          Boolean?
  airline               String?
  airlineLocation       String?
  paymentType           String?
  officeLocation        String?
  vehicleServiceType    String?
  vehicleServiceTypeId  Int?

  // Pricing snapshot — captured at booking creation/approval. agreedRate is
  // the unit rate (₦/hour, ₦/day, ₦/km, or one-off flat) per chargeModel.
  // agreedAmount is the projected total excluding tax (rate × units of the
  // selected model). Trip-end fills in actualAmount + billedAmount on the
  // trip itself; this snapshot is what the proforma is built from.
  chargeModel           String? // FLAT | HOURLY | DAILY | PER_KM
  agreedRate            Decimal? @db.Decimal(15, 2)
  agreedAmount          Decimal? @db.Decimal(15, 2)
  priority            BookingPriority @default(NORMAL)
  status              BookingStatus   @default(PENDING)
  approvedBy          Int?
  approvedAt          DateTime?
  rejectionReason     String?         @db.Text
  cancellationReason  String?         @db.Text
  checkedOutBy        Int?
  checkedOutAt        DateTime?
  checkedInBy         Int?
  checkedInAt         DateTime?
  conditionOnCheckout String?         @db.Text
  conditionOnCheckin  String?         @db.Text
  fuelLevelOnCheckout String?
  fuelLevelOnCheckin  String?
  notes               String?         @db.Text
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Optional staff-on-behalf-of customer link. Booking made for a CUSTOMER
  // (e.g. fleet desk takes a phone request). Distinct from requestedBy
  // which is always the logged-in user that created the row.
  customerId Int?

  // Relations
  vehicle            Vehicle?                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customer           Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceType        FleetVehicleServiceType?  @relation(fields: [vehicleServiceTypeId], references: [id], onDelete: SetNull)
  taxes              VehicleBookingTax[]
  proformaInvoices   SalesInvoice[]            @relation("ProformaForBooking")

  @@index([companyId, status])
  @@index([vehicleId, startDateTime])
  @@index([requestedBy, status])
  @@index([customerId])
  @@index([vehicleServiceTypeId])
  @@map("vehicle_bookings")
}

/**
 * Vehicle/Service Type catalog. Replaces the localStorage-based catalogue —
 * lives in the DB so per-type default rates can be configured and reports
 * can group by type via FK. System-seeded rows (Truck, Van, Car, etc.) are
 * marked isSystem so users can't delete them; tenants can add custom types.
 */
model FleetVehicleServiceType {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  code                 String    // TRUCK, VAN, CAR, … or custom
  name                 String
  description          String?   @db.Text
  isSystem             Boolean   @default(false)
  isActive             Boolean   @default(true)
  // Default rates — used as fallback when neither the vehicle nor the
  // booking specifies a rate. Per-vehicle defaults override these.
  defaultFlatRate      Decimal?  @db.Decimal(15, 2)
  defaultHourlyRate    Decimal?  @db.Decimal(15, 2)
  defaultDailyRate     Decimal?  @db.Decimal(15, 2)
  defaultKmRate        Decimal?  @db.Decimal(15, 2)
  defaultChargeModel   String?   // FLAT | HOURLY | DAILY | PER_KM
  // GL mapping — when a fleet invoice is posted for this service type,
  // revenue is credited to this account. Falls back to company-wide
  // defaultFleetRevenueAccountId in company_settings if not set.
  revenueGlAccountId   Int?
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  bookings VehicleBooking[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("fleet_vehicle_service_types")
}

/**
 * Tax line attached to a vehicle booking. Snapshots the tax name + rate at
 * the moment the booking is priced so a later VAT/WHT rate change doesn't
 * re-write history. taxId is a soft pointer (no FK) so the picker can pull
 * from either ifrs_vats or withholding_taxes.
 */
model VehicleBookingTax {
  id              Int      @id @default(autoincrement())
  bookingId       Int
  taxType         String   // VAT | WHT | CUSTOM
  taxId           Int?     // fleet_tax_configs.id or ifrs_vats.id (soft FK)
  name            String   // snapshot, e.g. "VAT 7.5%" or "Tourism Levy"
  rate            Decimal  @db.Decimal(7, 4) // up to 999.9999%
  amount          Decimal  @db.Decimal(15, 2)
  // GL account to credit at invoice posting — snapshotted from
  // fleet_tax_configs.glAccountId when the booking is created so a
  // later chart-of-accounts change doesn't re-write posted JEs.
  glAccountId     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  booking VehicleBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("vehicle_booking_taxes")
}

/**
 * Central fleet tax configuration. Defines the taxes that apply to fleet
 * bookings (e.g. VAT 7.5%, Tourism Levy, Airport Tax). isDefault = true rows
 * are auto-applied when a new booking is created. Each config carries a
 * glAccountId so the GL posting knows which account to credit.
 */
model FleetTaxConfig {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String    // "VAT 7.5%", "Tourism Levy 2%"
  taxType     String    // VAT | WHT | CUSTOM
  rate        Decimal   @db.Decimal(7, 4)
  glAccountId Int?      // credited at invoice posting
  isDefault   Boolean   @default(false) // auto-apply to new bookings
  isActive    Boolean   @default(true)
  description String?   @db.Text
  createdBy   Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, isActive])
  @@map("fleet_tax_configs")
}

enum BookingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Trips
// ============================================================================

model Trip {
  id                      Int        @id @default(autoincrement())
  companyId               Int
  vehicleId               Int
  bookingId               Int?
  tripNumber              String     @unique
  driverId                Int?
  driverName              String?
  tripType                TripType   @default(OFFICIAL)
  purpose                 String     @db.Text
  description             String?    @db.Text
  startLocation           String
  startLatitude           Decimal?   @db.Decimal(10, 8)
  startLongitude          Decimal?   @db.Decimal(11, 8)
  endLocation             String?
  endLatitude             Decimal?   @db.Decimal(10, 8)
  endLongitude            Decimal?   @db.Decimal(11, 8)
  plannedRoute            Json? // Array of waypoints
  actualRoute             Json? // GPS track points
  scheduledStartTime      DateTime
  scheduledEndTime        DateTime?
  actualStartTime         DateTime?
  actualEndTime           DateTime?
  startOdometer           Decimal?   @db.Decimal(12, 2)
  endOdometer             Decimal?   @db.Decimal(12, 2)
  distance                Decimal?   @db.Decimal(12, 2)
  estimatedDistance       Decimal?   @db.Decimal(12, 2)
  fuelUsed                Decimal?   @db.Decimal(10, 3)
  fuelCost                Decimal?   @db.Decimal(12, 2)
  tollCost                Decimal?   @db.Decimal(10, 2)
  parkingCost             Decimal?   @db.Decimal(10, 2)
  otherCosts              Decimal?   @db.Decimal(10, 2)
  // Internal cost tracking — per-trip direct costs.
  // These feed cost reports (trip + vehicle); they are NOT used for customer pricing.
  driverAllowance         Decimal?   @db.Decimal(12, 2)
  miscExpenses            Decimal?   @db.Decimal(12, 2)
  totalCost               Decimal?   @db.Decimal(12, 2)
  passengers              Json?
  numberOfPassengers      Int        @default(0)
  cargo                   String?    @db.Text
  cargoWeight             Decimal?   @db.Decimal(10, 2)
  status                  TripStatus @default(SCHEDULED)
  maxSpeedRecorded        Decimal?   @db.Decimal(6, 2)
  averageSpeed            Decimal?   @db.Decimal(6, 2)
  idleTime                Int? // minutes
  speedViolations         Int        @default(0)
  harshBrakingEvents      Int        @default(0)
  rapidAccelerationEvents Int        @default(0)
  driverRating            Decimal?   @db.Decimal(3, 2)
  customerRating          Decimal?   @db.Decimal(3, 2)
  customerFeedback        String?    @db.Text
  completionNotes         String?    @db.Text
  notes                   String?    @db.Text
  // Customer-billing snapshot — populated when the trip closes. These are
  // the *actuals* used to compute the final invoice (vs the totalCost
  // fields above, which are internal direct costs for cost reports).
  actualDuration          Int?       // minutes — endTime − startTime
  actualDistance          Decimal?   @db.Decimal(10, 2) // km — endOdo − startOdo
  billedAmount            Decimal?   @db.Decimal(15, 2) // pre-tax amount actually billed
  approvedBy              Int?
  approvedAt              DateTime?
  createdBy               Int?
  deletedAt               DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  fuelRecords FuelRecord[]
  incidents   VehicleIncident[]
  waypoints   TripWaypoint[]

  @@index([companyId, status])
  @@index([vehicleId, actualStartTime])
  @@index([driverId, actualStartTime])
  @@map("trips")
}

enum TripType {
  OFFICIAL
  PERSONAL
  DELIVERY
  PICKUP
  TRANSFER
  SERVICE
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DELAYED
}

model TripWaypoint {
  id                   Int            @id @default(autoincrement())
  tripId               Int
  sequenceNumber       Int
  location             String
  latitude             Decimal        @db.Decimal(10, 8)
  longitude            Decimal        @db.Decimal(11, 8)
  plannedArrivalTime   DateTime?
  actualArrivalTime    DateTime?
  plannedDepartureTime DateTime?
  actualDepartureTime  DateTime?
  waitingTime          Int? // minutes
  purpose              String?
  contactPerson        String?
  contactPhone         String?
  notes                String?        @db.Text
  status               WaypointStatus @default(PENDING)
  createdAt            DateTime       @default(now())

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sequenceNumber])
  @@map("trip_waypoints")
}

enum WaypointStatus {
  PENDING
  ARRIVED
  DEPARTED
  SKIPPED
}

// ============================================================================
// FLEET MANAGEMENT MODULE - Vehicle Inspections & Incidents
// ============================================================================

model VehicleInspection {
  id                      Int             @id @default(autoincrement())
  companyId               Int
  vehicleId               Int
  inspectionNumber        String          @unique
  inspectionType          InspectionType  @default(PRE_TRIP)
  inspectionDate          DateTime        @db.Date
  mileageAtInspection     Decimal?        @db.Decimal(12, 2)
  inspectedBy             Int
  inspectorName           String?
  exteriorCondition       ConditionRating @default(GOOD)
  interiorCondition       ConditionRating @default(GOOD)
  engineCondition         ConditionRating @default(GOOD)
  brakeCondition          ConditionRating @default(GOOD)
  tyreCondition           ConditionRating @default(GOOD)
  lightsCondition         ConditionRating @default(GOOD)
  fluidLevels             ConditionRating @default(GOOD)
  fuelLevel               String?
  cleanlinessLevel        ConditionRating @default(GOOD)
  checklistItems          Json? // Array of checklist items with pass/fail
  defectsFound            String?         @db.Text
  defectsSeverity         DefectSeverity?
  recommendedActions      String?         @db.Text
  immediateActionRequired Boolean         @default(false)
  vehicleCleared          Boolean         @default(true)
  images                  Json?
  supervisorId            Int?
  supervisorApproval      Boolean?
  supervisorNotes         String?         @db.Text
  notes                   String?         @db.Text
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId, inspectionDate])
  @@index([vehicleId, inspectionType])
  @@map("vehicle_inspections")
}

enum InspectionType {
  PRE_TRIP
  POST_TRIP
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
  RANDOM
}

enum ConditionRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum DefectSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

model VehicleIncident {
  id                   Int              @id @default(autoincrement())
  companyId            Int
  vehicleId            Int
  tripId               Int?
  incidentNumber       String           @unique
  incidentType         IncidentType     @default(ACCIDENT)
  incidentDate         DateTime         @db.Date
  incidentTime         DateTime?        @db.Time()
  location             String
  latitude             Decimal?         @db.Decimal(10, 8)
  longitude            Decimal?         @db.Decimal(11, 8)
  driverId             Int?
  driverName           String?
  description          String           @db.Text
  severity             IncidentSeverity @default(MINOR)
  injuries             Boolean          @default(false)
  injuryDetails        String?          @db.Text
  fatalities           Int              @default(0)
  thirdPartyInvolved   Boolean          @default(false)
  thirdPartyDetails    String?          @db.Text
  policeReportNumber   String?
  policeReportFiled    Boolean          @default(false)
  estimatedDamageCost  Decimal?         @db.Decimal(12, 2)
  actualRepairCost     Decimal?         @db.Decimal(12, 2)
  insuranceClaimNumber String?
  insuranceClaimStatus String?
  insuranceClaimAmount Decimal?         @db.Decimal(12, 2)
  insurancePaidAmount  Decimal?         @db.Decimal(12, 2)
  driverAtFault        Boolean?
  faultDescription     String?          @db.Text
  witnesses            Json? // Array of witness info
  images               Json?
  documents            Json?
  status               IncidentStatus   @default(REPORTED)
  investigatedBy       Int?
  investigationNotes   String?          @db.Text
  resolutionDate       DateTime?        @db.Date
  resolutionNotes      String?          @db.Text
  lessonsLearned       String?          @db.Text
  preventiveMeasures   String?          @db.Text
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([companyId, incidentDate])
  @@index([vehicleId, incidentType])
  @@index([status, severity])
  @@map("vehicle_incidents")
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
  THEFT
  VANDALISM
  TRAFFIC_VIOLATION
  MECHANICAL_FAILURE
  WEATHER_DAMAGE
  OTHER
}

enum IncidentSeverity {
  MINOR
  MODERATE
  MAJOR
  SEVERE
  TOTAL_LOSS
}

enum IncidentStatus {
  REPORTED
  UNDER_INVESTIGATION
  INSURANCE_CLAIMED
  UNDER_REPAIR
  RESOLVED
  CLOSED
}

// ============================================================================
// HR PAYROLL MODULE - Expense Claims
// ============================================================================

model ExpenseClaim {
  id                Int       @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  employeeId        Int
  claimNumber       String    @unique
  claimDate         DateTime  @db.Date
  description       String?   @db.Text
  totalAmount       Decimal   @db.Decimal(15, 2)
  approvedAmount    Decimal?  @db.Decimal(15, 2)
  currencyId        Int?
  status            String    @default("draft") // draft, submitted, under_review, approved, rejected, paid, cancelled
  submittedAt       DateTime?
  reviewedBy        Int?
  reviewedAt        DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  rejectionReason   String?   @db.Text
  paidAt            DateTime?
  paymentReference  String?
  paymentMethodId   Int?
  bankId            Int?
  journalEntryId    Int?
  notes             String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    ExpenseClaimItem[]

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("expense_claims")
}

model ExpenseClaimItem {
  id              Int      @id @default(autoincrement())
  expenseClaimId  Int
  expenseDate     DateTime @db.Date
  category        String
  description     String
  amount          Decimal  @db.Decimal(15, 2)
  receiptPath     String?
  receiptFileName String?
  isApproved      Boolean  @default(false)
  approvedAmount  Decimal? @db.Decimal(15, 2)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  expenseClaim ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)

  @@index([expenseClaimId])
  @@map("expense_claim_items")
}

// ============================================================================
// MANUFACTURING MODULE - Bill of Materials (BOM)
// ============================================================================

model BillOfMaterial {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String
  name              String
  description       String?   @db.Text
  productId         Int
  bomType           String    @default("standard")
  manufacturingType String?
  quantity          Decimal   @default(1) @db.Decimal(15, 4)
  uomId             Int?
  version           String    @default("1.0")
  isCurrentVersion  Boolean   @default(true)
  parentBomId       Int?
  status            String    @default("draft")
  effectiveFrom     DateTime? @db.Date
  effectiveTo       DateTime? @db.Date
  routingId         Int?
  overheadPercent   Decimal   @default(0) @db.Decimal(5, 2)
  laborCostPercent  Decimal   @default(0) @db.Decimal(5, 2)
  scrapPercent      Decimal   @default(0) @db.Decimal(5, 2)
  notes             String?   @db.Text
  expectedYieldPercent  Decimal?  @db.Decimal(5, 2)
  minimumBatchSize      Decimal?  @db.Decimal(15, 4)
  maximumBatchSize      Decimal?  @db.Decimal(15, 4)
  batchSizeMultiple     Decimal?  @db.Decimal(15, 4)
  standardMaterialCost  Decimal?  @db.Decimal(15, 2)
  standardLaborCost     Decimal?  @db.Decimal(15, 2)
  standardOverheadCost  Decimal?  @db.Decimal(15, 2)
  standardTotalCost     Decimal?  @db.Decimal(15, 2)
  costLastCalculatedAt  DateTime?
  approvalNotes         String?   @db.Text
  createdById       Int?
  updatedById       Int?
  approvedById      Int?
  approvedAt        DateTime?
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  product Item     @relation("FinishedGoods", fields: [productId], references: [id], onDelete: Cascade)
  routing Routing? @relation(fields: [routingId], references: [id], onDelete: SetNull)

  lines       BomLine[]
  byProducts  BomByProduct[]
  productionOrders ProductionOrder[]
  company     Company @relation(fields: [companyId], references: [id])

  // BOMs are versioned — multiple rows per (companyId, code) are valid.
  // The "only one current version per code" invariant is enforced by a
  // partial unique index in tenant-migrations.ts (idx_mfg_boms_company_code_current),
  // which Prisma can't express. Keep this as a non-unique index for query perf.
  @@index([companyId, code])
  @@index([companyId, status])
  @@index([productId])
  @@map("mfg_boms")
}

model BomLine {
  id           Int      @id @default(autoincrement())
  bomId        Int
  productId    Int
  quantity     Decimal  @db.Decimal(15, 4)
  uomId        Int?
  issueMethod  String?
  warehouseId  Int?
  locationId   Int?
  sequence     Int      @default(0)
  scrapPercent Decimal  @default(0) @db.Decimal(5, 2)
  isOptional   Boolean  @default(false)
  isByProduct  Boolean  @default(false)
  operationId  Int?
  componentType     String?   @db.VarChar(30)
  isCritical        Boolean   @default(false)
  operationOffsetDays Int     @default(0)
  fixedScrapQty     Decimal   @default(0) @db.Decimal(15, 4)
  allowSubstitutes  Boolean   @default(false)
  unitCost          Decimal   @default(0) @db.Decimal(15, 2)
  extendedCost      Decimal   @default(0) @db.Decimal(15, 2)
  effectiveFrom     DateTime? @db.Date
  effectiveTo       DateTime? @db.Date
  remarks      String?  @db.Text
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  bom     BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Item           @relation("ComponentItem", fields: [productId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@index([productId])
  @@map("mfg_bom_lines")
}

model BomByProduct {
  id                    Int      @id @default(autoincrement())
  bomId                 Int
  productId             Int
  quantity              Decimal  @db.Decimal(15, 4)
  uomId                 Int?
  costAllocationPercent Decimal  @default(0) @db.Decimal(5, 2)
  byProductType         String?  @db.VarChar(30)
  costAllocationMethod  String?  @db.VarChar(30)
  costAllocationAmount  Decimal? @db.Decimal(15, 2)
  operationId           Int?
  warehouseId           Int?
  locationId            Int?
  remarks               String?  @db.Text
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  bom     BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product Item           @relation("BomByProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@map("mfg_bom_by_products")
}

// ============================================================================
// MANUFACTURING MODULE - Routings & Work Centers
// ============================================================================

model WorkCenter {
  id               Int      @id @default(autoincrement())
  companyId        Int
  code             String   @unique
  name             String
  description      String?  @db.Text
  workCenterType   String   @default("machine")
  departmentId     Int?
  warehouseId      Int?
  locationId       Int?
  capacity         Decimal  @default(1) @db.Decimal(10, 2)
  capacityUom      String   @default("units/hour")
  efficiencyPercent Decimal @default(100) @db.Decimal(5, 2)
  costPerHour      Decimal  @default(0) @db.Decimal(12, 2)
  overheadPerHour  Decimal  @default(0) @db.Decimal(12, 2)
  setupCostPerHour Decimal  @default(0) @db.Decimal(12, 2)
  shiftPatternId   Int?
  oeeTarget        Decimal? @db.Decimal(5, 2)
  utilizationPercent       Decimal  @default(85) @db.Decimal(5, 2)
  hourlyLaborRate          Decimal  @default(0) @db.Decimal(12, 2)
  hourlyMachineRate        Decimal  @default(0) @db.Decimal(12, 2)
  costCenterId             Int?
  concurrentOperations     Int      @default(1)
  queueTimeHours           Decimal  @default(0) @db.Decimal(8, 2)
  moveTimeHours            Decimal  @default(0) @db.Decimal(8, 2)
  availabilityTargetPercent Decimal @default(90) @db.Decimal(5, 2)
  performanceTargetPercent  Decimal @default(95) @db.Decimal(5, 2)
  qualityTargetPercent      Decimal @default(99) @db.Decimal(5, 2)
  status           String   @default("operational")
  isActive         Boolean  @default(true)
  createdById      Int?
  updatedById      Int?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  operations              RoutingOperation[]
  productionOperations    ProductionOrderOperation[]
  capacityRecords         WorkCenterCapacity[]
  oeeRecords              WorkCenterOee[]
  calendars               WorkCenterCalendar[]
  exceptions              WorkCenterException[]
  company                 Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@map("mfg_work_centers")
}

model WorkCenterCapacity {
  id             Int      @id @default(autoincrement())
  workCenterId   Int
  date           DateTime @db.Date
  availableHours Decimal  @db.Decimal(10, 2)
  scheduledHours Decimal  @default(0) @db.Decimal(10, 2)
  remainingHours Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([workCenterId, date])
  @@map("mfg_work_center_capacity")
}

model WorkCenterOee {
  id                  Int      @id @default(autoincrement())
  workCenterId        Int
  date                DateTime @db.Date
  availability        Decimal  @default(0) @db.Decimal(5, 4)
  performance         Decimal  @default(0) @db.Decimal(5, 4)
  quality             Decimal  @default(0) @db.Decimal(5, 4)
  oee                 Decimal  @default(0) @db.Decimal(5, 4)
  plannedProductionTime Decimal? @db.Decimal(10, 2)
  actualRunTime       Decimal? @db.Decimal(10, 2)
  totalCount          Int?
  goodCount           Int?
  idealCycleTime      Decimal? @db.Decimal(10, 4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@index([workCenterId, date])
  @@map("mfg_work_center_oee")
}

model Routing {
  id               Int      @id @default(autoincrement())
  companyId        Int
  code             String
  name             String
  description      String?  @db.Text
  productId        Int?
  routingType      String?
  version          String   @default("1.0")
  isCurrentVersion Boolean  @default(true)
  status           String   @default("draft")
  effectiveFrom    DateTime? @db.Date
  effectiveTo      DateTime? @db.Date
  totalSetupTime   Decimal? @db.Decimal(10, 2)
  totalRunTime     Decimal? @db.Decimal(10, 2)
  totalWaitTime    Decimal? @db.Decimal(10, 2)
  totalMoveTime    Decimal? @db.Decimal(10, 2)
  totalQueueTime   Decimal? @db.Decimal(10, 2)
  totalCostPerUnit Decimal? @db.Decimal(15, 2)
  parentRoutingId  Int?
  totalLeadTime    Decimal? @db.Decimal(10, 2)
  timeUom          String   @default("hours") @db.VarChar(20)
  standardLaborCost    Decimal? @db.Decimal(15, 2)
  standardOverheadCost Decimal? @db.Decimal(15, 2)
  standardTotalCost    Decimal? @db.Decimal(15, 2)
  costLastCalculatedAt DateTime?
  approvalNotes    String?  @db.Text
  notes            String?  @db.Text
  createdById      Int?
  updatedById      Int?
  approvedById     Int?
  approvedAt       DateTime?
  isActive         Boolean  @default(true)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  product Item? @relation(fields: [productId], references: [id], onDelete: SetNull)

  operations       RoutingOperation[]
  boms             BillOfMaterial[]
  productionOrders ProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("mfg_routings")
}

model RoutingOperation {
  id                        Int      @id @default(autoincrement())
  routingId                 Int
  operationNumber           Int
  operationCode             String?  @db.VarChar(30)
  name                      String
  description               String?  @db.Text
  workCenterId              Int
  alternateWorkCenterId     Int?
  operationType             String   @default("standard") @db.VarChar(30)
  isReportingPoint          Boolean  @default(false)
  setupTime                 Decimal  @default(0) @db.Decimal(10, 2)
  runTimePerUnit            Decimal  @default(0) @db.Decimal(10, 2)
  runTimePerBatch           Decimal? @db.Decimal(10, 2)
  unitsPerHour              Decimal? @db.Decimal(10, 2)
  batchSize                 Decimal? @db.Decimal(15, 4)
  waitTime                  Decimal  @default(0) @db.Decimal(10, 2)
  moveTime                  Decimal  @default(0) @db.Decimal(10, 2)
  queueTime                 Decimal  @default(0) @db.Decimal(10, 2)
  minimumTransferQuantity   Decimal? @db.Decimal(15, 4)
  overlapPercent            Decimal  @default(0) @db.Decimal(5, 2)
  overlapAllowed            Boolean  @default(true)
  schedulingMethod          String   @default("forward") @db.VarChar(20)
  isCritical                Boolean  @default(false)
  minDaysFromStart          Int?
  maxDaysFromStart          Int?
  costBasis                 String?
  costPerUnit               Decimal  @default(0) @db.Decimal(12, 2)
  overheadPerUnit           Decimal  @default(0) @db.Decimal(12, 2)
  laborRatePerHour          Decimal? @db.Decimal(12, 2)
  overheadRatePerHour       Decimal? @db.Decimal(12, 2)
  subcontractorId           Int?
  subcontractCost           Decimal? @db.Decimal(12, 2)
  isSubcontracted           Boolean  @default(false)
  subcontractLeadDays       Int?
  qualityInspectionRequired Boolean  @default(false)
  inspectionPointId         Int?
  instructions              String?  @db.Text
  isMilestone               Boolean  @default(false)
  timeUom                   String?  @db.VarChar(20)
  fixedCost                 Decimal? @db.Decimal(15, 2)
  effectiveFrom             DateTime? @db.Date
  effectiveTo               DateTime? @db.Date
  notes                     String?  @db.Text
  deletedAt                 DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  routing    Routing    @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  resources  OperationResource[]

  @@unique([routingId, operationNumber])
  @@index([routingId, workCenterId])
  @@map("mfg_routing_operations")
}

model OperationResource {
  id           Int      @id @default(autoincrement())
  operationId  Int
  resourceType String
  resourceId   Int?
  resourceName String?
  quantity     Decimal  @default(1) @db.Decimal(10, 2)
  uomId        Int?
  costPerHour  Decimal  @default(0) @db.Decimal(12, 2)
  notes        String?  @db.Text
  resourceCode      String?  @db.VarChar(30)
  description       String?  @db.Text
  usagePercentage   Decimal? @db.Decimal(5, 2)
  setupTime         Decimal? @db.Decimal(10, 2)
  runTimePerUnit    Decimal? @db.Decimal(10, 2)
  isConcurrent      Boolean  @default(false)
  isPrimaryResource Boolean  @default(false)
  isConstraining    Boolean  @default(false)
  offsetTime        Decimal? @db.Decimal(10, 2)
  fixedCost         Decimal? @db.Decimal(15, 2)
  costBasis         String?  @db.VarChar(30)
  skillRequired     String?  @db.VarChar(100)
  skillLevel        String?  @db.VarChar(30)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  operation RoutingOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@map("mfg_operation_resources")
}

// ============================================================================
// MANUFACTURING MODULE - Production Orders
// ============================================================================

model ProductionOrder {
  id                Int       @id @default(autoincrement())
  companyId         Int
  orderNumber       String    @unique
  description       String?   @db.Text
  orderDate         DateTime? @db.Date
  productId         Int
  bomId             Int
  routingId         Int?
  warehouseId       Int?
  sourceWarehouseId Int?
  wipWarehouseId    Int?
  quantity          Decimal   @db.Decimal(15, 4)
  uomId             Int?
  completedQuantity Decimal   @default(0) @db.Decimal(15, 4)
  startedQuantity   Decimal   @default(0) @db.Decimal(15, 4)
  scrapQuantity     Decimal   @default(0) @db.Decimal(15, 4)
  orderType         String?
  priority          String    @default("normal")
  sourceType        String?
  sourceId          Int?
  sourceDocument    String?   @db.VarChar(100)
  salesOrderId      Int?
  salesOrderLineId  Int?
  parentOrderId     Int?
  status            String    @default("draft")
  progressPercentage Decimal  @default(0) @db.Decimal(5, 2)
  plannedStartDate  DateTime? @db.Date
  plannedEndDate    DateTime? @db.Date
  actualStartDate   DateTime? @db.Date
  actualEndDate     DateTime? @db.Date
  actualStartDatetime DateTime?
  actualEndDatetime   DateTime?
  dueDate           DateTime? @db.Date
  estimatedCost     Decimal?  @db.Decimal(15, 2)
  actualCost        Decimal?  @db.Decimal(15, 2)
  materialCost      Decimal?  @db.Decimal(15, 2)
  laborCost         Decimal?  @db.Decimal(15, 2)
  overheadCost      Decimal?  @db.Decimal(15, 2)
  plannedMaterialCost Decimal? @db.Decimal(15, 2)
  plannedLaborCost    Decimal? @db.Decimal(15, 2)
  plannedOverheadCost Decimal? @db.Decimal(15, 2)
  plannedTotalCost    Decimal? @db.Decimal(15, 2)
  plannedSetupTime    Decimal? @db.Decimal(10, 2)
  plannedRunTime      Decimal? @db.Decimal(10, 2)
  actualSetupTime     Decimal? @db.Decimal(10, 2)
  actualRunTime       Decimal? @db.Decimal(10, 2)
  batchNumber       String?   @db.VarChar(50)
  expiryDate        DateTime? @db.Date
  notes             String?   @db.Text
  productionNotes   String?   @db.Text
  isActive          Boolean   @default(true)
  createdById       Int?
  updatedById       Int?
  releasedById      Int?
  releasedAt        DateTime?
  closedById        Int?
  closedAt          DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  bom     BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  routing Routing?       @relation(fields: [routingId], references: [id], onDelete: SetNull)
  product Item           @relation(fields: [productId], references: [id], onDelete: Cascade)

  lines           ProductionOrderLine[]
  operations      ProductionOrderOperation[]
  materialIssues  MaterialIssue[]
  materialReturns MaterialReturn[]
  receipts        ProductionReceipt[]
  scrapRecords    ProductionScrap[]
  laborEntries    LaborEntry[]
  qualityInspections QualityInspection[]
  qualityDefects  QualityDefect[]
  nonConformances NonConformance[]
  company         Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([productId, status])
  @@index([plannedStartDate, plannedEndDate])
  @@map("mfg_production_orders")
}

model ProductionOrderLine {
  id                Int      @id @default(autoincrement())
  productionOrderId Int
  productId         Int
  bomLineId         Int?
  quantity          Decimal  @db.Decimal(15, 4)
  uomId             Int?
  issuedQuantity    Decimal  @default(0) @db.Decimal(15, 4)
  returnedQuantity  Decimal  @default(0) @db.Decimal(15, 4)
  consumedQuantity  Decimal  @default(0) @db.Decimal(15, 4)
  issueMethod       String?
  warehouseId       Int?
  locationId        Int?
  status            String   @default("pending")
  notes             String?  @db.Text
  lineNumber        Int?
  componentType     String?  @db.VarChar(30)
  operationId       Int?
  isIssued          Boolean  @default(false)
  unitCost          Decimal? @db.Decimal(15, 2)
  plannedCost       Decimal? @db.Decimal(15, 2)
  actualCost        Decimal? @db.Decimal(15, 2)
  batchNumber       String?  @db.VarChar(50)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_production_order_lines")
}

model ProductionOrderOperation {
  id                Int       @id @default(autoincrement())
  productionOrderId Int
  routingOperationId Int?
  operationNumber   Int
  name              String
  workCenterId      Int
  plannedSetupTime  Decimal   @default(0) @db.Decimal(10, 2)
  plannedRunTime    Decimal   @default(0) @db.Decimal(10, 2)
  plannedQueueTime  Decimal   @default(0) @db.Decimal(10, 2)
  plannedMoveTime   Decimal   @default(0) @db.Decimal(10, 2)
  actualSetupTime   Decimal?  @db.Decimal(10, 2)
  actualRunTime     Decimal?  @db.Decimal(10, 2)
  actualQueueTime   Decimal?  @db.Decimal(10, 2)
  actualMoveTime    Decimal?  @db.Decimal(10, 2)
  plannedStartDate  DateTime? @db.Date
  plannedEndDate    DateTime? @db.Date
  plannedStartDatetime DateTime?
  plannedEndDatetime   DateTime?
  actualStartDate   DateTime? @db.Date
  actualEndDate     DateTime? @db.Date
  actualStartDatetime  DateTime?
  actualEndDatetime    DateTime?
  plannedLaborCost     Decimal? @db.Decimal(15, 2)
  plannedOverheadCost  Decimal? @db.Decimal(15, 2)
  actualLaborCost      Decimal? @db.Decimal(15, 2)
  actualOverheadCost   Decimal? @db.Decimal(15, 2)
  completedQuantity Decimal   @default(0) @db.Decimal(15, 4)
  scrapQuantity     Decimal   @default(0) @db.Decimal(15, 4)
  status            String    @default("pending")
  notes             String?   @db.Text
  operationCode     String?   @db.VarChar(30)
  plannedQuantity   Decimal?  @db.Decimal(15, 4)
  startedQuantity   Decimal   @default(0) @db.Decimal(15, 4)
  progressPercentage Decimal  @default(0) @db.Decimal(5, 2)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter      @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, operationNumber])
  @@index([productionOrderId, status])
  @@map("mfg_production_order_operations")
}

model MaterialIssue {
  id                    Int      @id @default(autoincrement())
  productionOrderId     Int
  productionOrderLineId Int?
  issueNumber           String   @unique
  productId             Int
  quantity              Decimal  @db.Decimal(15, 4)
  uomId                 Int?
  warehouseId           Int?
  locationId            Int?
  lotNumber             String?
  serialNumber          String?
  unitCost              Decimal  @default(0) @db.Decimal(15, 2)
  totalCost             Decimal  @default(0) @db.Decimal(15, 2)
  issueDate             DateTime @db.Date
  issuedById            Int?
  notes                 String?  @db.Text
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Item            @relation("MaterialIssueProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_material_issues")
}

model MaterialReturn {
  id                    Int      @id @default(autoincrement())
  productionOrderId     Int
  productionOrderLineId Int?
  returnNumber          String   @unique
  productId             Int
  quantity              Decimal  @db.Decimal(15, 4)
  uomId                 Int?
  warehouseId           Int?
  locationId            Int?
  lotNumber             String?
  serialNumber          String?
  unitCost              Decimal  @default(0) @db.Decimal(15, 2)
  totalCost             Decimal  @default(0) @db.Decimal(15, 2)
  returnDate            DateTime @db.Date
  returnedById          Int?
  reason                String?  @db.Text
  notes                 String?  @db.Text
  deletedAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Item            @relation("MaterialReturnProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_material_returns")
}

model ProductionReceipt {
  id                Int      @id @default(autoincrement())
  productionOrderId Int
  receiptNumber     String   @unique
  productId         Int
  quantity          Decimal  @db.Decimal(15, 4)
  uomId             Int?
  warehouseId       Int?
  locationId        Int?
  lotNumber         String?
  serialNumber      String?
  unitCost          Decimal  @default(0) @db.Decimal(15, 2)
  totalCost         Decimal  @default(0) @db.Decimal(15, 2)
  receiptDate       DateTime @db.Date
  receivedById      Int?
  qualityStatus     String   @default("pending_qc")
  notes             String?  @db.Text
  productionOrderOperationId Int?
  outputType        String?  @db.VarChar(30)
  batchNumber       String?  @db.VarChar(50)
  productionDate    DateTime? @db.Date
  expiryDate        DateTime? @db.Date
  qualityInspectionId Int?
  isPosted          Boolean  @default(false)
  stockMovementId   Int?
  qcApprovedById    Int?
  qcApprovedAt      DateTime?
  qcComments        String?  @db.Text
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Item            @relation("ProductionReceiptProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_production_receipts")
}

model ProductionScrap {
  id                          Int      @id @default(autoincrement())
  productionOrderId           Int
  productionOrderOperationId  Int?
  scrapNumber                 String   @unique
  productId                   Int
  quantity                    Decimal  @db.Decimal(15, 4)
  uomId                      Int?
  warehouseId                Int?
  scrapReason                String?  @db.Text
  scrapCost                  Decimal  @default(0) @db.Decimal(15, 2)
  scrapDate                  DateTime @db.Date
  recordedById               Int?
  isRecoverable              Boolean  @default(false)
  notes                      String?  @db.Text
  scrapType                  String?  @db.VarChar(30)
  scrapReasonId              Int?
  scrapReasonCode            String?  @db.VarChar(30)
  unitCost                   Decimal? @db.Decimal(15, 2)
  recoveryValue              Decimal? @db.Decimal(15, 2)
  isPosted                   Boolean  @default(false)
  stockMovementId            Int?
  deletedAt                  DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_production_scrap")
}

model ReceivableSettings {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  receiptPostingMode     String   @default("direct") // "direct" | "approval_required"
  requireReceiptApproval Boolean  @default(false)
  autoAllocateReceipts   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("receivable_settings")
}

model QcAuthorization {
  id         Int       @id @default(autoincrement())
  companyId  Int
  roleId     Int?
  employeeId Int?
  canApprove Boolean   @default(true)
  canReject  Boolean   @default(true)
  isActive   Boolean   @default(true)
  createdBy  Int?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId])
  @@map("mfg_qc_authorizations")
}

model LaborEntry {
  id                          Int      @id @default(autoincrement())
  productionOrderId           Int
  productionOrderOperationId  Int?
  employeeId                  Int?
  laborType                   String   @default("direct")
  startTime                   DateTime?
  endTime                     DateTime?
  hours                       Decimal  @db.Decimal(10, 2)
  hourlyRate                  Decimal  @default(0) @db.Decimal(12, 2)
  totalCost                   Decimal  @default(0) @db.Decimal(15, 2)
  quantity                    Decimal? @db.Decimal(15, 4)
  scrapQuantity               Decimal? @db.Decimal(15, 4)
  notes                       String?  @db.Text
  employeeName                String?  @db.VarChar(200)
  workCenterId                Int?
  workDate                    DateTime? @db.Date
  isApproved                  Boolean  @default(false)
  approvedBy                  Int?
  approvedAt                  DateTime?
  createdBy                   Int?
  deletedAt                   DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("mfg_labor_entries")
}

// ============================================================================
// MANUFACTURING MODULE - Quality
// ============================================================================

model QualityParameter {
  id              Int      @id @default(autoincrement())
  companyId       Int
  code            String
  name            String
  description     String?  @db.Text
  parameterType   String   @default("numeric")
  unit            String?
  uom             String?
  dataType        String   @default("numeric")
  minValue        Decimal? @db.Decimal(15, 4)
  maxValue        Decimal? @db.Decimal(15, 4)
  targetValue     Decimal? @db.Decimal(15, 4)
  tolerance       Decimal? @db.Decimal(15, 4)
  toleranceLower  Decimal? @db.Decimal(15, 4)
  toleranceUpper  Decimal? @db.Decimal(15, 4)
  testMethod      String?  @db.Text
  instructions    String?  @db.Text
  frequency       String?
  allowedValues   Json?
  equipmentRequired String? @db.Text
  isCritical      Boolean  @default(false)
  isActive        Boolean  @default(true)
  decimalPlaces   Int?
  samplingType    String?  @db.VarChar(30)
  defaultSampleSizePercent Decimal? @db.Decimal(5, 2)
  defaultSampleSizeQty     Decimal? @db.Decimal(15, 4)
  isMandatory     Boolean  @default(false)
  createdBy       Int?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  standards         QualityStandardParameter[]
  defects           QualityDefect[]
  inspectionResults InspectionResult[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("mfg_quality_parameters")
}

model QualityStandard {
  id               Int       @id @default(autoincrement())
  companyId        Int
  code             String
  name             String
  description      String?   @db.Text
  version          String    @default("1.0")
  itemId           Int?
  productId        Int?
  categoryId       Int?
  status           String    @default("draft")
  inspectionType   String?
  samplingMethod   String?
  sampleSize       Decimal?  @db.Decimal(10, 2)
  isSamplePercentage Boolean @default(false)
  aqlLevel         String?
  effectiveFrom    DateTime? @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?   @db.Text
  isActive         Boolean   @default(true)
  approvedBy       Int?
  approvedAt       DateTime?
  createdBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  parameters  QualityStandardParameter[]
  inspections QualityInspection[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("mfg_quality_standards")
}

model QualityStandardParameter {
  id                 Int      @id @default(autoincrement())
  qualityStandardId  Int
  qualityParameterId Int
  sequence           Int      @default(0)
  isRequired         Boolean  @default(true)
  isMandatory        Boolean  @default(true)
  minValue           Decimal? @db.Decimal(15, 4)
  maxValue           Decimal? @db.Decimal(15, 4)
  targetValue        Decimal? @db.Decimal(15, 4)
  customMinValue     Decimal? @db.Decimal(15, 4)
  customMaxValue     Decimal? @db.Decimal(15, 4)
  customTargetValue  Decimal? @db.Decimal(15, 4)
  notes              String?  @db.Text
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  qualityStandard  QualityStandard  @relation(fields: [qualityStandardId], references: [id], onDelete: Cascade)
  qualityParameter QualityParameter @relation(fields: [qualityParameterId], references: [id], onDelete: Cascade)

  @@unique([qualityStandardId, qualityParameterId])
  @@map("mfg_quality_standard_parameters")
}

model QualityInspection {
  id                          Int       @id @default(autoincrement())
  companyId                   Int
  inspectionNumber            String    @unique
  inspectionType              String?
  sourceType                  String?   @db.VarChar(30)
  sourceId                    Int?
  sourceNumber                String?   @db.VarChar(50)
  qualityStandardId           Int?
  productionOrderId           Int?
  productionOrderOperationId  Int?
  purchaseOrderId             Int?
  grnId                       Int?
  productId                   Int?
  itemCode                    String?   @db.VarChar(50)
  itemName                    String?   @db.VarChar(200)
  lotNumber                   String?
  serialNumber                String?
  totalQuantity               Decimal?  @db.Decimal(15, 4)
  sampleQuantity              Decimal?  @db.Decimal(15, 4)
  inspectedQuantity           Decimal?  @db.Decimal(15, 4)
  passedQuantity              Decimal?  @db.Decimal(15, 4)
  failedQuantity              Decimal?  @db.Decimal(15, 4)
  passRate                    Decimal?  @db.Decimal(5, 2)
  result                      String?   @db.VarChar(20)
  disposition                 String?   @db.VarChar(30)
  dispositionNotes            String?   @db.Text
  dispositionById             Int?
  dispositionAt               DateTime?
  warehouseId                 Int?
  locationId                  Int?
  inspectionDate              DateTime? @db.Date
  startedAt                   DateTime?
  completedAt                 DateTime?
  inspectorId                 Int?
  inspectorName               String?   @db.VarChar(100)
  supplierId                  Int?
  supplierName                String?   @db.VarChar(200)
  equipmentUsed               String?   @db.Text
  priority                    String    @default("normal") @db.VarChar(20)
  correctiveActions           String?   @db.Text
  status                      String    @default("pending")
  notes                       String?   @db.Text
  batchNumber                 String?   @db.VarChar(50)
  uomId                       Int?
  dueDate                     DateTime? @db.Date
  workCenterId                Int?
  createdBy                   Int?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // Relations
  qualityStandard QualityStandard? @relation(fields: [qualityStandardId], references: [id], onDelete: SetNull)
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  results         InspectionResult[]

  @@index([companyId, status])
  @@index([productionOrderId])
  @@map("mfg_quality_inspections")
}

model InspectionResult {
  id                   Int      @id @default(autoincrement())
  qualityInspectionId  Int
  qualityParameterId   Int
  measuredValue        Decimal? @db.Decimal(15, 4)
  textValue            String?
  booleanValue         Boolean?
  passed               Boolean  @default(false)
  remarks              String?  @db.Text
  qualityStandardId    Int?
  parameterName        String?  @db.VarChar(200)
  parameterType        String?  @db.VarChar(30)
  sequence             Int      @default(0)
  minValue             Decimal? @db.Decimal(15, 4)
  maxValue             Decimal? @db.Decimal(15, 4)
  targetValue          Decimal? @db.Decimal(15, 4)
  expectedValue        String?  @db.VarChar(200)
  sampleSize           Int?
  samplesInspected     Int?
  samplesPassed        Int?
  samplesFailed        Int?
  measuredMin          Decimal? @db.Decimal(15, 4)
  measuredMax          Decimal? @db.Decimal(15, 4)
  measuredAvg          Decimal? @db.Decimal(15, 4)
  readings             Json?
  result               String?  @db.VarChar(30)
  deviation            Decimal? @db.Decimal(15, 4)
  deviationPercentage  Decimal? @db.Decimal(5, 2)
  criticality          String?  @db.VarChar(20)
  isMandatory          Boolean  @default(false)
  inspectedBy          Int?
  inspectedAt          DateTime?
  equipmentUsed        String?  @db.Text
  equipmentSerial      String?  @db.VarChar(100)
  notes                String?  @db.Text
  deletedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  qualityInspection QualityInspection @relation(fields: [qualityInspectionId], references: [id], onDelete: Cascade)
  qualityParameter  QualityParameter  @relation(fields: [qualityParameterId], references: [id], onDelete: Cascade)

  @@index([qualityInspectionId])
  @@map("mfg_inspection_results")
}

model QualityDefect {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  defectNumber       String    @unique
  qualityCheckId     Int?
  qualityParameterId Int?
  productionOrderId  Int?
  itemId             Int?
  defectType         String
  severity           String    @default("minor")
  description        String    @db.Text
  rootCause          String?   @db.Text
  correctiveAction   String?   @db.Text
  preventiveAction   String?   @db.Text
  quantityAffected   Decimal?  @db.Decimal(15, 4)
  status             String    @default("open")
  reportedBy         Int?
  assignedTo         Int?
  resolvedBy         Int?
  resolvedAt         DateTime?
  images             Json?
  qualityInspectionLineId Int?
  sourceType         String?   @db.VarChar(30)
  sourceId           Int?
  sourceNumber       String?   @db.VarChar(50)
  itemCode           String?   @db.VarChar(50)
  itemName           String?   @db.VarChar(200)
  batchNumber        String?   @db.VarChar(50)
  defectCode         String?   @db.VarChar(30)
  defectCategory     String?   @db.VarChar(50)
  uomId              Int?
  defectLocation     String?   @db.VarChar(200)
  warehouseId        Int?
  workCenterId       Int?
  detectionDate      DateTime? @db.Date
  detectionPoint     String?   @db.VarChar(50)
  rootCauseCategory  String?   @db.VarChar(50)
  responsibility     String?   @db.VarChar(50)
  responsibleUserId  Int?
  supplierId         Int?
  disposition        String?   @db.VarChar(30)
  estimatedCost      Decimal?  @db.Decimal(15, 2)
  actualCost         Decimal?  @db.Decimal(15, 2)
  actionDueDate      DateTime? @db.Date
  actionCompletedDate DateTime? @db.Date
  nonConformanceId   Int?
  reportedAt         DateTime?
  createdBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  qualityParameter QualityParameter? @relation(fields: [qualityParameterId], references: [id], onDelete: SetNull)
  productionOrder  ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  nonConformanceDefects NonConformanceDefect[]

  @@index([companyId, status])
  @@index([productionOrderId])
  @@map("mfg_quality_defects")
}

model NonConformance {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  ncNumber            String?
  ncrNumber           String?   @unique
  category            String?   @db.VarChar(30)
  productionOrderId   Int?
  qualityCheckId      Int?
  qualityInspectionId Int?
  qualityDefectId     Int?
  purchaseOrderId     Int?
  itemId              Int?
  productId           Int?
  customerId          Int?
  customerName        String?   @db.VarChar(200)
  responsibleDepartmentId Int?
  type                String    @default("product")
  severity            String    @default("minor")
  title               String
  description         String    @db.Text
  occurrenceDate      DateTime? @db.Date
  discoveryDate       DateTime? @db.Date
  targetCloseDate     DateTime? @db.Date
  rootCause           String?   @db.Text
  rootCauseCategory   String?
  rootCauseMethod     String?   @db.VarChar(30)
  rootCauseCompleted  Boolean   @default(false)
  rootCauseCompletedAt DateTime?
  correctiveAction    String?   @db.Text
  correctiveActionCompleted   Boolean   @default(false)
  correctiveActionCompletedAt DateTime?
  preventiveAction    String?   @db.Text
  preventiveActionCompleted   Boolean   @default(false)
  preventiveActionCompletedAt DateTime?
  containmentAction   String?   @db.Text
  containmentCompleted        Boolean   @default(false)
  containmentCompletedAt      DateTime?
  quantityAffected    Decimal?  @db.Decimal(15, 4)
  quantity            Decimal?  @db.Decimal(15, 4)
  disposition         String?
  costImpact          Decimal?  @db.Decimal(15, 2)
  costOfNonConformance Decimal? @db.Decimal(15, 2)
  costOfCorrection    Decimal?  @db.Decimal(15, 2)
  status              String    @default("open")
  reportedBy          Int?
  assignedTo          Int?
  dueDate             DateTime? @db.Date
  detectedDate        DateTime? @db.Date
  detectedById        Int?
  dispositionDate     DateTime? @db.Date
  dispositionById     Int?
  dispositionRemarks  String?   @db.Text
  verificationNotes   String?   @db.Text
  verificationCompleted       Boolean   @default(false)
  verificationCompletedAt     DateTime?
  effectivenessVerified       Boolean   @default(false)
  effectivenessReviewDate     DateTime? @db.Date
  effectivenessNotes  String?   @db.Text
  closureNotes        String?   @db.Text
  closedBy            Int?
  closedAt            DateTime?
  verifiedBy          Int?
  verifiedAt          DateTime?
  lotNumber           String?
  warehouseId         Int?
  locationId          Int?
  sourceType          String?   @db.VarChar(30)
  sourceId            Int?
  sourceNumber        String?   @db.VarChar(50)
  batchNumber         String?   @db.VarChar(50)
  uomId               Int?
  priority            String?   @db.VarChar(20)
  supplierId          Int?
  supplierName        String?   @db.VarChar(200)
  responsibleUserId   Int?
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  defects         NonConformanceDefect[]

  @@index([companyId, status])
  @@index([productionOrderId])
  @@map("mfg_non_conformances")
}

model NonConformanceDefect {
  id                Int      @id @default(autoincrement())
  nonConformanceId  Int
  qualityDefectId   Int?
  quantity          Decimal? @db.Decimal(15, 4)
  remarks           String?  @db.Text
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  nonConformance NonConformance @relation(fields: [nonConformanceId], references: [id], onDelete: Cascade)
  qualityDefect  QualityDefect? @relation(fields: [qualityDefectId], references: [id], onDelete: SetNull)

  @@index([nonConformanceId])
  @@map("mfg_non_conformance_defects")
}

// ============================================================================
// MANUFACTURING MODULE - Shift Patterns
// ============================================================================

model ShiftPattern {
  id            Int      @id @default(autoincrement())
  companyId     Int
  code          String
  name          String
  description   String?  @db.Text
  startTime     String
  endTime       String
  breakDuration Int      @default(0)
  daysOfWeek    Json
  color         String?  @db.VarChar(7)
  isNightShift  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdBy     Int?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  lines     ShiftPatternLine[]
  calendars WorkCenterCalendar[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("mfg_shift_patterns")
}

model ShiftPatternLine {
  id             Int      @id @default(autoincrement())
  shiftPatternId Int
  dayOfWeek      Int
  shiftName      String?
  startTime      String
  endTime        String
  breakMinutes   Int      @default(0)
  isWorkingDay   Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  shiftPattern ShiftPattern @relation(fields: [shiftPatternId], references: [id], onDelete: Cascade)

  @@index([shiftPatternId])
  @@map("mfg_shift_pattern_lines")
}

model ProductionShift {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  code                String
  name                String
  description         String?  @db.Text
  startTime           String   @db.VarChar(10)
  endTime             String   @db.VarChar(10)
  crossesMidnight     Boolean  @default(false)
  totalHours          Decimal? @db.Decimal(5, 2)
  breakHours          Decimal? @db.Decimal(5, 2)
  workingHours        Decimal? @db.Decimal(5, 2)
  breaks              Json?
  daysOfWeek          Json?
  monday              Boolean  @default(true)
  tuesday             Boolean  @default(true)
  wednesday           Boolean  @default(true)
  thursday            Boolean  @default(true)
  friday              Boolean  @default(true)
  saturday            Boolean  @default(false)
  sunday              Boolean  @default(false)
  workCenterId        Int?
  defaultHeadcount    Int?
  capacityFactor      Decimal? @db.Decimal(5, 2)
  laborRateMultiplier Decimal? @db.Decimal(5, 2)
  isOvertime          Boolean  @default(false)
  isNightShift        Boolean  @default(false)
  color               String?  @db.VarChar(7)
  isActive            Boolean  @default(true)
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("mfg_production_shifts")
}

// ============================================================================
// MANUFACTURING MODULE - MRP (Material Requirements Planning)
// ============================================================================

model MrpRun {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  runNumber              String    @unique
  runName                String?   @db.VarChar(100)
  runType                String    @default("net_change") @db.VarChar(30)
  isSimulation           Boolean   @default(false)
  description            String?   @db.Text
  horizonStart           DateTime? @db.Date
  horizonEnd             DateTime? @db.Date
  frozenPeriodDays       Int       @default(0)
  status                 String    @default("draft")
  progressPercentage     Decimal   @default(0) @db.Decimal(5, 2)
  startedAt              DateTime?
  completedAt            DateTime?
  errorMessage           String?   @db.Text
  executionTimeSeconds   Decimal?  @db.Decimal(10, 2)
  itemsProcessed         Int       @default(0)
  plannedOrdersCreated   Int       @default(0)
  exceptionsFound        Int       @default(0)
  createdById            Int?
  warehouseIds           Json?
  productIds             Json?
  categoryIds            Json?
  includeSalesOrders     Boolean   @default(true)
  includeForecasts       Boolean   @default(true)
  includeSafetyStock     Boolean   @default(true)
  includeReorderPoints   Boolean   @default(true)
  includeOnHand          Boolean   @default(true)
  includePurchaseOrders  Boolean   @default(true)
  includeProductionOrders Boolean  @default(true)
  includeTransferOrders  Boolean   @default(false)
  autoFirmWithinDays     Int?
  respectLeadTimes       Boolean   @default(true)
  useBomExplosion        Boolean   @default(true)
  notes                  String?   @db.Text
  planningHorizonDays    Int?
  includePlannedOrders   Boolean   @default(true)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  demands      MrpDemand[]
  supplies     MrpSupply[]
  plannedOrders MrpPlannedOrder[]
  peggings     MrpPegging[]
  exceptions   MrpException[]

  @@index([companyId, status])
  @@map("mfg_mrp_runs")
}

model MrpDemand {
  id                Int      @id @default(autoincrement())
  mrpRunId          Int
  productId         Int
  itemCode          String?  @db.VarChar(50)
  itemName          String?  @db.VarChar(200)
  demandType        String
  sourceRefType     String?
  sourceRefId       Int?
  sourceNumber      String?  @db.VarChar(50)
  sourceLineId      Int?
  warehouseId       Int?
  requiredDate      DateTime @db.Date
  dueDate           DateTime? @db.Date
  quantity          Decimal  @db.Decimal(15, 4)
  openQuantity      Decimal  @default(0) @db.Decimal(15, 4)
  allocatedQuantity Decimal  @default(0) @db.Decimal(15, 4)
  uomId             Int?
  priority          Int      @default(5)
  isFirm            Boolean  @default(false)
  customerId        Int?
  customerName      String?  @db.VarChar(200)
  status            String   @default("open") @db.VarChar(20)
  companyId         Int?
  notes             String?  @db.Text
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  mrpRun   MrpRun       @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  peggings MrpPegging[] @relation("DemandPegging")

  @@index([mrpRunId, productId])
  @@map("mfg_mrp_demands")
}

model MrpSupply {
  id                Int      @id @default(autoincrement())
  mrpRunId          Int
  productId         Int
  supplyType        String
  sourceRefType     String?
  sourceRefId       Int?
  warehouseId       Int?
  availableDate     DateTime @db.Date
  quantity          Decimal  @db.Decimal(15, 4)
  allocatedQuantity Decimal  @default(0) @db.Decimal(15, 4)
  remainingQuantity Decimal  @default(0) @db.Decimal(15, 4)
  uomId             Int?
  companyId         Int?
  itemCode          String?  @db.VarChar(50)
  itemName          String?  @db.VarChar(200)
  sourceNumber      String?  @db.VarChar(50)
  sourceLineId      Int?
  receiptDate       DateTime? @db.Date
  priority          Int      @default(5)
  isFirm            Boolean  @default(false)
  reliabilityFactor Decimal? @db.Decimal(5, 2)
  supplierId        Int?
  supplierName      String?  @db.VarChar(200)
  status            String   @default("open") @db.VarChar(20)
  notes             String?  @db.Text
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  mrpRun   MrpRun       @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  peggings MrpPegging[] @relation("SupplyPegging")

  @@index([mrpRunId, productId])
  @@map("mfg_mrp_supplies")
}

model MrpPlannedOrder {
  id              Int       @id @default(autoincrement())
  companyId       Int
  mrpRunId        Int
  orderNumber     String?
  orderType       String
  productId       Int
  quantity        Decimal   @db.Decimal(15, 4)
  uomId           Int?
  requiredDate    DateTime  @db.Date
  startDate       DateTime? @db.Date
  warehouseId     Int?
  vendorId        Int?
  bomId           Int?
  routingId       Int?
  fromWarehouseId Int?
  priority        Int       @default(5)
  status          String    @default("planned")
  releasedOrderId Int?
  notes           String?   @db.Text
  itemCode        String?   @db.VarChar(50)
  itemName        String?   @db.VarChar(200)
  orderedQuantity Decimal?  @db.Decimal(15, 4)
  openQuantity    Decimal?  @db.Decimal(15, 4)
  leadTimeDays    Int?
  releaseDate     DateTime? @db.Date
  isInFrozenPeriod Boolean  @default(false)
  urgency         String?   @db.VarChar(20)
  supplierName    String?   @db.VarChar(200)
  workCenterId    Int?
  isConverted     Boolean   @default(false)
  convertedOrderType    String?  @db.VarChar(30)
  convertedOrderNumber  String?  @db.VarChar(50)
  convertedAt     DateTime?
  convertedBy     Int?
  hasException    Boolean   @default(false)
  exceptionType   String?   @db.VarChar(50)
  exceptionMessage String?  @db.Text
  parentDemandId  Int?
  peggedQuantity  Decimal?  @db.Decimal(15, 4)
  createdBy       Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  mrpRun   MrpRun       @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  peggings MrpPegging[] @relation("PlannedOrderPegging")

  @@index([mrpRunId, productId])
  @@index([companyId, status])
  @@map("mfg_planned_orders")
}

model MrpPegging {
  id             Int  @id @default(autoincrement())
  mrpRunId       Int
  productId      Int
  demandId       Int?
  supplyId       Int?
  plannedOrderId Int?
  quantity       Decimal @db.Decimal(15, 4)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  mrpRun       MrpRun           @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  demand       MrpDemand?       @relation("DemandPegging", fields: [demandId], references: [id], onDelete: SetNull)
  supply       MrpSupply?       @relation("SupplyPegging", fields: [supplyId], references: [id], onDelete: SetNull)
  plannedOrder MrpPlannedOrder? @relation("PlannedOrderPegging", fields: [plannedOrderId], references: [id], onDelete: SetNull)

  @@index([mrpRunId])
  @@map("mfg_mrp_pegging")
}

model MrpException {
  id                Int       @id @default(autoincrement())
  mrpRunId          Int
  exceptionType     String
  productId         Int?
  warehouseId       Int?
  referenceType     String?
  referenceId       Int?
  currentDate       DateTime? @db.Date
  suggestedDate     DateTime? @db.Date
  currentQuantity   Decimal?  @db.Decimal(15, 4)
  suggestedQuantity Decimal?  @db.Decimal(15, 4)
  message           String?   @db.Text
  isResolved        Boolean   @default(false)
  resolutionAction  String?
  resolvedAt        DateTime?
  resolvedById      Int?
  notes             String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  mrpRun MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  @@index([mrpRunId])
  @@map("mfg_mrp_exceptions")
}

// ============================================================================
// MANUFACTURING MODULE - Demand Forecasting
// ============================================================================

model Forecast {
  id                Int       @id @default(autoincrement())
  companyId         Int
  code              String?
  name              String?
  productId         Int?
  warehouseId       Int?
  customerId        Int?
  forecastMethod    String?
  forecastPeriod    String?
  startDate         DateTime? @db.Date
  endDate           DateTime? @db.Date
  historicalPeriods Int?
  smoothingFactor   Decimal?  @db.Decimal(5, 4)
  seasonalityFactor Decimal?  @db.Decimal(5, 4)
  trendFactor       Decimal?  @db.Decimal(5, 4)
  isActive          Boolean   @default(true)
  notes             String?   @db.Text
  description       String?   @db.Text
  forecastType      String?   @db.VarChar(30)
  numberOfPeriods   Int?
  itemCategoryId    Int?
  version           String?   @db.VarChar(20)
  isLocked          Boolean   @default(false)
  status            String    @default("draft") @db.VarChar(20)
  approvedBy        Int?
  approvedAt        DateTime?
  forecastAccuracy  Decimal?  @db.Decimal(5, 2)
  mape              Decimal?  @db.Decimal(10, 4)
  bias              Decimal?  @db.Decimal(10, 4)
  createdBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  lines ForecastLine[]

  @@index([companyId])
  @@map("mfg_forecasts")
}

model ForecastLine {
  id             Int       @id @default(autoincrement())
  forecastId     Int
  periodStart    DateTime  @db.Date
  periodEnd      DateTime? @db.Date
  quantity       Decimal   @db.Decimal(15, 4)
  actualQuantity Decimal?  @db.Decimal(15, 4)
  notes          String?   @db.Text
  itemId         Int?
  uomId          Int?
  periodNumber   Int?
  adjustedQuantity  Decimal? @db.Decimal(15, 4)
  finalQuantity     Decimal? @db.Decimal(15, 4)
  varianceQuantity  Decimal? @db.Decimal(15, 4)
  variancePercentage Decimal? @db.Decimal(5, 2)
  consumedQuantity  Decimal? @db.Decimal(15, 4)
  remainingQuantity Decimal? @db.Decimal(15, 4)
  customerId     Int?
  warehouseId    Int?
  status         String    @default("active") @db.VarChar(20)
  isLocked       Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  forecast Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId, periodStart])
  @@map("mfg_forecast_lines")
}

// ============================================================================
// MANUFACTURING MODULE - Cost Tracking
// ============================================================================

model ManufacturingCost {
  id           Int      @id @default(autoincrement())
  companyId    Int
  workOrderId  Int?
  category     String
  costType     String   @default("actual")
  itemId       Int?
  employeeId   Int?
  workCenterId Int?
  quantity     Decimal? @db.Decimal(15, 4)
  unit         String?
  unitCost     Decimal  @default(0) @db.Decimal(15, 2)
  totalCost    Decimal  @default(0) @db.Decimal(15, 2)
  costDate     DateTime @db.Date
  description  String?  @db.Text
  reference    String?
  productionOrderOperationId Int?
  costCategory  String?  @db.VarChar(30)
  costCode      String?  @db.VarChar(30)
  referenceId   Int?
  referenceNumber String? @db.VarChar(50)
  uomId         Int?
  standardCost  Decimal? @db.Decimal(15, 2)
  variance      Decimal? @db.Decimal(15, 2)
  variancePercentage Decimal? @db.Decimal(5, 2)
  costAllocationRuleId Int?
  allocationPercentage Decimal? @db.Decimal(5, 2)
  isAllocated   Boolean  @default(false)
  period        String?  @db.VarChar(20)
  status        String   @default("draft") @db.VarChar(20)
  isPosted      Boolean  @default(false)
  journalEntryId Int?
  notes         String?  @db.Text
  createdBy    Int?
  updatedBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, workOrderId])
  @@index([category, costType])
  @@map("manufacturing_costs")
}

model WorkInstruction {
  id                            Int      @id @default(autoincrement())
  companyId                     Int
  title                         String
  description                   String?  @db.Text
  instructionType               String?
  itemId                        Int?
  workCenterId                  Int?
  bomId                         Int?
  priority                      String   @default("normal")
  version                       String   @default("1.0")
  steps                         Json?
  attachments                   Json?
  requiredEquipment             Json?
  requiredMaterials             Json?
  safetyRequirements            Json?
  qualityStandards              Json?
  estimatedTotalDurationMinutes Int?
  tags                          Json?
  notes                         String?  @db.Text
  status                        String   @default("draft")
  approvedBy                    Int?
  approvedAt                    DateTime?
  createdBy                     Int?
  updatedBy                     Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@index([companyId, status])
  @@map("work_instructions")
}

model CostAllocationRule {
  id                   Int      @id @default(autoincrement())
  companyId            Int
  name                 String
  description          String?  @db.Text
  costPoolType         String
  allocationMethod     String
  allocationDriver     String?
  sourceCostCenterId   Int?
  targetWorkCenterIds  Json?
  allocationPercentage Decimal? @db.Decimal(5, 2)
  fixedAmount          Decimal? @db.Decimal(15, 2)
  variableRate         Decimal? @db.Decimal(15, 4)
  isActive             Boolean  @default(true)
  priority             Int      @default(0)
  code                 String?  @db.VarChar(30)
  rateUom              String?  @db.VarChar(20)
  costCenterId         Int?
  targetType           String?  @db.VarChar(30)
  effectiveFrom        DateTime? @db.Date
  effectiveTo          DateTime? @db.Date
  deletedAt            DateTime?
  createdBy            Int?
  updatedBy            Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId, isActive])
  @@map("cost_allocation_rules")
}

// ============================================================================
// MANUFACTURING MODULE - Settings
// ============================================================================

model ManufacturingSetting {
  id                          Int      @id @default(autoincrement())
  companyId                   Int      @unique

  // -- BOM Settings --
  maxBomLevels                Int      @default(10)
  allowCircularBomCheck       Boolean  @default(true)
  defaultBomStatus            String   @default("draft")
  requireBomApproval          Boolean  @default(true)

  // -- Production Order Settings --
  autoGeneratePoNumber        Boolean  @default(true)
  poNumberPrefix              String   @default("PO") @db.VarChar(10)
  poNumberNextSequence        Int      @default(1)
  defaultIssueMethod          String   @default("manual") @db.VarChar(20)
  allowOverReceipt            Boolean  @default(false)
  overReceiptTolerancePercent Decimal  @default(0) @db.Decimal(5, 2)
  allowUnderReceipt           Boolean  @default(true)
  underReceiptTolerancePercent Decimal @default(5) @db.Decimal(5, 2)
  autoCloseCompletedOrders    Boolean  @default(true)

  // -- MRP Settings --
  mrpPlanningHorizonDays      Int      @default(90)
  mrpTimeFenceDays            Int      @default(7)
  mrpLotSizingMethod          String   @default("lot_for_lot") @db.VarChar(30)
  mrpDefaultLeadTimeDays      Int      @default(5)
  mrpSafetyStockMethod        String   @default("fixed") @db.VarChar(30)
  mrpIncludeSafetyStock       Boolean  @default(true)
  mrpAutoFirmWithinFence      Boolean  @default(false)

  // -- Capacity Planning --
  enableFiniteScheduling      Boolean  @default(true)
  schedulingDirection         String   @default("backward") @db.VarChar(20)
  considerQueueTime           Boolean  @default(true)
  considerMoveTime            Boolean  @default(true)
  defaultEfficiencyPercent    Decimal  @default(100) @db.Decimal(5, 2)
  defaultUtilizationPercent   Decimal  @default(85) @db.Decimal(5, 2)

  // -- Quality Settings --
  requireFirstArticleInspection Boolean @default(false)
  requireInProcessInspection    Boolean @default(true)
  requireFinalInspection        Boolean @default(true)
  inspectionSamplingMethod      String  @default("aql") @db.VarChar(30)
  defaultAqlLevel               String  @default("1.0") @db.VarChar(10)
  autoCreateNcrOnFail           Boolean @default(true)
  ncrRequiresDisposition        Boolean @default(true)
  capaRequiredForCriticalNcr    Boolean @default(true)

  // -- SPC Settings --
  enableSpcCollection         Boolean  @default(true)
  spcControlLimitSigma        Decimal  @default(3.0) @db.Decimal(3, 1)
  spcWarningLimitSigma        Decimal  @default(2.0) @db.Decimal(3, 1)
  spcMinSamplesForAnalysis    Int      @default(25)

  // -- Costing Settings --
  costingMethod               String   @default("actual") @db.VarChar(20)
  laborRateSource             String   @default("work_center") @db.VarChar(20)
  overheadAllocationBasis     String   @default("machine_hours") @db.VarChar(30)
  wipAccountId                Int?
  fgVarianceAccountId         Int?
  materialVarianceAccountId   Int?
  laborVarianceAccountId      Int?
  overheadVarianceAccountId   Int?
  scrapAccountId              Int?

  // -- Warehouse Defaults --
  defaultRawMaterialWarehouseId   Int?
  defaultWipWarehouseId           Int?
  defaultFinishedGoodsWarehouseId Int?
  defaultScrapWarehouseId         Int?
  allowWarehouseSelectionOnReceipt Boolean @default(true)

  // -- Traceability --
  enforceLotTraceability      Boolean  @default(true)
  autoGenerateProductionBatch Boolean  @default(true)
  productionBatchFormat       String   @default("PB-{YYYY}{MM}{DD}-{SEQ}") @db.VarChar(50)
  linkInputLotsToOutput       Boolean  @default(true)

  // -- IoT Integration --
  enableIotIntegration            Boolean  @default(false)
  iotPollingIntervalSeconds       Int      @default(60)
  iotConnectionTimeoutSeconds     Int      @default(30)
  fallbackToManualOnIotFailure    Boolean  @default(true)
  autoCreateQcOnCriticalAlarm     Boolean  @default(true)

  // -- Approval Workflow --
  poApprovalRequired              Boolean @default(true)
  materialIssueApprovalRequired   Boolean @default(false)
  receiptApprovalRequired         Boolean @default(true)
  ncrApprovalRequired             Boolean @default(true)
  capaApprovalRequired            Boolean @default(true)
  allowZeroCostMaterials          Boolean @default(false)

  // -- Audit --
  createdById                 Int?
  updatedById                 Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@map("mfg_settings")
}

// ============================================================================
// MANUFACTURING MODULE - Work Center Calendars & Exceptions
// ============================================================================

model WorkCenterCalendar {
  id             Int      @id @default(autoincrement())
  workCenterId   Int
  shiftPatternId Int
  dayOfWeek      Int
  startTime      String   @db.VarChar(10)
  endTime        String   @db.VarChar(10)
  breakMinutes   Int      @default(0)
  capacityHours  Decimal  @db.Decimal(8, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  workCenter   WorkCenter   @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  shiftPattern ShiftPattern @relation(fields: [shiftPatternId], references: [id], onDelete: Cascade)

  @@unique([workCenterId, shiftPatternId, dayOfWeek])
  @@map("mfg_work_center_calendars")
}

model WorkCenterException {
  id             Int       @id @default(autoincrement())
  workCenterId   Int
  exceptionDate  DateTime  @db.Date
  exceptionType  String    @default("holiday") @db.VarChar(20)
  isWorkingDay   Boolean   @default(false)
  startTime      String?   @db.VarChar(10)
  endTime        String?   @db.VarChar(10)
  capacityHours  Decimal?  @db.Decimal(8, 2)
  reason         String?   @db.VarChar(255)
  notes          String?   @db.Text
  createdById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  workCenter WorkCenter @relation(fields: [workCenterId], references: [id], onDelete: Cascade)

  @@unique([workCenterId, exceptionDate])
  @@map("mfg_work_center_exceptions")
}

// ============================================================================
// MANUFACTURING MODULE - Production Schedules
// ============================================================================

model ProductionSchedule {
  id                          Int       @id @default(autoincrement())
  companyId                   Int
  scheduleDate                DateTime  @db.Date
  shiftPatternId              Int?
  workCenterId                Int
  productionOrderId           Int?
  productionOrderOperationId  Int?
  productId                   Int?
  scheduledStart              DateTime
  scheduledEnd                DateTime
  scheduledHours              Decimal   @db.Decimal(8, 2)
  actualStart                 DateTime?
  actualEnd                   DateTime?
  actualHours                 Decimal?  @db.Decimal(8, 2)
  plannedQuantity             Decimal   @default(0) @db.Decimal(15, 4)
  actualQuantity              Decimal   @default(0) @db.Decimal(15, 4)
  sequence                    Int       @default(0)
  priority                    String    @default("normal") @db.VarChar(20)
  status                      String    @default("draft") @db.VarChar(20)
  plannedHeadcount            Int?
  actualHeadcount             Int?
  assignedEmployees           Json?
  capacityUsedPercent         Decimal?  @db.Decimal(5, 2)
  isOvertime                  Boolean   @default(false)
  notes                       String?   @db.Text
  scheduleNotes               String?   @db.Text
  hasConflict                 Boolean   @default(false)
  conflictReason              String?   @db.Text
  scheduledById               Int?
  createdById                 Int?
  deletedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, scheduleDate, workCenterId])
  @@index([workCenterId, scheduleDate])
  @@index([productionOrderId])
  @@map("mfg_production_schedules")
}

// ============================================================================
// PETTY CASH MODULE
// ============================================================================

model PettyCashSettings {
  id                           Int      @id @default(autoincrement())
  companyId                    Int      @unique
  disbursementPrefix           String   @default("PCD")
  disbursementNextNumber       Int      @default(1)
  replenishmentPrefix          String   @default("PCR")
  replenishmentNextNumber      Int      @default(1)
  requireDisbursementApproval  Boolean  @default(true)
  requireReplenishmentApproval Boolean  @default(true)
  maxDisbursementAmount        Decimal? @db.Decimal(15, 2)
  requireReceiptAttachment     Boolean  @default(false)
  defaultExpenseAccountId      Int?
  autoPostToGL                 Boolean  @default(false)
  createdBy                    Int?
  updatedBy                    Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@map("petty_cash_settings")
}

model PettyCashCategory {
  id               Int       @id @default(autoincrement())
  companyId        Int
  name             String
  code             String
  description      String?   @db.Text
  expenseAccountId Int?
  maxAmount        Decimal?  @db.Decimal(15, 2)
  requiresReceipt  Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  disbursementItems PettyCashDisbursementItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("petty_cash_categories")
}

model PettyCashFund {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  name                  String
  code                  String
  description           String?   @db.Text
  custodianId           Int?
  custodianName         String?
  glAccountId           Int?
  currencyCode          String    @default("NGN") @db.VarChar(3)
  fundLimit             Decimal   @db.Decimal(15, 2)
  currentBalance        Decimal   @default(0) @db.Decimal(15, 2)
  openingBalance        Decimal   @default(0) @db.Decimal(15, 2)
  minimumBalance        Decimal   @default(0) @db.Decimal(15, 2)
  status                String    @default("active")
  lastReconciledAt      DateTime?
  lastReconciledBalance Decimal?  @db.Decimal(15, 2)
  isActive              Boolean   @default(true)
  createdBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  disbursements  PettyCashDisbursement[]
  replenishments PettyCashReplenishment[]
  company        Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("petty_cash_funds")
}

model PettyCashDisbursement {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  fundId             Int
  disbursementNumber String    @unique
  disbursementDate   DateTime  @db.Date
  payeeName          String
  description        String?   @db.Text
  totalAmount        Decimal   @db.Decimal(15, 2)
  taxAmount          Decimal   @default(0) @db.Decimal(15, 2)
  netAmount          Decimal   @default(0) @db.Decimal(15, 2)
  receiptNumber      String?
  receiptAttachment  String?
  status             String    @default("draft")
  approvalStatus     String    @default("pending")
  journalEntryId     Int?
  postedAt           DateTime?
  postedBy           Int?
  approvedAt         DateTime?
  approvedBy         Int?
  approvalNotes      String?   @db.Text
  rejectionReason    String?   @db.Text
  notes              String?   @db.Text
  createdBy          Int?
  updatedBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  fund  PettyCashFund              @relation(fields: [fundId], references: [id], onDelete: Restrict)
  items PettyCashDisbursementItem[]

  @@index([companyId, status])
  @@index([fundId, disbursementDate])
  @@map("petty_cash_disbursements")
}

model PettyCashDisbursementItem {
  id               Int      @id @default(autoincrement())
  disbursementId   Int
  categoryId       Int?
  expenseAccountId Int?
  description      String
  quantity         Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice        Decimal  @db.Decimal(15, 2)
  lineAmount       Decimal  @db.Decimal(15, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount      Decimal  @db.Decimal(15, 2)
  costCenterId     Int?
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  disbursement PettyCashDisbursement @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  category     PettyCashCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([disbursementId])
  @@map("petty_cash_disbursement_items")
}

model PettyCashReplenishment {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  fundId              Int
  replenishmentNumber String    @unique
  requestDate         DateTime  @db.Date
  amount              Decimal   @db.Decimal(15, 2)
  description         String?   @db.Text
  sourceBankId        Int?
  sourceAccountId     Int?
  referenceNumber     String?
  journalEntryId      Int?
  status              String    @default("draft")
  requestedBy         Int?
  requestedAt         DateTime  @default(now())
  approvedBy          Int?
  approvedAt          DateTime?
  approvalNotes       String?   @db.Text
  rejectionReason     String?   @db.Text
  processedBy         Int?
  processedAt         DateTime?
  postedAt            DateTime?
  postedBy            Int?
  notes               String?   @db.Text
  createdBy           Int?
  updatedBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  fund PettyCashFund @relation(fields: [fundId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([fundId, requestDate])
  @@map("petty_cash_replenishments")
}

// ============================================================================
// ASSETS MODULE - Asset Classes, Assets, Depreciation, Transfers, Maintenance, Disposals, Settings
// ============================================================================

model AssetClass {
  id                                Int                @id @default(autoincrement())
  companyId                         Int
  code                              String             @unique
  name                              String
  description                       String?            @db.Text
  parentId                          Int?
  depreciationMethod                DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeYears                   Int                @default(5)
  usefulLifeMonths                  Int                @default(0)
  residualValuePercent              Decimal            @default(0) @db.Decimal(5, 2)
  assetAccountId                    Int?
  accumulatedDepreciationAccountId  Int?
  depreciationExpenseAccountId      Int?
  gainLossAccountId                 Int?
  maintenanceAccountId              Int?
  isActive                          Boolean            @default(true)
  createdBy                         Int?
  deletedAt                         DateTime?
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime           @updatedAt

  // Relations
  parent   AssetClass?  @relation("AssetClassHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AssetClass[] @relation("AssetClassHierarchy")
  assets   Asset[]
  company  Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, isActive])
  @@map("ast_asset_classes")
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
  DOUBLE_DECLINING
  SUM_OF_YEARS
  SUM_OF_YEARS_DIGITS
  UNITS_OF_PRODUCTION
  NO_DEPRECIATION
}

model Asset {
  id                      Int                @id @default(autoincrement())
  companyId               Int
  branchId                Int?
  assetClassId            Int
  assetCode               String             @unique
  name                    String
  description             String?            @db.Text
  serialNumber            String?
  barcode                 String?
  make                    String?
  model                   String?
  manufacturer            String?
  location                String?
  department              String?
  custodianUserId         Int?
  acquisitionDate         DateTime?          @db.Date
  acquisitionCost         Decimal            @db.Decimal(15, 2)
  acquisitionMethod       String?
  supplierId              Int?
  purchaseOrderNumber     String?
  invoiceNumber           String?
  grnId                   Int?
  grnLineId               Int?
  depreciationMethod      DepreciationMethod
  usefulLifeYears         Int
  residualValue           Decimal            @default(0) @db.Decimal(15, 2)
  residualValuePercent    Decimal            @default(0) @db.Decimal(5, 2)
  depreciationStartDate   DateTime?          @db.Date
  bookValue               Decimal            @default(0) @db.Decimal(15, 2)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(15, 2)
  impairmentLoss          Decimal            @default(0) @db.Decimal(15, 2)
  lastDepreciationDate    DateTime?          @db.Date
  status                  String             @default("active")
  condition               String             @default("new")
  warrantyStartDate       DateTime?          @db.Date
  warrantyExpiryDate      DateTime?          @db.Date
  lastMaintenanceDate     DateTime?          @db.Date
  nextMaintenanceDate     DateTime?          @db.Date
  disposalDate            DateTime?          @db.Date
  disposalValue           Decimal?           @db.Decimal(15, 2)
  disposalMethod          String?
  disposalNotes           String?            @db.Text
  notes                   String?            @db.Text
  customFields            Json?
  imagePath               String?
  createdById             Int?
  deletedAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  assetClass          AssetClass         @relation(fields: [assetClassId], references: [id], onDelete: Cascade)
  depreciationRecords AssetDepreciation[]
  transfers           AssetTransfer[]
  maintenanceRecords  AssetMaintenance[]
  disposals           AssetDisposal[]
  company             Company            @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([assetClassId, status])
  @@index([branchId, status])
  @@map("ast_assets")
}

model AssetDepreciation {
  id                      Int      @id @default(autoincrement())
  companyId               Int
  assetId                 Int
  depreciationDate        DateTime @db.Date
  fiscalYear              Int
  fiscalPeriod            Int
  periodName              String?
  depreciationMethod      String
  openingBookValue        Decimal  @db.Decimal(15, 2)
  depreciationAmount      Decimal  @db.Decimal(15, 2)
  closingBookValue        Decimal  @db.Decimal(15, 2)
  accumulatedDepreciation Decimal  @db.Decimal(15, 2)
  annualDepreciationRate  Decimal? @db.Decimal(8, 4)
  usefulLifeYears         Int?
  residualValue           Decimal? @db.Decimal(15, 2)
  monthsDepreciated       Int      @default(1)
  isPosted                Boolean  @default(false)
  transactionId           Int?
  postedAt                DateTime?
  postedByUserId          Int?
  batchNumber             String?
  isAdjustment            Boolean  @default(false)
  adjustmentReason        String?  @db.Text
  status                  String   @default("draft")
  createdById             Int?
  deletedAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, depreciationDate])
  @@index([isPosted, depreciationDate])
  @@index([companyId, fiscalYear, fiscalPeriod])
  @@map("ast_depreciations")
}

model AssetTransfer {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  assetId             Int
  transferNumber      String    @unique
  transferDate        DateTime  @db.Date
  effectiveDate       DateTime? @db.Date
  transferType        String
  fromLocation        String?
  fromDepartment      String?
  fromCustodianUserId Int?
  fromBranchId        Int?
  toLocation          String?
  toDepartment        String?
  toCustodianUserId   Int?
  toBranchId          Int?
  conditionAtTransfer String?
  conditionNotes      String?   @db.Text
  status              String    @default("draft")
  requestedByUserId   Int?
  approvedByUserId    Int?
  approvedAt          DateTime?
  dispatchedAt        DateTime?
  receivedByUserId    Int?
  receivedAt          DateTime?
  reason              String?   @db.Text
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, transferDate])
  @@index([companyId, status])
  @@map("ast_transfers")
}

model AssetMaintenance {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  assetId               Int
  maintenanceNumber     String    @unique
  title                 String?
  description           String?   @db.Text
  maintenanceType       String    @default("preventive")
  priority              String    @default("medium")
  scheduledDate         DateTime? @db.Date
  dueDate               DateTime? @db.Date
  startedDate           DateTime? @db.Date
  completedDate         DateTime? @db.Date
  estimatedDurationHours Decimal? @db.Decimal(8, 2)
  actualDurationHours   Decimal?  @db.Decimal(8, 2)
  isRecurring           Boolean   @default(false)
  recurrenceFrequency   String?
  recurrenceInterval    Int?
  nextScheduledDate     DateTime? @db.Date
  vendorName            String?
  vendorContact         String?
  technicianName        String?
  assignedToUserId      Int?
  estimatedCost         Decimal?  @db.Decimal(15, 2)
  actualCost            Decimal?  @db.Decimal(15, 2)
  laborCost             Decimal?  @db.Decimal(12, 2)
  partsCost             Decimal?  @db.Decimal(12, 2)
  costBreakdown         String?   @db.Text
  partsUsed             String?   @db.Text
  materialsUsed         String?   @db.Text
  conditionBefore       String?
  conditionAfter        String?
  meterReadingBefore    Decimal?  @db.Decimal(15, 2)
  meterReadingAfter     Decimal?  @db.Decimal(15, 2)
  meterUnit             String?
  workPerformed         String?   @db.Text
  findings              String?   @db.Text
  recommendations       String?   @db.Text
  notes                 String?   @db.Text
  status                String    @default("scheduled")
  requiresFollowUp     Boolean   @default(false)
  followUpNotes         String?   @db.Text
  requestedByUserId     Int?
  approvedByUserId      Int?
  approvedAt            DateTime?
  completedByUserId     Int?
  isPosted              Boolean   @default(false)
  transactionId         Int?
  postedAt              DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, maintenanceType])
  @@index([companyId, status])
  @@map("ast_maintenances")
}

model AssetDisposal {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  assetId                 Int
  disposalNumber          String    @unique
  disposalDate            DateTime  @db.Date
  disposalType            String
  bookValueAtDisposal     Decimal   @db.Decimal(15, 2)
  accumulatedDepreciation Decimal   @db.Decimal(15, 2)
  disposalProceeds        Decimal   @default(0) @db.Decimal(15, 2)
  disposalCosts           Decimal   @default(0) @db.Decimal(12, 2)
  gainLoss                Decimal   @default(0) @db.Decimal(15, 2)
  buyerEntityId           Int?
  buyerName               String?
  buyerContact            String?
  buyerAddress            String?   @db.Text
  saleAgreementNumber     String?
  invoiceNumber           String?
  paymentReceivedDate     DateTime? @db.Date
  paymentMethod           String?
  status                  String    @default("draft")
  requestedByUserId       Int?
  approvedByUserId        Int?
  approvedAt              DateTime?
  completedAt             DateTime?
  isPosted                Boolean   @default(false)
  transactionId           Int?
  postedAt                DateTime?
  reason                  String?   @db.Text
  notes                   String?   @db.Text
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, disposalDate])
  @@index([companyId, status])
  @@map("ast_disposals")
}

// Asset Settings - Company-level configuration for asset module
model AssetSettings {
  id                           Int      @id @default(autoincrement())
  companyId                    Int      @unique

  // Depreciation Settings
  defaultDepreciationMethod    String   @default("STRAIGHT_LINE")
  autoCalculateDepreciation    Boolean  @default(true)
  depreciationFrequency        String   @default("monthly")
  prorationFirstYear           Boolean  @default(true)
  prorationDisposalYear        Boolean  @default(true)
  midMonthConvention           Boolean  @default(false)

  // Lifecycle Settings
  requireAssetApproval         Boolean  @default(false)
  requireDisposalApproval      Boolean  @default(true)
  requireTransferApproval      Boolean  @default(true)
  requireMaintenanceApproval   Boolean  @default(false)
  autoGenerateCode             Boolean  @default(true)
  codePrefix                   String   @default("AST")
  codePadding                  Int      @default(6)

  // Valuation Settings
  allowRevaluation             Boolean  @default(false)
  requireRevaluationApproval   Boolean  @default(true)
  trackImpairment              Boolean  @default(true)
  calculateFairValue           Boolean  @default(false)

  // Maintenance Settings
  trackMaintenanceCosts        Boolean  @default(true)
  maintenanceReminderDays      Int      @default(7)
  allowMaintenanceScheduling   Boolean  @default(true)
  capitalizationThreshold      Decimal  @default(5000) @db.Decimal(15, 2)

  // Transfer Settings
  allowInterCompanyTransfer    Boolean  @default(false)
  allowInterBranchTransfer     Boolean  @default(true)
  requirePhysicalVerification  Boolean  @default(true)

  // Notification Settings
  notifyOnDepreciation         Boolean  @default(false)
  notifyOnMaintenanceDue       Boolean  @default(true)
  notifyOnWarrantyExpiry       Boolean  @default(true)
  notifyOnDisposal             Boolean  @default(true)
  warrantyExpiryReminderDays   Int      @default(30)

  // Barcode & Tracking
  enableBarcode                Boolean  @default(true)
  enableQrCode                 Boolean  @default(false)
  barcodeFormat                String?

  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@map("ast_settings")
}

// ============================================================================
// BUDGET MODULE (Exact Parity with Original Laravel System)
// ============================================================================

// Budget Settings - Company-level configuration for budget control
model BudgetSetting {
  id        Int @id @default(autoincrement())
  companyId Int @unique

  // Dimension Configuration
  useBranchDimension     Boolean @default(true)
  useDepartmentDimension Boolean @default(true)
  useProjectDimension    Boolean @default(false)
  useCostCenterDimension Boolean @default(false)

  // Control Settings
  defaultControlType       BudgetControlType @default(WARN)
  warningThresholdPercent  Decimal           @default(80.00) @db.Decimal(5, 2)
  criticalThresholdPercent Decimal           @default(95.00) @db.Decimal(5, 2)

  // Phasing Configuration
  defaultPhasingMethod  BudgetPhasingMethod @default(EVEN)
  allowManualPhasing    Boolean             @default(true)
  allowPriorYearPhasing Boolean             @default(true)

  // Integration Hooks - Which documents trigger budget checks
  checkOnPurchaseRequisition Boolean @default(true)
  checkOnPurchaseOrder       Boolean @default(true)
  checkOnApInvoice           Boolean @default(true)
  checkOnJournalEntry        Boolean @default(true)
  checkOnExpenseRequest      Boolean @default(true)

  // Approval Configuration
  approvalLevels           Int      @default(3)
  requireOverrideSignature Boolean  @default(true)
  requireBudgetApproval    Boolean  @default(true)
  requireTransferApproval  Boolean  @default(true)
  requireOverrideApproval  Boolean  @default(true)
  autoApproveBelowAmount   Decimal? @db.Decimal(18, 2)

  // Notification Settings
  notifyBudgetApprover      Boolean @default(true)
  notifyTransferApprover    Boolean @default(true)
  notifyOverrideApprover    Boolean @default(true)
  notifyOnWarningThreshold  Boolean @default(true)
  notifyOnCriticalThreshold Boolean @default(true)
  notifyOnOverBudget        Boolean @default(true)

  // Document Numbering
  budgetNumberFormat   String @default("BUD-{YEAR}-{SEQUENCE}")
  transferNumberFormat String @default("BTR-{YEAR}-{SEQUENCE}")
  overrideNumberFormat String @default("BOV-{YEAR}-{SEQUENCE}")
  sequencePadding      Int    @default(5)

  // Fiscal Year Settings
  fiscalYearStartMonth Int @default(1)
  periodsPerYear       Int @default(12)

  isActive         Boolean   @default(true)
  notes            String?   @db.Text
  controlSettings  Json?
  createdBy        Int?
  updatedBy        Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  companies Company[]
  budgets   Budget[]

  @@map("budget_settings")
}

enum BudgetControlType {
  HARD_STOP // Block transaction completely
  WARN // Allow but show warning
  OVERRIDE // Require manager approval
  LOG_ONLY // Log silently, no user interaction
}

enum BudgetPhasingMethod {
  EVEN // Equal distribution across periods
  MANUAL // User specifies each period
  PRIOR_YEAR // Copy from previous year
}

// Main Budget Header with approval workflow
model Budget {
  id           Int          @id @default(autoincrement())
  companyId    Int
  branchId     Int?
  fiscalYearId Int
  settingId    Int?
  createdBy    Int?
  budgetNumber String       @unique
  name         String
  description  String?      @db.Text
  budgetType   BudgetType   @default(OPERATING)
  status       BudgetStatus @default(DRAFT)

  // Version Control
  version        Int     @default(1)
  parentBudgetId Int?
  isRevision     Boolean @default(false)

  // Denormalized Totals (for performance)
  totalBudgetAmount    Decimal @default(0) @db.Decimal(18, 4)
  totalCommittedAmount Decimal @default(0) @db.Decimal(18, 4)
  totalActualAmount    Decimal @default(0) @db.Decimal(18, 4)
  totalAvailableAmount Decimal @default(0) @db.Decimal(18, 4)

  // Dates
  effectiveDate   DateTime  @db.Date
  expiryDate      DateTime? @db.Date
  submittedAt     DateTime?
  submittedBy     Int?
  approvedAt      DateTime?
  approvedBy      Int?
  rejectionReason String?   @db.Text
  returnedReason  String?   @db.Text

  currency  String    @default("NGN")
  isActive  Boolean   @default(true)
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  company      Company        @relation(fields: [companyId], references: [id])
  fiscalYear   FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  setting      BudgetSetting? @relation(fields: [settingId], references: [id])
  parentBudget Budget?        @relation("BudgetRevisions", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  revisions    Budget[]       @relation("BudgetRevisions")
  lines        BudgetLine[]

  @@index([companyId, fiscalYearId, status])
  @@index([budgetType, status])
  @@index([branchId])
  @@map("budgets")
}

enum BudgetType {
  OPERATING // Day-to-day operational expenses
  CAPITAL // Capital expenditure (fixed assets)
  PROJECT // Project-specific budget
  GRANTS // Grant/donor-funded budget
  CONSOLIDATED // Consolidated/group budget
}

enum BudgetStatus {
  DRAFT // Initial creation
  PENDING_APPROVAL // Submitted for approval
  APPROVED // Approved but not yet active
  REJECTED // Rejected by approver
  RETURNED // Returned for revision
  ACTIVE // Currently in use
  CLOSED // Closed at period end
  ARCHIVED // Historical/archived
}

// Budget Lines - Individual allocations with multi-dimensional breakdown
model BudgetLine {
  id       Int @id @default(autoincrement())
  budgetId Int

  // 5-Segment CoA Dimensions
  companyId    Int
  branchId     Int?
  departmentId Int?
  accountId    Int
  projectId    Int?
  costCenterId Int?

  lineDescription String? @db.Text

  // Control Settings (Line-level Override)
  controlType             BudgetControlType?
  warningThresholdPercent Decimal?           @db.Decimal(5, 2)

  // Amounts
  annualBudgetAmount Decimal @db.Decimal(18, 4)
  committedAmount    Decimal @default(0) @db.Decimal(18, 4)
  actualAmount       Decimal @default(0) @db.Decimal(18, 4)
  availableAmount    Decimal @default(0) @db.Decimal(18, 4)

  // Phasing
  phasingMethod   BudgetPhasingMethod @default(EVEN)
  priorYearLineId Int?

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  budget            Budget                   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account           IfrsAccount              @relation(fields: [accountId], references: [id])
  priorYearLine     BudgetLine?              @relation("PriorYearLine", fields: [priorYearLineId], references: [id], onDelete: SetNull)
  derivedLines      BudgetLine[]             @relation("PriorYearLine")
  periodAllocations BudgetPeriodAllocation[]
  transactions      BudgetTransaction[]
  transfersFrom     BudgetTransfer[]         @relation("TransferFromLine")
  transfersTo       BudgetTransfer[]         @relation("TransferToLine")
  overrides         BudgetOverride[]
  exceptions        BudgetControlException[]

  @@index([accountId, budgetId])
  @@index([projectId, budgetId])
  @@index([companyId, branchId, departmentId, accountId])
  @@map("budget_lines")
}

// Period Allocations - Monthly/Periodic breakdown for granular control
model BudgetPeriodAllocation {
  id                Int       @id @default(autoincrement())
  budgetLineId      Int
  periodNumber      Int // 1-12 for monthly
  periodName        String // "January 2026", "Q1 2026", etc.
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  budgetAmount      Decimal   @db.Decimal(18, 4)
  committedAmount   Decimal   @default(0) @db.Decimal(18, 4)
  actualAmount      Decimal   @default(0) @db.Decimal(18, 4)
  availableAmount   Decimal   @default(0) @db.Decimal(18, 4)
  allocationPercent Decimal   @default(8.3333) @db.Decimal(8, 4) // 100/12
  isClosed          Boolean   @default(false)
  closedAt          DateTime?
  closedBy          Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  budgetLine   BudgetLine          @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  transactions BudgetTransaction[]

  @@unique([budgetLineId, periodNumber])
  @@index([startDate, endDate])
  @@map("budget_period_allocations")
}

// Budget Transactions - Commitment & Actual tracking with audit trail
model BudgetTransaction {
  id                       Int                   @id @default(autoincrement())
  budgetLineId             Int
  budgetPeriodAllocationId Int?
  createdBy                Int?
  transactionType          BudgetTransactionType

  // Source Document (Polymorphic)
  sourceType   String? // PurchaseRequisition, PurchaseOrder, ApInvoice, JournalEntry, ExpenseRequest
  sourceId     Int?
  sourceNumber String?

  // Amount
  amount       Decimal @db.Decimal(18, 4)
  currencyCode String  @default("NGN")
  exchangeRate Decimal @default(1) @db.Decimal(18, 8)
  baseAmount   Decimal @db.Decimal(18, 4)

  description     String?   @db.Text
  transactionDate DateTime  @db.Date
  postedAt        DateTime?
  balanceAfter    Decimal   @db.Decimal(18, 4) // Running balance snapshot
  createdAt       DateTime  @default(now())

  // Relations
  budgetLine       BudgetLine              @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  periodAllocation BudgetPeriodAllocation? @relation(fields: [budgetPeriodAllocationId], references: [id], onDelete: SetNull)

  @@index([sourceType, sourceId])
  @@index([budgetLineId, transactionDate])
  @@index([transactionType, createdAt])
  @@map("budget_transactions")
}

enum BudgetTransactionType {
  COMMITMENT // From PR/PO
  COMMITMENT_RELEASE // When PO cancelled/reduced
  ACTUAL // From AP Invoice, Journal Entry
  ACTUAL_REVERSAL // Credit notes, reversals
  TRANSFER_IN // Budget transfer received
  TRANSFER_OUT // Budget transfer sent
  ADJUSTMENT // Manual adjustment
}

// Budget Transfers - Inter-line transfers with approval workflow
model BudgetTransfer {
  id             Int    @id @default(autoincrement())
  transferNumber String @unique

  // Source and Destination Lines
  fromBudgetLineId       Int
  fromPeriodAllocationId Int?
  toBudgetLineId         Int
  toPeriodAllocationId   Int?

  transferAmount Decimal              @db.Decimal(18, 4)
  reason         String               @db.Text
  justification  String?              @db.Text
  status         BudgetTransferStatus @default(DRAFT)

  // Requester
  requestedBy Int
  requestedAt DateTime  @default(now())
  submittedAt DateTime?

  // Approver
  approvedBy      Int?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text

  postedAt  DateTime?
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  fromBudgetLine BudgetLine @relation("TransferFromLine", fields: [fromBudgetLineId], references: [id], onDelete: Restrict)
  toBudgetLine   BudgetLine @relation("TransferToLine", fields: [toBudgetLineId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([fromBudgetLineId])
  @@index([toBudgetLineId])
  @@map("budget_transfers")
}

enum BudgetTransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  POSTED
  CANCELLED
}

// Budget Overrides - Hard stop override with digital signatures
model BudgetOverride {
  id             Int    @id @default(autoincrement())
  overrideNumber String @unique
  budgetLineId   Int

  // Source Document (Polymorphic)
  sourceType   String?
  sourceId     Int?
  sourceNumber String?

  // Override Details
  overrideAmount    Decimal @db.Decimal(18, 4)
  budgetAvailable   Decimal @db.Decimal(18, 4)
  overAmount        Decimal @db.Decimal(18, 4)
  overBudgetPercent Decimal @db.Decimal(8, 4)

  reason         String               @db.Text
  justification  String               @db.Text
  businessImpact String?              @db.Text
  status         BudgetOverrideStatus @default(PENDING)

  // Requester
  requestedBy Int
  requestedAt DateTime  @default(now())
  submittedAt DateTime?

  // Approver
  approvedBy       Int?
  approvedAt       DateTime?
  approverComments String?   @db.Text
  rejectionReason  String?   @db.Text

  // Digital Signatures
  requesterSignaturePath String?
  approverSignaturePath  String?
  requesterSignedAt      DateTime?
  approverSignedAt       DateTime?

  // Audit Trail (IP/Device)
  requesterIp        String?
  approverIp         String?
  requesterUserAgent String? @db.Text
  approverUserAgent  String? @db.Text

  // Validity
  expiresAt    DateTime?
  isOneTimeUse Boolean   @default(true)
  isUsed       Boolean   @default(false)
  usedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  budgetLine BudgetLine               @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  exceptions BudgetControlException[]

  @@index([sourceType, sourceId])
  @@index([status, requestedAt])
  @@index([budgetLineId, status])
  @@map("budget_overrides")
}

enum BudgetOverrideStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Budget Control Exceptions - Complete audit log of all control checks
model BudgetControlException {
  id           Int  @id @default(autoincrement())
  companyId    Int?
  budgetLineId Int?

  // Source Document
  sourceType   String
  sourceId     Int
  sourceNumber String?

  // Exception Details
  exceptionType BudgetExceptionType
  controlType   BudgetControlType
  actionTaken   BudgetControlAction

  // Amounts
  budgetAmount       Decimal? @db.Decimal(18, 4)
  committedAmount    Decimal? @db.Decimal(18, 4)
  actualAmount       Decimal? @db.Decimal(18, 4)
  availableAmount    Decimal? @db.Decimal(18, 4)
  requestedAmount    Decimal  @db.Decimal(18, 4)
  overAmount         Decimal? @db.Decimal(18, 4)
  utilizationPercent Decimal? @db.Decimal(8, 4)

  budgetOverrideId Int?
  userId           Int
  notes            String?  @db.Text
  createdAt        DateTime @default(now())

  // Relations
  budgetLine     BudgetLine?     @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  budgetOverride BudgetOverride? @relation(fields: [budgetOverrideId], references: [id], onDelete: SetNull)

  @@index([sourceType, sourceId])
  @@index([exceptionType, createdAt])
  @@index([budgetLineId, createdAt])
  @@map("budget_control_exceptions")
}

enum BudgetExceptionType {
  OVER_BUDGET
  THRESHOLD_WARNING
  THRESHOLD_CRITICAL
  NO_BUDGET_FOUND
  BUDGET_INACTIVE
  PERIOD_CLOSED
  CONTROL_BYPASSED
}

enum BudgetControlAction {
  BLOCKED
  WARNED
  OVERRIDDEN
  LOGGED
  ALLOWED
}

// ============================================================================
// PAYABLES MODULE
// ============================================================================

model SupplierPaymentMethod {
  id                  Int               @id @default(autoincrement())
  companyId           Int
  supplierId          Int
  methodType          PaymentMethodType @default(BANK_TRANSFER)
  isPrimary           Boolean           @default(false)
  bankName            String?
  accountName         String?
  accountNumber       String?
  routingNumber       String?
  swiftCode           String?
  ibanNumber          String?
  branchCode          String?
  currency            String            @default("NGN")
  paypalEmail         String?
  mobileMoneyNumber   String?
  mobileMoneyProvider String?
  checkPayeeName      String?
  instructions        String?           @db.Text
  isActive            Boolean           @default(true)
  verifiedAt          DateTime?
  verifiedBy          Int?
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([companyId, supplierId])
  @@index([supplierId, isPrimary])
  @@map("supplier_payment_methods")
}

enum PaymentMethodType {
  BANK_TRANSFER
  CHECK
  CASH
  CREDIT_CARD
  WIRE_TRANSFER
  PAYPAL
  MOBILE_MONEY
  LETTER_OF_CREDIT
}

model SupplierPayment {
  id                Int      @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  userId            Int?
  supplierId        Int
  paymentNumber     String   @unique
  paymentDate       DateTime @db.Date
  paymentMethod     String   @default("BANK_TRANSFER")
  amountPaid        Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal  @db.Decimal(18, 2)
  allocatedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  unallocatedAmount Decimal  @db.Decimal(18, 2)
  whtAmount         Decimal  @default(0) @db.Decimal(18, 2)
  netAmount         Decimal  @default(0) @db.Decimal(18, 2)
  currency          String   @default("NGN")
  exchangeRate      Decimal  @default(1) @db.Decimal(12, 6)
  baseAmount        Decimal  @db.Decimal(18, 2)
  bankAccountId     Int?
  bankAccountNumber String?
  bankName          String?
  checkNumber       String?
  reference         String?
  description       String?  @db.Text
  status            String   @default("pending")
  approvalStatus    String   @default("draft")
  voucherNumber     String?
  journalEntryId    Int?
  isPosted          Boolean  @default(false)
  postedBy          Int?
  postedAt          DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  submittedAt       DateTime?
  voidedBy          Int?
  voidedAt          DateTime?
  voidReason        String?  @db.Text
  attachments       Json?
  notes             String?  @db.Text
  createdBy         Int?
  deletedAt         DateTime?
  // Batch import tagging — same semantics as on ExpenseRequest. batchRef
  // holds the externalRef from the uploaded CSV (uniqueness / retry dedup);
  // isHistoricalLoad marks Super-Admin bulk-backfill rows so audit reports
  // can separate current activity from prior-period backfill.
  batchRef          String?
  isHistoricalLoad  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  allocations      SupplierPaymentAllocation[]
  paymentMethods   PayablesPaymentMethod[]
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  bank             Bank?    @relation(fields: [bankId], references: [id])
  bankId           Int?

  @@index([companyId, paymentDate])
  @@index([supplierId, status])
  @@index([batchRef])
  @@map("pay_payments")
}

model SupplierPaymentAllocation {
  id                Int      @id @default(autoincrement())
  paymentId         Int
  purchaseInvoiceId Int
  amount            Decimal  @db.Decimal(18, 2)
  vatAmount         Decimal  @default(0) @db.Decimal(15, 2)
  whtBase           Decimal  @default(0) @db.Decimal(15, 2)
  whtId             Int?
  whtRate           Decimal  @default(0) @db.Decimal(5, 2)
  whtAmount         Decimal  @default(0) @db.Decimal(15, 2)
  netAmount         Decimal  @default(0) @db.Decimal(15, 2)
  discountTaken     Decimal  @default(0) @db.Decimal(15, 2)
  writeOffAmount    Decimal  @default(0) @db.Decimal(15, 2)
  allocationDate    DateTime @db.Date
  notes             String?  @db.Text
  createdBy         Int?
  createdAt         DateTime @default(now())

  // Relations
  payment         SupplierPayment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([paymentId, purchaseInvoiceId])
  @@index([purchaseInvoiceId])
  @@map("pay_payment_allocations")
}

model PayablesPaymentMethod {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  paymentMethodId Int
  bankId          Int
  amount          Decimal  @db.Decimal(18, 2)
  reference       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  payment       SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod   @relation(fields: [paymentMethodId], references: [id])
  bank          Bank            @relation("PayablesPaymentBank", fields: [bankId], references: [id])

  @@index([paymentId])
  @@map("pay_payment_methods")
}

model PayablesSettings {
  id                       Int      @id @default(autoincrement())
  companyId                Int      @unique
  paymentPrefix            String   @default("PAY")
  paymentNextNumber        Int      @default(1)
  requirePaymentApproval   Boolean  @default(true)
  paymentApprovalThreshold Decimal  @default(0) @db.Decimal(15, 2)
  defaultPaymentTerms      String?  @default("Net 30")
  autoAllocatePayments     Boolean  @default(false)
  allowPartialPayments     Boolean  @default(true)
  allowOverPayments        Boolean  @default(false)
  enableWhtDeduction       Boolean  @default(false)
  defaultWhtRate           Decimal  @default(0) @db.Decimal(5, 2)
  whtDeductionPoint        String   @default("payment") @db.VarChar(20)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("pay_settings")
}

// ============================================================================
// RECEIVABLES MODULE
// ============================================================================

model CustomerReceipt {
  id                Int      @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  customerId        Int
  receiptNumber     String   @unique
  receiptDate       DateTime @db.Date
  paymentMethod     String   @default("BANK_TRANSFER")
  totalAmount       Decimal  @db.Decimal(18, 2)
  allocatedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  unallocatedAmount Decimal  @db.Decimal(18, 2)
  currency          String   @default("NGN")
  exchangeRate      Decimal  @default(1) @db.Decimal(12, 6)
  baseAmount        Decimal  @db.Decimal(18, 2)
  bankAccountId     Int?
  bankAccountNumber String?
  bankName          String?
  checkNumber       String?
  referenceNumber   String?
  description       String?  @db.Text
  status            String   @default("DRAFT")
  journalEntryId    Int?
  isPosted          Boolean  @default(false)
  postedBy          Int?
  postedAt          DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  voidedBy          Int?
  voidedAt          DateTime?
  voidReason        String?  @db.Text
  attachments       Json?
  notes             String?  @db.Text
  createdBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cashRegisterSessionId Int?

  // Relations
  allocations    ReceiptAllocation[]
  paymentMethods ReceiptPaymentMethod[]
  customer       Customer             @relation(fields: [customerId], references: [id])
  bank           Bank?                @relation(fields: [bankId], references: [id])
  bankId         Int?
  session        CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  @@index([companyId, receiptDate])
  @@index([customerId, status])
  @@map("customer_receipts")
}

model ReceiptAllocation {
  id              Int      @id @default(autoincrement())
  receiptId       Int
  invoiceId       Int
  allocationDate  DateTime @db.Date
  allocatedAmount Decimal  @db.Decimal(18, 2)
  discountAllowed Decimal  @default(0) @db.Decimal(15, 2)
  writeOffAmount  Decimal  @default(0) @db.Decimal(15, 2)

  // VAT Tracking (proportional from invoice)
  vatAmount           Decimal @default(0) @db.Decimal(15, 2)
  vatRecognized       Boolean @default(false)
  vatRecognizedAmount Decimal @default(0) @db.Decimal(15, 2)

  // WHT Tracking (Withholding Tax)
  whtId       Int?
  whtBase     Decimal @default(0) @db.Decimal(15, 2) // Amount excluding VAT
  whtRate     Decimal @default(0) @db.Decimal(5, 2)
  whtAmount   Decimal @default(0) @db.Decimal(15, 2)
  netReceived Decimal @default(0) @db.Decimal(15, 2) // Amount after WHT deduction

  notes     String?  @db.Text
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Relations
  receipt        CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  salesInvoice   SalesInvoice?   @relation(fields: [salesInvoiceId], references: [id])
  salesInvoiceId Int?

  @@index([receiptId, invoiceId])
  @@index([invoiceId])
  @@map("receipt_allocations")
}

model ReceiptPaymentMethod {
  id              Int      @id @default(autoincrement())
  receiptId       Int
  paymentMethodId Int
  bankId          Int?
  accountId       Int? // GL account to post to
  amount          Decimal  @db.Decimal(18, 2)
  reference       String? // Check number, transaction ID, etc.
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  receipt       CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod   @relation(fields: [paymentMethodId], references: [id])
  bank          Bank?           @relation("ReceiptPaymentBank", fields: [bankId], references: [id])

  @@index([receiptId])
  @@map("receipt_payment_methods")
}

model CreditNote {
  id                Int      @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  customerId        Int
  creditNoteNumber  String   @unique
  creditNoteDate    DateTime @db.Date
  originalInvoiceId Int?
  reason            String   @default("GOODS_RETURNED")
  subtotal          Decimal  @db.Decimal(18, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(15, 2)
  totalAmount       Decimal  @db.Decimal(18, 2)
  allocatedAmount   Decimal  @default(0) @db.Decimal(18, 2)
  unallocatedAmount Decimal  @db.Decimal(18, 2)
  currency          String   @default("NGN")
  exchangeRate      Decimal  @default(1) @db.Decimal(12, 6)
  baseAmount        Decimal  @db.Decimal(18, 2)
  description       String?  @db.Text
  postToGL          Boolean  @default(false)
  glAccountId       Int?
  status            String   @default("DRAFT")
  journalEntryId    Int?
  isPosted          Boolean  @default(false)
  postedBy          Int?
  postedAt          DateTime?
  approvedBy        Int?
  approvedAt        DateTime?
  voidedBy          Int?
  voidedAt          DateTime?
  voidReason        String?  @db.Text
  rejectionReason   String?  @db.Text
  attachments       Json?
  notes             String?  @db.Text
  createdBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  lines       CreditNoteLine[]
  allocations CreditNoteAllocation[]

  // Commission (clawback)
  commissionCalculations CommissionCalculation[]

  @@index([companyId, creditNoteDate])
  @@index([customerId, status])
  @@map("credit_notes")
}

model CreditNoteLine {
  id                    Int      @id @default(autoincrement())
  creditNoteId          Int
  lineNumber            Int
  itemId                Int?
  description           String
  quantity              Decimal  @db.Decimal(15, 4)
  unit                  String
  unitPrice             Decimal  @db.Decimal(15, 2)
  discountPercentage    Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount        Decimal  @default(0) @db.Decimal(15, 2)
  taxCode               String?
  taxRate               Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount             Decimal  @default(0) @db.Decimal(15, 2)
  lineTotal             Decimal  @db.Decimal(18, 2)
  warehouseId           Int?
  originalInvoiceLineId Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now())

  // Relations
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@unique([creditNoteId, lineNumber])
  @@map("credit_note_lines")
}

model CreditNoteAllocation {
  id              Int      @id @default(autoincrement())
  creditNoteId    Int
  invoiceId       Int
  allocationDate  DateTime @db.Date
  allocatedAmount Decimal  @db.Decimal(18, 2)
  notes           String?  @db.Text
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  // Relations
  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId, invoiceId])
  @@index([invoiceId])
  @@map("credit_note_allocations")
}

// ============================================================================
// PROJECT MANAGEMENT MODULE
// ============================================================================

model ProjectType {
  id                 Int         @id @default(autoincrement())
  companyId          Int
  code               String      @unique
  name               String
  description        String?     @db.Text
  defaultBillingType BillingType @default(FIXED_PRICE)
  isActive           Boolean     @default(true)
  createdBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  projects Project[]

  @@index([companyId, isActive])
  @@map("project_types")
}

enum BillingType {
  FIXED_PRICE
  TIME_AND_MATERIALS
  RETAINER
  MILESTONE_BASED
  NOT_BILLABLE
}

model ProjectCategory {
  id          Int       @id @default(autoincrement())
  companyId   Int
  code        String    @unique
  name        String
  description String?   @db.Text
  parentId    Int?
  isActive    Boolean   @default(true)
  createdBy   Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  parent   ProjectCategory?  @relation("ProjectCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProjectCategory[] @relation("ProjectCategoryHierarchy")
  projects Project[]

  @@index([companyId, isActive])
  @@map("project_categories")
}

model Project {
  id                   Int             @id @default(autoincrement())
  companyId            Int
  branchId             Int?
  projectTypeId        Int?
  categoryId           Int?
  customerId           Int?
  projectNumber        String          @unique
  name                 String
  description          String?         @db.Text
  status               ProjectStatus   @default(PLANNING)
  priority             ProjectPriority @default(MEDIUM)
  startDate            DateTime?       @db.Date
  targetEndDate        DateTime?       @db.Date
  actualEndDate        DateTime?       @db.Date
  billingType          BillingType     @default(FIXED_PRICE)
  budgetAmount         Decimal?        @db.Decimal(18, 2)
  estimatedCost        Decimal?        @db.Decimal(18, 2)
  actualCost           Decimal?        @db.Decimal(18, 2)
  contractValue        Decimal?        @db.Decimal(18, 2)
  billedAmount         Decimal         @default(0) @db.Decimal(18, 2)
  paidAmount           Decimal         @default(0) @db.Decimal(18, 2)
  currency             String          @default("NGN")
  completionPercentage Decimal         @default(0) @db.Decimal(5, 2)
  projectManagerId     Int?
  projectManagerName   String?
  departmentId         Int?
  tags                 Json?
  attachments          Json?
  notes                String?         @db.Text
  metadata             Json?
  createdBy            Int?
  approvedBy           Int?
  approvedAt           DateTime?
  closedBy             Int?
  closedAt             DateTime?
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relations
  projectType ProjectType?     @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  category    ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  phases      ProjectPhase[]
  milestones  ProjectMilestone[]
  budgetLines ProjectBudget[]
  teamMembers ProjectTeamMember[]
  timeEntries TimeEntry[]
  revenues    ProjectRevenue[]
  company     Company             @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([customerId, status])
  @@index([projectManagerId])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProjectPhase {
  id                   Int         @id @default(autoincrement())
  projectId            Int
  phaseNumber          Int
  name                 String
  description          String?     @db.Text
  startDate            DateTime?   @db.Date
  endDate              DateTime?   @db.Date
  actualStartDate      DateTime?   @db.Date
  actualEndDate        DateTime?   @db.Date
  status               PhaseStatus @default(NOT_STARTED)
  completionPercentage Decimal     @default(0) @db.Decimal(5, 2)
  budgetAmount         Decimal?    @db.Decimal(15, 2)
  actualCost           Decimal?    @db.Decimal(15, 2)
  sortOrder            Int         @default(0)
  notes                String?     @db.Text
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestones ProjectMilestone[]

  @@unique([projectId, phaseNumber])
  @@index([projectId, status])
  @@map("project_phases")
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

model ProjectMilestone {
  id            Int             @id @default(autoincrement())
  projectId     Int
  phaseId       Int?
  name          String
  description   String?         @db.Text
  dueDate       DateTime        @db.Date
  completedDate DateTime?       @db.Date
  status        MilestoneStatus @default(PENDING)
  isBillable    Boolean         @default(false)
  billingAmount Decimal?        @db.Decimal(15, 2)
  billedAt      DateTime?
  deliverables  Json? // Array of deliverable items
  dependencies  Json? // Array of milestone IDs
  assignedTo    Int?
  sortOrder     Int             @default(0)
  notes         String?         @db.Text
  createdBy     Int?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([phaseId, status])
  @@index([dueDate, status])
  @@map("project_milestones")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

model ProjectBudget {
  id              Int      @id @default(autoincrement())
  projectId       Int
  lineNumber      Int
  category        String // labor, materials, equipment, subcontractor, travel, other
  description     String
  budgetedAmount  Decimal  @db.Decimal(15, 2)
  committedAmount Decimal  @default(0) @db.Decimal(15, 2)
  actualAmount    Decimal  @default(0) @db.Decimal(15, 2)
  varianceAmount  Decimal  @default(0) @db.Decimal(15, 2)
  accountId       Int?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lineNumber])
  @@index([projectId, category])
  @@map("project_budgets")
}

model ProjectTeamMember {
  id                   Int       @id @default(autoincrement())
  projectId            Int
  employeeId           Int?
  userId               Int?
  memberName           String
  role                 String
  email                String?
  phone                String?
  startDate            DateTime? @db.Date
  endDate              DateTime? @db.Date
  allocationPercentage Decimal   @default(100) @db.Decimal(5, 2)
  hourlyRate           Decimal?  @db.Decimal(10, 2)
  isBillable           Boolean   @default(true)
  isActive             Boolean   @default(true)
  permissions          Json?
  notes                String?   @db.Text
  createdBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]

  @@index([projectId, isActive])
  @@index([employeeId])
  @@map("project_team_members")
}

model TimeEntry {
  id              Int             @id @default(autoincrement())
  companyId       Int
  projectId       Int
  teamMemberId    Int?
  employeeId      Int?
  userId          Int?
  entryDate       DateTime        @db.Date
  startTime       DateTime?       @db.Time()
  endTime         DateTime?       @db.Time()
  duration        Decimal         @db.Decimal(6, 2) // hours
  description     String          @db.Text
  taskCategory    String?
  isBillable      Boolean         @default(true)
  billingRate     Decimal?        @db.Decimal(10, 2)
  billableAmount  Decimal?        @db.Decimal(12, 2)
  isBilled        Boolean         @default(false)
  invoiceId       Int?
  invoicedAt      DateTime?
  status          TimeEntryStatus @default(DRAFT)
  approvedBy      Int?
  approvedAt      DateTime?
  rejectedBy      Int?
  rejectedAt      DateTime?
  rejectionReason String?         @db.Text
  notes           String?         @db.Text
  createdBy       Int?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember ProjectTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)

  @@index([companyId, entryDate])
  @@index([projectId, entryDate])
  @@index([employeeId, entryDate])
  @@index([status, isBilled])
  @@map("time_entries")
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ProjectRevenue {
  id               Int         @id @default(autoincrement())
  projectId        Int
  revenueNumber    String      @unique
  revenueDate      DateTime    @db.Date
  revenueType      RevenueType @default(MILESTONE)
  description      String
  amount           Decimal     @db.Decimal(18, 2)
  milestoneId      Int?
  invoiceId        Int?
  invoiceNumber    String?
  invoiceDate      DateTime?   @db.Date
  isPaid           Boolean     @default(false)
  paymentDate      DateTime?   @db.Date
  paymentReference String?
  notes            String?     @db.Text
  createdBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, revenueDate])
  @@map("project_revenues")
}

enum RevenueType {
  MILESTONE
  TIME_BASED
  RETAINER
  EXPENSE_REIMBURSEMENT
  OTHER
}

// ============================================================================
// PRINTING MODULE
// ============================================================================

model PrintTemplate {
  id             Int            @id @default(autoincrement())
  companyId      Int
  code           String         @unique
  name           String
  description    String?        @db.Text
  documentType   String // invoice, po, receipt, report, etc.
  templateFormat TemplateFormat @default(PDF)
  templateEngine TemplateEngine @default(HTML) // HTML or DESIGNER
  paperSize      String         @default("A4")
  orientation    Orientation    @default(PORTRAIT)

  // HTML Template Engine (for developers)
  headerHtml String? @db.Text
  bodyHtml   String? @db.Text
  footerHtml String? @db.Text
  css        String? @db.Text

  // Visual Designer Engine (for business users)
  designerJson Json? // JSON template definition for drag-and-drop designer

  headerHeight    Int? // mm
  footerHeight    Int? // mm
  marginTop       Int       @default(10) // mm
  marginBottom    Int       @default(10)
  marginLeft      Int       @default(10)
  marginRight     Int       @default(10)
  logoPosition    String?
  showPageNumbers Boolean   @default(true)
  showPrintDate   Boolean   @default(true)
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  version         Int       @default(1)
  createdBy       Int?
  updatedBy       Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  variables PrintTemplateVariable[]

  @@index([companyId, documentType])
  @@index([companyId, isDefault])
  @@index([companyId, templateEngine])
  @@map("print_templates")
}

enum TemplateFormat {
  PDF
  HTML
  EXCEL
  WORD
  THERMAL // For thermal receipt printers (58mm, 80mm)
}

enum TemplateEngine {
  HTML // HTML/CSS/Handlebars templates (for developers)
  DESIGNER // JSON drag-and-drop templates (for business users)
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
}

model PrintTemplateVariable {
  id              Int          @id @default(autoincrement())
  templateId      Int
  variableName    String
  variableLabel   String
  variableType    VariableType @default(TEXT)
  defaultValue    String?
  isRequired      Boolean      @default(false)
  validationRules Json?
  helpText        String?      @db.Text
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  template PrintTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, variableName])
  @@map("print_template_variables")
}

enum VariableType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  IMAGE
  TABLE
  LIST
}

// ============================================================================
// AI MODULE
// ============================================================================

model AiConversation {
  id                Int                @id @default(autoincrement())
  companyId         Int
  userId            Int
  conversationId    String             @unique @default(uuid())
  title             String?
  context           String? // document, help, general, etc.
  contextEntityType String? // invoice, customer, product, etc.
  contextEntityId   Int?
  model             String             @default("claude-sonnet-4-20250514")
  agentType         String             @default("general") // accountant, inventory, hr, general
  totalTokens       Int                @default(0)
  totalCost         Decimal            @default(0) @db.Decimal(10, 4)
  status            ConversationStatus @default(ACTIVE)
  metadata          Json?
  archivedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations
  messages AiMessage[]

  @@index([companyId, userId])
  @@index([userId, status])
  @@index([contextEntityType, contextEntityId])
  @@map("ai_conversations")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model AiMessage {
  id              Int         @id @default(autoincrement())
  conversationId  Int
  role            MessageRole
  content         String      @db.Text
  tokensUsed      Int         @default(0)
  cost            Decimal     @default(0) @db.Decimal(10, 6)
  functionCall    Json?
  functionResult  Json?
  attachments     Json?
  metadata        Json?
  feedbackRating  Int? // 1-5
  feedbackComment String?     @db.Text
  errorMessage    String?     @db.Text
  createdAt       DateTime    @default(now())

  // Relations
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  FUNCTION
}

// ============================================================================
// HR PAYROLL MODULE - Performance Management
// ============================================================================

model PerformanceReview {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  employeeId           Int
  reviewerId           Int
  reviewCode           String    @unique
  reviewPeriod         String    @default("annual") // annual, semi_annual, quarterly, monthly
  periodStart          DateTime  @db.Date
  periodEnd            DateTime  @db.Date
  dueDate              DateTime  @db.Date
  status               String    @default("draft") // draft, self_review, manager_review, completed, cancelled
  selfRating           Decimal?  @db.Decimal(3, 1)
  managerRating        Decimal?  @db.Decimal(3, 1)
  finalRating          Decimal?  @db.Decimal(3, 1)
  selfComments         String?   @db.Text
  managerComments      String?   @db.Text
  strengths            Json?
  areasForImprovement  Json?
  developmentPlan      String?   @db.Text
  goalsAchieved        Int?
  totalGoals           Int?
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee Employee @relation("ReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  goals    PerformanceGoal[]

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([reviewerId])
  @@map("performance_reviews")
}

model PerformanceGoal {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  employeeId          Int
  performanceReviewId Int?
  title               String
  description         String?   @db.Text
  targetValue         Decimal?  @db.Decimal(15, 2)
  actualValue         Decimal?  @db.Decimal(15, 2)
  unit                String?
  weight              Decimal   @default(1) @db.Decimal(5, 2)
  startDate           DateTime  @db.Date
  dueDate             DateTime  @db.Date
  status              String    @default("not_started") // not_started, in_progress, completed, exceeded, not_achieved
  progress            Int       @default(0)
  selfRating          Decimal?  @db.Decimal(3, 1)
  managerRating       Decimal?  @db.Decimal(3, 1)
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performanceReview PerformanceReview? @relation(fields: [performanceReviewId], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@index([performanceReviewId])
  @@index([status])
  @@map("performance_goals")
}

// ============================================================================
// HR PAYROLL MODULE - Recruitment
// ============================================================================

model JobPosting {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  branchId            Int?
  departmentId        Int?
  positionId          Int?
  jobCode             String    @unique
  title               String
  description         String?   @db.Text
  requirements        String?   @db.Text
  responsibilities    String?   @db.Text
  employmentType      EmploymentType @default(FULL_TIME)
  salaryRangeMin      Decimal?  @db.Decimal(15, 2)
  salaryRangeMax      Decimal?  @db.Decimal(15, 2)
  showSalary          Boolean   @default(false)
  location            String?
  isRemote            Boolean   @default(false)
  experienceYears     Int?
  educationLevel      String?
  skills              Json?
  openings            Int       @default(1)
  applicationDeadline DateTime? @db.Date
  status              String    @default("draft") // draft, published, closed, filled, cancelled
  publishedAt         DateTime?
  closedAt            DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position     Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([companyId, status])
  @@index([departmentId])
  @@map("job_postings")
}

model JobApplication {
  id                Int       @id @default(autoincrement())
  companyId         Int
  jobPostingId      Int
  applicationCode   String    @unique
  firstName         String
  lastName          String
  email             String
  phone             String?
  resumeUrl         String?
  coverLetterUrl    String?
  linkedinUrl       String?
  portfolioUrl      String?
  currentEmployer   String?
  currentPosition   String?
  currentSalary     Decimal?  @db.Decimal(15, 2)
  expectedSalary    Decimal?  @db.Decimal(15, 2)
  noticePeriodDays  Int?
  availableFrom     DateTime? @db.Date
  source            String?
  referredBy        String?
  skills            Json?
  educationHistory  Json?
  workHistory       Json?
  status            String    @default("new") // new, screening, shortlisted, interview, offered, hired, rejected, withdrawn
  rating            Int?
  notes             String?   @db.Text
  rejectionReason   String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  interviews Interview[]
  offers     JobOffer[]

  @@index([companyId, jobPostingId])
  @@index([companyId, status])
  @@index([email])
  @@map("job_applications")
}

model Interview {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  jobApplicationId   Int
  interviewCode      String    @unique
  interviewType      String    @default("in_person") // in_person, phone, video, panel, technical, hr
  roundNumber        Int       @default(1)
  scheduledAt        DateTime
  duration           Int?
  location           String?
  meetingLink        String?
  interviewerIds     Json?
  interviewerNames   Json?
  status             String    @default("scheduled") // scheduled, in_progress, completed, cancelled, no_show
  result             String    @default("pending") // pending, passed, failed, on_hold
  feedback           String?   @db.Text
  technicalScore     Decimal?  @db.Decimal(3, 1)
  communicationScore Decimal?  @db.Decimal(3, 1)
  cultureFitScore    Decimal?  @db.Decimal(3, 1)
  overallScore       Decimal?  @db.Decimal(3, 1)
  notes              String?   @db.Text
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([companyId, jobApplicationId])
  @@index([status])
  @@map("interviews")
}

model JobOffer {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  jobApplicationId      Int
  offerCode             String    @unique
  positionId            Int?
  departmentId          Int?
  cadreId               Int?
  gradeLevelId          Int?
  offeredSalary         Decimal   @db.Decimal(15, 2)
  salaryType            SalaryType @default(STRUCTURED)
  employmentType        EmploymentType @default(FULL_TIME)
  startDate             DateTime  @db.Date
  expiresAt             DateTime?
  probationPeriodMonths Int?
  benefits              Json?
  allowances            Json?
  notes                 String?   @db.Text
  status                String    @default("draft") // draft, sent, accepted, rejected, withdrawn, expired
  sentAt                DateTime?
  respondedAt           DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?   @db.Text
  approvalStatus        String    @default("pending") // pending, approved, rejected
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([jobApplicationId])
  @@map("job_offers")
}

// ============================================================================
// HR PAYROLL MODULE - Training
// ============================================================================

model TrainingProgram {
  id               Int       @id @default(autoincrement())
  companyId        Int
  name             String
  code             String    @unique
  description      String?   @db.Text
  trainingType     String    @default("technical") // technical, soft_skills, compliance, leadership, safety, onboarding
  deliveryMethod   String    @default("classroom") // classroom, online, blended, on_the_job, workshop, seminar
  duration         Int?
  durationUnit     String?   @default("hours") // hours, days, weeks
  provider         String?
  instructorName   String?
  maxParticipants  Int?
  minParticipants  Int?
  cost             Decimal?  @db.Decimal(15, 2)
  location         String?
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  objectives       Json?
  materials        Json?
  prerequisites    Json?
  status           String    @default("draft") // draft, scheduled, in_progress, completed, cancelled
  isActive         Boolean   @default(true)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollments TrainingEnrollment[]

  @@index([companyId, status])
  @@index([trainingType])
  @@map("training_programs")
}

model TrainingEnrollment {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  trainingProgramId    Int
  employeeId           Int
  enrollmentCode       String    @unique
  enrolledAt           DateTime  @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  status               String    @default("enrolled") // enrolled, in_progress, completed, withdrawn, failed
  progress             Int       @default(0)
  score                Decimal?  @db.Decimal(5, 2)
  passingScore         Decimal?  @db.Decimal(5, 2)
  certificateUrl       String?
  feedback             String?   @db.Text
  attendancePercentage Decimal?  @db.Decimal(5, 2)
  notes                String?   @db.Text
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, employeeId])
  @@index([companyId, status])
  @@map("training_enrollments")
}

// ============================================================================
// HR PAYROLL MODULE - Time & Attendance
// ============================================================================

model WorkSchedule {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  name                String
  code                String    @unique
  description         String?   @db.Text
  workDays            Json      // array of day names e.g. ["Monday","Tuesday",...]
  startTime           String    // HH:mm
  endTime             String    // HH:mm
  breakStartTime      String?   // HH:mm
  breakEndTime        String?   // HH:mm
  breakDurationMinutes Int?
  totalWorkHours      Decimal   @db.Decimal(4, 1)
  isFlexible          Boolean   @default(false)
  flexibleStartRange  String?   // HH:mm
  flexibleEndRange    String?   // HH:mm
  isDefault           Boolean   @default(false)
  isActive            Boolean   @default(true)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId, isActive])
  @@map("work_schedules")
}

model Shift {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  name                 String
  code                 String    @unique
  description          String?   @db.Text
  shiftType            String    @default("regular") // regular, morning, afternoon, night, split, rotating
  startTime            String    // HH:mm
  endTime              String    // HH:mm
  breakDurationMinutes Int?
  totalHours           Decimal   @db.Decimal(4, 1)
  color                String?
  allowanceAmount      Decimal?  @db.Decimal(15, 2)
  isOvernight          Boolean   @default(false)
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, isActive])
  @@map("shifts")
}

model OvertimeRequest {
  id               Int       @id @default(autoincrement())
  companyId        Int
  employeeId       Int
  requestCode      String    @unique
  requestDate      DateTime  @db.Date
  startTime        String    // HH:mm
  endTime          String    // HH:mm
  hoursRequested   Decimal   @db.Decimal(5, 2)
  hoursApproved    Decimal?  @db.Decimal(5, 2)
  reason           String    @db.Text
  status           String    @default("draft") // draft, submitted, approved, rejected, cancelled
  rateMultiplier   Decimal   @default(1.5) @db.Decimal(3, 1)
  calculatedAmount Decimal?  @db.Decimal(15, 2)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("overtime_requests")
}

// ============================================================================
// HR PAYROLL MODULE - Onboarding & Offboarding
// ============================================================================

model OnboardingTemplate {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String
  code         String    @unique
  description  String?   @db.Text
  departmentId Int?
  positionId   Int?
  durationDays Int       @default(30)
  tasks        Json?     // array of task objects
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  onboardings EmployeeOnboarding[]

  @@index([companyId, isActive])
  @@map("onboarding_templates")
}

model EmployeeOnboarding {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  employeeId            Int
  onboardingTemplateId  Int
  startDate             DateTime  @db.Date
  expectedEndDate       DateTime  @db.Date
  actualEndDate         DateTime? @db.Date
  status                String    @default("not_started") // not_started, in_progress, completed, cancelled
  progress              Int       @default(0)
  completedTasks        Int       @default(0)
  totalTasks            Int       @default(0)
  taskProgress          Json?     // array of task progress objects
  notes                 String?   @db.Text
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template OnboardingTemplate  @relation(fields: [onboardingTemplateId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("employee_onboardings")
}

model OffboardingTemplate {
  id              Int       @id @default(autoincrement())
  companyId       Int
  name            String
  code            String    @unique
  description     String?   @db.Text
  terminationType String?   // resignation, termination, retirement, contract_end, layoff
  durationDays    Int       @default(14)
  tasks           Json?
  isDefault       Boolean   @default(false)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  offboardings EmployeeOffboarding[]

  @@index([companyId, isActive])
  @@map("offboarding_templates")
}

model EmployeeOffboarding {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  employeeId             Int
  offboardingTemplateId  Int
  terminationType        String    // resignation, termination, retirement, contract_end, layoff
  terminationReason      String?   @db.Text
  lastWorkingDate        DateTime  @db.Date
  startDate              DateTime  @db.Date
  expectedEndDate        DateTime  @db.Date
  actualEndDate          DateTime? @db.Date
  status                 String    @default("not_started") // not_started, in_progress, completed, cancelled
  progress               Int       @default(0)
  completedTasks         Int       @default(0)
  totalTasks             Int       @default(0)
  taskProgress           Json?
  exitInterviewDate      DateTime?
  exitInterviewNotes     String?   @db.Text
  clearanceStatus        String?   @default("pending") // pending, in_progress, cleared
  finalSettlementAmount  Decimal?  @db.Decimal(15, 2)
  notes                  String?   @db.Text
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  template OffboardingTemplate  @relation(fields: [offboardingTemplateId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@map("employee_offboardings")
}

// ============================================================================
// HR PAYROLL MODULE - Leave Types (Configuration)
// ============================================================================

model LeaveTypeConfig {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  name               String
  code               String
  description        String?   @db.Text
  daysPerYear        Int       @default(0)
  isPaid             Boolean   @default(true)
  requiresAttachment Boolean   @default(false)
  requiresApproval   Boolean   @default(true)
  maxConsecutiveDays Int?
  minNoticeDays      Int?
  carryForward       Boolean   @default(false)
  maxCarryForward    Int?
  gender             String?   // null=all, male, female
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("leave_type_configs")
}

// ============================================================================
// HR PAYROLL MODULE - Time Clock Records (Attendance)
// ============================================================================

model TimeClockRecord {
  id              Int       @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  clockInTime     DateTime
  clockOutTime    DateTime?
  clockInLocation String?
  clockOutLocation String?
  totalHours      Decimal?  @db.Decimal(6, 2)
  breakMinutes    Int?      @default(0)
  overtimeHours   Decimal?  @db.Decimal(6, 2)
  status          String    @default("clocked_in") // clocked_in, clocked_out, absent, late, early_departure
  shiftId         Int?
  source          String    @default("manual") // manual, biometric, mobile, web
  ipAddress       String?
  notes           String?   @db.Text
  approvedBy      Int?
  approvedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, clockInTime])
  @@index([employeeId, status])
  @@map("time_clock_records")
}

// ============================================================================
// HR PAYROLL MODULE - Probation
// ============================================================================

model Probation {
  id                Int       @id @default(autoincrement())
  companyId         Int
  employeeId        Int
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  extendedEndDate   DateTime? @db.Date
  probationType     String    @default("initial") // initial, extended
  durationMonths    Int       @default(3)
  status            String    @default("active") // active, extended, confirmed, terminated, failed
  objectives        Json?
  reviewNotes       String?   @db.Text
  reviewedBy        Int?
  reviewedAt        DateTime?
  confirmationDate  DateTime? @db.Date
  terminationReason String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([endDate, status])
  @@map("probations")
}

// ============================================================================
// HR PAYROLL MODULE - Expense Categories
// ============================================================================

model ExpenseCategory {
  id              Int       @id @default(autoincrement())
  companyId       Int
  name            String
  code            String
  description     String?   @db.Text
  maxAmount       Decimal?  @db.Decimal(15, 2)
  requiresReceipt Boolean   @default(false)
  glAccountId     Int?
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("expense_categories")
}

// ============================================================================
// HR PAYROLL MODULE - Reimbursements
// ============================================================================

model Reimbursement {
  id               Int       @id @default(autoincrement())
  companyId        Int
  expenseClaimId   Int
  employeeId       Int
  paymentDate      DateTime  @db.Date
  amount           Decimal   @db.Decimal(15, 2)
  paymentMethod    String    @default("bank_transfer") // bank_transfer, cash, cheque
  referenceNumber  String?
  bankName         String?
  accountNumber    String?
  chequeNumber     String?
  notes            String?   @db.Text
  processedBy      Int?
  journalEntryId   Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, expenseClaimId])
  @@index([paymentDate])
  @@map("reimbursements")
}

// ============================================================================
// HR PAYROLL MODULE - Shift Assignments
// ============================================================================

model ShiftAssignment {
  id           Int       @id @default(autoincrement())
  companyId    Int
  employeeId   Int
  shiftId      Int
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  isRecurring  Boolean   @default(false)
  recurPattern String?   // daily, weekly, monthly
  notes        String?   @db.Text
  assignedBy   Int?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([companyId, shiftId])
  @@index([startDate, endDate])
  @@map("shift_assignments")
}

// ============================================================================
// HR PAYROLL MODULE - Rosters
// ============================================================================

model Roster {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String
  code         String
  description  String?   @db.Text
  departmentId Int?
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  status       String    @default("draft") // draft, published, active, completed, cancelled
  publishedBy  Int?
  publishedAt  DateTime?
  notes        String?   @db.Text
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  entries RosterEntry[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([startDate, endDate])
  @@map("rosters")
}

model RosterEntry {
  id         Int       @id @default(autoincrement())
  rosterId   Int
  employeeId Int
  shiftId    Int
  date       DateTime  @db.Date
  startTime  String?   // Override shift start
  endTime    String?   // Override shift end
  status     String    @default("scheduled") // scheduled, confirmed, swapped, cancelled
  swappedWith Int?     // Employee ID if swapped
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  roster Roster @relation(fields: [rosterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, employeeId, date])
  @@index([rosterId])
  @@index([employeeId, date])
  @@map("roster_entries")
}

// ============================================================================
// HR PAYROLL MODULE - Employee Work Schedules
// ============================================================================

model EmployeeWorkSchedule {
  id              Int       @id @default(autoincrement())
  companyId       Int
  employeeId      Int
  workScheduleId  Int
  effectiveDate   DateTime  @db.Date
  endDate         DateTime? @db.Date
  isCurrent       Boolean   @default(true)
  notes           String?   @db.Text
  assignedBy      Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId])
  @@index([employeeId, isCurrent])
  @@map("employee_work_schedules")
}

// ============================================================================
// HR PAYROLL MODULE - Job Placements
// ============================================================================

model JobPlacement {
  id               Int       @id @default(autoincrement())
  companyId        Int
  jobApplicationId Int
  jobPostingId     Int
  employeeId       Int?      // Created employee after placement
  placementDate    DateTime  @db.Date
  startDate        DateTime  @db.Date
  positionId       Int?
  departmentId     Int?
  salaryOffered    Decimal?  @db.Decimal(15, 2)
  status           String    @default("pending") // pending, onboarded, confirmed, cancelled
  onboardingId     Int?
  notes            String?   @db.Text
  processedBy      Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId, status])
  @@index([jobApplicationId])
  @@index([employeeId])
  @@map("job_placements")
}

// ============================================================================
// HR PAYROLL MODULE - Interview Schedules
// ============================================================================

model InterviewSchedule {
  id             Int       @id @default(autoincrement())
  companyId      Int
  interviewId    Int
  scheduledDate  DateTime
  duration       Int       @default(60) // minutes
  location       String?
  meetingLink    String?
  roomName       String?
  interviewerIds Json?     // Array of user IDs
  status         String    @default("scheduled") // scheduled, confirmed, rescheduled, completed, cancelled, no_show
  reminderSent   Boolean   @default(false)
  notes          String?   @db.Text
  rescheduledFrom DateTime?
  cancelReason   String?   @db.Text
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, interviewId])
  @@index([scheduledDate, status])
  @@map("interview_schedules")
}

// ============================================================================
// HR PAYROLL MODULE - Performance Review Templates
// ============================================================================

model PerformanceReviewTemplate {
  id                Int       @id @default(autoincrement())
  companyId         Int
  name              String
  code              String
  description       String?   @db.Text
  reviewType        String    @default("annual") // annual, quarterly, probation, 360_degree, project
  sections          Json?     // Array of sections with competencies
  ratingScale       Int       @default(5) // 1-5, 1-10, etc.
  ratingLabels      Json?     // { 1: "Poor", 2: "Below Average", ... }
  includeGoals      Boolean   @default(true)
  includeKpis       Boolean   @default(true)
  includeSelfReview Boolean   @default(false)
  includePeerReview Boolean   @default(false)
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("performance_review_templates")
}

// ============================================================================
// HR PAYROLL MODULE - Payslip Generation
// ============================================================================

model PayslipGeneration {
  id             Int       @id @default(autoincrement())
  companyId      Int
  payrollId      Int
  employeeId     Int
  payrollPeriod  String
  payslipNumber  String    @unique
  generatedAt    DateTime  @default(now())
  payslipHtml    String?   @db.Text
  pdfPath        String?
  emailSent      Boolean   @default(false)
  emailSentAt    DateTime?
  downloadCount  Int       @default(0)
  lastDownloadAt DateTime?
  generatedBy    Int?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, payrollId])
  @@index([companyId, employeeId])
  @@index([payrollPeriod])
  @@map("payslip_generations")
}

// ============================================================================
// HR PAYROLL MODULE - Pivot Tables
// ============================================================================

model EmployeeSkill {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  skillId           Int
  proficiencyLevel  String    @default("beginner") // beginner, intermediate, advanced, expert
  acquiredDate      DateTime? @db.Date
  expiryDate        DateTime? @db.Date
  certifiedBy       String?
  acquisitionMethod String?   // FORMAL_TRAINING, SELF_TAUGHT, ON_THE_JOB, MENTORING, CERTIFICATION, WORKSHOP, ONLINE_COURSE, OTHER
  yearsOfExperience Int?
  lastUsedDate      DateTime? @db.Date
  endorsements      Int       @default(0)
  projectsUsed      Json?     // String array stored as JSON
  notes             String?   @db.Text
  createdBy         Int?
  updatedBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
  @@index([employeeId])
  @@index([skillId])
  @@map("employee_skills")
}

model EmployeeCertification {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  certificationId   Int
  dateObtained      DateTime  @db.Date          @map("issue_date") // renamed from issueDate to match service
  expiryDate        DateTime? @db.Date
  certificateNumber String?
  issuedBy          String?   @map("issuing_body") // renamed from issuingBody to match service
  proficiencyLevel  String?   // beginner, intermediate, advanced, expert
  status            String    @default("active") // active, expired, revoked, renewed, pending_renewal, suspended
  renewalDate       DateTime? @db.Date
  documentPath      String?   @map("attachment_path") // renamed from attachmentPath to match service
  verificationUrl   String?
  notes             String?   @db.Text
  createdBy         Int?
  updatedBy         Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, certificationId])
  @@index([employeeId])
  @@index([certificationId])
  @@index([expiryDate, status])
  @@map("employee_certifications")
}

model EmployeeKpi {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  kpiId        Int
  targetValue  Decimal?  @db.Decimal(15, 2)
  actualValue  Decimal?  @db.Decimal(15, 2)
  weight       Decimal   @default(1) @db.Decimal(5, 2)
  score        Decimal?  @db.Decimal(5, 2)
  period       String?   // e.g., "2026-Q1", "2026-01"
  status       String    @default("pending") // pending, in_progress, achieved, missed, exceeded
  notes        String?   @db.Text
  reviewedBy   Int?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, kpiId, period])
  @@index([employeeId])
  @@index([kpiId])
  @@map("employee_kpis")
}

// ============================================================================
// HR & Payroll - Master Catalog: Skills
// ============================================================================

model Skill {
  id                    Int       @id @default(autoincrement())
  name                  String
  code                  String
  category              String    // PROGRAMMING, DATABASE, CLOUD, NETWORKING, SECURITY, PROJECT_MANAGEMENT, COMMUNICATION, LEADERSHIP, ANALYTICAL, DESIGN, MARKETING, FINANCE, LEGAL, HEALTHCARE, OTHER
  description           String?   @db.Text
  isTechnical           Boolean   @default(true)
  isCertifiable         Boolean   @default(false)
  relatedCertifications Json?     // String array stored as JSON
  isActive              Boolean   @default(true)
  notes                 String?   @db.Text
  createdBy             Int?
  updatedBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  employeeSkills EmployeeSkill[]

  @@unique([code])
  @@index([category, isActive])
  @@map("skills")
}

// ============================================================================
// HR & Payroll - Master Catalog: KPIs
// ============================================================================

model Kpi {
  id                 Int       @id @default(autoincrement())
  name               String
  code               String
  category           String    // FINANCIAL, CUSTOMER, INTERNAL_PROCESS, LEARNING_GROWTH, SALES, MARKETING, OPERATIONS, QUALITY, COMPLIANCE, INNOVATION, SUSTAINABILITY, OTHER
  description        String?   @db.Text
  measurementUnit    String    // PERCENTAGE, COUNT, CURRENCY, RATIO, SCORE, TIME, WEIGHT, OTHER
  calculationFormula String?
  frequency          String    @default("monthly") // DAILY, WEEKLY, MONTHLY, QUARTERLY, SEMI_ANNUALLY, ANNUALLY
  baselineValue      Decimal?  @db.Decimal(15, 2)
  targetValue        Decimal?  @db.Decimal(15, 2)
  weight             Decimal   @default(1) @db.Decimal(5, 2)
  isActive           Boolean   @default(true)
  notes              String?   @db.Text
  createdBy          Int?
  updatedBy          Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  kpiAchievements KpiAchievement[]

  @@unique([code])
  @@index([category, isActive])
  @@map("kpis")
}

// ============================================================================
// HR & Payroll - KPI Achievements (employee KPI assignments + tracking)
// ============================================================================

model KpiAchievement {
  id                     Int       @id @default(autoincrement())
  employeeId             Int
  kpiId                  Int
  startDate              DateTime? @db.Date
  endDate                DateTime? @db.Date
  targetValue            Decimal?  @db.Decimal(15, 2)
  baselineValue          Decimal?  @db.Decimal(15, 2)
  actualValue            Decimal?  @db.Decimal(15, 2)
  achievementPercentage  Decimal?  @db.Decimal(5, 2)
  weight                 Decimal   @default(1) @db.Decimal(5, 2)
  status                 String    @default("not_started") // not_started, in_progress, achieved, exceeded, not_achieved, cancelled
  achievementDate        DateTime? @db.Date
  evidence               String?   @db.Text
  comments               String?   @db.Text
  notes                  String?   @db.Text
  createdBy              Int?
  updatedBy              Int?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kpi      Kpi      @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([kpiId])
  @@index([status])
  @@map("kpi_achievements")
}

// ============================================================================
// HR & Payroll - Master Catalog: Certifications
// ============================================================================

model Certification {
  id                   Int       @id @default(autoincrement())
  name                 String
  code                 String
  type                 String    // PROFESSIONAL, TECHNICAL, ACADEMIC, INDUSTRY, GOVERNMENT, SAFETY, QUALITY, ENVIRONMENTAL, OTHER
  issuingOrganization  String?
  description          String?   @db.Text
  requirements         String?   @db.Text
  validityPeriodMonths Int?
  requiresRenewal      Boolean   @default(false)
  renewalProcess       String?   @db.Text
  isMandatory          Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdBy            Int?
  updatedBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employeeCertifications EmployeeCertification[]

  @@unique([code])
  @@index([type, isActive])
  @@map("certifications")
}

// ============================================================================
// HR & Payroll - Appointments (promotions, transfers, confirmations, etc.)
// ============================================================================

model Appointment {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  companyId            Int
  appointmentNumber    String    // auto-generated APT-YYYY-####
  type                 String    // PROMOTION, TRANSFER, CONFIRMATION, DEMOTION, SECONDMENT, ACTING_APPOINTMENT, CONTRACT_RENEWAL, SALARY_REVISION
  status               String    @default("draft") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED, EFFECTIVE, CANCELLED
  effectiveDate        DateTime  @db.Date
  appointmentLetter    String?   // file path
  reason               String?   @db.Text
  previousPositionId   Int?
  previousDepartmentId Int?
  previousBranchId     Int?
  previousGradeId      Int?
  previousSalary       Decimal?  @db.Decimal(15, 2)
  newPositionId        Int?
  newDepartmentId      Int?
  newBranchId          Int?
  newGradeId           Int?
  newSalary            Decimal?  @db.Decimal(15, 2)
  jobDescription       String?   @db.Text
  responsibilities     String?   @db.Text
  termsAndConditions   String?   @db.Text
  notes                String?   @db.Text
  submittedBy          Int?
  submittedAt          DateTime?
  approvedBy           Int?
  approvedAt           DateTime?
  rejectedBy           Int?
  rejectedAt           DateTime?
  rejectionReason      String?   @db.Text
  createdBy            Int?
  updatedBy            Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, appointmentNumber])
  @@index([employeeId])
  @@index([companyId, status])
  @@index([type, status])
  @@map("appointments")
}

// ============================================================================
// HR & Payroll - Exit Interviews
// ============================================================================

model ExitInterview {
  id                       Int       @id @default(autoincrement())
  employeeId               Int
  companyId                Int
  exitReason               String    // RESIGNATION, RETIREMENT, TERMINATION, END_OF_CONTRACT, REDUNDANCY, MUTUAL_AGREEMENT, DEATH, ABSCONDING, OTHER
  lastWorkingDate          DateTime? @db.Date
  interviewDate            DateTime? @db.Date
  status                   String    @default("scheduled") // scheduled, completed, cancelled, no_show
  conductedBy              Int?      // FK to Employee
  reasonForLeaving         String?   @db.Text
  newEmployer              String?
  newPosition              String?
  jobSatisfaction          Int?      // 1-5 scale
  managementSatisfaction   Int?      // 1-5 scale
  compensationSatisfaction Int?      // 1-5 scale
  workLifeBalance          Int?      // 1-5 scale
  careerGrowthSatisfaction Int?      // 1-5 scale
  recommendToFriend        Int?      // 1-5 likelihood
  returnLikelihood         Int?      // 1-5 likelihood
  positiveAspects          String?   @db.Text
  areasForImprovement      String?   @db.Text
  additionalComments       String?   @db.Text
  wouldRehire              Boolean?
  interviewerNotes         String?   @db.Text
  createdBy                Int?
  updatedBy                Int?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId, status])
  @@index([exitReason])
  @@map("exit_interviews")
}

// ============================================================================
// HR & Payroll - Settings (per-company HR/Payroll configuration)
// ============================================================================

model HRPayrollSetting {
  id                              Int      @id @default(autoincrement())
  companyId                       Int      @unique
  // Statutory Rates (Nigerian defaults)
  pensionEmployeeRate             Decimal  @default(8) @db.Decimal(5, 2)
  pensionEmployerRate             Decimal  @default(10) @db.Decimal(5, 2)
  nhfRate                         Decimal  @default(2.5) @db.Decimal(5, 2)
  nhisEmployeeRate                Decimal  @default(5) @db.Decimal(5, 2)
  nhisEmployerRate                Decimal  @default(5) @db.Decimal(5, 2)
  nsitfRate                       Decimal  @default(1) @db.Decimal(5, 2)
  itfRate                         Decimal  @default(1) @db.Decimal(5, 2)
  // Tax Relief Settings (NTA 2025)
  taxReliefPercentage             Decimal  @default(20) @db.Decimal(5, 2)
  consolidatedReliefAllowance     Decimal  @default(200000) @db.Decimal(15, 2)
  rentReliefMaxPercentage         Decimal  @default(0) @db.Decimal(5, 2)
  lifeInsuranceReliefMaxPercentage Decimal @default(0) @db.Decimal(5, 2)
  // Leave Settings
  defaultAnnualLeaveDays          Int      @default(20)
  defaultSickLeaveDays            Int      @default(10)
  defaultMaternityLeaveDays       Int      @default(84) // 12 weeks
  defaultPaternityLeaveDays       Int      @default(10)
  // Payroll Settings
  defaultPayrollFrequency         String   @default("monthly")
  // Default pay-element mode for new employees. Per-employee override
  // remains available via Employee.payMode. Use FORMULA_BASED for orgs
  // that build salaries from formulas / percentages, GRADE_BASED for
  // grade-banded workforces, LUMP_SUM for casual / contract staff.
  defaultPayMode                  PayMode? @default(FORMULA_BASED)
  autoCalculateStatutory          Boolean  @default(true)
  autoDeductLoans                 Boolean  @default(true)
  // Approval Settings
  requireLeaveApproval            Boolean  @default(true)
  requireLoanApproval             Boolean  @default(true)
  requireExpenseApproval          Boolean  @default(true)
  requireGradeChangeApproval      Boolean  @default(true)
  // GL accounts for payroll journal posting (all optional —
  // if any required account for a non-zero leg is missing, the
  // posting is skipped with a warning rather than blocking approval)
  // DR side (expense)
  salaryExpenseAccountId          Int?
  pensionExpenseAccountId         Int?     // employer pension contribution (DR)
  nhisExpenseAccountId            Int?     // employer NHIS contribution (DR)
  otherStatutoryExpenseAccountId  Int?     // NSITF + ITF (DR, employer-only)
  // CR side (liability / payable)
  netSalaryPayableAccountId       Int?
  payeLiabilityAccountId          Int?
  pensionLiabilityAccountId       Int?     // employee + employer pension (CR)
  nhfLiabilityAccountId           Int?
  nhisLiabilityAccountId          Int?     // employee + employer NHIS (CR)
  otherStatutoryLiabilityAccountId Int?    // NSITF + ITF (CR)
  otherDeductionsPayableAccountId Int?     // loans, voluntary, WHT etc.
  rentReliefRate                  Decimal  @default(20) @db.Decimal(5, 2)
  rentReliefMaxAmount             Decimal  @default(500000) @db.Decimal(15, 2)
  defaultSalaryApproach           String   @default("STRUCTURED") @db.VarChar(20)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("hr_payroll_settings")
}

// ============================================================================
// Fund Management Module - Enums
// ============================================================================

enum FmFundType {
  OPEN_ENDED
  CLOSED_END
  PRIVATE_EQUITY
}

enum FmNavFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum FmPencomFundType {
  FUND_I
  FUND_II
  FUND_III
  FUND_IV
  FUND_V
  FUND_VI
}

enum FmAssetClass {
  EQUITY
  FIXED_INCOME
  MONEY_MARKET
  ALTERNATIVE
  REAL_ESTATE
  SUKUK
  CASH
}

enum FmSecurityType {
  STOCK
  BOND
  FGN_BOND
  STATE_BOND
  CORPORATE_BOND
  TBILL
  COMMERCIAL_PAPER
  MUTUAL_FUND
  SUKUK
  ETF
  REIT
  PRIVATE_EQUITY
  MONEY_MARKET_FUND
}

enum FmExchange {
  NGX
  FMDQ
  NASD
  OTC
  PRIVATE
}

enum FmInvestorType {
  INDIVIDUAL
  CORPORATE
  INSTITUTIONAL
  HNI
}

enum FmTradeType {
  BUY
  SELL
  MATURITY
  COUPON
  DIVIDEND
  RIGHTS
  BONUS
}

enum FmShariaStatus {
  COMPLIANT
  NON_COMPLIANT
  UNDER_REVIEW
  WATCH
  NOT_SCREENED
}

enum FmPriceSource {
  MANUAL
  NGX_FEED
  FMDQ_FEED
  BLOOMBERG
  REUTERS
  CBN
  CUSTOM
}

enum FmCouponFrequency {
  ANNUAL
  SEMI_ANNUAL
  QUARTERLY
  MONTHLY
  ZERO_COUPON
}

enum FmDayCountConvention {
  ACT_360
  ACT_365
  ACT_ACT
  THIRTY_360
}

enum FmDistributionType {
  DIVIDEND
  INTEREST
  CAPITAL_GAIN
  RETURN_OF_CAPITAL
}

enum FmRedemptionType {
  FULL
  PARTIAL
}

enum FmAccrualType {
  COUPON_INTEREST
  DIVIDEND_INCOME
  MANAGEMENT_FEE
  PERFORMANCE_FEE
  ADMIN_FEE
  CUSTODY_FEE
  TRUSTEESHIP_FEE
  OTHER_EXPENSE
}

enum FmFeeType {
  MANAGEMENT
  PERFORMANCE
  ADMIN
  CUSTODY
  TRUSTEESHIP
  ENTRY_LOAD
  EXIT_LOAD
}

enum FmCashMovementType {
  SUBSCRIPTION_RECEIPT
  REDEMPTION_PAYMENT
  TRADE_SETTLEMENT
  FEE_PAYMENT
  DISTRIBUTION_PAYMENT
  TRANSFER
  OTHER
}

enum FmComplianceRuleType {
  CONCENTRATION
  SECTOR
  ASSET_CLASS_LIMIT
  ISSUER
  LIQUIDITY
  CURRENCY
  SINGLE_SECURITY
  RELATED_PARTY
}

enum FmCheckType {
  PRE_TRADE
  POST_TRADE
  PERIODIC
  AD_HOC
}

enum FmReturnMethod {
  TWR
  MWR
}

// ============================================================================
// Fund Management Module - Section A: Fund Setup (7 models)
// ============================================================================

model FmFund {
  id                       Int              @id @default(autoincrement())
  fundCode                 String           @unique @db.VarChar(20)
  name                     String           @db.VarChar(255)
  shortName                String?          @db.VarChar(50)
  description              String?          @db.VarChar(2000)
  fundType                 FmFundType
  inceptionDate            DateTime         @db.Date
  terminationDate          DateTime?        @db.Date
  baseCurrency             String           @default("NGN") @db.VarChar(3)
  status                   String           @default("draft") // draft, active, suspended, liquidating, terminated
  isShariaCompliant        Boolean          @default(false)
  navFrequency             FmNavFrequency
  navCalendarId            Int?
  minimumSubscription      Decimal?         @db.Decimal(18, 2)
  minimumRedemption        Decimal?         @db.Decimal(18, 2)
  lockUpPeriodDays         Int?
  redemptionNoticeDays     Int?
  redemptionSettlementDays Int?
  redemptionGateThreshold  Decimal?         @db.Decimal(5, 2)
  coolingOffPeriodHours    Int?             // Cancellation window for portal subscriptions
  gatingActive             Boolean          @default(false) // Manual redemption gate toggle
  gatingMessage            String?          @db.Text // Message shown when gating is active
  managementFeeRate        Decimal?         @db.Decimal(8, 4)
  performanceFeeRate       Decimal?         @db.Decimal(8, 4)
  adminFeeRate             Decimal?         @db.Decimal(8, 4)
  custodyFeeRate           Decimal?         @db.Decimal(8, 4)
  trusteeshipFeeRate       Decimal?         @db.Decimal(8, 4)
  highWaterMark            Decimal?         @db.Decimal(18, 6)
  hurdleRate               Decimal?         @db.Decimal(8, 4)
  performanceFeeMethod     String?          // HIGH_WATER_MARK, HURDLE, BOTH
  benchmarkId              Int?
  regulatoryType           String           // SEC, PENCOM, BOTH
  pencomFundType           FmPencomFundType?
  prospectusRef            String?          @db.VarChar(100)
  secRegistrationNo        String?          @db.VarChar(100)
  // Investor-facing marketing / expectation figures (not guaranteed returns)
  projectedRate            Decimal?         @db.Decimal(8, 4)  // e.g. 16.00 means 16%
  benchmarkFormula         String?          @db.VarChar(500)   // narrative benchmark, e.g. "70% FGN Sukuk + 30% T-Bills"
  profitSharingRatio       String?          @db.VarChar(20)    // e.g. "55:45" (customer:manager)
  autoReinvest             Boolean          @default(false)    // If true, distributions are auto-reinvested (BKMI pattern)
  totalAUM                 Decimal?         @db.Decimal(18, 2)
  totalUnitsOutstanding    Decimal?         @db.Decimal(18, 6)
  latestNAVPerUnit         Decimal?         @db.Decimal(18, 6)
  latestNAVDate            DateTime?        @db.Date
  companyId                Int
  createdBy                Int?
  deletedAt                DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  benchmark FmBenchmark?   @relation(fields: [benchmarkId], references: [id], onDelete: SetNull)
  navCalendar FmNavCalendar? @relation(fields: [navCalendarId], references: [id], onDelete: SetNull)

  classes                  FmFundClass[]
  fundAccounts             FmFundAccount[]
  investorAccounts         FmInvestorAccount[]
  distributions            FmDistribution[]
  portfolios               FmPortfolio[]
  trades                   FmTrade[]
  tradeAllocations         FmTradeAllocation[]
  cashMovements            FmCashMovement[]
  navCalculations          FmNavCalculation[]
  accruals                 FmAccrual[]
  feeCalculations          FmFeeCalculation[]
  complianceRules          FmComplianceRule[]
  complianceChecks         FmComplianceCheck[]
  purificationRecords      FmPurificationRecord[]
  shariaBoardDecisions     FmShariaBoardDecision[]
  regulatoryReturns        FmRegulatoryReturn[]
  performanceReports       FmPerformanceReport[]
  custodianReconciliations FmCustodianReconciliation[]
  capitalCalls             FmCapitalCall[]
  creditFacilities         FmCreditFacility[]
  zakatConfig              FmZakatConfig?

  @@index([companyId])
  @@index([fundCode])
  @@index([status])
  @@index([fundType])
  @@map("fm_funds")
}

model FmFundClass {
  id                       Int      @id @default(autoincrement())
  fundId                   Int
  classCode                String   @db.VarChar(10)
  className                String   @db.VarChar(100)
  currency                 String   @db.VarChar(3)
  managementFeeOverride    Decimal? @db.Decimal(8, 4)
  performanceFeeOverride   Decimal? @db.Decimal(8, 4)
  minimumInvestment        Decimal? @db.Decimal(18, 2)
  entryLoad                Decimal? @db.Decimal(8, 4)
  exitLoad                 Decimal? @db.Decimal(8, 4)
  isInstitutional          Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  fund             FmFund              @relation(fields: [fundId], references: [id], onDelete: Cascade)
  investorAccounts FmInvestorAccount[]
  feeCalculations  FmFeeCalculation[]

  @@unique([fundId, classCode])
  @@map("fm_fund_classes")
}

model FmBenchmark {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(20)
  provider    String?  @db.VarChar(100)
  currency    String   @db.VarChar(3)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  companyId   Int
  createdAt   DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices  FmBenchmarkPrice[]
  funds   FmFund[]

  @@index([companyId])
  @@map("fm_benchmarks")
}

model FmBenchmarkPrice {
  id          Int      @id @default(autoincrement())
  benchmarkId Int
  date        DateTime @db.Date
  value       Decimal  @db.Decimal(18, 6)
  returnPct   Decimal? @db.Decimal(12, 6)
  createdAt   DateTime @default(now())

  benchmark FmBenchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([benchmarkId, date])
  @@map("fm_benchmark_prices")
}

model FmNavCalendar {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  frequency   FmNavFrequency
  weeklyDay   Int?
  monthlyDay  Int?
  holidays    Json?
  weekendDays Json?
  cutoffTime  DateTime? @db.Time(0)
  timezone    String   @default("Africa/Lagos") @db.VarChar(50)
  companyId   Int
  createdAt   DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  funds   FmFund[]

  @@index([companyId])
  @@map("fm_nav_calendars")
}

model FmFundAccount {
  id             Int      @id @default(autoincrement())
  fundId         Int
  accountType    String   // CUSTODY, SETTLEMENT, INCOME, EXPENSE, SUBSCRIPTION
  bankName       String   @db.VarChar(255)
  accountNumber  String   @db.VarChar(50)
  accountName    String?  @db.VarChar(255)
  currency       String   @db.VarChar(3)
  custodianId    Int?
  currentBalance Decimal? @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  fund      FmFund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  custodian FmCustodian? @relation(fields: [custodianId], references: [id], onDelete: SetNull)

  cashMovementsFrom FmCashMovement[] @relation("CashMovementFrom")
  cashMovementsTo   FmCashMovement[] @relation("CashMovementTo")

  @@index([fundId])
  @@map("fm_fund_accounts")
}

model FmCustodian {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(255)
  code          String   @unique @db.VarChar(20)
  contactPerson String?  @db.VarChar(255)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  address       String?  @db.Text
  swiftCode     String?  @db.VarChar(11)
  feedFormat    String?  // SWIFT_MT535, SWIFT_MT536, CSV, CUSTOM
  feedEndpoint  String?  @db.VarChar(500)
  feedSchedule  String?  @db.VarChar(50)
  isActive      Boolean  @default(true)
  companyId     Int
  createdAt     DateTime @default(now())

  company                Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fundAccounts           FmFundAccount[]
  custodianReconciliations FmCustodianReconciliation[]

  @@index([companyId])
  @@map("fm_custodians")
}

// ============================================================================
// Fund Management Module - Section B: Investor Management (6 models)
// ============================================================================

model FmInvestor {
  id                    Int             @id @default(autoincrement())
  investorCode          String          @unique @db.VarChar(20)
  investorType          FmInvestorType
  firstName             String?         @db.VarChar(100)
  lastName              String?         @db.VarChar(100)
  otherNames            String?         @db.VarChar(100)
  companyName           String?         @db.VarChar(255)
  rcNumber              String?         @db.VarChar(50) // RC (Ltd/PLC) or BN (sole prop/partnership) CAC number
  businessType          String?         @db.VarChar(50) // LIMITED_LIABILITY, PLC, LLP, SOLE_PROPRIETOR, PARTNERSHIP, COOPERATIVE, NGO, TRUST, PUBLIC_SECTOR
  dateOfIncorporation   DateTime?       @db.Date
  businessNature        String?         @db.VarChar(255) // industry / nature of business
  contactPersonName     String?         @db.VarChar(255)
  contactPersonPosition String?         @db.VarChar(100)
  contactPersonEmail    String?         @db.VarChar(255)
  contactPersonPhone    String?         @db.VarChar(50)
  annualTurnover        Decimal?        @db.Decimal(18, 2)
  passportPhotoUrl      String?         @db.Text
  notes                 String?         @db.Text
  // Guardian (required when customer is a minor — used for accounts like BKMI)
  guardianName          String?         @db.VarChar(255)
  guardianRelationship  String?         @db.VarChar(50) // parent, legal guardian, trustee, etc.
  guardianPhone         String?         @db.VarChar(50)
  guardianEmail         String?         @db.VarChar(255)
  guardianIdType        String?         @db.VarChar(50)
  guardianIdNumber      String?         @db.VarChar(50)
  guardianBvn           String?         @db.VarChar(20)
  guardianAddress       String?         @db.Text
  email                 String          @db.VarChar(255)
  phone                 String?         @db.VarChar(50)
  alternatePhone        String?         @db.VarChar(50)
  address               String?         @db.Text
  city                  String?         @db.VarChar(100)
  state                 String?         @db.VarChar(100)
  country               String?         @db.VarChar(100)
  nationality           String?         @db.VarChar(100)
  dateOfBirth           DateTime?       @db.Date
  gender                Gender?
  maritalStatus         MaritalStatus?
  idType                String          // BVN, NIN, PASSPORT, DRIVERS_LICENSE, VOTER_CARD, CAC
  idNumber              String          @db.VarChar(50)
  idExpiryDate          DateTime?       @db.Date
  taxId                 String?         @db.VarChar(50)
  riskProfile           String          // CONSERVATIVE, MODERATE, MODERATE_AGGRESSIVE, AGGRESSIVE
  investmentObjective   String?         // CAPITAL_PRESERVATION, INCOME, GROWTH, AGGRESSIVE_GROWTH
  accreditationStatus   String          // RETAIL, QUALIFIED, ACCREDITED
  isPEP                 Boolean         @default(false)
  pepDetails            String?         @db.Text
  kycStatus             String          // PENDING, APPROVED, EXPIRED, REJECTED
  kycApprovedBy         Int?
  kycApprovedAt         DateTime?
  kycExpiryDate         DateTime?       @db.Date
  kycDocuments          Json?
  amlRiskRating         String          // LOW, MEDIUM, HIGH
  amlLastReviewDate     DateTime?       @db.Date
  sourceOfFunds         String?         @db.VarChar(255)
  // Halal source declaration — required for Islamic fund subscriptions.
  // Captured at investor onboarding; the system blocks Mudarabah/Wakala
  // contract signing if not certified.
  sourceOfFundsHalalCertified Boolean    @default(false)
  sourceOfFundsCertifiedAt    DateTime?
  employerName          String?         @db.VarChar(255)
  occupation            String?         @db.VarChar(255)
  annualIncome          Decimal?        @db.Decimal(18, 2)
  bankName              String?         @db.VarChar(255)
  bankAccountNumber     String?         @db.VarChar(30)
  bankAccountName       String?         @db.VarChar(255)
  bankCode              String?         @db.VarChar(10)
  nextOfKinName         String?         @db.VarChar(255)
  nextOfKinPhone        String?         @db.VarChar(50)
  nextOfKinRelationship String?         @db.VarChar(50)
  customerRole          String?         @db.VarChar(20) // investor, investee, both
  kycRevalidationDate   DateTime?       @db.Date
  // Personal dates (for relationship management)
  weddingAnniversary    DateTime?       @db.Date
  // Portal access
  passwordHash          String?         @db.VarChar(255)
  portalEnabled         Boolean         @default(false)
  lastLoginAt           DateTime?
  companyId             Int
  createdBy             Int?
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  portalUser          User?               @relation("InvestorPortalUser")
  investorAccounts    FmInvestorAccount[]
  documents           FmInvestorDocument[]
  creditFacilities    FmCreditFacility[]
  deviceRegistrations FmDeviceRegistration[]
  creditScores        FmCreditScore[]
  directors           FmInvestorDirector[]
  ubos                FmInvestorUbo[]
  displayName         String?  @db.VarChar(255)
  onboardingStatus    String   @default("APPROVED") @db.VarChar(30)
  customerNumber      String?  @db.VarChar(10)

  @@index([companyId])
  @@index([investorCode])
  @@index([email])
  @@index([kycStatus])
  @@index([investorType])
  @@index([customerRole])
  @@map("fm_investors")
}

// ============================================================================
// FUND MANAGEMENT MODULE - AML Risk Controls (one row per tenant)
// ============================================================================

model FmAmlSettings {
  companyId               Int       @id
  highRiskBlockEnabled    Boolean   @default(true)
  highRiskThreshold       Decimal   @default(1000000) @db.Decimal(18, 2)
  requiresSeniorApproval  Boolean   @default(false)
  notes                   String?   @db.Text
  updatedBy               Int?
  updatedAt               DateTime  @updatedAt
  createdAt               DateTime  @default(now())

  @@map("fm_aml_settings")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Transaction GL Configuration (tenant-defined)
//   Same pattern as FmFeeGlConfig but for core cash movements:
//   SUBSCRIPTION, REDEMPTION, DISTRIBUTION, SWITCH.
// ============================================================================

model FmTransactionGlConfig {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  fundId              Int?      // NULL = tenant default; set = per-fund override
  transactionType     String    @db.VarChar(20) // SUBSCRIPTION, REDEMPTION, DISTRIBUTION, SWITCH
  debitAccountId      Int
  creditAccountId     Int
  isActive            Boolean   @default(true)
  notes               String?   @db.Text
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([fundId])
  @@index([transactionType])
  @@map("fm_transaction_gl_config")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Fee GL Configuration (tenant-defined)
// ============================================================================

model FmFeeGlConfig {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  fundId              Int?      // NULL = tenant default; set = per-fund override
  feeType             String    @db.VarChar(20) // MANAGEMENT, PERFORMANCE, ADMIN, CUSTODY, TRUSTEESHIP, AUDIT
  expenseAccountId    Int       // Debit on accrual
  liabilityAccountId  Int       // Credit on accrual, Debit on payment
  cashAccountId       Int       // Credit on payment
  isActive            Boolean   @default(true)
  notes               String?   @db.Text
  createdBy           Int?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([fundId])
  @@index([feeType])
  @@map("fm_fee_gl_config")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Investor Document Types (configurable per tenant)
// ============================================================================

model FmInvestorDocumentType {
  id               Int       @id @default(autoincrement())
  companyId        Int
  name             String    @db.VarChar(150)
  code             String    @db.VarChar(50)
  description      String?   @db.Text
  isRequired       Boolean   @default(true)
  applicableTypes  Json      // JSON string[] — "ALL" or combination of INDIVIDUAL/CORPORATE/INSTITUTIONAL/HNI
  sortOrder        Int       @default(0)
  isActive         Boolean   @default(true)
  isSystem         Boolean   @default(false) // seeded defaults cannot be hard-deleted
  createdBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([isActive])
  @@map("fm_investor_document_types")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Investor Directors (Corporate KYC)
// ============================================================================

model FmInvestorDirector {
  id             Int       @id @default(autoincrement())
  investorId     Int
  companyId      Int
  fullName       String    @db.VarChar(255)
  position       String    @db.VarChar(100) // MD, Chairman, Director, CFO, CEO, Other
  idType         String?   @db.VarChar(50) // BVN, NIN, PASSPORT, DRIVERS_LICENSE
  idNumber       String?   @db.VarChar(50)
  bvn            String?   @db.VarChar(20)
  nationality    String?   @db.VarChar(3)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  dateAppointed  DateTime? @db.Date
  isActive       Boolean   @default(true)
  createdBy      Int?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  investor FmInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([companyId])
  @@map("fm_investor_directors")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Investor UBOs / Beneficial Owners (AML/CFT)
// ============================================================================

model FmInvestorUbo {
  id               Int       @id @default(autoincrement())
  investorId       Int
  companyId        Int
  fullName         String    @db.VarChar(255)
  ownershipPercent Decimal   @db.Decimal(5, 2) // 0.00 - 100.00
  controlType      String    @db.VarChar(30) // DIRECT, INDIRECT, VOTING_RIGHTS, OTHER
  idType           String?   @db.VarChar(50)
  idNumber         String?   @db.VarChar(50)
  bvn              String?   @db.VarChar(20)
  nationality      String?   @db.VarChar(3)
  address          String?   @db.Text
  isPEP            Boolean   @default(false)
  pepDetails       String?   @db.Text
  createdBy        Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  investor FmInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([companyId])
  @@map("fm_investor_ubos")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Investor/Customer Documents (KYC Onboarding)
// ============================================================================

model FmInvestorDocument {
  id                 Int       @id @default(autoincrement())
  investorId         Int
  companyId          Int
  documentCode       String    @db.VarChar(30)
  documentName       String    @db.VarChar(255)
  documentType       String    @db.VarChar(50) // ID_CARD, UTILITY_BILL, CAC_CERTIFICATE, BOARD_RESOLUTION, MANDATE_FORM, PASSPORT_PHOTO, SIGNATURE, TAX_CERTIFICATE, OTHER
  documentCategory   String    @default("KYC") @db.VarChar(50)
  description        String?   @db.Text
  documentNumber     String?   @db.VarChar(100)
  issueDate          DateTime? @db.Date
  expiryDate         DateTime? @db.Date
  issuingAuthority   String?   @db.VarChar(255)
  fileName           String    @db.VarChar(500)
  originalFileName   String    @db.VarChar(500)
  filePath           String    @db.VarChar(1000)
  fileExtension      String    @db.VarChar(10)
  mimeType           String    @db.VarChar(100)
  fileSize           BigInt
  status             String    @default("uploaded") @db.VarChar(30) // uploaded, pending_review, verified, rejected, expired
  isMandatory        Boolean   @default(false)
  isVerified         Boolean   @default(false)
  verifiedDate       DateTime? @db.Date
  verifiedBy         Int?
  verificationNotes  String?   @db.Text
  hasExpiry          Boolean   @default(false)
  version            Int       @default(1)
  isCurrentVersion   Boolean   @default(true)
  previousVersionId  Int?
  uploadedBy         Int
  uploadedAt         DateTime  @default(now())
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  investor FmInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([companyId])
  @@index([documentType])
  @@index([status])
  @@map("fm_investor_documents")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Facility Types (Product Configuration)
// ============================================================================

model FmCreditFacilityType {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  name                   String    @db.VarChar(255)
  code                   String    @db.VarChar(20)
  description            String?   @db.Text
  facilityStructure      String    @default("murabaha") @db.VarChar(30) // murabaha, musharakah, ijarah, mudarabah, wakalah, istisnaa
  profitRate             Decimal   @default(0) @db.Decimal(8, 4)
  profitCalculation      String    @default("flat") @db.VarChar(30) // flat, declining_balance
  repaymentMethod        String    @default("emi") @db.VarChar(30) // emi, declining_balance, bullet, balloon
  repaymentFrequency     String    @default("monthly") @db.VarChar(20) // monthly, quarterly
  maxAmount              Decimal?  @db.Decimal(18, 2)
  minAmount              Decimal?  @db.Decimal(18, 2)
  maxTenureMonths        Int       @default(60)
  minTenureMonths        Int       @default(1)
  processingFee          Decimal   @default(0) @db.Decimal(18, 2)
  processingFeeType      String    @default("fixed") @db.VarChar(20) // fixed, percentage
  managerProfitSharePct  Decimal   @default(30) @db.Decimal(8, 4)
  investorProfitSharePct Decimal   @default(70) @db.Decimal(8, 4)
  requiresApproval       Boolean   @default(true)
  isShariaCompliant      Boolean   @default(true)
  isActive               Boolean   @default(true)
  createdBy              Int?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilities FmCreditFacility[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("fm_credit_facility_types")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Facilities (Sharia-Compliant Financing)
// ============================================================================

model FmCreditFacility {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  facilityNumber          String    @unique @db.VarChar(30)
  facilityTypeId          Int
  investorId              Int       // the investee customer
  fundId                  Int       // which fund provides the capital
  applicationDate         DateTime  @db.Date
  approvalDate            DateTime? @db.Date
  disbursementDate        DateTime? @db.Date
  maturityDate            DateTime? @db.Date
  purpose                 String?   @db.Text
  assetDescription        String?   @db.Text
  costPrice               Decimal   @db.Decimal(18, 2)
  profitAmount            Decimal   @db.Decimal(18, 2)
  totalFacilityAmount     Decimal   @db.Decimal(18, 2)
  profitRate              Decimal   @db.Decimal(8, 4)
  tenureMonths            Int
  repaymentMethod         String    @default("emi") @db.VarChar(30)
  repaymentFrequency      String    @default("monthly") @db.VarChar(20)
  installmentAmount       Decimal   @db.Decimal(18, 2)
  totalRepaid             Decimal   @default(0) @db.Decimal(18, 2)
  outstandingBalance      Decimal   @db.Decimal(18, 2)
  managerProfitSharePct   Decimal   @db.Decimal(8, 4)
  investorProfitSharePct  Decimal   @db.Decimal(8, 4)
  managerProfitEarned     Decimal   @default(0) @db.Decimal(18, 2)
  investorProfitEarned    Decimal   @default(0) @db.Decimal(18, 2)
  processingFee           Decimal   @default(0) @db.Decimal(18, 2)
  status                  String    @default("pending") @db.VarChar(20) // pending, approved, disbursed, active, completed, defaulted, cancelled
  disbursementMethod      String?   @default("bank") @db.VarChar(20)
  disbursementReference   String?   @db.VarChar(100)
  approvalNotes           String?   @db.Text
  rejectionReason         String?   @db.Text
  journalEntryId          Int?
  approvedBy              Int?
  approvedAt              DateTime?
  rejectedBy              Int?
  rejectedAt              DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  cancelledBy             Int?
  cancellationReason      String?   @db.Text
  // AAOIFI FAS 2 — Murabaha supplier details
  supplierId              Int?
  supplierName            String?   @db.VarChar(255)
  supplierInvoiceRef      String?   @db.VarChar(100)
  supplierDeliveryDate    DateTime? @db.Date
  ownershipTransferredAt  DateTime?
  saleJournalEntryId      Int?      // JE2: fund sells asset to investee (DR Receivable / CR Murabaha Asset / CR Deferred Income)
  createdBy               Int?
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company            Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facilityType       FmCreditFacilityType       @relation(fields: [facilityTypeId], references: [id], onDelete: Restrict)
  investor           FmInvestor                 @relation(fields: [investorId], references: [id], onDelete: Cascade)
  fund               FmFund                     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  supplier           Supplier?                  @relation("FacilitySupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  schedule           FmCreditSchedule[]
  repayments         FmCreditRepayment[]
  profitAllocations  FmCreditProfitAllocation[]
  provisions              FmProvision[]
  collaterals             FmCollateral[]
  documents               FmFacilityDocument[]
  wakalaFeeTierId         Int?
  wakalaFeeTier           FmWakalaFeeTier? @relation(fields: [wakalaFeeTierId], references: [id], onDelete: SetNull)
  earlySettlementDate     DateTime?        @db.Date
  earlySettlementRebate   Decimal?         @db.Decimal(18, 2)
  restructuredFrom        Int?

  @@index([companyId])
  @@index([investorId])
  @@index([fundId])
  @@index([status])
  @@map("fm_credit_facilities")
}


model FmFacilityDocument {
  id            Int      @id @default(autoincrement())
  companyId     Int
  facilityId    Int
  documentKey   String   @db.VarChar(100)  // e.g. application_letter, cv, cac_7_2
  documentLabel String   @db.VarChar(255)
  fileName      String   @db.VarChar(255)
  originalName  String   @db.VarChar(255)
  filePath      String   @db.VarChar(500)
  url           String   @db.VarChar(500)
  mimeType      String   @db.VarChar(100)
  size          Int
  uploadedBy    Int?
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facility FmCreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([companyId, facilityId])
  @@map("fm_facility_documents")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Deferred Profit Ledger (per facility)
// ============================================================================

model FmDeferredProfit {
  id                  Int      @id @default(autoincrement())
  facilityId          Int      @unique
  companyId           Int
  effectiveDate       DateTime @db.Date
  totalDeferredProfit Decimal  @db.Decimal(18, 2)
  recognizedProfit    Decimal  @default(0) @db.Decimal(18, 2)
  remainingDeferred   Decimal  @db.Decimal(18, 2)
  glJournalEntryId    Int?
  setupBy             Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@map("fm_deferred_profit")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Schedule (Repayment Plan)
// ============================================================================

model FmCreditSchedule {
  id                Int       @id @default(autoincrement())
  facilityId        Int
  installmentNumber Int
  dueDate           DateTime  @db.Date
  principalPortion  Decimal   @db.Decimal(18, 2)
  profitPortion     Decimal   @db.Decimal(18, 2)
  totalAmount       Decimal   @db.Decimal(18, 2)
  balanceAfter      Decimal   @db.Decimal(18, 2)
  status            String    @default("upcoming") @db.VarChar(20) // upcoming, due, paid, overdue, partial
  paidAmount        Decimal   @default(0) @db.Decimal(18, 2)
  paidDate          DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  facility FmCreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([dueDate])
  @@index([status])
  @@map("fm_credit_schedules")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Repayments (Actual Payments)
// ============================================================================

model FmCreditRepayment {
  id                Int       @id @default(autoincrement())
  facilityId        Int
  scheduleId        Int?
  repaymentDate     DateTime  @db.Date
  amount            Decimal   @db.Decimal(18, 2)
  principalPortion  Decimal   @db.Decimal(18, 2)
  profitPortion     Decimal   @db.Decimal(18, 2)
  balanceAfter      Decimal   @db.Decimal(18, 2)
  paymentMethod     String    @default("bank") @db.VarChar(20) // bank, cash, deduction
  reference         String?   @db.VarChar(100)
  receiptNumber     String?   @db.VarChar(50)
  notes             String?   @db.Text
  journalEntryId    Int?
  receivedBy        Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  facility FmCreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([repaymentDate])
  @@map("fm_credit_repayments")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Profit Allocation (Manager/Investor Split)
// ============================================================================

model FmCreditProfitAllocation {
  id                   Int       @id @default(autoincrement())
  facilityId           Int
  companyId            Int
  periodStart          DateTime  @db.Date
  periodEnd            DateTime  @db.Date
  totalProfitCollected Decimal   @db.Decimal(18, 2)
  managerShare         Decimal   @db.Decimal(18, 2)
  investorShare        Decimal   @db.Decimal(18, 2)
  managerSharePct      Decimal   @db.Decimal(8, 4)
  investorSharePct     Decimal   @db.Decimal(8, 4)
  distributionId       Int?
  journalEntryId       Int?
  status               String    @default("calculated") @db.VarChar(20) // calculated, distributed, posted
  createdBy            Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facility FmCreditFacility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([companyId])
  @@map("fm_credit_profit_allocations")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Zakat Configuration & Calculation
// ============================================================================

model FmZakatConfig {
  id                  Int       @id @default(autoincrement())
  fundId              Int       @unique
  companyId           Int
  zakatMethod         String    @default("AAOIFI_HIJRI") @db.VarChar(20) // AAOIFI_HIJRI, SIMPLE_25
  zakatRateOverride   Decimal?  @db.Decimal(8, 6) // override default rate if needed
  autoDeductEnabled   Boolean   @default(false)
  charityName         String?   @db.VarChar(255)
  charityAccountNo    String?   @db.VarChar(50)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  fund    FmFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("fm_zakat_configs")
}

model FmZakatCalculation {
  id                 Int       @id @default(autoincrement())
  fundId             Int
  investorAccountId  Int?
  companyId          Int
  calculationDate    DateTime  @db.Date
  zakatMethod        String    @db.VarChar(20)
  zakatableAssets    Decimal   @db.Decimal(18, 2)
  nonZakatableAssets Decimal   @db.Decimal(18, 2)
  totalAssets        Decimal   @db.Decimal(18, 2)
  zakatRate          Decimal   @db.Decimal(8, 6)
  zakatAmount        Decimal   @db.Decimal(18, 2)
  investorUnits      Decimal?  @db.Decimal(18, 6)
  totalUnits         Decimal?  @db.Decimal(18, 6)
  hijriYear          String?   @db.VarChar(10)
  status             String    @default("calculated") @db.VarChar(20) // calculated, deducted, paid, waived
  paymentDate        DateTime? @db.Date
  paymentReference   String?   @db.VarChar(100)
  // Disbursement target — must be a verified fm_charity_ngo when set.
  // Validated at recordPayment(); the NGO's bank details are captured into
  // paymentReference for the audit trail.
  charityNgoId       Int?
  paymentMethod      String?   @db.VarChar(40) // bank_transfer | cash | other
  paidByUserId       Int?
  createdBy          Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([companyId])
  @@index([investorAccountId])
  @@index([charityNgoId])
  @@map("fm_zakat_calculations")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Notification Templates & Logs
// ============================================================================

model FmNotificationTemplate {
  id            Int       @id @default(autoincrement())
  companyId     Int
  eventType     String    @db.VarChar(50) // OVERDUE, KYC_EXPIRY, NAV_PUBLISHED, DISTRIBUTION_DECLARED, etc.
  channel       String    @db.VarChar(20) // EMAIL, IN_APP, WHATSAPP, SMS, PUSH
  subject       String?   @db.VarChar(255)
  bodyTemplate  String    @db.Text // Handlebars template
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, eventType, channel])
  @@index([companyId])
  @@map("fm_notification_templates")
}

model FmNotificationLog {
  id              Int       @id @default(autoincrement())
  companyId       Int
  templateId      Int?
  recipientId     Int       // investor ID or user ID
  recipientType   String    @db.VarChar(20) // INVESTOR, EMPLOYEE
  recipientContact String?  @db.VarChar(255) // email, phone, etc.
  channel         String    @db.VarChar(20)
  eventType       String    @db.VarChar(50)
  subject         String?   @db.VarChar(255)
  body            String?   @db.Text
  status          String    @default("sent") @db.VarChar(20) // sent, delivered, failed, read
  sentAt          DateTime  @default(now())
  deliveredAt     DateTime?
  readAt          DateTime?
  errorMessage    String?   @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([recipientId, recipientType])
  @@index([eventType])
  @@map("fm_notification_logs")
}

model FmDeviceRegistration {
  id           Int       @id @default(autoincrement())
  investorId   Int
  deviceToken  String    @db.VarChar(500)
  platform     String    @db.VarChar(20) // IOS, ANDROID, WEB
  deviceName   String?   @db.VarChar(100)
  isActive     Boolean   @default(true)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  investor FmInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@map("fm_device_registrations")
}

model FmInvestorAccount {
  id                  Int       @id @default(autoincrement())
  investorId          Int
  fundId              Int
  fundClassId         Int?
  accountNumber       String    @unique @db.VarChar(30)
  currency            String    @default("NGN") @db.VarChar(10)
  unitsHeld           Decimal   @default(0) @db.Decimal(18, 6)
  averageCostPerUnit  Decimal?  @db.Decimal(18, 6)
  totalInvested       Decimal   @default(0) @db.Decimal(18, 2)
  totalRedeemed       Decimal   @default(0) @db.Decimal(18, 2)
  totalDistributions  Decimal   @default(0) @db.Decimal(18, 2)
  currentValue        Decimal?  @db.Decimal(18, 2)
  unrealizedGainLoss  Decimal?  @db.Decimal(18, 2)
  unrealisedGain      Decimal   @default(0) @db.Decimal(18, 2)
  realisedGain        Decimal   @default(0) @db.Decimal(18, 2)
  status              String    @default("active") // active, suspended, closed, dormant
  openDate            DateTime  @db.Date
  closeDate           DateTime? @db.Date
  lastTransactionDate DateTime? @db.Date
  companyId           Int
  createdBy           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor               FmInvestor                 @relation(fields: [investorId], references: [id], onDelete: Cascade)
  fund                   FmFund                     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fundClass              FmFundClass?               @relation(fields: [fundClassId], references: [id], onDelete: SetNull)

  subscriptions          FmSubscription[]
  redemptions            FmRedemption[]
  distributionAllocations FmDistributionAllocation[]
  purificationRecords    FmPurificationRecord[]
  investorStatements     FmInvestorStatement[]
  capitalCommitments     FmCapitalCommitment[]
  capitalCallItems       FmCapitalCallItem[]

  @@unique([investorId, fundId, fundClassId])
  @@index([fundId])
  @@index([status])
  @@map("fm_investor_accounts")
}

model FmSubscription {
  id                  Int       @id @default(autoincrement())
  subscriptionNumber  String    @unique @db.VarChar(30)
  investorAccountId   Int
  requestDate         DateTime  @db.Date
  subscriptionDate    DateTime? @db.Date
  amount              Decimal   @db.Decimal(18, 2)
  currency            String    @db.VarChar(3)
  fxRate              Decimal?  @db.Decimal(18, 8)
  amountInBaseCurrency Decimal? @db.Decimal(18, 2)
  navDate             DateTime? @db.Date
  navPerUnit          Decimal?  @db.Decimal(18, 6)
  entryLoadRate       Decimal?  @db.Decimal(8, 4)
  entryLoadAmount     Decimal?  @db.Decimal(18, 2)
  netAmount           Decimal?  @db.Decimal(18, 2)
  unitsAllocated      Decimal?  @db.Decimal(18, 6)
  paymentReference    String?   @db.VarChar(100)
  paymentDate         DateTime? @db.Date
  paymentVerified     Boolean   @default(false)
  paymentVerifiedBy   Int?
  paymentVerifiedAt   DateTime?
  kycChecked          Boolean   @default(false)
  amlChecked          Boolean   @default(false)
  status              String    @default("pending") // pending, payment_verified, approved, allocated, settled, rejected, cancelled
  approvedBy          Int?
  approvedAt          DateTime?
  rejectionReason     String?   @db.Text
  journalEntryId      Int?
  notes               String?   @db.Text
  companyId           Int
  createdBy           Int?
  isHistoricalLoad    Boolean   @default(false)
  isHistorical        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)

  @@index([investorAccountId])
  @@index([status])
  @@index([subscriptionDate])
  @@index([companyId])
  @@map("fm_subscriptions")
}

model FmRedemption {
  id                   Int              @id @default(autoincrement())
  redemptionNumber     String           @unique @db.VarChar(30)
  investorAccountId    Int
  requestDate          DateTime         @db.Date
  redemptionDate       DateTime?        @db.Date
  redemptionType       FmRedemptionType
  unitsToRedeem        Decimal?         @db.Decimal(18, 6)
  amountToRedeem       Decimal?         @db.Decimal(18, 2)
  navDate              DateTime?        @db.Date
  navPerUnit           Decimal?         @db.Decimal(18, 6)
  grossAmount          Decimal?         @db.Decimal(18, 2)
  exitLoadRate         Decimal?         @db.Decimal(8, 4)
  exitLoadAmount       Decimal?         @db.Decimal(18, 2)
  withholdingTaxRate   Decimal?         @db.Decimal(8, 4)
  withholdingTaxAmount Decimal?         @db.Decimal(18, 2)
  netPayable           Decimal?         @db.Decimal(18, 2)
  paymentDate          DateTime?        @db.Date
  paymentReference     String?          @db.VarChar(100)
  paymentBankName      String?          @db.VarChar(255)
  paymentAccountNumber String?          @db.VarChar(50)
  lockUpCheckPassed    Boolean?
  lockUpExpiryDate     DateTime?        @db.Date
  liquidityCheckPassed Boolean?
  liquidityRatio       Decimal?         @db.Decimal(8, 4)
  status               String           @default("pending") // pending, approved, processing, paid, rejected, cancelled, gated
  gatedPercentage      Decimal?         @db.Decimal(8, 4)
  approvedBy           Int?
  approvedAt           DateTime?
  rejectionReason      String?          @db.Text
  journalEntryId       Int?
  notes                String?          @db.Text
  companyId            Int
  createdBy            Int?
  isHistoricalLoad     Boolean          @default(false)
  isHistorical         Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)

  @@index([investorAccountId])
  @@index([status])
  @@index([companyId])
  @@map("fm_redemptions")
}

model FmDistribution {
  id                  Int                @id @default(autoincrement())
  distributionNumber  String             @unique @db.VarChar(30)
  fundId              Int
  distributionDate    DateTime           @db.Date
  recordDate          DateTime           @db.Date
  exDate              DateTime           @db.Date
  distributionType    FmDistributionType
  totalAmount         Decimal            @db.Decimal(18, 2)
  amountPerUnit       Decimal            @db.Decimal(18, 6)
  totalWithholdingTax Decimal?           @db.Decimal(18, 2)
  purificationAmount  Decimal?           @db.Decimal(18, 2)
  purificationPerUnit Decimal?           @db.Decimal(18, 6)
  status              String             @default("declared") // declared, approved, processing, paid
  approvedBy          Int?
  approvedAt          DateTime?
  journalEntryId      Int?
  companyId           Int
  createdBy           Int?
  createdAt           DateTime           @default(now())
  projectedProfit         Decimal?           @db.Decimal(18, 2)
  varianceAmount          Decimal?           @db.Decimal(18, 2)
  variancePct             Decimal?           @db.Decimal(8, 4)
  periodDays              Int?
  fundProjectedRate       Decimal?           @db.Decimal(8, 4)
  fundAumAtDeclaration    Decimal?           @db.Decimal(18, 2)
  updatedAt               DateTime           @updatedAt

  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund                 FmFund                    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  distributionAllocations FmDistributionAllocation[]
  purificationRecords  FmPurificationRecord[]

  @@index([fundId])
  @@index([status])
  @@index([companyId])
  @@map("fm_distributions")
}

model FmDistributionAllocation {
  id                 Int       @id @default(autoincrement())
  distributionId     Int
  investorAccountId  Int
  unitsOnRecordDate  Decimal   @db.Decimal(18, 6)
  grossAmount        Decimal   @db.Decimal(18, 2)
  withholdingTax     Decimal?  @db.Decimal(18, 2)
  purificationAmount Decimal?  @db.Decimal(18, 2)
  netAmount          Decimal   @db.Decimal(18, 2)
  paymentDate        DateTime? @db.Date
  paymentReference   String?   @db.VarChar(100)
  status             String    @default("pending") // pending, paid
  createdAt          DateTime  @default(now())

  distribution    FmDistribution    @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)

  @@unique([distributionId, investorAccountId])
  @@map("fm_distribution_allocations")
}

// ============================================================================
// Fund Management Module - Section C: Securities & Portfolio (6 models)
// ============================================================================

model FmSecurity {
  id                 Int                  @id @default(autoincrement())
  securityCode       String               @db.VarChar(20)
  isin               String?              @db.VarChar(12)
  name               String               @db.VarChar(255)
  shortName          String?              @db.VarChar(50)
  assetClass         FmAssetClass
  securityType       FmSecurityType
  currency           String               @db.VarChar(3)
  exchange           FmExchange?
  sector             String?              @db.VarChar(100)
  industry           String?              @db.VarChar(100)
  country            String?              @db.VarChar(3)
  issuer             String?              @db.VarChar(255)
  couponRate         Decimal?             @db.Decimal(8, 4)
  maturityDate       DateTime?            @db.Date
  faceValue          Decimal?             @db.Decimal(18, 2)
  couponFrequency    FmCouponFrequency?
  dayCountConvention FmDayCountConvention?
  issueDate          DateTime?            @db.Date
  callDate           DateTime?            @db.Date
  lotSize            Int?
  shariaStatus       FmShariaStatus       @default(NOT_SCREENED)
  shariaScreenDate   DateTime?            @db.Date
  shariaScreenNotes  String?              @db.Text
  // Sukuk-specific fields
  sukukStructure     String?              @db.VarChar(30) // IJARA, MURABAHA, WAKALA, MUDARABAH, HYBRID
  waqfRights         Boolean?             @default(false)
  underlyingAsset    String?              @db.Text
  assetValuation     Decimal?             @db.Decimal(18, 2)
  rentalRate         Decimal?             @db.Decimal(8, 4) // annual rental rate
  nextRentalDate     DateTime?            @db.Date
  // Credit rating
  issuerCreditRating String?              @db.VarChar(10) // AAA, AA+, etc.
  ratingAgency       String?              @db.VarChar(50) // Fitch, Moody's, S&P, Agusto, GCR
  ratingDate         DateTime?            @db.Date
  isActive           Boolean              @default(true)
  companyId          Int
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  prices             FmSecurityPrice[]
  portfolios         FmPortfolio[]
  trades             FmTrade[]
  accruals           FmAccrual[]
  shariaScreenings   FmShariaScreening[]
  shariaBoardDecisions FmShariaBoardDecision[]
  sukukRentalSchedules FmSukukRentalSchedule[]

  @@index([companyId])
  @@index([assetClass])
  @@index([securityType])
  @@index([isin])
  @@index([shariaStatus])
  @@map("fm_securities")
}

model FmSecurityPrice {
  id              Int           @id @default(autoincrement())
  securityId      Int
  priceDate       DateTime      @db.Date
  bidPrice        Decimal?      @db.Decimal(18, 6)
  askPrice        Decimal?      @db.Decimal(18, 6)
  closePrice      Decimal?      @db.Decimal(18, 6)
  cleanPrice      Decimal?      @db.Decimal(18, 6)
  dirtyPrice      Decimal?      @db.Decimal(18, 6)
  accruedInterest Decimal?      @db.Decimal(18, 6)
  yield           Decimal?      @db.Decimal(12, 6)
  volume          BigInt?
  source          FmPriceSource
  isVerified      Boolean       @default(false)
  verifiedBy      Int?
  verifiedAt      DateTime?
  createdBy       Int?
  createdAt       DateTime      @default(now())

  security FmSecurity @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([securityId, priceDate, source])
  @@index([priceDate])
  @@index([securityId, priceDate])
  @@map("fm_security_prices")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Sukuk Rental Schedule
// ============================================================================

model FmSukukRentalSchedule {
  id               Int       @id @default(autoincrement())
  securityId       Int
  companyId        Int
  periodNumber     Int
  periodStart      DateTime  @db.Date
  periodEnd        DateTime  @db.Date
  expectedRental   Decimal   @db.Decimal(18, 2)
  actualRental     Decimal   @default(0) @db.Decimal(18, 2)
  accrualAmount    Decimal   @default(0) @db.Decimal(18, 2)
  status           String    @default("scheduled") @db.VarChar(20) // scheduled, accrued, received, overdue
  receivedDate     DateTime? @db.Date
  receivedBy       Int?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  security FmSecurity @relation(fields: [securityId], references: [id], onDelete: Cascade)
  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([securityId])
  @@index([companyId])
  @@index([status])
  @@map("fm_sukuk_rental_schedules")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Sukuk Coupon Distribution
// ============================================================================
// Records a coupon (rental) distribution paid to investors against a scheduled
// FmSukukRentalSchedule row. A Sukuk pays rental (not interest); this table
// captures the actual distribution to holders so it can be reconciled with the
// rental schedule and the operator's bank statements.
// ============================================================================

model FmSukukCouponDistribution {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  fundId              Int
  securityId          Int
  rentalScheduleId    Int
  distributionDate    DateTime  @db.Timestamptz(6)
  totalDistributed    Decimal   @db.Decimal(20, 2)
  pricePerUnit        Decimal   @db.Decimal(20, 6)
  status              String    @default("calculated") @db.VarChar(20) // calculated | paid | voided
  paidAt              DateTime? @db.Timestamptz(6)
  paymentMethod       String?   @db.VarChar(40) // bank_transfer | reinvest | other
  paymentReference    String?   @db.VarChar(100)
  notes               String?
  recordedById        Int?
  paidById            Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([companyId, fundId, securityId])
  @@index([rentalScheduleId])
  @@map("fm_sukuk_coupon_distributions")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Sukuk Redemption
// ============================================================================
// Records redemption events for a Sukuk security held by the fund: full at
// maturity, early (with premium/discount), or partial. Distinct from
// FmRedemption — that table tracks INVESTOR-side unit liquidations from a
// fund. This table tracks redemptions of the underlying Sukuk instruments
// themselves at maturity / call.
// ============================================================================

model FmSukukRedemption {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  fundId              Int
  securityId          Int
  redemptionType      String    @db.VarChar(20) // maturity | early | partial
  redemptionDate      DateTime  @db.Timestamptz(6)
  unitsRedeemed       Decimal   @db.Decimal(20, 6)
  faceValuePaid       Decimal   @db.Decimal(20, 2)
  premiumOrDiscount   Decimal   @default(0) @db.Decimal(20, 2)
  totalProceeds       Decimal   @db.Decimal(20, 2)
  status              String    @default("pending") @db.VarChar(20) // pending | settled | voided
  settledAt           DateTime? @db.Timestamptz(6)
  paymentMethod       String?   @db.VarChar(40)
  paymentReference    String?   @db.VarChar(100)
  notes               String?
  recordedById        Int?
  settledById         Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([companyId, fundId, securityId])
  @@index([redemptionDate])
  @@map("fm_sukuk_redemptions")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Credit Scoring
// ============================================================================

model FmCreditScore {
  id                       Int       @id @default(autoincrement())
  investorId               Int
  companyId                Int
  scoreDate                DateTime  @db.Date
  score                    Int       // 0-1000
  riskGrade                String    @db.VarChar(5) // A, B, C, D, E
  repaymentHistoryScore    Int       @default(0)
  facilityUtilizationScore Int       @default(0)
  tenureScore              Int       @default(0)
  collateralScore          Int       @default(0)
  notes                    String?   @db.Text
  calculatedBy             Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor FmInvestor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([companyId])
  @@map("fm_credit_scores")
}

// ============================================================================
// FUND MANAGEMENT MODULE - IFRS 9 Provisioning
// ============================================================================

model FmProvision {
  id                  Int       @id @default(autoincrement())
  facilityId          Int
  companyId           Int
  provisionDate       DateTime  @db.Date
  stage               Int       // 1, 2, 3
  stageReason         String?   @db.VarChar(100)
  daysPastDue         Int       @default(0)
  probabilityOfDefault Decimal  @default(0) @db.Decimal(8, 6)
  lossGivenDefault    Decimal   @default(0) @db.Decimal(8, 6)
  exposureAtDefault   Decimal   @default(0) @db.Decimal(18, 2)
  expectedCreditLoss  Decimal   @default(0) @db.Decimal(18, 2)
  provision12Month    Decimal   @default(0) @db.Decimal(18, 2)
  provisionLifetime   Decimal   @default(0) @db.Decimal(18, 2)
  journalEntryId      Int?
  createdBy           Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facility FmCreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([companyId])
  @@map("fm_provisions")
}

// ============================================================================
// FUND MANAGEMENT MODULE - Collateral Management
// ============================================================================

model FmCollateral {
  id              Int       @id @default(autoincrement())
  facilityId      Int
  companyId       Int
  collateralType  String    @db.VarChar(30) // PROPERTY, VEHICLE, EQUIPMENT, CASH_DEPOSIT, GUARANTEE
  description     String?   @db.Text
  estimatedValue  Decimal?  @db.Decimal(18, 2)
  valuationDate   DateTime? @db.Date
  valuationBy     String?   @db.VarChar(255)
  insuranceExpiry DateTime? @db.Date
  status          String    @default("registered") @db.VarChar(20) // registered, released, foreclosed
  releasedDate    DateTime? @db.Date
  releasedBy      Int?
  createdBy       Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  facility FmCreditFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([companyId])
  @@map("fm_collaterals")
}

model FmPortfolio {
  id                 Int       @id @default(autoincrement())
  fundId             Int
  securityId         Int
  quantity           Decimal   @db.Decimal(18, 6)
  costBasis          Decimal   @db.Decimal(18, 2)
  averageCost        Decimal   @db.Decimal(18, 6)
  marketPrice        Decimal?  @db.Decimal(18, 6)
  marketValue        Decimal?  @db.Decimal(18, 2)
  unrealizedGainLoss Decimal?  @db.Decimal(18, 2)
  accruedIncome      Decimal?  @db.Decimal(18, 2)
  weightInFund       Decimal?  @db.Decimal(8, 4)
  asOfDate           DateTime  @db.Date
  companyId          Int
  updatedAt          DateTime  @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund     FmFund     @relation(fields: [fundId], references: [id], onDelete: Cascade)
  security FmSecurity @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([fundId, securityId])
  @@index([fundId])
  @@index([asOfDate])
  @@map("fm_portfolios")
}

model FmTrade {
  id                         Int         @id @default(autoincrement())
  tradeNumber                String      @unique @db.VarChar(30)
  fundId                     Int
  securityId                 Int
  tradeDate                  DateTime    @db.Date
  settlementDate             DateTime    @db.Date
  tradeType                  FmTradeType
  quantity                   Decimal     @db.Decimal(18, 6)
  price                      Decimal     @db.Decimal(18, 6)
  grossAmount                Decimal     @db.Decimal(18, 2)
  commission                 Decimal?    @db.Decimal(18, 2)
  secFee                     Decimal?    @db.Decimal(18, 2)
  cscsCharge                 Decimal?    @db.Decimal(18, 2)
  stampDuty                  Decimal?    @db.Decimal(18, 2)
  otherFees                  Decimal?    @db.Decimal(18, 2)
  totalFees                  Decimal?    @db.Decimal(18, 2)
  netAmount                  Decimal     @db.Decimal(18, 2)
  currency                   String      @db.VarChar(3)
  fxRate                     Decimal?    @db.Decimal(18, 8)
  amountInBaseCurrency       Decimal?    @db.Decimal(18, 2)
  counterparty               String?     @db.VarChar(255)
  broker                     String?     @db.VarChar(255)
  preTradeComplianceStatus   String?     // PASSED, FAILED, OVERRIDDEN, NOT_CHECKED
  complianceOverrideReason   String?     @db.Text
  complianceOverrideBy       Int?
  shariaComplianceStatus     String?     // PASSED, FAILED, NOT_APPLICABLE
  status                     String      @default("pending") // pending, approved, executed, settling, settled, cancelled, failed
  executedBy                 Int?
  approvedBy                 Int?
  approvedAt                 DateTime?
  journalEntryId             Int?
  notes                      String?     @db.Text
  companyId                  Int
  createdBy                  Int?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund             FmFund               @relation(fields: [fundId], references: [id], onDelete: Cascade)
  security         FmSecurity           @relation(fields: [securityId], references: [id], onDelete: Cascade)

  tradeAllocations FmTradeAllocation[]
  complianceChecks FmComplianceCheck[]

  @@index([fundId])
  @@index([securityId])
  @@index([tradeDate])
  @@index([status])
  @@index([companyId])
  @@map("fm_trades")
}

model FmTradeAllocation {
  id              Int      @id @default(autoincrement())
  tradeId         Int
  fundId          Int
  quantity        Decimal  @db.Decimal(18, 6)
  amount          Decimal  @db.Decimal(18, 2)
  allocationBasis String   // PRO_RATA, MANUAL, SPECIFIC
  createdAt       DateTime @default(now())

  trade FmTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  fund  FmFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([fundId])
  @@map("fm_trade_allocations")
}

model FmCashMovement {
  id                Int              @id @default(autoincrement())
  fundId            Int
  movementDate      DateTime         @db.Date
  movementType      FmCashMovementType
  amount            Decimal          @db.Decimal(18, 2)
  currency          String           @db.VarChar(3)
  fxRate            Decimal?         @db.Decimal(18, 8)
  fromAccountId     Int?
  toAccountId       Int?
  reference         String?          @db.VarChar(100)
  description       String?          @db.Text
  relatedEntityType String?          @db.VarChar(50)
  relatedEntityId   Int?
  status            String           @default("pending") // pending, confirmed, reversed
  journalEntryId    Int?
  companyId         Int
  createdBy         Int?
  createdAt         DateTime         @default(now())

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund        FmFund        @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fromAccount FmFundAccount? @relation("CashMovementFrom", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   FmFundAccount? @relation("CashMovementTo", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_cash_movements")
}

// ============================================================================
// Fund Management Module - Section D: Valuation & NAV (4 models)
// ============================================================================

model FmNavCalculation {
  id                    Int       @id @default(autoincrement())
  fundId                Int
  navDate               DateTime  @db.Date
  totalInvestments      Decimal   @db.Decimal(18, 2)
  totalCash             Decimal   @db.Decimal(18, 2)
  totalAccruedIncome    Decimal   @db.Decimal(18, 2)
  totalOtherAssets      Decimal?  @db.Decimal(18, 2)
  totalAssets           Decimal   @db.Decimal(18, 2)
  totalAccruedFees      Decimal   @db.Decimal(18, 2)
  totalOtherLiabilities Decimal?  @db.Decimal(18, 2)
  totalLiabilities      Decimal   @db.Decimal(18, 2)
  netAssetValue         Decimal   @db.Decimal(18, 2)
  unitsOutstanding      Decimal   @db.Decimal(18, 6)
  navPerUnit            Decimal   @db.Decimal(18, 6)
  previousNavPerUnit    Decimal?  @db.Decimal(18, 6)
  dailyReturn           Decimal?  @db.Decimal(12, 8)
  wtdReturn             Decimal?  @db.Decimal(12, 8)
  mtdReturn             Decimal?  @db.Decimal(12, 8)
  qtdReturn             Decimal?  @db.Decimal(12, 8)
  ytdReturn             Decimal?  @db.Decimal(12, 8)
  inceptionReturn       Decimal?  @db.Decimal(12, 8)
  managementFeeAccrual  Decimal?  @db.Decimal(18, 2)
  performanceFeeAccrual Decimal?  @db.Decimal(18, 2)
  otherFeeAccrual       Decimal?  @db.Decimal(18, 2)
  staleePriceAlerts     Json?
  status                String    @default("draft") // draft, verified, published, rejected
  calculatedBy          Int?
  calculatedAt          DateTime?
  verifiedBy            Int?
  verifiedAt            DateTime?
  publishedAt           DateTime?
  notes                 String?   @db.Text
  companyId             Int
  createdAt             DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund    FmFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, navDate])
  @@index([navDate])
  @@index([status])
  @@map("fm_nav_calculations")
}

model FmAccrual {
  id           Int          @id @default(autoincrement())
  fundId       Int
  accrualDate  DateTime     @db.Date
  accrualType  FmAccrualType
  securityId   Int?
  amount       Decimal      @db.Decimal(18, 2)
  currency     String       @db.VarChar(3)
  startDate    DateTime?    @db.Date
  endDate      DateTime?    @db.Date
  daysAccrued  Int?
  basisAmount  Decimal?     @db.Decimal(18, 2)
  rate         Decimal?     @db.Decimal(12, 8)
  isReversed   Boolean      @default(false)
  reversalDate DateTime?    @db.Date
  companyId    Int
  createdAt    DateTime     @default(now())

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund     FmFund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  security FmSecurity? @relation(fields: [securityId], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_accruals")
}

model FmFeeCalculation {
  id                    Int       @id @default(autoincrement())
  fundId                Int
  fundClassId           Int?
  feeType               FmFeeType
  periodStart           DateTime  @db.Date
  periodEnd             DateTime  @db.Date
  basisAmount           Decimal   @db.Decimal(18, 2)
  rate                  Decimal   @db.Decimal(12, 8)
  calculatedAmount      Decimal   @db.Decimal(18, 2)
  highWaterMark         Decimal?  @db.Decimal(18, 6)
  previousHighWaterMark Decimal?  @db.Decimal(18, 6)
  hurdleRate            Decimal?  @db.Decimal(8, 4)
  excessReturn          Decimal?  @db.Decimal(12, 8)
  status                String    @default("accrued") // accrued, invoiced, paid
  invoiceNumber         String?   @db.VarChar(50)
  invoiceDate           DateTime? @db.Date
  paymentDate           DateTime? @db.Date
  journalEntryId        Int?
  companyId             Int
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund      FmFund       @relation(fields: [fundId], references: [id], onDelete: Cascade)
  fundClass FmFundClass? @relation(fields: [fundClassId], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_fee_calculations")
}

model FmFxRate {
  id           Int       @id @default(autoincrement())
  fromCurrency String    @db.VarChar(3)
  toCurrency   String    @db.VarChar(3)
  rateDate     DateTime  @db.Date
  rate         Decimal   @db.Decimal(18, 8)
  inverseRate  Decimal   @db.Decimal(18, 8)
  source       String    // CBN_OFFICIAL, CBN_PARALLEL, MARKET, MANUAL
  isVerified   Boolean   @default(false)
  verifiedBy   Int?
  companyId    Int
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([fromCurrency, toCurrency, rateDate, source])
  @@index([companyId])
  @@map("fm_fx_rates")
}

// ============================================================================
// Fund Management Module - Section E: Compliance (5 models)
// ============================================================================

model FmComplianceRule {
  id                Int                 @id @default(autoincrement())
  ruleName          String              @db.VarChar(255)
  ruleType          FmComplianceRuleType
  scope             String              // FUND, ALL_FUNDS, PENCOM
  fundId            Int?
  parameter         String              @db.VarChar(100)
  limitValue        Decimal             @db.Decimal(12, 4)
  limitType         String              // PERCENTAGE, ABSOLUTE
  warningThreshold  Decimal?            @db.Decimal(12, 4)
  isActive          Boolean             @default(true)
  regulatorySource  String              // SEC, PENCOM, INTERNAL, SHARIA
  description       String?             @db.Text
  pencomFundType    FmPencomFundType?
  companyId         Int
  deletedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund             FmFund?              @relation(fields: [fundId], references: [id], onDelete: Cascade)
  complianceChecks FmComplianceCheck[]

  @@index([companyId])
  @@index([fundId])
  @@map("fm_compliance_rules")
}

model FmComplianceCheck {
  id           Int         @id @default(autoincrement())
  fundId       Int
  tradeId      Int?
  checkDate    DateTime    @db.Date
  ruleId       Int
  checkType    FmCheckType
  currentValue Decimal     @db.Decimal(12, 4)
  limitValue   Decimal     @db.Decimal(12, 4)
  headroom     Decimal?    @db.Decimal(12, 4)
  status       String      // PASSED, BREACHED, WARNING
  breachDetails String?    @db.Text
  resolution   String?     @db.Text
  resolvedBy   Int?
  resolvedAt   DateTime?
  companyId    Int
  createdAt    DateTime    @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund    FmFund           @relation(fields: [fundId], references: [id], onDelete: Cascade)
  trade   FmTrade?         @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  rule    FmComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_compliance_checks")
}

model FmShariaScreening {
  id                         Int       @id @default(autoincrement())
  securityId                 Int
  screeningDate              DateTime  @db.Date
  screenedBy                 Int?
  businessActivityResult     String    // PASS, FAIL, WATCH
  failedActivities           Json?
  toleranceNotes             String?   @db.Text
  debtToAssets               Decimal?  @db.Decimal(12, 6)
  debtToAssetsLimit          Decimal?  @db.Decimal(12, 6)
  cashInterestToAssets       Decimal?  @db.Decimal(12, 6)
  cashInterestToAssetsLimit  Decimal?  @db.Decimal(12, 6)
  receivablesToAssets         Decimal?  @db.Decimal(12, 6)
  receivablesToAssetsLimit   Decimal?  @db.Decimal(12, 6)
  interestToRevenue          Decimal?  @db.Decimal(12, 6)
  interestToRevenueLimit     Decimal?  @db.Decimal(12, 6)
  financialRatioResult       String    // PASS, FAIL
  overallResult              String    // COMPLIANT, NON_COMPLIANT, WATCH
  boardApproval              Boolean   @default(false)
  boardApprovalDate          DateTime? @db.Date
  boardApprovalRef           String?   @db.VarChar(100)
  notes                      String?   @db.Text
  nextScreeningDate          DateTime? @db.Date
  companyId                  Int
  createdAt                  DateTime  @default(now())

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  security FmSecurity @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@index([securityId])
  @@index([companyId])
  @@map("fm_sharia_screenings")
}

model FmPurificationRecord {
  id                     Int       @id @default(autoincrement())
  fundId                 Int
  investorAccountId      Int?      // nullable: late-fee → charity entries are not investor-attributable
  periodStart            DateTime  @db.Date
  periodEnd              DateTime  @db.Date
  totalIncome            Decimal   @db.Decimal(18, 2)
  nonPermissibleIncome   Decimal   @db.Decimal(18, 2)
  purificationRatio      Decimal   @db.Decimal(12, 8)
  investorShareOfIncome  Decimal   @db.Decimal(18, 2)
  purificationAmount     Decimal   @db.Decimal(18, 2)
  distributionId         Int?
  status                 String    @default("calculated") // calculated, distributed, donated, verified
  charityName            String?   @db.VarChar(255)
  donationReceipt        String?   @db.VarChar(255)
  donationDate           DateTime? @db.Date
  companyId              Int
  createdBy              Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund            FmFund             @relation(fields: [fundId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount? @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)
  distribution    FmDistribution?    @relation(fields: [distributionId], references: [id], onDelete: SetNull)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_purification_records")
}

model FmShariaBoardDecision {
  id            Int       @id @default(autoincrement())
  fundId        Int?
  securityId    Int?
  decisionDate  DateTime  @db.Date
  decisionType  String    // APPROVAL, REJECTION, REVIEW, FATWA, GUIDELINE
  subject       String    @db.VarChar(255)
  decision      String    @db.Text
  rationale     String?   @db.Text
  boardMembers  Json?
  quorumMet     Boolean
  validFrom     DateTime? @db.Date
  validUntil    DateTime? @db.Date
  supersedesId  Int?
  documentPath  String?   @db.VarChar(500)
  companyId     Int
  createdAt     DateTime  @default(now())

  company     Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund        FmFund?                @relation(fields: [fundId], references: [id], onDelete: Cascade)
  security    FmSecurity?            @relation(fields: [securityId], references: [id], onDelete: SetNull)
  supersedes  FmShariaBoardDecision? @relation("ShariaBoardSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy FmShariaBoardDecision[] @relation("ShariaBoardSupersedes")

  @@index([fundId])
  @@index([companyId])
  @@map("fm_sharia_board_decisions")
}

// ============================================================================
// Fund Management Module - Section F: Reporting & Reconciliation (4 models)
// ============================================================================

model FmInvestorStatement {
  id                         Int       @id @default(autoincrement())
  investorAccountId          Int
  periodStart                DateTime  @db.Date
  periodEnd                  DateTime  @db.Date
  statementType              String    // MONTHLY, QUARTERLY, ANNUAL, AD_HOC
  openingUnits               Decimal?  @db.Decimal(18, 6)
  closingUnits               Decimal?  @db.Decimal(18, 6)
  openingValue               Decimal?  @db.Decimal(18, 2)
  closingValue               Decimal?  @db.Decimal(18, 2)
  subscriptionsDuringPeriod  Decimal?  @db.Decimal(18, 2)
  redemptionsDuringPeriod    Decimal?  @db.Decimal(18, 2)
  distributionsDuringPeriod  Decimal?  @db.Decimal(18, 2)
  feesDuringPeriod           Decimal?  @db.Decimal(18, 2)
  returnPct                  Decimal?  @db.Decimal(12, 8)
  purificationDuringPeriod   Decimal?  @db.Decimal(18, 2)
  documentPath               String?   @db.VarChar(500)
  generatedAt                DateTime
  sentAt                     DateTime?
  sentTo                     String?   @db.VarChar(255)
  companyId                  Int
  createdAt                  DateTime  @default(now())

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)

  @@index([investorAccountId])
  @@index([companyId])
  @@map("fm_investor_statements")
}

model FmRegulatoryReturn {
  id              Int       @id @default(autoincrement())
  fundId          Int
  returnType      String    // SEC_QUARTERLY, SEC_ANNUAL, PENCOM_MONTHLY, PENCOM_QUARTERLY
  periodStart     DateTime  @db.Date
  periodEnd       DateTime  @db.Date
  data            Json
  totalAUM        Decimal?  @db.Decimal(18, 2)
  status          String    @default("draft") // draft, reviewed, submitted, accepted, rejected
  submittedAt     DateTime?
  submittedBy     Int?
  referenceNumber String?   @db.VarChar(100)
  rejectionReason String?   @db.Text
  documentPath    String?   @db.VarChar(500)
  companyId       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund    FmFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([companyId])
  @@map("fm_regulatory_returns")
}

model FmPerformanceReport {
  id                     Int            @id @default(autoincrement())
  fundId                 Int
  reportDate             DateTime       @db.Date
  dailyReturn            Decimal?       @db.Decimal(12, 8)
  wtdReturn              Decimal?       @db.Decimal(12, 8)
  mtdReturn              Decimal?       @db.Decimal(12, 8)
  qtdReturn              Decimal?       @db.Decimal(12, 8)
  ytdReturn              Decimal?       @db.Decimal(12, 8)
  oneYearReturn          Decimal?       @db.Decimal(12, 8)
  threeYearReturn        Decimal?       @db.Decimal(12, 8)
  fiveYearReturn         Decimal?       @db.Decimal(12, 8)
  sinceInceptionReturn   Decimal?       @db.Decimal(12, 8)
  benchmarkDailyReturn   Decimal?       @db.Decimal(12, 8)
  benchmarkYtdReturn     Decimal?       @db.Decimal(12, 8)
  alpha                  Decimal?       @db.Decimal(12, 8)
  beta                   Decimal?       @db.Decimal(12, 8)
  sharpeRatio            Decimal?       @db.Decimal(12, 8)
  sortinoRatio           Decimal?       @db.Decimal(12, 8)
  trackingError          Decimal?       @db.Decimal(12, 8)
  informationRatio       Decimal?       @db.Decimal(12, 8)
  maxDrawdown            Decimal?       @db.Decimal(12, 8)
  volatility             Decimal?       @db.Decimal(12, 8)
  returnMethod           FmReturnMethod
  companyId              Int
  createdAt              DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund    FmFund  @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([fundId, reportDate, returnMethod])
  @@index([fundId])
  @@index([companyId])
  @@map("fm_performance_reports")
}

model FmCustodianReconciliation {
  id                   Int       @id @default(autoincrement())
  fundId               Int
  reconciliationDate   DateTime  @db.Date
  custodianId          Int
  feedFileReference    String?   @db.VarChar(255)
  feedImportedAt       DateTime?
  totalSecurities      Int?
  custodianSecurities  Int?
  matchedSecurities    Int?
  unmatchedSecurities  Int?
  totalCash            Decimal?  @db.Decimal(18, 2)
  custodianCash        Decimal?  @db.Decimal(18, 2)
  cashVariance         Decimal?  @db.Decimal(18, 2)
  status               String    @default("pending") // pending, imported, matching, matched, exceptions, resolved
  exceptions           Json?
  resolvedBy           Int?
  resolvedAt           DateTime?
  notes                String?   @db.Text
  companyId            Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund      FmFund      @relation(fields: [fundId], references: [id], onDelete: Cascade)
  custodian FmCustodian @relation(fields: [custodianId], references: [id], onDelete: Cascade)

  @@index([fundId])
  @@index([custodianId])
  @@index([companyId])
  @@map("fm_custodian_reconciliations")
}

// ============================================================================
// Fund Management Module - Section G: Private Equity Extension (3 models)
// ============================================================================

model FmCapitalCommitment {
  id                Int       @id @default(autoincrement())
  investorAccountId Int
  committedAmount   Decimal   @db.Decimal(18, 2)
  calledAmount      Decimal   @default(0) @db.Decimal(18, 2)
  uncalledAmount    Decimal   @db.Decimal(18, 2)
  distributedAmount Decimal   @default(0) @db.Decimal(18, 2)
  currency          String    @db.VarChar(3)
  commitmentDate    DateTime  @db.Date
  expiryDate        DateTime? @db.Date
  status            String    @default("active") // active, fully_called, expired, cancelled
  companyId         Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)
  capitalCallItems FmCapitalCallItem[]

  @@index([investorAccountId])
  @@index([companyId])
  @@map("fm_capital_commitments")
}

model FmCapitalCall {
  id              Int       @id @default(autoincrement())
  callNumber      String    @unique @db.VarChar(30)
  fundId          Int
  callDate        DateTime  @db.Date
  dueDate         DateTime  @db.Date
  callPercentage  Decimal   @db.Decimal(8, 4)
  totalCallAmount Decimal   @db.Decimal(18, 2)
  purpose         String?   @db.VarChar(255)
  status          String    @default("draft") // draft, issued, partially_paid, fully_paid, defaulted
  companyId       Int
  createdBy       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fund             FmFund             @relation(fields: [fundId], references: [id], onDelete: Cascade)
  capitalCallItems FmCapitalCallItem[]

  @@index([fundId])
  @@index([companyId])
  @@map("fm_capital_calls")
}

model FmCapitalCallItem {
  id                Int       @id @default(autoincrement())
  capitalCallId     Int
  investorAccountId Int
  commitmentId      Int
  callAmount        Decimal   @db.Decimal(18, 2)
  paidAmount        Decimal   @default(0) @db.Decimal(18, 2)
  paidDate          DateTime? @db.Date
  paymentReference  String?   @db.VarChar(100)
  status            String    @default("pending") // pending, partially_paid, paid, overdue, defaulted
  remindersSent     Int       @default(0)
  lastReminderDate  DateTime? @db.Date
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  capitalCall     FmCapitalCall      @relation(fields: [capitalCallId], references: [id], onDelete: Cascade)
  investorAccount FmInvestorAccount  @relation(fields: [investorAccountId], references: [id], onDelete: Cascade)
  commitment      FmCapitalCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([capitalCallId, investorAccountId])
  @@index([capitalCallId])
  @@index([investorAccountId])
  @@map("fm_capital_call_items")
}

// ============================================================
// UNPOSTED ACCOUNTING ENTRIES
// ============================================================

model UnpostedAccountingEntry {
  id                Int       @id @default(autoincrement())
  companyId         Int
  branchId          Int?
  sourceType        String    // sales_invoice, payment_receipt, expense_request, bank_transfer, etc.
  sourceId          Int
  reference         String
  transactionDate   DateTime  @db.Date
  entryType         String    // revenue, cogs, payment, expense, asset, liability
  failureReason     String    // missing_gl_account, zero_item_cost, unbalanced_entry, etc.
  errorMessage      String?   @db.Text
  transactionData   Json?
  missingAccountType String?
  transactionAmount Decimal   @db.Decimal(15, 2)
  currencyCode      String    @default("NGN") @db.VarChar(3)
  status            String    @default("pending") // pending, resolved, reposted, ignored
  resolvedAt        DateTime?
  resolvedBy        Int?
  resolutionNotes   String?   @db.Text
  journalEntryId    Int?
  createdBy         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([sourceType, sourceId])
  @@index([failureReason])
  @@map("unposted_accounting_entries")
}

// ============================================================
// INDUSTRIAL IOT MODULE
// ============================================================

model IiotDevice {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  code                   String    @db.VarChar(30)
  name                   String    @db.VarChar(255)
  description            String?   @db.Text
  deviceType             String    @db.VarChar(30) // plc, scale, sensor, gateway
  manufacturer           String?   @db.VarChar(100)
  model                  String?   @db.VarChar(100)
  serialNumber           String?   @db.VarChar(100)
  firmwareVersion        String?   @db.VarChar(50)
  protocol               String    @db.VarChar(30) // pcom_tcp, modbus_tcp
  ipAddress              String    @db.VarChar(45)
  port                   Int
  unitId                 Int?      // Modbus slave/unit ID
  connectionTimeout      Int       @default(5000)
  pollInterval           Int       @default(1000)
  reconnectEnabled       Boolean   @default(true)
  reconnectIntervalMs    Int       @default(1000)
  reconnectMaxIntervalMs Int       @default(60000)
  location               String?   @db.VarChar(255)
  status                 String    @default("offline") @db.VarChar(30) // online, offline, error, disabled
  lastSeenAt             DateTime?
  lastErrorMessage       String?   @db.Text
  lastErrorAt            DateTime?
  metadata               Json?
  isEnabled              Boolean   @default(true)
  createdById            Int?
  updatedById            Int?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tags          IiotDeviceTag[]
  scaleProfiles IiotScaleProfile[]
  events        IiotDeviceEvent[]
  writeLogs     IiotWriteLog[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, deviceType])
  @@index([companyId, isEnabled])
  @@map("iiot_devices")
}

model IiotDeviceTag {
  id                Int       @id @default(autoincrement())
  companyId         Int
  deviceId          Int
  name              String    @db.VarChar(100)
  description       String?   @db.VarChar(255)
  address           String    @db.VarChar(50) // PCOM: MI0, ML10; Modbus: 40001
  dataType          String    @db.VarChar(20) // bool, int16, uint16, int32, uint32, float32, float64, string
  functionCode      Int?      // Modbus FC: 1,2,3,4
  registerCount     Int?      @default(1)
  byteOrder         String?   @db.VarChar(30) // big_endian, little_endian, etc.
  pollIntervalMs    Int       @default(1000)
  scalingEnabled    Boolean   @default(false)
  scalingMultiplier Decimal?  @db.Decimal(15, 6)
  scalingOffset     Decimal?  @db.Decimal(15, 6)
  scalingUnit       String?   @db.VarChar(20)
  loggingMode       String    @default("on_change") @db.VarChar(30)
  loggingDeadband   Decimal?  @db.Decimal(15, 6)
  currentValue      String?   @db.VarChar(255)
  currentValueAt    DateTime?
  quality           String    @default("uncertain") @db.VarChar(20) // good, bad, uncertain, error
  accessMode        String    @default("read") @db.VarChar(20) // read, write, read_write
  isEnabled         Boolean   @default(true)
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  IiotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  groupMembers       IiotTagGroupMember[]
  workCenterBindings IiotWorkCenterBinding[]
  alarms             IiotAlarm[]

  @@unique([deviceId, name])
  @@index([companyId, deviceId])
  @@index([deviceId, isEnabled])
  @@map("iiot_device_tags")
}

model IiotDeviceEvent {
  id             Int      @id @default(autoincrement())
  companyId      Int
  deviceId       Int
  eventType      String   @db.VarChar(30) // connected, disconnected, error, reconnecting, reconnected, disabled, enabled
  message        String?  @db.Text
  ipAddress      String?  @db.VarChar(45)
  port           Int?
  responseTimeMs Int?
  metadata       Json?
  createdAt      DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  IiotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([companyId, deviceId, createdAt])
  @@index([companyId, eventType, createdAt])
  @@map("iiot_device_events")
}

model IiotTagGroup {
  id          Int       @id @default(autoincrement())
  companyId   Int
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  color       String?   @db.VarChar(7)
  icon        String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdById Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members IiotTagGroupMember[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("iiot_tag_groups")
}

model IiotTagGroupMember {
  id          Int      @id @default(autoincrement())
  tagGroupId  Int
  deviceTagId Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tagGroup  IiotTagGroup  @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  deviceTag IiotDeviceTag @relation(fields: [deviceTagId], references: [id], onDelete: Cascade)

  @@unique([tagGroupId, deviceTagId])
  @@index([tagGroupId])
  @@index([deviceTagId])
  @@map("iiot_tag_group_members")
}

model IiotWorkCenterBinding {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  workCenterId          Int
  deviceTagId           Int
  metricType            String    @db.VarChar(50) // machine_status, cycle_count, reject_count, cycle_time, speed, temperature, pressure, weight, energy, custom
  unitsPerCycle         Decimal?  @db.Decimal(15, 4)
  idealCycleTimeSeconds Decimal?  @db.Decimal(10, 2)
  isActive              Boolean   @default(true)
  notes                 String?   @db.VarChar(255)
  createdById           Int?
  updatedById           Int?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceTag IiotDeviceTag @relation(fields: [deviceTagId], references: [id], onDelete: Cascade)

  @@unique([workCenterId, metricType])
  @@index([companyId, workCenterId])
  @@index([deviceTagId])
  @@map("iiot_work_center_bindings")
}

model IiotAlarm {
  id                       Int       @id @default(autoincrement())
  companyId                Int
  deviceTagId              Int
  name                     String    @db.VarChar(255)
  description              String?   @db.Text
  condition                String    @db.VarChar(20) // gt, lt, eq, neq, between, outside
  thresholdValue           Decimal   @db.Decimal(15, 6)
  thresholdValue2          Decimal?  @db.Decimal(15, 6) // for between/outside
  severity                 String    @db.VarChar(20) // info, warning, critical, emergency
  hysteresis               Decimal?  @db.Decimal(15, 6)
  delaySeconds             Int       @default(0)
  autoResolve              Boolean   @default(true)
  autoResolveDelaySeconds  Int       @default(10)
  escalationMinutes        Int?
  suppressDuringMaintenance Boolean  @default(true)
  notifyWebSocket          Boolean   @default(true)
  isActive                 Boolean   @default(true)
  createdById              Int?
  updatedById              Int?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceTag IiotDeviceTag @relation(fields: [deviceTagId], references: [id], onDelete: Cascade)
  events    IiotAlarmEvent[]

  @@unique([deviceTagId, name])
  @@index([companyId, isActive])
  @@index([deviceTagId])
  @@map("iiot_alarms")
}

model IiotAlarmEvent {
  id               Int       @id @default(autoincrement())
  companyId        Int
  alarmId          Int
  deviceTagId      Int
  deviceId         Int
  triggeredAt      DateTime
  triggerValue     Decimal   @db.Decimal(15, 6)
  thresholdValue   Decimal   @db.Decimal(15, 6)
  severity         String    @db.VarChar(20)
  status           String    @default("active") @db.VarChar(20) // active, acknowledged, resolved
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  acknowledgeNotes String?   @db.Text
  resolvedAt       DateTime?
  resolvedById     Int?
  resolveValue     Decimal?  @db.Decimal(15, 6)
  resolveNotes     String?   @db.Text
  isAutoResolved   Boolean   @default(false)
  durationSeconds  Int?
  escalated        Boolean   @default(false)
  escalatedAt      DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  alarm   IiotAlarm @relation(fields: [alarmId], references: [id], onDelete: Cascade)

  @@index([companyId, status, severity])
  @@index([companyId, deviceId, triggeredAt])
  @@index([alarmId, triggeredAt])
  @@map("iiot_alarm_events")
}

model IiotScaleProfile {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  deviceId             Int?      // NULL for Web Serial (browser-only) scales
  name                 String    @db.VarChar(255)
  code                 String    @db.VarChar(30)
  scaleType            String    @db.VarChar(30) // network_modbus, web_serial, plc_analog
  unit                 String    @db.VarChar(10) // kg, g, lb, oz, t
  decimalPrecision     Int       @default(2)
  minWeight            Decimal?  @db.Decimal(15, 4)
  maxWeight            Decimal?  @db.Decimal(15, 4)
  defaultTareWeight    Decimal   @default(0) @db.Decimal(15, 4)
  stabilityThreshold   Decimal   @default(0.05) @db.Decimal(10, 4)
  stabilityDurationMs  Int       @default(2000)
  weightRegisterAddress String?  @db.VarChar(50)
  weightDataType       String?   @db.VarChar(20)
  tareRegisterAddress  String?   @db.VarChar(50)
  zeroRegisterAddress  String?   @db.VarChar(50)
  serialConfig         Json?     // Web Serial settings
  lastCalibrationDate  DateTime? @db.Date
  nextCalibrationDate  DateTime? @db.Date
  calibrationCertificate String? @db.VarChar(255)
  location             String?   @db.VarChar(255)
  isActive             Boolean   @default(true)
  createdById          Int?
  updatedById          Int?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device        IiotDevice?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  weightRecords IiotWeightRecord[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([deviceId])
  @@map("iiot_scale_profiles")
}

model IiotWeightRecord {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  scaleProfileId      Int
  recordNumber        String    @unique @db.VarChar(30) // WGT-2026-00001
  grossWeight         Decimal   @db.Decimal(15, 4)
  tareWeight          Decimal   @db.Decimal(15, 4)
  netWeight           Decimal   @db.Decimal(15, 4)
  unit                String    @db.VarChar(10)
  isStable            Boolean   @default(true)
  captureMethod       String    @db.VarChar(20) // automatic, web_serial, manual
  productionOrderId   Int?
  stockMovementId     Int?
  qualityInspectionId Int?
  purchaseReceiptId   Int?
  documentType        String?   @db.VarChar(50) // production_order, stock_movement, quality_inspection, purchase_receipt, standalone
  documentReference   String?   @db.VarChar(100)
  itemId              Int?
  itemUnitWeight      Decimal?  @db.Decimal(15, 6)
  calculatedQuantity  Decimal?  @db.Decimal(15, 4)
  expectedWeight      Decimal?  @db.Decimal(15, 4)
  weightVariance      Decimal?  @db.Decimal(15, 4)
  variancePercent     Decimal?  @db.Decimal(8, 4)
  toleranceExceeded   Boolean   @default(false)
  notes               String?   @db.Text
  operatorId          Int
  capturedAt          DateTime
  createdAt           DateTime  @default(now())

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scaleProfile IiotScaleProfile @relation(fields: [scaleProfileId], references: [id], onDelete: Cascade)

  @@index([companyId, capturedAt])
  @@index([productionOrderId])
  @@index([stockMovementId])
  @@index([scaleProfileId, capturedAt])
  @@index([companyId, documentType])
  @@map("iiot_weight_records")
}

model IiotDashboardConfig {
  id               Int       @id @default(autoincrement())
  companyId        Int
  userId           Int
  name             String    @db.VarChar(100)
  description      String?   @db.VarChar(255)
  isDefault        Boolean   @default(false)
  layout           Json
  refreshIntervalMs Int      @default(1000)
  autoRefresh      Boolean   @default(true)
  isShared         Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([companyId, userId])
  @@index([companyId, isShared])
  @@map("iiot_dashboard_configs")
}

// ---------------------------------------------------------------------------
// IIoT Settings (one row per company)
// ---------------------------------------------------------------------------

model IiotSettings {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  defaultPcomPort     Int      @default(20256)
  defaultModbusPort   Int      @default(502)
  defaultPollInterval Int      @default(1000)
  connectionTimeout   Int      @default(5000)
  dataRetentionDays   Int      @default(365)
  enableWebSocket     Boolean  @default(true)
  webSocketThrottleMs Int      @default(250)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
  @@index([companyId])
  @@map("iiot_settings")
}

// ===========================================================================
// SCHOOL MANAGEMENT MODULE
// ===========================================================================

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum SmSessionStatus {
  UPCOMING
  CURRENT
  COMPLETED
}

enum SmTermStatus {
  UPCOMING
  CURRENT
  COMPLETED
}

enum SmClassCategory {
  NURSERY
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

enum SmSubjectType {
  CORE
  ELECTIVE
  VOCATIONAL
}

enum SmGender {
  MALE
  FEMALE
}

enum SmBloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum SmGenotype {
  AA
  AS
  SS
  AC
  SC
}

enum SmStudentCategory {
  DAY
  BOARDER
  ALL
}

enum SmSpecialCategory {
  SCHOLARSHIP
  STAFF_WARD
  SPECIAL_NEEDS
}

enum SmStudentStatus {
  APPLICANT
  ADMITTED
  ACTIVE
  SUSPENDED
  WITHDRAWN
  GRADUATED
  EXPELLED
}

enum SmGuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  UNCLE
  AUNT
  SIBLING
  OTHER
}

enum SmEnrolmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  TRANSFERRED
  WITHDRAWN
}

enum SmDocumentType {
  BIRTH_CERTIFICATE
  IMMUNIZATION
  PREVIOUS_RESULT
  PASSPORT_PHOTO
  TRANSFER_CERT
  ID_CARD
  OTHER
}

enum SmStaffType {
  TEACHING
  NON_TEACHING
  ADMIN
}

enum SmFeeInvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum SmPaymentMethod {
  CASH
  BANK_TRANSFER
  POS
  ONLINE
  CHECK
}

enum SmFeeDiscountType {
  STAFF_WARD
  SIBLING
  SCHOLARSHIP
  FINANCIAL_AID
  CUSTOM
}

enum SmDiscountValueType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SmDiscountAppliesTo {
  ALL_FEES
  TUITION_ONLY
  SPECIFIC_CATEGORIES
}

enum SmResultStatus {
  PENDING
  COMPUTED
  APPROVED
  PUBLISHED
}

enum SmPsychomotorCategory {
  AFFECTIVE
  PSYCHOMOTOR
}

enum SmPromotionDecision {
  PROMOTED
  REPEATED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// A. Academic Structure (8 tables)
// ---------------------------------------------------------------------------

model SmAcademicSession {
  id        Int             @id @default(autoincrement())
  name      String          @db.VarChar(50)
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  isCurrent Boolean         @default(false)
  status    SmSessionStatus @default(UPCOMING)
  companyId Int
  createdBy Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  terms              SmTerm[]
  enrolments         SmEnrolment[]
  feeStructures      SmFeeStructure[]
  feeInvoices        SmFeeInvoice[]
  assessments        SmAssessment[]
  results            SmResult[]
  resultSummaries    SmResultSummary[]
  psychomotorRatings SmPsychomotorRating[]
  attendances        SmAttendance[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([isCurrent])
  @@index([status])
  @@map("sm_academic_sessions")
}

model SmTerm {
  id                       Int          @id @default(autoincrement())
  sessionId                Int
  name                     String       @db.VarChar(50)
  termNumber               Int
  startDate                DateTime     @db.Date
  endDate                  DateTime     @db.Date
  midTermBreakStart        DateTime?    @db.Date
  midTermBreakEnd          DateTime?    @db.Date
  nextTermResumptionDate   DateTime?    @db.Date
  isCurrent                Boolean      @default(false)
  status                   SmTermStatus @default(UPCOMING)
  schoolDays               Int?
  companyId                Int
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  session            SmAcademicSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feeStructures      SmFeeStructure[]
  feeInvoices        SmFeeInvoice[]
  assessments        SmAssessment[]
  results            SmResult[]
  resultSummaries    SmResultSummary[]
  psychomotorRatings SmPsychomotorRating[]
  attendances        SmAttendance[]

  @@unique([sessionId, termNumber])
  @@index([sessionId])
  @@index([isCurrent])
  @@map("sm_terms")
}

model SmClassLevel {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(50)
  code           String          @db.VarChar(20)
  category       SmClassCategory
  sortOrder      Int
  classTeacherId Int?
  companyId      Int
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections       SmClassSection[]
  classSubjects  SmClassSubject[]
  enrolments     SmEnrolment[]
  feeStructures  SmFeeStructure[]
  assessments    SmAssessment[]
  results        SmResult[]
  resultSummaries SmResultSummary[]
  attendances     SmAttendance[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([category])
  @@index([sortOrder])
  @@map("sm_class_levels")
}

model SmClassSection {
  id             Int      @id @default(autoincrement())
  classLevelId   Int
  name           String   @db.VarChar(10)
  capacity       Int      @default(40)
  classTeacherId Int?
  roomNumber     String?  @db.VarChar(20)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classLevel SmClassLevel  @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  enrolments SmEnrolment[]

  @@unique([classLevelId, name])
  @@index([classLevelId])
  @@map("sm_class_sections")
}

model SmSubject {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  code        String        @db.VarChar(20)
  subjectType SmSubjectType
  department  String?       @db.VarChar(100)
  creditHours Int?
  description String?       @db.Text
  companyId   Int
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  classSubjects SmClassSubject[]
  assessments   SmAssessment[]
  results       SmResult[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([subjectType])
  @@map("sm_subjects")
}

model SmClassSubject {
  id           Int      @id @default(autoincrement())
  classLevelId Int
  subjectId    Int
  teacherId    Int?
  isCompulsory Boolean  @default(true)
  createdAt    DateTime @default(now())

  classLevel SmClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    SmSubject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classLevelId, subjectId])
  @@map("sm_class_subjects")
}

model SmGradingScale {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isDefault   Boolean  @default(false)
  companyId   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   SmGradingScaleItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("sm_grading_scales")
}

model SmGradingScaleItem {
  id             Int      @id @default(autoincrement())
  gradingScaleId Int
  grade          String   @db.VarChar(10)
  minScore       Decimal  @db.Decimal(5, 2)
  maxScore       Decimal  @db.Decimal(5, 2)
  gradePoint     Decimal? @db.Decimal(4, 2)
  remark         String   @db.VarChar(50)
  sortOrder      Int
  createdAt      DateTime @default(now())

  gradingScale SmGradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)

  @@unique([gradingScaleId, grade])
  @@map("sm_grading_scale_items")
}

// ---------------------------------------------------------------------------
// B. Student Management (7 tables)
// ---------------------------------------------------------------------------

model SmStudent {
  id                     Int                @id @default(autoincrement())
  admissionNumber        String             @unique @db.VarChar(30)
  firstName              String             @db.VarChar(100)
  middleName             String?            @db.VarChar(100)
  lastName               String             @db.VarChar(100)
  dateOfBirth            DateTime           @db.Date
  gender                 SmGender
  stateOfOrigin          String?            @db.VarChar(50)
  lga                    String?            @db.VarChar(100)
  nationality            String?            @default("Nigerian") @db.VarChar(50)
  religion               String?            @db.VarChar(50)
  bloodGroup             SmBloodGroup?
  genotype               SmGenotype?
  photo                  String?            @db.VarChar(500)
  address                String?            @db.Text
  studentCategory        SmStudentCategory
  specialCategory        SmSpecialCategory?
  previousSchool         String?            @db.VarChar(255)
  transferCertificateUrl String?            @db.VarChar(500)
  admissionDate          DateTime           @db.Date
  graduationDate         DateTime?          @db.Date
  status                 SmStudentStatus    @default(ACTIVE)
  statusChangeReason     String?            @db.Text
  siblingGroupId         String?            @db.VarChar(36)
  companyId              Int
  createdBy              Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?

  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  guardians          SmStudentGuardian[]
  medicalRecord      SmMedicalRecord?
  enrolments         SmEnrolment[]
  documents          SmStudentDocument[]
  feeInvoices        SmFeeInvoice[]
  feePayments        SmFeePayment[]
  scores             SmScore[]
  results            SmResult[]
  resultSummaries    SmResultSummary[]
  psychomotorRatings SmPsychomotorRating[]
  attendances        SmAttendance[]

  @@index([companyId])
  @@index([status])
  @@index([siblingGroupId])
  @@index([lastName, firstName])
  @@map("sm_students")
}

model SmGuardian {
  id                 Int                     @id @default(autoincrement())
  firstName          String                  @db.VarChar(100)
  lastName           String                  @db.VarChar(100)
  phone              String                  @db.VarChar(20)
  phoneAlt           String?                 @db.VarChar(20)
  email              String?                 @db.VarChar(255)
  occupation         String?                 @db.VarChar(100)
  employer           String?                 @db.VarChar(255)
  address            String?                 @db.Text
  relationship       SmGuardianRelationship
  isEmergencyContact Boolean                 @default(false)
  portalUserId       Int?
  companyId          Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  students SmStudentGuardian[]

  @@index([companyId])
  @@index([phone])
  @@index([email])
  @@map("sm_guardians")
}

model SmStudentGuardian {
  id         Int      @id @default(autoincrement())
  studentId  Int
  guardianId Int
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  student  SmStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian SmGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@map("sm_student_guardians")
}

model SmMedicalRecord {
  id                      Int       @id @default(autoincrement())
  studentId               Int       @unique
  allergies               String?   @db.Text
  medicalConditions       String?   @db.Text
  medications             String?   @db.Text
  disabilities            String?   @db.Text
  immunizationStatus      String?   @db.VarChar(50)
  lastCheckupDate         DateTime? @db.Date
  healthInsuranceProvider String?   @db.VarChar(100)
  healthInsuranceNumber   String?   @db.VarChar(50)
  doctorName              String?   @db.VarChar(100)
  doctorPhone             String?   @db.VarChar(20)
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  student SmStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("sm_medical_records")
}

model SmEnrolment {
  id             Int                @id @default(autoincrement())
  studentId      Int
  sessionId      Int
  classLevelId   Int
  classSectionId Int
  rollNumber     Int?
  enrolmentDate  DateTime           @db.Date
  status         SmEnrolmentStatus  @default(ACTIVE)
  promotedToId   Int?               @unique
  remarks        String?            @db.Text
  createdBy      Int?
  companyId      Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  student            SmStudent             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session            SmAcademicSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel         SmClassLevel          @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classSection       SmClassSection        @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  promotedTo         SmEnrolment?          @relation("EnrolmentPromotion", fields: [promotedToId], references: [id])
  promotedFrom       SmEnrolment?          @relation("EnrolmentPromotion")
  feeInvoices        SmFeeInvoice[]
  scores             SmScore[]
  results            SmResult[]
  resultSummaries    SmResultSummary[]
  psychomotorRatings SmPsychomotorRating[]
  attendances        SmAttendance[]

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@index([sessionId])
  @@index([classLevelId])
  @@index([classSectionId])
  @@index([companyId])
  @@map("sm_enrolments")
}

model SmStudentDocument {
  id           Int            @id @default(autoincrement())
  studentId    Int
  documentType SmDocumentType
  title        String         @db.VarChar(255)
  fileUrl      String         @db.VarChar(500)
  fileSize     Int?
  mimeType     String?        @db.VarChar(100)
  uploadedBy   Int?
  createdAt    DateTime       @default(now())

  student SmStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([documentType])
  @@map("sm_student_documents")
}

model SmStaff {
  id                Int         @id @default(autoincrement())
  employeeId        Int?
  firstName         String      @db.VarChar(100)
  lastName          String      @db.VarChar(100)
  email             String?     @db.VarChar(255)
  phone             String?     @db.VarChar(20)
  staffType         SmStaffType
  designation       String?     @db.VarChar(100)
  subjectsQualified String?     @db.Text
  trcnNumber        String?     @db.VarChar(50)
  qualification     String?     @db.VarChar(100)
  yearsOfExperience Int?
  companyId         Int
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([employeeId])
  @@index([staffType])
  @@map("sm_staff")
}

// ---------------------------------------------------------------------------
// C. Fee Management (6 tables)
// ---------------------------------------------------------------------------

model SmFeeCategory {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  code            String   @db.VarChar(30)
  glAccountId     Int?
  description     String?  @db.Text
  isSystemDefined Boolean  @default(false)
  companyId       Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glAccount     IfrsAccount?         @relation("FeeCategoryGLAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  feeStructures SmFeeStructure[]
  invoiceItems  SmFeeInvoiceItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([glAccountId])
  @@map("sm_fee_categories")
}

model SmFeeStructure {
  id              Int              @id @default(autoincrement())
  sessionId       Int
  termId          Int
  classLevelId    Int
  studentCategory SmStudentCategory @default(DAY)
  feeCategoryId   Int
  amount          Decimal          @db.Decimal(15, 2)
  isOptional      Boolean          @default(false)
  companyId       Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  session     SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term        SmTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel  SmClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  feeCategory SmFeeCategory     @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([sessionId, termId, classLevelId, studentCategory, feeCategoryId])
  @@index([companyId])
  @@index([sessionId, termId, classLevelId])
  @@map("sm_fee_structures")
}

model SmFeeInvoice {
  id              Int                  @id @default(autoincrement())
  invoiceNumber   String               @db.VarChar(30)
  studentId       Int
  sessionId       Int
  termId          Int
  enrolmentId     Int?
  subtotal        Decimal              @db.Decimal(15, 2)
  discountAmount  Decimal              @default(0) @db.Decimal(15, 2)
  discountType    SmFeeDiscountType?
  discountPercent Decimal?             @db.Decimal(5, 2)
  totalAmount     Decimal              @db.Decimal(15, 2)
  amountPaid      Decimal              @default(0) @db.Decimal(15, 2)
  balance         Decimal              @db.Decimal(15, 2)
  dueDate         DateTime             @db.Date
  status          SmFeeInvoiceStatus   @default(DRAFT)
  journalEntryId  Int?
  companyId       Int
  createdBy       Int?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  student      SmStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session      SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term         SmTerm         @relation(fields: [termId], references: [id], onDelete: Cascade)
  enrolment    SmEnrolment?   @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items        SmFeeInvoiceItem[]
  payments     SmFeePayment[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([studentId])
  @@index([sessionId, termId])
  @@index([status])
  @@index([journalEntryId])
  @@map("sm_fee_invoices")
}

model SmFeeInvoiceItem {
  id            Int     @id @default(autoincrement())
  invoiceId     Int
  feeCategoryId Int
  description   String  @db.VarChar(255)
  amount        Decimal @db.Decimal(15, 2)
  glAccountId   Int?

  invoice     SmFeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategory SmFeeCategory @relation(fields: [feeCategoryId], references: [id], onDelete: Cascade)
  glAccount   IfrsAccount?  @relation("FeeInvoiceItemGLAccount", fields: [glAccountId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, feeCategoryId])
  @@index([invoiceId])
  @@index([feeCategoryId])
  @@map("sm_fee_invoice_items")
}

model SmFeePayment {
  id              Int              @id @default(autoincrement())
  receiptNumber   String           @db.VarChar(30)
  invoiceId       Int
  studentId       Int
  amount          Decimal          @db.Decimal(15, 2)
  paymentMethod   SmPaymentMethod
  paymentDate     DateTime         @db.Date
  bankAccountId   Int?
  referenceNumber String?          @db.VarChar(100)
  journalEntryId  Int?
  receivedBy      Int?
  isRefund        Boolean          @default(false)
  companyId       Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice      SmFeeInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student      SmStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, receiptNumber])
  @@index([companyId])
  @@index([invoiceId])
  @@index([studentId])
  @@index([paymentDate])
  @@index([journalEntryId])
  @@map("sm_fee_payments")
}

model SmFeeDiscount {
  id                  Int                   @id @default(autoincrement())
  name                String                @db.VarChar(100)
  discountType        SmFeeDiscountType
  valueType           SmDiscountValueType
  value               Decimal               @db.Decimal(15, 2)
  appliesTo           SmDiscountAppliesTo   @default(ALL_FEES)
  specificCategoryIds Json?
  glAccountId         Int?
  requiresApproval    Boolean               @default(false)
  companyId           Int
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  glAccount IfrsAccount? @relation("FeeDiscountGLAccount", fields: [glAccountId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([discountType])
  @@map("sm_fee_discounts")
}

// ---------------------------------------------------------------------------
// D. Examinations & Results (5 tables)
// ---------------------------------------------------------------------------

model SmAssessment {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  code         String    @db.VarChar(20)
  sessionId    Int
  termId       Int
  classLevelId Int
  subjectId    Int
  maxScore     Decimal   @db.Decimal(5, 2)
  weight       Decimal   @db.Decimal(5, 2)
  date         DateTime? @db.Date
  companyId    Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  session    SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term       SmTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel SmClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    SmSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  scores     SmScore[]

  @@unique([companyId, sessionId, termId, classLevelId, subjectId, code])
  @@index([companyId])
  @@index([sessionId, termId])
  @@index([classLevelId])
  @@index([subjectId])
  @@map("sm_assessments")
}

model SmScore {
  id           Int       @id @default(autoincrement())
  assessmentId Int
  studentId    Int
  enrolmentId  Int
  score        Decimal?  @db.Decimal(5, 2)
  remarks      String?   @db.VarChar(255)
  enteredBy    Int?
  enteredAt    DateTime  @default(now())
  companyId    Int

  assessment SmAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    SmStudent    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolment  SmEnrolment  @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([enrolmentId])
  @@index([companyId])
  @@map("sm_scores")
}

model SmResult {
  id           Int     @id @default(autoincrement())
  studentId    Int
  enrolmentId  Int
  sessionId    Int
  termId       Int
  classLevelId Int
  subjectId    Int
  caTotal      Decimal @db.Decimal(5, 2)
  examScore    Decimal @db.Decimal(5, 2)
  totalScore   Decimal @db.Decimal(5, 2)
  grade        String  @db.VarChar(10)
  gradePoint   Decimal @db.Decimal(4, 2)
  remarks      String? @db.VarChar(100)
  companyId    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    SmStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolment  SmEnrolment       @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  session    SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term       SmTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel SmClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject    SmSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId, termId, subjectId])
  @@index([enrolmentId])
  @@index([sessionId, termId, classLevelId])
  @@index([companyId])
  @@map("sm_results")
}

model SmResultSummary {
  id                Int                  @id @default(autoincrement())
  studentId         Int
  enrolmentId       Int
  sessionId         Int
  termId            Int
  classLevelId      Int
  totalScore        Decimal              @db.Decimal(8, 2)
  averageScore      Decimal              @db.Decimal(5, 2)
  subjectCount      Int
  gpa               Decimal              @db.Decimal(4, 2)
  classPosition     Int?
  classSize         Int?
  status            SmResultStatus       @default(PENDING)
  principalComment  String?              @db.Text
  teacherComment    String?              @db.Text
  promotionDecision SmPromotionDecision?
  companyId         Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  student    SmStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolment  SmEnrolment       @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  session    SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term       SmTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  classLevel SmClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId, termId])
  @@index([enrolmentId])
  @@index([sessionId, termId, classLevelId])
  @@index([companyId])
  @@index([status])
  @@map("sm_result_summaries")
}

model SmPsychomotorRating {
  id          Int                    @id @default(autoincrement())
  studentId   Int
  enrolmentId Int
  sessionId   Int
  termId      Int
  category    SmPsychomotorCategory
  trait       String                 @db.VarChar(50)
  rating      Int
  ratedBy     Int?
  companyId   Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  student   SmStudent         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolment SmEnrolment       @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  session   SmAcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  term      SmTerm            @relation(fields: [termId], references: [id], onDelete: Cascade)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId, termId, trait])
  @@index([enrolmentId])
  @@index([sessionId, termId])
  @@index([companyId])
  @@map("sm_psychomotor_ratings")
}

model SmAttendance {
  id            Int      @id @default(autoincrement())
  studentId     Int
  enrolmentId   Int
  sessionId     Int
  termId        Int
  classLevelId  Int
  date          DateTime @db.Date
  status        String   @db.VarChar(10) // PRESENT | ABSENT | LATE | EXCUSED
  remarks       String?  @db.VarChar(255)
  takenBy       Int?
  companyId     Int

  student     SmStudent         @relation(fields: [studentId], references: [id])
  enrolment   SmEnrolment       @relation(fields: [enrolmentId], references: [id])
  session     SmAcademicSession @relation(fields: [sessionId], references: [id])
  term        SmTerm            @relation(fields: [termId], references: [id])
  classLevel  SmClassLevel      @relation(fields: [classLevelId], references: [id])
  company     Company           @relation(fields: [companyId], references: [id])

  @@unique([studentId, enrolmentId, date])
  @@index([companyId, sessionId, termId, classLevelId, date])
  @@map("sm_attendances")
}

// ============================================================================
// IMPORT MANAGEMENT MODULE
// ============================================================================

model ImportOrder {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  orderNumber           String
  supplierId            Int
  currencyId            Int?
  exchangeRate          Decimal?  @db.Decimal(15, 6)
  incoterms             String?   @db.VarChar(10)
  paymentInstrument     String?   @db.VarChar(20)

  // Proforma details
  proformaNumber        String?
  proformaDate          DateTime? @db.Date
  proformaAmount        Decimal?  @db.Decimal(15, 2)

  // Origin/destination
  countryOfSupply       String?
  countryOfOrigin       String?
  portOfLoading         String?
  portOfDischarge       String?   @default("Lagos (Apapa)")
  finalDestination      String?

  // Values (foreign currency)
  fobValue              Decimal?  @db.Decimal(15, 2)
  freightValue          Decimal?  @db.Decimal(15, 2)
  insuranceValue        Decimal?  @db.Decimal(15, 2)
  cifValue              Decimal?  @db.Decimal(15, 2)

  // Totals (local currency NGN)
  totalDutyAmount       Decimal?  @db.Decimal(15, 2)
  totalLandedCost       Decimal?  @db.Decimal(15, 2)

  // Status
  status                String    @default("draft")

  // Tracking
  expectedDeliveryDate  DateTime? @db.Date
  actualDeliveryDate    DateTime? @db.Date
  warehouseId           Int?
  notes                 String?   @db.Text

  // Workflow
  createdBy             Int?
  approvedBy            Int?
  approvedAt            DateTime?
  closedBy              Int?
  closedAt              DateTime?
  cancellationReason    String?   @db.Text

  // Soft delete
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier           Supplier       @relation(fields: [supplierId], references: [id])
  currency           IfrsCurrency?  @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  lines              ImportOrderLine[]
  formM              ImportFormM?
  letterOfCredit     ImportLetterOfCredit?
  payments           ImportPayment[]
  shipments          ImportShipment[]
  customsClearance   ImportCustomsClearance?
  dutyAssessment     ImportDutyAssessment?
  documents          ImportDocument[]
  certifications     ImportCertification[]
  landedCosts        ImportLandedCost[]
  statusHistory      ImportStatusHistory[]

  @@unique([companyId, orderNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@map("im_import_orders")
}

model ImportOrderLine {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int
  lineNumber          Int
  itemId              Int
  description         String?   @db.Text
  hsCode              String?   @db.VarChar(20)
  quantity            Decimal   @db.Decimal(15, 3)
  uomId               Int?
  unitPrice           Decimal   @db.Decimal(15, 4)
  lineTotal           Decimal   @db.Decimal(15, 2)

  // Physical properties
  grossWeightKg       Decimal?  @db.Decimal(10, 3)
  netWeightKg         Decimal?  @db.Decimal(10, 3)
  volumeCbm           Decimal?  @db.Decimal(10, 4)
  packageCount        Int?
  packageType         String?   @db.VarChar(50)

  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  item          Item            @relation(fields: [itemId], references: [id])

  landedCost    ImportLandedCost?

  @@index([importOrderId])
  @@index([itemId])
  @@map("im_import_order_lines")
}

model ImportFormM {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int       @unique
  companyId           Int
  formMNumber         String?
  baNumber            String?
  bankId              Int?

  // Amounts
  amount              Decimal?  @db.Decimal(15, 2)
  currencyId          Int?

  // Dates
  submittedDate       DateTime? @db.Date
  validatedDate       DateTime? @db.Date
  approvedDate        DateTime? @db.Date
  expiryDate          DateTime? @db.Date

  // Status
  status              String    @default("draft")

  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank          Bank?           @relation(fields: [bankId], references: [id], onDelete: SetNull)
  currency      IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("im_form_m")
}

model ImportLetterOfCredit {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int       @unique
  companyId           Int
  lcNumber            String?
  lcType              String    @default("sight")

  // Banks
  issuingBankId       Int?
  advisingBankName    String?
  confirmingBankName  String?

  // Amounts
  amount              Decimal?  @db.Decimal(15, 2)
  currencyId          Int?
  exchangeRate        Decimal?  @db.Decimal(15, 6)

  // Margin/Deposit
  marginPercentage    Decimal?  @db.Decimal(5, 2)
  marginAmount        Decimal?  @db.Decimal(15, 2)
  marginPaidDate      DateTime? @db.Date

  // Usance-specific
  tenorDays           Int?

  // Dates
  applicationDate     DateTime? @db.Date
  issueDate           DateTime? @db.Date
  expiryDate          DateTime? @db.Date
  latestShipDate      DateTime? @db.Date
  paymentDueDate      DateTime? @db.Date

  // Status
  status              String    @default("draft")

  // Amendments
  amendments          Json?

  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  issuingBank   Bank?           @relation("LCIssuingBank", fields: [issuingBankId], references: [id], onDelete: SetNull)
  currency      IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("im_letters_of_credit")
}

model ImportPayment {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int
  companyId           Int
  paymentNumber       String?

  paymentType         String

  // Amounts
  amount              Decimal   @db.Decimal(15, 2)
  currencyId          Int?
  exchangeRate        Decimal?  @db.Decimal(15, 6)
  localAmount         Decimal   @db.Decimal(15, 2)

  // Payment details
  paymentDate         DateTime  @db.Date
  bankId              Int?
  reference           String?
  beneficiary         String?

  // Status
  status              String    @default("pending")

  // GL posting reference
  journalEntryId      Int?

  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank          Bank?           @relation(fields: [bankId], references: [id], onDelete: SetNull)
  currency      IfrsCurrency?   @relation(fields: [currencyId], references: [id], onDelete: SetNull)

  @@index([importOrderId])
  @@index([companyId])
  @@index([paymentType])
  @@map("im_import_payments")
}

model ImportShipment {
  id                    Int       @id @default(autoincrement())
  importOrderId         Int
  companyId             Int

  billOfLadingNumber    String?
  airwayBillNumber      String?
  shippingLine          String?
  vesselName            String?
  voyageNumber          String?

  portOfLoading         String?
  portOfDischarge       String?

  // Dates
  etd                   DateTime? @db.Date
  eta                   DateTime? @db.Date
  actualDeparture       DateTime? @db.Date
  actualArrival         DateTime? @db.Date

  // Cargo totals
  totalGrossWeightKg    Decimal?  @db.Decimal(12, 3)
  totalVolumeCbm        Decimal?  @db.Decimal(12, 4)
  totalPackages         Int?

  // Status
  status                String    @default("booked")

  notes                 String?   @db.Text
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder       @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  containers    ImportContainer[]

  @@index([importOrderId])
  @@index([companyId])
  @@map("im_shipments")
}

model ImportContainer {
  id                  Int       @id @default(autoincrement())
  shipmentId          Int
  containerNumber     String
  sealNumber          String?

  containerType       String    @default("fcl_20")

  grossWeightKg       Decimal?  @db.Decimal(10, 3)
  volumeCbm           Decimal?  @db.Decimal(10, 4)

  // Status
  status              String    @default("empty")

  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  shipment      ImportShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("im_containers")
}

model ImportCustomsClearance {
  id                    Int       @id @default(autoincrement())
  importOrderId         Int       @unique
  companyId             Int

  // Clearing agent
  clearingAgentId       Int?
  clearingAgentName     String?
  clearingAgentLicense  String?

  // PAAR
  paarNumber            String?
  paarDate              DateTime? @db.Date
  paarAmount            Decimal?  @db.Decimal(15, 2)

  // SGD
  sgdNumber             String?
  sgdDate               DateTime? @db.Date

  // Risk assessment
  riskChannel           String?   @db.VarChar(10)

  // Examination
  examinationDate       DateTime? @db.Date
  examinationResult     String?
  examinationNotes      String?   @db.Text

  // Release
  releaseOrderNumber    String?
  releaseDate           DateTime? @db.Date

  // Terminal
  terminalName          String?
  terminalReceiptDate   DateTime? @db.Date
  terminalExitDate      DateTime? @db.Date

  // Haulage
  haulageCompany        String?
  pickupDate            DateTime? @db.Date
  deliveryDate          DateTime? @db.Date

  // Status
  status                String    @default("paar_pending")

  notes                   String?   @db.Text
  clearingAgentSupplierId Int?
  journalEntryId          Int?
  dutyAmount              Decimal   @default(0) @db.Decimal(15, 2)
  containerDeposit        Decimal   @default(0) @db.Decimal(15, 2)
  portCharges             Decimal   @default(0) @db.Decimal(15, 2)
  localExpenses           Decimal   @default(0) @db.Decimal(15, 2)
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clearingAgent Supplier?       @relation("ClearingAgent", fields: [clearingAgentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@map("im_customs_clearance")
}

model ImportDutyAssessment {
  id                    Int       @id @default(autoincrement())
  importOrderId         Int       @unique
  companyId             Int

  // CIF base
  cifValue              Decimal   @db.Decimal(15, 2)
  exchangeRate          Decimal   @db.Decimal(15, 6)
  cifValueNgn           Decimal   @db.Decimal(15, 2)

  // Import Duty
  dutyRate              Decimal   @db.Decimal(5, 2)
  dutyAmount            Decimal   @db.Decimal(15, 2)

  // Surcharge (7% of duty)
  surchargeRate         Decimal   @db.Decimal(5, 2)  @default(7)
  surchargeAmount       Decimal   @db.Decimal(15, 2)

  // CISS (1% of FOB)
  cissRate              Decimal   @db.Decimal(5, 2)  @default(1)
  cissAmount            Decimal   @db.Decimal(15, 2)

  // ETLS (0.5% of CIF)
  etlsRate              Decimal   @db.Decimal(5, 2)  @default(0.5)
  etlsAmount            Decimal   @db.Decimal(15, 2)

  // VAT (7.5%)
  vatRate               Decimal   @db.Decimal(5, 2)  @default(7.5)
  vatAmount             Decimal   @db.Decimal(15, 2)

  // Total
  totalAssessment       Decimal   @db.Decimal(15, 2)

  // Status
  status                String    @default("assessed")

  assessmentDate        DateTime? @db.Date
  paidDate              DateTime? @db.Date
  paymentReference      String?

  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("im_duty_assessments")
}

model ImportDocument {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int
  companyId           Int

  documentType        String

  documentNumber      String?
  issueDate           DateTime? @db.Date
  expiryDate          DateTime? @db.Date
  issuedBy            String?

  // File
  filePath            String?
  fileName            String?
  fileSize            Int?

  // Status
  status              String    @default("pending")

  notes               String?   @db.Text
  verifiedBy          Int?
  verifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([importOrderId])
  @@index([documentType])
  @@map("im_documents")
}

model ImportCertification {
  id                    Int       @id @default(autoincrement())
  importOrderId         Int
  companyId             Int

  certificationType     String

  certificateNumber     String?
  issuedBy              String?
  issueDate             DateTime? @db.Date
  expiryDate            DateTime? @db.Date

  inspectionBody        String?

  // Status
  status                String    @default("not_required")

  // Fee
  feeAmount             Decimal?  @db.Decimal(15, 2)
  feeCurrencyId         Int?

  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([importOrderId])
  @@map("im_certifications")
}

model ImportLandedCost {
  id                    Int       @id @default(autoincrement())
  importOrderLineId     Int       @unique
  importOrderId         Int
  companyId             Int

  // Component costs (NGN)
  fobCost               Decimal   @db.Decimal(15, 2)  @default(0)
  freightCost           Decimal   @db.Decimal(15, 2)  @default(0)
  insuranceCost         Decimal   @db.Decimal(15, 2)  @default(0)
  cifCost               Decimal   @db.Decimal(15, 2)  @default(0)

  // Duty components
  dutyAmount            Decimal   @db.Decimal(15, 2)  @default(0)
  surchargeAmount       Decimal   @db.Decimal(15, 2)  @default(0)
  vatAmount             Decimal   @db.Decimal(15, 2)  @default(0)
  cissAmount            Decimal   @db.Decimal(15, 2)  @default(0)
  etlsAmount            Decimal   @db.Decimal(15, 2)  @default(0)

  // Other charges
  clearingCharges       Decimal   @db.Decimal(15, 2)  @default(0)
  terminalCharges       Decimal   @db.Decimal(15, 2)  @default(0)
  haulageCharges        Decimal   @db.Decimal(15, 2)  @default(0)
  demurrageCharges      Decimal   @db.Decimal(15, 2)  @default(0)
  otherCharges          Decimal   @db.Decimal(15, 2)  @default(0)

  // Totals
  totalLandedCost       Decimal   @db.Decimal(15, 2)  @default(0)
  landedCostPerUnit     Decimal   @db.Decimal(15, 4)  @default(0)

  // Exchange rate at final calculation
  exchangeRate          Decimal?  @db.Decimal(15, 6)

  // Status
  isFinalized           Boolean   @default(false)
  finalizedAt           DateTime?
  inventoryUpdated      Boolean   @default(false)
  inventoryUpdatedAt    DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  importOrderLine ImportOrderLine @relation(fields: [importOrderLineId], references: [id], onDelete: Cascade)
  importOrder     ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([importOrderId])
  @@index([companyId])
  @@map("im_landed_costs")
}

model ImportStatusHistory {
  id                  Int       @id @default(autoincrement())
  importOrderId       Int
  previousStatus      String?
  newStatus           String
  changedBy           Int?
  changedAt           DateTime  @default(now())
  notes               String?   @db.Text

  // Relations
  importOrder   ImportOrder     @relation(fields: [importOrderId], references: [id], onDelete: Cascade)

  @@index([importOrderId])
  @@map("im_status_history")
}

model IiotWriteLog {
  id           Int      @id @default(autoincrement())
  companyId    Int
  deviceId     Int
  userId       Int
  writeType    String   @db.VarChar(30) // manual, work_order_dispatch
  address      String   @db.VarChar(50)
  dataType     String   @db.VarChar(20)
  valueSent    String   @db.VarChar(255)
  success      Boolean
  errorMessage String?  @db.Text
  metadata     Json?
  durationMs   Int?
  createdAt    DateTime @default(now())

  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device  IiotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([companyId, deviceId, createdAt])
  @@index([companyId, writeType, createdAt])
  @@map("iiot_write_logs")
}

// Energy readings — periodic snapshots for trending
model IiotEnergyReading {
  id              Int       @id @default(autoincrement())
  companyId       Int
  workCenterId    Int
  deviceTagId     Int
  metricType      String    @db.VarChar(30) // energy, power, current, voltage
  value           Decimal   @db.Decimal(15, 4)
  unit            String?   @db.VarChar(20)
  recordedAt      DateTime  @default(now())

  @@index([companyId, workCenterId, recordedAt])
  @@index([companyId, metricType, recordedAt])
  @@map("iiot_energy_readings")
}
// ============================================================================
// VETERINARY MODULE
// ============================================================================

model VetClient {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  clientCode         String
  firstName          String
  lastName           String
  phone              String
  email              String?
  address            String?
  city               String?
  state              String?
  idType             String?
  idNumber           String?
  notes              String?
  // Sprint 2: GPS coordinates for ambulatory routing + zone billing.
  // Captured on the client form ("use my location") or set later on the
  // first ambulatory request from a phone with location services enabled.
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  outstandingBalance Decimal   @default(0) @db.Decimal(12, 2)
  // Bridge to standard AR: vet billing creates SalesInvoices against this Customer.
  // Auto-backfilled by tenant migration 2026-04-25-001 for pre-existing rows.
  customerId         Int?
  isActive           Boolean   @default(true)
  createdById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer Customer? @relation("CustomerVetClient", fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([companyId, clientCode])
  @@index([companyId, phone])
  @@index([companyId, lastName])
  @@index([customerId])
  @@map("vet_clients")
}

model VetAnimal {
