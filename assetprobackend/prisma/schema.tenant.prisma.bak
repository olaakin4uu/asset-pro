  companyId       Int
  siteId          Int
  feedTypeId      Int?
  feedName        String    @db.VarChar(150)
  inventoryItemId Int?
  currentStockKg  Decimal   @default(0) @db.Decimal(15,4)
  minStockKg      Decimal?  @db.Decimal(15,4)
  maxStockKg      Decimal?  @db.Decimal(15,4)
  unitCost        Decimal?  @db.Decimal(15,4)
  expiryDate      DateTime? @db.Date
  batchNumber     String?   @db.VarChar(50)
  notes           String?   @db.Text
  updatedById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, siteId])
  @@index([companyId, feedTypeId])
  @@map("lsk_feed_inventory")
}

model LskFeedReceipt {
  id              Int       @id @default(autoincrement())
  companyId       Int
  siteId          Int
  receiptCode     String    @db.VarChar(30)
  receiptDate     DateTime  @db.Date
