  costPerKg       Decimal?  @db.Decimal(15,4)
  costContribution Decimal? @db.Decimal(15,4)
  proteinContrib  Decimal?  @db.Decimal(5,2)
  energyContrib   Decimal?  @db.Decimal(8,2)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, formulationId])
  @@map("lsk_feed_formulation_items")
}

model LskFeedInventory {
