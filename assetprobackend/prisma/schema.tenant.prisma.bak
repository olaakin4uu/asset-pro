  outputFeedName  String    @db.VarChar(150)
  outputQuantityKg Decimal  @db.Decimal(15,4)
  totalInputCost  Decimal?  @db.Decimal(15,2)
  costPerKg       Decimal?  @db.Decimal(15,4)
  laborCost       Decimal?  @db.Decimal(15,2)
  overheadCost    Decimal?  @db.Decimal(15,2)
