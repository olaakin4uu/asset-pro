  maxValue         Decimal? @db.Decimal(12, 4)
  criticalMinValue Decimal? @db.Decimal(12, 4)
  criticalMaxValue Decimal? @db.Decimal(12, 4)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([companyId, speciesId, analyte])
  @@map("vet_lab_reference_ranges")
}

model VetProcedure {
