}

model LskPigMortality {
  id              Int       @id @default(autoincrement())
  companyId       Int
  pigId           Int?
  batchId         Int?
  batchType       String?   @db.VarChar(20)
  mortalityDate   DateTime  @db.Date
  quantity        Int       @default(1)
  reasonId        Int?
  category        String?   @db.VarChar(30)
  estimatedWeightKg Decimal? @db.Decimal(8,2)
  notes           String?   @db.Text
  recordedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, pigId])
  @@index([companyId, batchId])
  @@index([companyId, mortalityDate])
  @@map("lsk_pig_mortalities")
}

model LskPigCostItem {
  id              Int       @id @default(autoincrement())
  companyId       Int
  pigId           Int?
  batchId         Int?
  batchType       String?   @db.VarChar(20)
  costType        String    @db.VarChar(50)
  description     String    @db.VarChar(200)
  amount          Decimal   @db.Decimal(15,2)
  costDate        DateTime  @db.Date
  referenceType   String?   @db.VarChar(50)
  referenceId     Int?
  notes           String?   @db.Text
  createdById     Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, pigId])
  @@index([companyId, batchId])
  @@index([companyId, costType])
  @@map("lsk_pig_cost_items")
}

// ============================================================================
// LIVESTOCK MODULE — Phase 6: Feed & Nutrition (Cross-Species)
// ============================================================================

model LskFeedFormulation {
  id                Int       @id @default(autoincrement())
  companyId         Int
  formulationCode   String    @db.VarChar(30)
  name              String    @db.VarChar(150)
  speciesId         Int?
  targetFeedCategory String?  @db.VarChar(50)
  totalCostPerKg    Decimal?  @db.Decimal(15,4)
  proteinPercent    Decimal?  @db.Decimal(5,2)
  energyKcalPerKg   Decimal?  @db.Decimal(8,2)
  fatPercent        Decimal?  @db.Decimal(5,2)
  fiberPercent      Decimal?  @db.Decimal(5,2)
  moisturePercent   Decimal?  @db.Decimal(5,2)
  description       String?   @db.Text
  isActive          Boolean   @default(true)
  createdById       Int?
  updatedById       Int?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, formulationCode])
  @@index([companyId, isActive])
  @@index([companyId, speciesId])
  @@map("lsk_feed_formulations")
}

model LskFeedFormulationItem {
  id              Int       @id @default(autoincrement())
  companyId       Int
  formulationId   Int
  ingredientName  String    @db.VarChar(150)
  inventoryItemId Int?
