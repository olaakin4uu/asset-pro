  symptomTags        Json?
  temperature        Decimal? @db.Decimal(5, 2)
  heartRate          Int?
  respiratoryRate    Int?
  weight             Decimal? @db.Decimal(8, 2)
  bodyConditionScore Int?
  triageCategory     String
  painScore          Int?
  notes              String?
  recordedById       Int?
  createdAt          DateTime @default(now())

  @@map("vet_triage_records")
}

model VetSoapNote {
