  id                       Int       @id @default(autoincrement())
  procedureId              Int       @unique
  consentSigned            Boolean   @default(false)
  preOpVitalsRecorded      Boolean   @default(false)
  fastingConfirmed         Boolean   @default(false)
  instrumentsSterilized    Boolean   @default(false)
  anesthesiaMachineChecked Boolean   @default(false)
  ivAccessEstablished      Boolean   @default(false)
  postOpMedsPrepared       Boolean   @default(false)
  additionalChecks         Json?
  completedById            Int?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())

  @@map("vet_surgery_checklists")
}

model VetAnesthesiaRecord {
  id                   Int       @id @default(autoincrement())
  procedureId          Int       @unique
