  inductionDrug        String?
  inductionDose        String?
  maintenanceDrug      String?
  maintenanceRate      String?
  intubationSize       String?
  entries              Json      @default("[]")
  recoveryStartedAt    DateTime?
  recoveryCompletedAt  DateTime?
  recordedById         Int?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("vet_anesthesia_records")
}

model VetProcedureConsumable {
  id              Int      @id @default(autoincrement())
  procedureId     Int
  itemId          Int
  quantity        Decimal  @db.Decimal(10, 2)
  lotNumber       String?
  stockMovementId Int?
  createdAt       DateTime @default(now())

  @@index([procedureId])
  @@map("vet_procedure_consumables")
}

model VetPriceList {
  id        Int       @id @default(autoincrement())
  companyId Int
  name      String
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  validFrom DateTime? @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("vet_price_lists")
}

model VetPriceListItem {
  id              Int      @id @default(autoincrement())
  priceListId     Int
  serviceType     String
  serviceName     String
  speciesId       Int?
  price           Decimal  @db.Decimal(12, 2)
  afterHoursPrice Decimal? @db.Decimal(12, 2)
  // Sprint 1.3: optional ₦/kg surcharge added to `price` based on the
  // patient's weight. e.g. anesthesia for a 40kg dog vs a 5kg cat.
  // Null/zero = flat pricing (back-compat).
  weightBasedRate Decimal? @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([priceListId])
  @@map("vet_price_list_items")
}

// ============================================================================
// Sprint 1.3: Consumable Packs — bundle the syringe/cotton/gloves/etc. that
// always go with a procedure type, so they get billed instead of given away.
// Operators apply a pack to a procedure with one click; each pack item then
// becomes a VetProcedureConsumable row (which drives stock movement + bill).
// ============================================================================

model VetConsumablePack {
  id          Int      @id @default(autoincrement())
  companyId   Int
  code        String
  name        String
  description String?  @db.Text
  // Free-text hint for which procedureType this pack defaults to ("spay",
  // "dental", "vaccination"). Used by the UI to suggest a pack — never
  // hard-enforced because procedureType is itself free-text.
  appliesTo   String?
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items VetConsumablePackItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("vet_consumable_packs")
}

model VetConsumablePackItem {
  id        Int      @id @default(autoincrement())
  packId    Int
  itemId    Int
  quantity  Decimal  @db.Decimal(10, 2) @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pack VetConsumablePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  item Item              @relation("ConsumablePackItems", fields: [itemId], references: [id])

  @@unique([packId, itemId])
  @@index([packId])
  @@map("vet_consumable_pack_items")
}

model VetVisitCharge {
  id            Int      @id @default(autoincrement())
  visitId       Int
  companyId     Int
  chargeType    String
  description   String
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  referenceId   Int?
  referenceType String?
  createdAt     DateTime @default(now())

  @@index([visitId])
  @@map("vet_visit_charges")
}

// Sprint 2/3 Batch 8 (#10) — field visit photo attachments
model VetVisitPhoto {
  id            Int      @id @default(autoincrement())
  companyId     Int
  visitId       Int
  filePath      String
  fileSizeBytes Int      @default(0)
  mimeType      String   @default("image/jpeg") @db.VarChar(100)
  uploadedById  Int
  caption       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, visitId])
  @@map("vet_visit_photos")
}

model VetSettings {
  id                         Int      @id @default(autoincrement())
  companyId                  Int      @unique
  clinicHours                Json?
  defaultAppointmentDuration Json?
  reminderTiming             Json?
  defaultPriceListId         Int?
  controlledDrugItemIds      Json?
  autoGenerateInvoice        Boolean  @default(true)
  requireTriageBeforeConsult Boolean  @default(true)
  preferredWeightUnit        String   @default("kg")
  balanceEnforcement         String   @default("warn")
  balanceBlockThreshold      Decimal? @db.Decimal(12, 2)

  // Extended fields (form parity)
  workingHoursStart           String?
  workingHoursEnd             String?
  workingDays                 Int[]    @default([])
  appointmentDuration         Int?
  appointmentSlotInterval     Int?
  enableSmsReminders          Boolean  @default(false)
  reminderHoursBefore         Int      @default(24)
  enableOnlineBooking         Boolean  @default(false)
  defaultWeightUnit           String?  @default("kg")
  defaultTemperatureUnit      String?  @default("celsius")
  enableAutoCharging          Boolean  @default(false)
  enableDispensingIntegration Boolean  @default(false)
  visitNumberPrefix           String?
  appointmentNumberPrefix     String?
  labOrderNumberPrefix        String?

  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("vet_settings")
}

// ============================================================================
// VETERINARY MODULE - Phase 2: Ambulatory, Insurance, CRM
// ============================================================================

model VetAmbulatoryRequest {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  branchId              Int?
  clientId              Int
  animalId              Int?
  location              String
  latitude              Decimal?  @db.Decimal(10, 7)
  longitude             Decimal?  @db.Decimal(10, 7)
  address               String?
  species               String
  estimatedAnimalCount  Int       @default(1)
  reason                String
  urgencyLevel          String    @default("ROUTINE")
  preferredDate         DateTime? @db.Date
  preferredTimeSlot     String?
  specialInstructions   String?   @db.Text
  biosecurityNotes      String?
  status                String    @default("PENDING")
  cancelReason          String?
  cancellationFee       Decimal?  @db.Decimal(12, 2)
  requestedById         Int?
  fuelCost              Decimal?  @db.Decimal(12, 2)
  tripDistanceKm        Decimal?  @db.Decimal(8, 2)
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId, status])
  @@index([companyId, urgencyLevel])
  @@index([clientId])
  @@map("vet_ambulatory_requests")
}

model VetDispatchAssignment {
