// ============================================================================
// ON-PREMISE DEPLOYMENT & SYNC
// ============================================================================

enum SyncOperation {
  INSERT
  UPDATE
  DELETE
}

enum SyncStatus {
  pending
  synced
  failed
  conflict
  skipped
}

enum SyncDirection {
  push
  pull
  full
}

enum SyncLogStatus {
  success
  partial
  failed
}

enum ConflictResolution {
  local_wins
  cloud_wins
  merged
  pending
}

enum ConflictStrategy {
  last_write_wins
  on_premise_wins
  cloud_wins
  flag_for_review
}

enum ModuleOwnershipType {
  on_premise_primary
  cloud_primary
  bidirectional
}

enum UpdateStatus {
  checking
  downloading
  migrating
  restarting
  verifying
  success
  failed
  rolled_back
}

enum BackupDestination {
  local
  s3
  cloud
}

enum BackupStatus {
  in_progress
  completed
  failed
  expired
  deleted
}

enum InstanceStatus {
  online
  offline
  updating
  error
  provisioning
}

// Cloud-only: registry of all on-premise deployments
model OnPremiseInstance {
  id                Int            @id @default(autoincrement())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  instanceId        String         @unique // UUID assigned during setup
  name              String // Human-readable name (e.g., "Lagos HQ")
  version           String // Current software version
  status            InstanceStatus @default(provisioning)
  licenseKey        String         @unique
  licenseExpiresAt  DateTime
  lastHeartbeatAt   DateTime?
  lastSyncAt        DateTime?
  syncQueueDepth    Int            @default(0)
  diskUsagePercent  Float          @default(0)
  updatePolicy      String         @default("auto") // auto, manual, critical-only
  updateWindowStart String? // "02:00"
  updateWindowEnd   String? // "05:00"
  pinnedVersion     String?
  gitBranch         String         @default("release/stable")
  containerHealth   Json? // { backend: "healthy", frontend: "healthy", ... }
  sitePrefixCode    String // "HQ", "LG", etc.

  heartbeats       InstanceHeartbeat[]
  moduleOwnerships ModuleOwnership[]
  syncLogs         SyncLog[]
  updateLogs       UpdateLog[]
  backupRecords    BackupRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
  @@map("on_premise_instances")
}

// Cloud-only: time-series health data from on-premise instances
model InstanceHeartbeat {
  id                 Int               @id @default(autoincrement())
  instanceId         Int
  instance           OnPremiseInstance @relation(fields: [instanceId], references: [id])
  version            String
  cpuUsagePercent    Float
  memoryUsagePercent Float
  diskUsagePercent   Float
  syncQueueDepth     Int
  containerHealth    Json // { backend: "healthy", frontend: "unhealthy", ... }
  uptimeSeconds      Int
  createdAt          DateTime          @default(now())

  @@index([instanceId, createdAt])
  @@map("instance_heartbeats")
}

// Both: queue of local changes pending push to cloud/remote
model SyncOutbox {
  id              BigInt        @id @default(autoincrement())
  tenantId        String
  tableName       String
  recordId        String // Original record ID (could be int or UUID)
  operation       SyncOperation
  payload         Json // Full record data at time of change
  previousPayload Json? // Previous state (for conflict detection)
  timestamp       DateTime      @default(now())
  status          SyncStatus    @default(pending)
  retryCount      Int           @default(0)
  lastError       String?
  syncedAt        DateTime?
  batchId         String? // Groups records from the same sync cycle
  createdAt       DateTime      @default(now())

  @@index([status, timestamp])
  @@index([tenantId, tableName])
  @@index([batchId])
  @@map("sync_outbox")
}

// Both: queue of incoming changes from cloud/remote
model SyncInbox {
  id               BigInt        @id @default(autoincrement())
  tenantId         String
  tableName        String
  recordId         String
  operation        SyncOperation
  payload          Json
  sourceInstanceId String? // Which instance originated this change
  timestamp        DateTime // When the change was originally made
  status           SyncStatus    @default(pending)
  appliedAt        DateTime?
  error            String?
  createdAt        DateTime      @default(now())

  @@index([status, timestamp])
  @@index([tenantId, tableName])
  @@map("sync_inbox")
}

// Both: records of detected sync conflicts
model SyncConflict {
  id           Int                @id @default(autoincrement())
  tenantId     String
  tableName    String
  recordId     String
  localPayload Json
  cloudPayload Json
  resolution   ConflictResolution @default(pending)
  resolvedBy   Int? // userId who resolved (null if auto-resolved)
  resolvedAt   DateTime?
  autoResolved Boolean            @default(false)
  strategyUsed ConflictStrategy?
  createdAt    DateTime           @default(now())

  @@index([tenantId, resolution])
  @@map("sync_conflicts")
}

// Both: audit log of sync operations
model SyncLog {
  id                Int                @id @default(autoincrement())
  tenantId          String
  instanceId        Int?
  instance          OnPremiseInstance? @relation(fields: [instanceId], references: [id])
  syncId            String             @unique // UUID for this sync cycle
  direction         SyncDirection
  startedAt         DateTime
  completedAt       DateTime?
  status            SyncLogStatus      @default(success)
  recordsPushed     Int                @default(0)
  recordsPulled     Int                @default(0)
  conflictsDetected Int                @default(0)
  conflictsResolved Int                @default(0)
  errors            Json? // Array of error details
  durationMs        Int?
  bytesTransferred  BigInt?
  createdAt         DateTime           @default(now())

  @@index([tenantId, startedAt])
  @@index([instanceId, startedAt])
  @@map("sync_logs")
}

// On-premise-only: tracks sync position per table
model SyncCursor {
  id           Int       @id @default(autoincrement())
  tableName    String    @unique
  lastPulledAt DateTime?
  lastPushedAt DateTime?
  lastPulledId String?
  updatedAt    DateTime  @updatedAt

  @@map("sync_cursors")
}

// Both: per-module sync configuration
model ModuleOwnership {
  id               Int                 @id @default(autoincrement())
  tenantId         String
  instanceId       Int?
  instance         OnPremiseInstance?  @relation(fields: [instanceId], references: [id])
  moduleSlug       String
  ownership        ModuleOwnershipType @default(bidirectional)
  conflictStrategy ConflictStrategy    @default(last_write_wins)
  syncEnabled      Boolean             @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([tenantId, instanceId, moduleSlug])
  @@map("module_ownership")
}

// Both: software update history
model UpdateLog {
  id             Int                @id @default(autoincrement())
  instanceId     Int?
  instance       OnPremiseInstance? @relation(fields: [instanceId], references: [id])
  fromVersion    String
  toVersion      String
  status         UpdateStatus
  migrationsRun  Json? // ["20260301_add_sync_tables", ...]
  startedAt      DateTime
  completedAt    DateTime?
  durationMs     Int?
  rollbackReason String?
  dbSnapshotPath String?
  error          String?
  createdAt      DateTime           @default(now())

  @@index([instanceId, startedAt])
  @@map("update_logs")
}

// Both: backup metadata
model BackupRecord {
  id              Int                @id @default(autoincrement())
  instanceId      Int?
  instance        OnPremiseInstance? @relation(fields: [instanceId], references: [id])
  filename        String
  sizeBytes       BigInt
  checksum        String // SHA-256
  destination     BackupDestination
  destinationPath String
  encrypted       Boolean            @default(true)
  status          BackupStatus       @default(in_progress)
  expiresAt       DateTime
  restoredAt      DateTime?
  createdAt       DateTime           @default(now())

  @@index([instanceId, createdAt])
  @@map("backup_records")
}

// Tenant-level backup for per-schema backup/restore
model TenantBackup {
  id           Int           @id @default(autoincrement())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schemaName   String
  filename     String        @unique
  sizeBytes    BigInt        @default(0)
  checksum     String?
  status       BackupStatus  @default(in_progress)
  notes        String?
  createdBy    String?
  isScheduled    Boolean       @default(false)
  restoreStatus  String?       // PENDING_APPROVAL, APPROVED, REJECTED, null (not a restore request)
  restoreTarget  String?       // Target tenant ID for restore
  requestedById  Int?          // User who requested restore
  restoredAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("tenant_backups")
}

// ============================================================================
// SMS / WHATSAPP INBOUND REPORTING (Sprint 2B)
// ============================================================================
// Inbound messages from rural farm managers who SMS/WhatsApp short commands
// (e.g. "M FK001 2" = 2 deaths on flock FK001) to record livestock events
// when they have no smartphone or no data signal. Logged centrally because
// the sender's tenant is unknown until we resolve their phone number.

model SmsInboundMessage {
  id                Int       @id @default(autoincrement())
  provider          String    @default("termii") // termii, twilio, msg91...
  providerMessageId String    @unique // Idempotency key from provider
  channel           String    @default("sms") // sms, whatsapp
  fromPhone         String
  toPhone           String?
  rawBody           String    @db.Text
  receivedAt        DateTime  @default(now())

  // Resolution (nullable — set once we match phone → tenant user)
  tenantId          String?
  tenantSchema      String?
  userId            Int?
  companyId         Int?

  // Parsed command
  command           String? // MORTALITY, FEED, EGG, WEIGHT, HELP, UNKNOWN
  commandArgs       Json?

  // Lifecycle: received → parsed → dispatched → replied | failed
  status            String    @default("received")
  errorMessage      String?   @db.Text

  // Outbound reply (what we SMS'd back to the farmer)
  replyBody         String?   @db.Text
  replySentAt       DateTime?
  replyProviderId   String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([fromPhone, receivedAt])
  @@index([status, receivedAt])
  @@map("sms_inbound_messages")
}
