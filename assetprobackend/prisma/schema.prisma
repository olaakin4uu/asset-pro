  newSubscriptions    Int
  churned             Int
  upgrades            Int
  downgrades          Int
  totalRevenue        Decimal  @db.Decimal(15, 2)
  infrastructureCost  Decimal  @db.Decimal(15, 2)
  netRevenue          Decimal  @db.Decimal(15, 2)
  currency            String   @default("NGN")
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([month])
  @@map("monthly_financial_summaries")
}

