  description                      String?            @db.Text
  parentId                         Int?
  depreciationMethod               DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeYears                  Int                @default(5)
  usefulLifeMonths                 Int                @default(0)
  residualValuePercent             Decimal            @default(0) @db.Decimal(5, 2)
  assetAccountId                   Int?
  accumulatedDepreciationAccountId Int?
  depreciationExpenseAccountId     Int?
  gainLossAccountId                Int?
  maintenanceAccountId             Int?
  isActive                         Boolean            @default(true)
  createdBy                        Int?
  deletedAt                        DateTime?
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt

  // Relations
  parent   AssetClass?  @relation("AssetClassHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children AssetClass[] @relation("AssetClassHierarchy")
  assets   Asset[]
  company  Company      @relation(fields: [companyId], references: [id])

  @@index([companyId, isActive])
  @@map("ast_asset_classes")
}

model Asset {
  id                      Int                @id @default(autoincrement())
  companyId               Int
  branchId                Int?
  assetClassId            Int
  assetCode               String             @unique
  name                    String
  description             String?            @db.Text
  serialNumber            String?
  barcode                 String?
  make                    String?
  model                   String?
  manufacturer            String?
  location                String?
  department              String?
  custodianUserId         Int?
  acquisitionDate         DateTime?          @db.Date
  acquisitionCost         Decimal            @db.Decimal(15, 2)
  acquisitionMethod       String?
  supplierId              Int?
  purchaseOrderNumber     String?
  invoiceNumber           String?
  grnId                   Int?
  grnLineId               Int?
  depreciationMethod      DepreciationMethod
  usefulLifeYears         Int
  residualValue           Decimal            @default(0) @db.Decimal(15, 2)
  residualValuePercent    Decimal            @default(0) @db.Decimal(5, 2)
  depreciationStartDate   DateTime?          @db.Date
  bookValue               Decimal            @default(0) @db.Decimal(15, 2)
  accumulatedDepreciation Decimal            @default(0) @db.Decimal(15, 2)
  impairmentLoss          Decimal            @default(0) @db.Decimal(15, 2)
  lastDepreciationDate    DateTime?          @db.Date
  status                  String             @default("active")
  condition               String             @default("new")
  warrantyStartDate       DateTime?          @db.Date
  warrantyExpiryDate      DateTime?          @db.Date
  lastMaintenanceDate     DateTime?          @db.Date
  nextMaintenanceDate     DateTime?          @db.Date
  disposalDate            DateTime?          @db.Date
  disposalValue           Decimal?           @db.Decimal(15, 2)
  disposalMethod          String?
  disposalNotes           String?            @db.Text
  notes                   String?            @db.Text
  customFields            Json?
  imagePath               String?
  createdById             Int?
  deletedAt               DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  // Relations
  assetClass          AssetClass          @relation(fields: [assetClassId], references: [id], onDelete: Cascade)
  depreciationRecords AssetDepreciation[]
  transfers           AssetTransfer[]
  maintenanceRecords  AssetMaintenance[]
  disposals           AssetDisposal[]
  company             Company             @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([assetClassId, status])
  @@index([branchId, status])
  @@map("ast_assets")
}

model AssetDepreciation {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  assetId                 Int
  depreciationDate        DateTime  @db.Date
  fiscalYear              Int
  fiscalPeriod            Int
  periodName              String?
  depreciationMethod      String
  openingBookValue        Decimal   @db.Decimal(15, 2)
  depreciationAmount      Decimal   @db.Decimal(15, 2)
  closingBookValue        Decimal   @db.Decimal(15, 2)
  accumulatedDepreciation Decimal   @db.Decimal(15, 2)
  annualDepreciationRate  Decimal?  @db.Decimal(8, 4)
  usefulLifeYears         Int?
  residualValue           Decimal?  @db.Decimal(15, 2)
  monthsDepreciated       Int       @default(1)
  isPosted                Boolean   @default(false)
  transactionId           Int?
  postedAt                DateTime?
  postedByUserId          Int?
  batchNumber             String?
  isAdjustment            Boolean   @default(false)
  adjustmentReason        String?   @db.Text
  status                  String    @default("draft")
  createdById             Int?
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, depreciationDate])
  @@index([isPosted, depreciationDate])
  @@index([companyId, fiscalYear, fiscalPeriod])
  @@map("ast_depreciations")
}

model AssetTransfer {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  assetId             Int
  transferNumber      String    @unique
  transferDate        DateTime  @db.Date
  effectiveDate       DateTime? @db.Date
  transferType        String
  fromLocation        String?
  fromDepartment      String?
  fromCustodianUserId Int?
  fromBranchId        Int?
  toLocation          String?
  toDepartment        String?
  toCustodianUserId   Int?
  toBranchId          Int?
  conditionAtTransfer String?
  conditionNotes      String?   @db.Text
  status              String    @default("draft")
  requestedByUserId   Int?
  approvedByUserId    Int?
  approvedAt          DateTime?
  dispatchedAt        DateTime?
  receivedByUserId    Int?
  receivedAt          DateTime?
  reason              String?   @db.Text
  notes               String?   @db.Text
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, transferDate])
  @@index([companyId, status])
  @@map("ast_transfers")
}

model AssetMaintenance {
  id                     Int       @id @default(autoincrement())
  companyId              Int
  assetId                Int
  maintenanceNumber      String    @unique
  title                  String?
  description            String?   @db.Text
  maintenanceType        String    @default("preventive")
  priority               String    @default("medium")
  scheduledDate          DateTime? @db.Date
  dueDate                DateTime? @db.Date
  startedDate            DateTime? @db.Date
  completedDate          DateTime? @db.Date
  estimatedDurationHours Decimal?  @db.Decimal(8, 2)
  actualDurationHours    Decimal?  @db.Decimal(8, 2)
  isRecurring            Boolean   @default(false)
  recurrenceFrequency    String?
  recurrenceInterval     Int?
  nextScheduledDate      DateTime? @db.Date
  vendorName             String?
  vendorContact          String?
  technicianName         String?
  assignedToUserId       Int?
  estimatedCost          Decimal?  @db.Decimal(15, 2)
  actualCost             Decimal?  @db.Decimal(15, 2)
  laborCost              Decimal?  @db.Decimal(12, 2)
  partsCost              Decimal?  @db.Decimal(12, 2)
  costBreakdown          String?   @db.Text
  partsUsed              String?   @db.Text
  materialsUsed          String?   @db.Text
  conditionBefore        String?
  conditionAfter         String?
  meterReadingBefore     Decimal?  @db.Decimal(15, 2)
  meterReadingAfter      Decimal?  @db.Decimal(15, 2)
  meterUnit              String?
  workPerformed          String?   @db.Text
  findings               String?   @db.Text
  recommendations        String?   @db.Text
  notes                  String?   @db.Text
  status                 String    @default("scheduled")
  requiresFollowUp       Boolean   @default(false)
  followUpNotes          String?   @db.Text
  requestedByUserId      Int?
  approvedByUserId       Int?
  approvedAt             DateTime?
  completedByUserId      Int?
  isPosted               Boolean   @default(false)
  transactionId          Int?
  postedAt               DateTime?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, maintenanceType])
  @@index([companyId, status])
  @@map("ast_maintenances")
}

model AssetDisposal {
  id                      Int       @id @default(autoincrement())
  companyId               Int
  assetId                 Int
  disposalNumber          String    @unique
  disposalDate            DateTime  @db.Date
  disposalType            String
  bookValueAtDisposal     Decimal   @db.Decimal(15, 2)
  accumulatedDepreciation Decimal   @db.Decimal(15, 2)
  disposalProceeds        Decimal   @default(0) @db.Decimal(15, 2)
  disposalCosts           Decimal   @default(0) @db.Decimal(12, 2)
  gainLoss                Decimal   @default(0) @db.Decimal(15, 2)
  buyerEntityId           Int?
  buyerName               String?
  buyerContact            String?
  buyerAddress            String?   @db.Text
  saleAgreementNumber     String?
  invoiceNumber           String?
  paymentReceivedDate     DateTime? @db.Date
  paymentMethod           String?
  status                  String    @default("draft")
  requestedByUserId       Int?
  approvedByUserId        Int?
  approvedAt              DateTime?
  completedAt             DateTime?
  isPosted                Boolean   @default(false)
  transactionId           Int?
  postedAt                DateTime?
  reason                  String?   @db.Text
  notes                   String?   @db.Text
  deletedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, disposalDate])
  @@index([companyId, status])
  @@map("ast_disposals")
}

model AssetSettings {
  id                          Int      @id @default(autoincrement())
  companyId                   Int      @unique
  defaultDepreciationMethod   String   @default("STRAIGHT_LINE")
  autoCalculateDepreciation   Boolean  @default(true)
  depreciationFrequency       String   @default("monthly")
  prorationFirstYear          Boolean  @default(true)
  prorationDisposalYear       Boolean  @default(true)
  midMonthConvention          Boolean  @default(false)
  requireAssetApproval        Boolean  @default(false)
  requireDisposalApproval     Boolean  @default(true)
  requireTransferApproval     Boolean  @default(true)
  requireMaintenanceApproval  Boolean  @default(false)
  autoGenerateCode            Boolean  @default(true)
  codePrefix                  String   @default("AST")
  codePadding                 Int      @default(6)
  allowRevaluation            Boolean  @default(false)
  requireRevaluationApproval  Boolean  @default(true)
  trackImpairment             Boolean  @default(true)
  calculateFairValue          Boolean  @default(false)
  trackMaintenanceCosts       Boolean  @default(true)
  maintenanceReminderDays     Int      @default(7)
  allowMaintenanceScheduling  Boolean  @default(true)
  capitalizationThreshold     Decimal  @default(5000) @db.Decimal(15, 2)
  allowInterCompanyTransfer   Boolean  @default(false)
  allowInterBranchTransfer    Boolean  @default(true)
  requirePhysicalVerification Boolean  @default(true)
  notifyOnDepreciation        Boolean  @default(false)
  notifyOnMaintenanceDue      Boolean  @default(true)
  notifyOnWarrantyExpiry      Boolean  @default(true)
  notifyOnDisposal            Boolean  @default(true)
  warrantyExpiryReminderDays  Int      @default(30)
  enableBarcode               Boolean  @default(true)
  enableQrCode                Boolean  @default(false)
  barcodeFormat               String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  // Relations
  company Company @relation(fields: [companyId], references: [id])

  @@map("ast_settings")
}
