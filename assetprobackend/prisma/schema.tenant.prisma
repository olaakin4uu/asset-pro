// ============================================================
// AssetPro — Tenant Schema
// Tables per tenant schema (provisioned at sign-up)
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// INFRASTRUCTURE — Migration tracking
// ============================================================================
model TenantMigration {
  id          String    @id @db.VarChar(255)
  description String?   @db.Text
  appliedAt   DateTime? @default(now()) @db.Timestamp(6)

  @@map("_tenant_migrations")
}

// ============================================================================
// CORE MODULE - Users, Companies, Branches
// ============================================================================

model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String    @unique
  emailVerifiedAt        DateTime?
  password               String
  companyId              Int?
  branchId               Int?
  entityId               Int?
  rememberToken          String?
  twoFactorSecret        String?   @db.Text
  twoFactorRecoveryCodes String?   @db.Text
  twoFactorConfirmedAt   DateTime?
  userType               UserType  @default(EMPLOYEE)
  themePreference        String?
  locale                 String    @default("en")
  signaturePath          String?
  inviteToken            String?
  inviteExpiresAt        DateTime?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  company Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  entity  IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  // Created records (audit trail)
  createdCompanies Company[] @relation("CompanyCreator")
  createdBranches  Branch[]  @relation("BranchCreator")
  createdRoles     Role[]    @relation("RoleCreator")
  createdUsers     User[]    @relation("UserCreator")

  // Updated records (audit trail)
  updatedCompanies Company[] @relation("CompanyUpdater")
  updatedBranches  Branch[]  @relation("BranchUpdater")
  updatedRoles     Role[]    @relation("RoleUpdater")
  updatedUsers     User[]    @relation("UserUpdater")

  // Self-referential audit (who created/updated this user)
  createdById   Int?
  updatedById   Int?
  createdByUser User? @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("UserUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  // Approvals
  processApprovals ProcessApproval[]

  // Personal access tokens
  tokens PersonalAccessToken[]

  // Audit logs
  auditLogs AuditLog[]

  // Messages sent
  sentMessages Message[] @relation("MessageSender")

  // Roles and permissions (Spatie-like)
  roles       UserRole[]
  permissions UserPermission[]

  // Multi-company / multi-branch access grants
  companyAccess UserCompanyAccess[]
  branchAccess  UserBranchAccess[]

  @@index([companyId])
  @@index([branchId])
  @@index([entityId])
  @@index([companyId, userType])
  @@index([branchId, userType])
  @@map("users")
}

enum UserType {
  EMPLOYEE
  CUSTOMER
  SUPPLIER
  INVESTOR
  ADMIN
  SYSTEM
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  name       String
  token      String    @unique @db.VarChar(64)
  abilities  Json?
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

model Company {
  id                 Int       @id @default(autoincrement())
  entityId           Int?
  name               String
  displayName        String?
  email              String?
  phone              String?
  address            String?   @db.Text
  city               String?
  state              String?
  country            String?
  postalCode         String?
  businessType       String    @default("general")
  currency           String    @default("NGN") @db.VarChar(3)
  taxNumber          String?
  registrationNumber String?
  website            String?
  logoPath           String?
  isActive           Boolean   @default(true)
  createdById        Int?
  updatedById        Int?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  entity    IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("CompanyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  branches Branch[]
  users    User[]

  // Process approvals
  approvalFlows     ProcessApprovalFlow[]
  approvalFlowSteps ProcessApprovalFlowStep[]
  processApprovals  ProcessApproval[]
  approvalStatuses  ProcessApprovalStatus[]

  // Accounting
  accounts       IfrsAccount[]
  currencies     IfrsCurrency[]
  transactions   IfrsTransaction[]
  journalEntries JournalEntry[]
  fiscalYears    FiscalYear[]
  periodLocks    PeriodLock[]
  banks          Bank[]

  // Petty Cash
  pettyCashFunds PettyCashFund[]

  // Expense requests
  expenseRequests ExpenseRequest[]

  // Bank transfers
  bankTransfers BankTransfer[]

  // Unposted accounting entries
  unpostedAccountingEntries UnpostedAccountingEntry[]

  // Notifications
  notifications Notification[]

  // Messages
  messages Message[]

  // Bank reconciliations & withholding
  bankReconciliations BankReconciliation[]
  withholdingTaxes    WithholdingTax[]
  pettyCashSettings   PettyCashSettings?

  // Assets
  assetClasses AssetClass[]
  assets       Asset[]
  assetSettings AssetSettings?

  // Departments
  departments Department[]

  userAccess UserCompanyAccess[]

  @@index([isActive, country])
  @@index([createdById])
  @@map("companies")
}

model Branch {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String
  code         String
  email        String?
  phone        String?
  address      String?   @db.Text
  city         String?
  state        String?
  country      String?
  postalCode   String?
  timezone     String    @default("Africa/Lagos")
  isActive     Boolean   @default(true)
  isHeadOffice Boolean   @default(false)
  createdById  Int?
  updatedById  Int?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("BranchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("BranchUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  users User[]
  banks Bank[]

  userAccess UserBranchAccess[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, isHeadOffice])
  @@index([code])
  @@index([createdById])
  @@map("branches")
}

model Department {
  id                 Int       @id @default(autoincrement())
  companyId          Int
  branchId           Int?
  parentDepartmentId Int?
  name               String
  code               String
  description        String?   @db.Text
  departmentHead     String?
  budgetAllocation   Decimal?  @db.Decimal(15, 2)
  costCenter         String?
  phone              String?
  email              String?
  location           String?   @db.Text
  isActive           Boolean   @default(true)
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Department? @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  @@unique([companyId, branchId, name])
  @@unique([companyId, branchId, code])
  @@index([companyId, branchId])
  @@map("departments")
}

// ============================================================================
// CORE MODULE - Process Approvals
// ============================================================================

model ProcessApprovalFlow {
  id                   Int      @id @default(autoincrement())
  name                 String
  approvableType       String
  entitySlug           String?
  description          String?  @db.Text
  conditions           Json?
  notificationSettings Json?
  isActive             Boolean  @default(true)
  isDefault            Boolean  @default(false)
  priority             Int      @default(10)
  autoSubmit           Boolean  @default(false)
  parallelApproval     Boolean  @default(false)
  companyId            Int?
  createdById          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  steps ProcessApprovalFlowStep[]

  @@index([companyId])
  @@index([approvableType])
  @@map("process_approval_flows")
}

model ProcessApprovalFlowStep {
  id                    Int            @id @default(autoincrement())
  processApprovalFlowId Int
  name                  String?
  description           String?        @db.Text
  roleId                Int?
  approverType          String         @default("role")
  approverIds           Json?
  approvalMode          String         @default("any")
  permissions           Json?
  employees             Json?
  escalationEmployees   Json?
  order                 Int?
  stepOrder             Int            @default(0)
  action                ApprovalAction @default(APPROVE)
  conditions            Json?
  isRequired            Boolean        @default(true)
  timeoutHours          Int?
  escalationRoleId      Int?
  escalationUserId      Int?
  isActive              Boolean        @default(true)
  stepType              String         @default("approve")
  overrideAllowed       Boolean        @default(false)
  overrideApproverType  String?
  overrideApproverIds   Json?
  overrideNoteMinLength Int            @default(30)
  overrideNotifySkipped Boolean        @default(true)
  branchId              Int?
  branchScope           String         @default("all")
  isLocked              Boolean        @default(false)
  isFinalStep           Boolean        @default(false)
  companyId             Int?
  tenantId              String?        @db.VarChar(38)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  // Relations
  processApprovalFlow ProcessApprovalFlow @relation(fields: [processApprovalFlowId], references: [id], onDelete: Cascade)
  role                Role?               @relation(fields: [roleId], references: [id])
  company             Company?            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  approvals ProcessApproval[]

  @@index([roleId])
  @@index([order])
  @@index([tenantId])
  @@map("process_approval_flow_steps")
}

enum ApprovalAction {
  APPROVE
  VERIFY
  CHECK
}

model ProcessApproval {
  id                        Int       @id @default(autoincrement())
  approvableType            String
  approvableId              Int
  processApprovalFlowStepId Int?
  approvalAction            String    @default("Approved") @db.VarChar(64)
  approverName              String?   @db.Text
  comment                   String?   @db.Text
  signaturePath             String?
  approvedAt                DateTime?
  userId                    Int
  companyId                 Int?
  tenantId                  String?   @db.VarChar(38)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Relations
  processApprovalFlowStep ProcessApprovalFlowStep? @relation(fields: [processApprovalFlowStepId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company                 Company?                 @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([approvableType, approvableId])
  @@index([tenantId])
  @@map("process_approvals")
}

model ProcessApprovalStatus {
  id             Int      @id @default(autoincrement())
  approvableType String
  approvableId   Int
  steps          Json?
  status         String   @default("CREATED") @db.VarChar(10)
  creatorId      Int?
  companyId      Int?
  tenantId       String?  @db.VarChar(38)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([approvableType, approvableId])
  @@index([tenantId])
  @@map("process_approval_statuses")
}

model ApprovableModelRegistry {
  id                    Int      @id @default(autoincrement())
  modelClass            String   @unique
  displayName           String
  moduleName            String
  availableFields       Json?
  defaultConditions     Json?
  notificationTemplates Json?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("approvable_model_registry")
}

// ============================================================================
// CORE MODULE - Roles & Permissions (Spatie-like)
// ============================================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String
  guardName   String   @default("web")
  description String?
  createdById Int?
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy User? @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("RoleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  permissions   RolePermission[]
  users         UserRole[]
  approvalSteps ProcessApprovalFlowStep[]

  @@unique([name, guardName])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String
  guardName   String   @default("web")
  module      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[]

  @@unique([name, guardName])
  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_has_permissions")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       Int
  permissionId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserCompanyAccess {
  userId    Int
  companyId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company_access")
}

model UserBranchAccess {
  userId   Int
  branchId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

// ============================================================================
// CORE MODULE - Messages & Notifications
// ============================================================================

model Message {
  id                Int             @id @default(autoincrement())
  uuid              String          @unique @default(uuid())
  companyId         Int
  senderId          Int
  subject           String
  body              String          @db.Text
  bodyHtml          String?         @db.Text
  priority          MessagePriority @default(NORMAL)
  referenceableType String?
  referenceableId   Int?
  parentId          Int?
  isDraft           Boolean         @default(false)
  sentAt            DateTime?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sender  User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  parent  Message?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Message[] @relation("MessageReplies")

  @@index([companyId])
  @@index([senderId])
  @@index([sentAt])
  @@index([parentId])
  @@index([isDraft, sentAt])
  @@map("messages")
}

enum MessagePriority {
  NORMAL
  HIGH
  URGENT
}

model Notification {
  id             String    @id @default(uuid())
  type           String
  notifiableType String
  notifiableId   Int
  data           Json
  readAt         DateTime?
  companyId      Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([notifiableType, notifiableId])
  @@index([readAt])
  @@map("notifications")
}

// ============================================================================
// CORE MODULE - Audit Log
// ============================================================================

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  event         String
  auditableType String
  auditableId   Int
  oldValues     Json?
  newValues     Json?
  url           String?
  ipAddress     String?
  userAgent     String?  @db.Text
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([auditableType, auditableId])
  @@index([userId])
  @@index([createdAt])
  @@map("audits")
}

// ============================================================================
// ACCOUNTS MODULE - IFRS Entities & Categories
// ============================================================================

model IfrsEntity {
  id              Int       @id @default(autoincrement())
  name            String
  currencyId      Int?
  parentEntityId  Int?
  year            Int?
  multiCurrency   Boolean   @default(false)
  midYearBalances Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  currency      IfrsCurrency? @relation("EntityCurrency", fields: [currencyId], references: [id], onDelete: SetNull)
  parentEntity  IfrsEntity?   @relation("EntityHierarchy", fields: [parentEntityId], references: [id], onDelete: SetNull)
  childEntities IfrsEntity[]  @relation("EntityHierarchy")

  users            User[]
  companies        Company[]
  accounts         IfrsAccount[]
  categories       IfrsCategory[]
  reportingPeriods IfrsReportingPeriod[]
  vats             IfrsVat[]
  balances         IfrsBalance[]
  transactions     IfrsTransaction[]
  ledgers          IfrsLedger[]

  @@map("ifrs_entities")
}

model IfrsCurrency {
  id            Int       @id @default(autoincrement())
  name          String
  code          String    @db.VarChar(3)
  symbol        String?
  decimalPlaces Int       @default(2)
  entityId      Int?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  entities IfrsEntity[] @relation("EntityCurrency")
  accounts IfrsAccount[]

  // Exchange rates
  exchangeRatesFrom IfrsExchangeRate[] @relation("ExchangeRateFrom")
  exchangeRatesTo   IfrsExchangeRate[] @relation("ExchangeRateTo")
  company           Company?           @relation(fields: [companyId], references: [id])
  companyId         Int?

  @@unique([entityId, code])
  @@index([entityId])
  @@map("ifrs_currencies")
}

model IfrsReportingPeriod {
  id           Int       @id @default(autoincrement())
  entityId     Int
  calendarYear Int
  number       Int
  label        String
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  status       String    @default("OPEN")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  entity IfrsEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, calendarYear, number])
  @@index([entityId, calendarYear])
  @@map("ifrs_reporting_periods")
}

model IfrsCategory {
  id           Int       @id @default(autoincrement())
  entityId     Int?
  name         String
  categoryType String
  code         String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  entity   IfrsEntity?   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  accounts IfrsAccount[]

  @@index([entityId])
  @@index([categoryType])
  @@map("ifrs_categories")
}

// ============================================================================
// ACCOUNTS MODULE - Chart of Accounts
// ============================================================================

model IfrsAccount {
  id                Int       @id @default(autoincrement())
  entityId          Int?
  companyId         Int?
  categoryId        Int?
  currencyId        Int?
  code              String
  name              String
  description       String?   @db.Text
  accountType       String
  ifrs18AccountType String?
  parentId          Int?
  isPosting         Boolean   @default(true)
  closingRate       Boolean   @default(false)
  isActive          Boolean   @default(true)
  normalBalance     String    @default("debit") @db.VarChar(20)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  entity   IfrsEntity?   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  company  Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category IfrsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  currency IfrsCurrency? @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  parent   IfrsAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children IfrsAccount[] @relation("AccountHierarchy")

  balances           IfrsBalance[]
  debitTransactions  IfrsTransaction[]  @relation("DebitAccount")
  creditTransactions IfrsTransaction[]  @relation("CreditAccount")
  ledgers            IfrsLedger[]
  journalLines       JournalEntryLine[]

  // Bank accounts
  bankAccounts Bank[]

  // Bank transfer items
  transferItemsSource BankTransferItem[] @relation("TransferItemSourceAccount")
  transferItemsDest   BankTransferItem[] @relation("TransferItemDestAccount")

  @@unique([entityId, code])
  @@unique([companyId, code])
  @@index([categoryId])
  @@index([accountType])
  @@map("ifrs_accounts")
}

model IfrsVat {
  id             Int       @id @default(autoincrement())
  entityId       Int?
  name           String
  code           String
  rate           Decimal   @db.Decimal(5, 2)
  accountId      Int?
  inputAccountId Int?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  entity IfrsEntity? @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("ifrs_vats")
}

model IfrsBalance {
  id                 Int       @id @default(autoincrement())
  entityId           Int
  accountId          Int
  year               Int
  period             Int
  balance            Decimal   @db.Decimal(15, 2)
  balanceType        String    @default("debit")
  createdBy          Int?
  approvedAt         DateTime?
  approvedBy         Int?
  approvalComment    String?   @db.Text
  lastModifiedBy     Int?
  modificationReason String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  entity  IfrsEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  account IfrsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([entityId, accountId, year, period])
  @@map("ifrs_balances")
}

model IfrsTransaction {
  id              Int       @id @default(autoincrement())
  entityId        Int
  companyId       Int?
  transactionDate DateTime  @db.Date
  transactionNo   String?
  transactionType String?
  debitAccountId  Int
  creditAccountId Int
  amount          Decimal   @db.Decimal(15, 2)
  narration       String?   @db.Text
  reference       String?
  referenceType   String?
  referenceId     Int?
  currency        String?   @db.VarChar(3)
  exchangeRate    Decimal?  @db.Decimal(15, 6)
  baseAmount      Decimal?  @db.Decimal(15, 2)
  isCleared       Boolean   @default(false)
  clearedDate     DateTime?
  isReversed      Boolean   @default(false)
  reversedBy      Int?
  reversalOf      Int?
  posted          Boolean   @default(false)
  postedAt        DateTime?
  postedBy        Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  entity        IfrsEntity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  debitAccount  IfrsAccount @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccount IfrsAccount @relation("CreditAccount", fields: [creditAccountId], references: [id])

  @@index([entityId])
  @@index([companyId])
  @@index([transactionDate])
  @@index([transactionNo])
